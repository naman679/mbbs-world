&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;A 6-month-old male infant is brought by his parents to a primary healthcare center in a semi-urban area of India. The parents are concerned about their child&#x27;s lack of response to stimuli and inability to support his head, which they noticed was significantly different from their older child at this age. They also mention that the infant has had episodes described as \&quot;startles\&quot; that seemed abnormal and unlike typical infant reflexes. On physical examination, the physician notes the infant&#x27;s peculiar hair, which is sparse, kinky, and depigmented, along with loose skin folds, microcephaly, and a pronounced forehead. Given these findings and considering the rural Indian healthcare setting where genetic testing facilities are rare, the physician recalls a rare disease of copper metabolism linked to the ATP7A gene mutation. What is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Wilson\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Menkes disease&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Dubin Johnson syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Rotor Syndrome&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Menkes disease&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture11_ZaSc03U.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Menkes disease&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Wilson\u2019s disease (A) involves a different gene (ATP7B) and typically presents later in childhood or adolescence with liver disease and neuropsychiatric symptoms. Dubin-Johnson syndrome (C) and Rotor syndrome (D) are both hereditary hyperbilirubinemia syndromes , primarily affecting the liver, and do not present with the neurological or connective tissue features seen in Menkes disease.&lt;/li&gt;&lt;li&gt;\u2022 Wilson\u2019s disease (A) involves a different gene (ATP7B) and typically presents later in childhood or adolescence with liver disease and neuropsychiatric symptoms.&lt;/li&gt;&lt;li&gt;\u2022 Wilson\u2019s disease (A)&lt;/li&gt;&lt;li&gt;\u2022 (ATP7B)&lt;/li&gt;&lt;li&gt;\u2022 liver disease and neuropsychiatric symptoms.&lt;/li&gt;&lt;li&gt;\u2022 Dubin-Johnson syndrome (C) and Rotor syndrome (D) are both hereditary hyperbilirubinemia syndromes , primarily affecting the liver, and do not present with the neurological or connective tissue features seen in Menkes disease.&lt;/li&gt;&lt;li&gt;\u2022 Dubin-Johnson syndrome (C) and Rotor syndrome (D) are both hereditary hyperbilirubinemia syndromes&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Menkes disease, also known as kinky hair disease , is a rare X-linked recessive disorder characterized by defective copper transport due to mutations in the ATP7A gene . This leads to a deficiency in copper-dependent enzymes like lysyl oxidase that are crucial for neurodevelopment, connective tissue formation, and hair pigmentation .&lt;/li&gt;&lt;li&gt;\u27a4 Menkes disease, also known as kinky hair disease&lt;/li&gt;&lt;li&gt;\u27a4 X-linked recessive disorder&lt;/li&gt;&lt;li&gt;\u27a4 ATP7A gene&lt;/li&gt;&lt;li&gt;\u27a4 lysyl oxidase&lt;/li&gt;&lt;li&gt;\u27a4 crucial for neurodevelopment, connective tissue formation, and hair pigmentation&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition page 3123&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition page 3123&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-year-old girl is brought in by her mother due to failure to thrive and easy fatigability. Examination reveals severe anemia, splenomegaly, and jaundice. The patient&#x27;s family history includes an unspecified \&quot;blood problem.\&quot; Hemoglobin electrophoresis is normal, and a complete blood count (CBC) shows normocytic anemia. Peripheral blood smear demonstrates numerous abnormal erythrocytes, including spiculated cells. Given these findings and the presence of an enzyme deficiency leading to anemia, what is the most common enzyme deficiency associated with this presentation?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Glucose-6-phosphate dehydrogenase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Glucose-6-Phosphatase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Pyruvate dehydrogenase complex (PDC)&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Pyruvate kinase deficiency&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Pyruvate kinase deficiency&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Pyruvate kinase deficiency&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Glucose-6-phosphate dehydrogenase deficiency will results in anemia with Smear findings of `Bite cells .&lt;/li&gt;&lt;li&gt;\u2022 Option A:&lt;/li&gt;&lt;li&gt;\u2022 Glucose-6-phosphate dehydrogenase deficiency&lt;/li&gt;&lt;li&gt;\u2022 anemia&lt;/li&gt;&lt;li&gt;\u2022 Smear findings of `Bite cells&lt;/li&gt;&lt;li&gt;\u2022 Option B: Glucose-6-Phosphatase deficiency will results in the Type 1 Glycogen storage disorder .&lt;/li&gt;&lt;li&gt;\u2022 Option B:&lt;/li&gt;&lt;li&gt;\u2022 Glucose-6-Phosphatase deficiency&lt;/li&gt;&lt;li&gt;\u2022 Type 1 Glycogen storage disorder&lt;/li&gt;&lt;li&gt;\u2022 Option C: Pyruvate dehydrogenase complex (PDC) deficiency will results in the Lactic acidosis , ataxia and retardation.&lt;/li&gt;&lt;li&gt;\u2022 Option C:&lt;/li&gt;&lt;li&gt;\u2022 Pyruvate dehydrogenase complex&lt;/li&gt;&lt;li&gt;\u2022 Lactic acidosis&lt;/li&gt;&lt;li&gt;\u2022 ataxia&lt;/li&gt;&lt;li&gt;\u2022 retardation.&lt;/li&gt;&lt;li&gt;\u2022 Educational objective:&lt;/li&gt;&lt;li&gt;\u2022 Educational objective:&lt;/li&gt;&lt;li&gt;\u2022 Pyruvate kinase deficiency is an enzyme disorder that leads to hemolytic anemia by affecting the glycolytic pathway in red blood cells , resulting in insufficient ATP production and decreased cell survival . The clinical presentation can include failure to thrive, severe anemia , splenomegaly, and jaundice . The presence of bizarre erythrocytes , including spiculated cells on the peripheral smear , is consistent with hemolytic anemia .&lt;/li&gt;&lt;li&gt;\u2022 Pyruvate kinase deficiency&lt;/li&gt;&lt;li&gt;\u2022 enzyme disorder&lt;/li&gt;&lt;li&gt;\u2022 leads to hemolytic anemia&lt;/li&gt;&lt;li&gt;\u2022 glycolytic pathway in red blood cells&lt;/li&gt;&lt;li&gt;\u2022 insufficient ATP production&lt;/li&gt;&lt;li&gt;\u2022 decreased cell survival&lt;/li&gt;&lt;li&gt;\u2022 failure to thrive, severe anemia&lt;/li&gt;&lt;li&gt;\u2022 splenomegaly,&lt;/li&gt;&lt;li&gt;\u2022 jaundice&lt;/li&gt;&lt;li&gt;\u2022 bizarre erythrocytes&lt;/li&gt;&lt;li&gt;\u2022 spiculated cells on the peripheral smear&lt;/li&gt;&lt;li&gt;\u2022 consistent with hemolytic anemia&lt;/li&gt;&lt;li&gt;\u2022 Ref: Nelson 21 st edition, Chapter 490 \u2013 Page No 10062-10065&lt;/li&gt;&lt;li&gt;\u2022 Ref:&lt;/li&gt;&lt;li&gt;\u2022 Nelson 21 st edition, Chapter 490 \u2013 Page No 10062-10065&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 15-year-old girl presents to the pediatric outpatient department with progressive writhing and jerking movements of the extremities, excessive drooling, and multiple joint pains. On examination, a brown-yellow pigment is noted around the iris. Despite an unremarkable CT scan, an MRI reveals bilateral hypodense areas in the basal ganglia. Laboratory tests show elevated levels of aspartate transaminase (AST) and alanine transaminase (ALT). Based on the clinical presentation and investigative findings, which gene is most likely responsible for her condition?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;ATP 7A in Chromosome 13&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;ATP 7B in Chromosome 13&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;ATP 13B in Chromosome 7&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;ATP 13A in Chromosome 7&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. ATP 7B in Chromosome 13&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) ATP 7B in Chromosome 13&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. ATP 7A on Chromosome 13: Mutations in the ATP7A gene cause Menkes disease , a condition characterized by copper deficiency , leading to neurological degeneration , kinky hair , and growth failure , which is not consistent with the patient&#x27;s presentation.&lt;/li&gt;&lt;li&gt;\u2022 Option A. ATP 7A on Chromosome 13:&lt;/li&gt;&lt;li&gt;\u2022 Mutations&lt;/li&gt;&lt;li&gt;\u2022 ATP7A gene&lt;/li&gt;&lt;li&gt;\u2022 Menkes disease&lt;/li&gt;&lt;li&gt;\u2022 copper deficiency&lt;/li&gt;&lt;li&gt;\u2022 neurological degeneration&lt;/li&gt;&lt;li&gt;\u2022 kinky hair&lt;/li&gt;&lt;li&gt;\u2022 growth failure&lt;/li&gt;&lt;li&gt;\u2022 Option C. ATP 13B on Chromosome 7 &amp;amp; D. ATP 13A on Chromosome 7: There are no well-documented diseases directly associated with mutations in ATP 13B or ATP 13A that match the clinical features described in the question. These options are included as distractors.&lt;/li&gt;&lt;li&gt;\u2022 Option C. ATP 13B on Chromosome 7 &amp;amp; D. ATP 13A on Chromosome 7:&lt;/li&gt;&lt;li&gt;\u2022 no well-documented diseases directly associated&lt;/li&gt;&lt;li&gt;\u2022 mutations in ATP 13B or ATP 13A&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Wilson&#x27;s disease , an autosomal recessive disorder affecting copper metabolism , leading to copper accumulation in tissues . This condition is characterized by neurological symptoms (such as writhing and jerking movements), psychiatric disturbances , Kayser-Fleischer rings (the brown-yellow pigment around the iris), and liver dysfunction (elevated AST and ALT). The disease is caused by mutations in the ATP7B gene located on Chromosome 13 , which encodes a protein essential for copper transport and excretion.&lt;/li&gt;&lt;li&gt;\u27a4 Wilson&#x27;s disease&lt;/li&gt;&lt;li&gt;\u27a4 autosomal recessive disorder&lt;/li&gt;&lt;li&gt;\u27a4 copper metabolism&lt;/li&gt;&lt;li&gt;\u27a4 copper accumulation in tissues&lt;/li&gt;&lt;li&gt;\u27a4 neurological symptoms&lt;/li&gt;&lt;li&gt;\u27a4 psychiatric disturbances&lt;/li&gt;&lt;li&gt;\u27a4 Kayser-Fleischer rings&lt;/li&gt;&lt;li&gt;\u27a4 liver dysfunction&lt;/li&gt;&lt;li&gt;\u27a4 ATP7B gene located on Chromosome 13&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition Page No- 1940.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition Page No- 1940.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 7-month-old full-term female infant is brought in by her mother due to poor weight gain. The child exhibits failure to thrive, hypotonia, reduced muscle mass, and significant head lag upon physical examination. Laboratory tests reveal markedly elevated levels of lactate, pyruvate, and alanine, with a blood gas analysis showing a pH of 7.0. Despite treatment with thiamine, the infant&#x27;s lactic acidosis does not improve. Based on the clinical and laboratory findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Pyruvate dehydrogenase complex (PDC) deficiency&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Pyruvate kinase deficiency&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Glucose-6-phosphate dehydrogenase deficiency&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Glucose-6-Phosphatase deficiency&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Pyruvate dehydrogenase complex (PDC) deficiency&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Pyruvate dehydrogenase complex (PDC) deficiency&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B: Pyruvate kinase deficiency will result in hemolytic anemia along with hepatosplenomegaly.&lt;/li&gt;&lt;li&gt;\u2022 Option B:&lt;/li&gt;&lt;li&gt;\u2022 Pyruvate kinase deficiency&lt;/li&gt;&lt;li&gt;\u2022 hemolytic anemia&lt;/li&gt;&lt;li&gt;\u2022 hepatosplenomegaly.&lt;/li&gt;&lt;li&gt;\u2022 Option C: Glucose-6-phosphate dehydrogenase deficiency will results in hemolytic anemia with Smear findings of `Bite cells .&lt;/li&gt;&lt;li&gt;\u2022 Option C:&lt;/li&gt;&lt;li&gt;\u2022 Glucose-6-phosphate dehydrogenase deficiency&lt;/li&gt;&lt;li&gt;\u2022 hemolytic anemia&lt;/li&gt;&lt;li&gt;\u2022 Smear findings of `Bite cells&lt;/li&gt;&lt;li&gt;\u2022 Option D: Glucose-6-Phosphatase deficiency will results in the Type 1 Glycogen storage disorder .&lt;/li&gt;&lt;li&gt;\u2022 Option D:&lt;/li&gt;&lt;li&gt;\u2022 Glucose-6-Phosphatase deficiency&lt;/li&gt;&lt;li&gt;\u2022 Type 1 Glycogen storage disorder&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Pyruvate dehydrogenase complex (PDC) deficiency , a metabolic disorder marked by elevated lactate , pyruvate , and alanine levels , along with failure to thrive and neurological symptoms&lt;/li&gt;&lt;li&gt;\u27a4 Pyruvate dehydrogenase complex&lt;/li&gt;&lt;li&gt;\u27a4 deficiency&lt;/li&gt;&lt;li&gt;\u27a4 metabolic disorder&lt;/li&gt;&lt;li&gt;\u27a4 elevated lactate&lt;/li&gt;&lt;li&gt;\u27a4 pyruvate&lt;/li&gt;&lt;li&gt;\u27a4 alanine levels&lt;/li&gt;&lt;li&gt;\u27a4 failure to thrive&lt;/li&gt;&lt;li&gt;\u27a4 neurological symptoms&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No 3487-3489&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No 3487-3489&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 12-year-old girl is brought in by her anxious mother due to a significantly enlarged abdomen and recurrent episodes of weakness, sweating, and pallor, which resolve after eating. The child has a history of delayed developmental milestones and poor academic performance. Physical examination reveals an enlarged, firm liver. Laboratory tests show hypoglycemia, acidosis (low pH), elevated lactate, triglycerides, ketones, and free fatty acids. A liver biopsy indicates high glycogen content with normal structure, and enzyme assays reveal markedly low levels of glucose-6-phosphatase. Based on these findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Von Gierke\u2019s disease&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Anderson\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Cori\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Pompe\u2019s disease&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Von Gierke\u2019s disease&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Von Gierke\u2019s disease&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Anderson\u2019s disease (Glycogen Storage Disease Type IV): Characterized by abnormal glycogen with a branched structure , leading to liver cirrhosis , but not typically presenting with hypoglycemia or the specific metabolic abnormalities seen in Von Gierke\u2019s disease.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Anderson\u2019s disease (Glycogen Storage Disease Type IV):&lt;/li&gt;&lt;li&gt;\u2022 abnormal glycogen&lt;/li&gt;&lt;li&gt;\u2022 branched structure&lt;/li&gt;&lt;li&gt;\u2022 liver cirrhosis&lt;/li&gt;&lt;li&gt;\u2022 Option C. Cori\u2019s disease (Glycogen Storage Disease Type III): Involves a deficiency in the debranching enzyme , leading to abnormal glycogen structure and mild hypoglycemia , but not as severe as in Von Gierke\u2019s disease.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Cori\u2019s disease (Glycogen Storage Disease Type III):&lt;/li&gt;&lt;li&gt;\u2022 deficiency in the debranching enzyme&lt;/li&gt;&lt;li&gt;\u2022 abnormal glycogen structure&lt;/li&gt;&lt;li&gt;\u2022 mild hypoglycemia&lt;/li&gt;&lt;li&gt;\u2022 Option D. Pompe\u2019s disease (Glycogen Storage Disease Type II): Caused by a deficiency in the lysosomal acid alpha-glucosidase , leading to glycogen accumulation in lysosomes , particularly affecting muscle tissue, not primarily associated with hypoglycemia or liver enlargement.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Pompe\u2019s disease (Glycogen Storage Disease Type II):&lt;/li&gt;&lt;li&gt;\u2022 deficiency in the lysosomal acid alpha-glucosidase&lt;/li&gt;&lt;li&gt;\u2022 glycogen accumulation in lysosomes&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Von Gierke\u2019s disease (Glycogen Storage Disease Type Ia) through its hallmark features of hypoglycemia , lactic acidosis , hyperlipidemia , and hepatomegaly due to a deficiency in glucose-6-phosphatase .&lt;/li&gt;&lt;li&gt;\u27a4 Von Gierke\u2019s disease&lt;/li&gt;&lt;li&gt;\u27a4 hypoglycemia&lt;/li&gt;&lt;li&gt;\u27a4 lactic acidosis&lt;/li&gt;&lt;li&gt;\u27a4 hyperlipidemia&lt;/li&gt;&lt;li&gt;\u27a4 hepatomegaly&lt;/li&gt;&lt;li&gt;\u27a4 deficiency in glucose-6-phosphatase&lt;/li&gt;&lt;li&gt;\u27a4 Affected tissue : Liver and kidney&lt;/li&gt;&lt;li&gt;\u27a4 tissue&lt;/li&gt;&lt;li&gt;\u27a4 Clinical features: large quantities of glycogen are formed and stored in hepatocytes, renal and intestinal mucosa cells . The liver and kidneys become enlarged. Abnormalities of lipids may lead to xanthoma formation. Uric acid is often elevated and may cause clinical gout. Galactose, fructose, and glycerol are metabolised to lactate. The elevated blood lactate levels cause metabolic acidosis.&lt;/li&gt;&lt;li&gt;\u27a4 Clinical features:&lt;/li&gt;&lt;li&gt;\u27a4 . The liver and kidneys become enlarged.&lt;/li&gt;&lt;li&gt;\u27a4 lipids&lt;/li&gt;&lt;li&gt;\u27a4 xanthoma formation.&lt;/li&gt;&lt;li&gt;\u27a4 Treatment : Blood loss may require oral iron. Treatment of hyperuricaemia and pyelonephritis protect renal function. Diazoxide to maintain blood glucose has been disappointing. Liver transplantation for primary disease or for hepatocellular carcinoma seems effective.&lt;/li&gt;&lt;li&gt;\u27a4 Treatment&lt;/li&gt;&lt;li&gt;\u27a4 hyperuricaemia and pyelonephritis&lt;/li&gt;&lt;li&gt;\u27a4 Liver transplantation&lt;/li&gt;&lt;li&gt;\u27a4 hepatocellular carcinoma&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No 3441-3446&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 105 \u2013 Page No 3441-3446&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A newborn becomes lethargic and difficult to feed, developing progressive jaundice with a serum bilirubin level peaking at 13.5 mg/dL. Despite undergoing exchange blood transfusions, the bilirubin levels remain elevated. On the ninth day, vomiting commences, and the infant exhibits hepatomegaly and worsening cerebral symptoms. The accompanying eye findings, consistent with the provided image, and positive urine tests for reducing substances (which are negative when specifically testing for glucose), suggest hereditary galactosemia. Which of the following is NOT a clinical feature of hereditary galactosemia?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Hepatosplenomegaly&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Amino aciduria&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Mental retardation&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Weight gain&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Weight gain&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture3_UsEmUMc.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Weight gain&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Hepatosplenomegaly: This is a common feature of hereditary galactosemia due to the accumulation of galactose-1-phosphate in the liver and spleen.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Hepatosplenomegaly:&lt;/li&gt;&lt;li&gt;\u2022 hereditary galactosemia&lt;/li&gt;&lt;li&gt;\u2022 accumulation of galactose-1-phosphate&lt;/li&gt;&lt;li&gt;\u2022 liver and spleen.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Aminoaciduria: This occurs due to the toxic effects of accumulated metabolites on the renal tubules , leading to the excretion of amino acids in the urine .&lt;/li&gt;&lt;li&gt;\u2022 Option B. Aminoaciduria:&lt;/li&gt;&lt;li&gt;\u2022 toxic effects of accumulated metabolites&lt;/li&gt;&lt;li&gt;\u2022 renal tubules&lt;/li&gt;&lt;li&gt;\u2022 excretion of amino acids&lt;/li&gt;&lt;li&gt;\u2022 urine&lt;/li&gt;&lt;li&gt;\u2022 Option C. Mental retardation: Can develop as a result of chronic toxicity from the accumulated galactose metabolites if the condition remains untreated.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Mental retardation:&lt;/li&gt;&lt;li&gt;\u2022 chronic toxicity from the accumulated galactose metabolites&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hereditary galactosemia is a metabolic disorder resulting from a deficiency of one of the enzymes involved in galactose metabolism , most commonly galactose-1-phosphate uridyltransferase . This leads to the accumulation of galactose-1-phosphate and related metabolites, causing multiple systemic effects . Clinical features include failure to thrive (which is contradictory to weight gain), jaundice, hepatomegaly, vomiting , and in untreated cases, cataracts, aminoaciduria, and mental retardation . Weight gain is not a feature of hereditary galactosemia; instead, these patients often have failure to thrive due to liver dysfunction and feeding difficulties .&lt;/li&gt;&lt;li&gt;\u27a4 Hereditary galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 metabolic disorder&lt;/li&gt;&lt;li&gt;\u27a4 deficiency of one of the enzymes&lt;/li&gt;&lt;li&gt;\u27a4 galactose metabolism&lt;/li&gt;&lt;li&gt;\u27a4 galactose-1-phosphate uridyltransferase&lt;/li&gt;&lt;li&gt;\u27a4 accumulation of&lt;/li&gt;&lt;li&gt;\u27a4 multiple systemic effects&lt;/li&gt;&lt;li&gt;\u27a4 failure to thrive&lt;/li&gt;&lt;li&gt;\u27a4 jaundice, hepatomegaly, vomiting&lt;/li&gt;&lt;li&gt;\u27a4 untreated cases, cataracts, aminoaciduria, and mental retardation&lt;/li&gt;&lt;li&gt;\u27a4 failure to thrive due to liver dysfunction and feeding difficulties&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No-3473-3476.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 105 \u2013 Page No-3473-3476.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-month-old infant presents with failure to thrive and abdominal distension. On examination, the pediatrician notes hepatosplenomegaly. Liver biopsy findings show glycogen with an abnormal, amylopectin-like structure characterized by long outer chains and a lack of branching points. Based on these biopsy findings, which type of Glycogen Storage Disease (GSD) is most likely?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Cori\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Anderson\u2019s disease&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Her\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Pompes disease&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Anderson\u2019s disease&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Anderson\u2019s disease&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Cori\u2019s disease (GSD III): Cori&#x27;s disease is due to a deficiency of the debranching enzyme (amylo-1,6-glucosidase ). This leads to a limit dextrin-like structure in the glycogen, not the long outer chains without adequate branching seen in Anderson&#x27;s disease .&lt;/li&gt;&lt;li&gt;\u2022 Option A. Cori\u2019s disease (GSD III):&lt;/li&gt;&lt;li&gt;\u2022 deficiency&lt;/li&gt;&lt;li&gt;\u2022 debranching enzyme (amylo-1,6-glucosidase&lt;/li&gt;&lt;li&gt;\u2022 limit dextrin-like structure&lt;/li&gt;&lt;li&gt;\u2022 not the long outer chains&lt;/li&gt;&lt;li&gt;\u2022 Anderson&#x27;s disease&lt;/li&gt;&lt;li&gt;\u2022 Option C. Her\u2019s disease (GSD VI): Her&#x27;s disease is caused by a deficiency of liver phosphorylase . It does not cause the accumulation of abnormal glycogen but rather an inability to adequately break down normal glycogen .&lt;/li&gt;&lt;li&gt;\u2022 Option C. Her\u2019s disease (GSD VI):&lt;/li&gt;&lt;li&gt;\u2022 liver phosphorylase&lt;/li&gt;&lt;li&gt;\u2022 accumulation of abnormal glycogen&lt;/li&gt;&lt;li&gt;\u2022 inability&lt;/li&gt;&lt;li&gt;\u2022 normal glycogen&lt;/li&gt;&lt;li&gt;\u2022 Option D. Pompe\u2019s disease (GSD II): Pompe&#x27;s disease is a lysosomal storage disease due to deficiency of the enzyme acid alpha-glucosidase . It leads to the accumulation of normal glycogen in lysosomes and not the abnormal structure described.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Pompe\u2019s disease (GSD II):&lt;/li&gt;&lt;li&gt;\u2022 lysosomal storage disease&lt;/li&gt;&lt;li&gt;\u2022 deficiency of the enzyme acid alpha-glucosidase&lt;/li&gt;&lt;li&gt;\u2022 normal glycogen in lysosomes&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Anderson&#x27;s disease, or GSD IV, is caused by a deficiency of the branching enzyme (\u03b1-1,4-glucan 6-glycosyltransferase) . This deficiency results in the accumulation of an abnormal glycogen with a structure similar to amylopectin , known as polyglucosan, which has long outer chains and is missing the appropriate branching pattern . The liver biopsy of a patient with Anderson&#x27;s disease typically shows this abnormal glycogen structure , which aligns with the findings described in the patient.&lt;/li&gt;&lt;li&gt;\u27a4 Anderson&#x27;s disease, or GSD IV,&lt;/li&gt;&lt;li&gt;\u27a4 deficiency&lt;/li&gt;&lt;li&gt;\u27a4 (\u03b1-1,4-glucan 6-glycosyltransferase)&lt;/li&gt;&lt;li&gt;\u27a4 abnormal glycogen&lt;/li&gt;&lt;li&gt;\u27a4 similar to amylopectin&lt;/li&gt;&lt;li&gt;\u27a4 polyglucosan,&lt;/li&gt;&lt;li&gt;\u27a4 missing the appropriate branching pattern&lt;/li&gt;&lt;li&gt;\u27a4 liver biopsy&lt;/li&gt;&lt;li&gt;\u27a4 abnormal glycogen structure&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No 3458-3463&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 105 \u2013 Page No 3458-3463&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Madhuri, an 11-year-old girl, presents with joint pain and stiffness, particularly in the hips and knees, and reports that her urine turns dark upon air exposure and has a peculiar odor. Physical examination shows pigmented areas on her skin, and laboratory tests reveal elevated levels of homogentisic acid in her urine. Based on these clinical findings, what is the most likely diagnosis and its mode of inheritance?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Alkaptonuria and Autosomal Dominant.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Phenylketonuria and Autosomal Dominant.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Phenylketonuria and Autosomal Recessive&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Alkaptonuria and Autosomal Recessive&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Alkaptonuria and Autosomal Recessive&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture6_o8HgSS1.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture7_wX4aPp7.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Alkaptonuria and Autosomal Recessive&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Alkaptonuria and Autosomal Dominant: This is incorrect; alkaptonuria is autosomal recessive .&lt;/li&gt;&lt;li&gt;\u2022 Option A. Alkaptonuria and Autosomal Dominant:&lt;/li&gt;&lt;li&gt;\u2022 alkaptonuria is autosomal recessive&lt;/li&gt;&lt;li&gt;\u2022 Option B. Phenylketonuria and Autosomal Dominant: This is incorrect; PKU is autosomal recessive and is not associated with joint pain or urine darkening.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Phenylketonuria and Autosomal Dominant:&lt;/li&gt;&lt;li&gt;\u2022 PKU is autosomal recessive&lt;/li&gt;&lt;li&gt;\u2022 Option C. Phenylketonuria and Autosomal Recessive: Although PKU is autosomal recessive , it does not cause urine to darken or joint pain , making this option incorrect for the given clinical presentation.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Phenylketonuria and Autosomal Recessive:&lt;/li&gt;&lt;li&gt;\u2022 PKU is autosomal recessive&lt;/li&gt;&lt;li&gt;\u2022 not&lt;/li&gt;&lt;li&gt;\u2022 darken or joint pain&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Alkaptonuria is characterized by a deficiency in the enzyme homogentisate dioxygenase , leading to the accumulation of homogentisic acid , which can cause darkening of the urine upon exposure to air and joint pain due to ochronosis (buildup of homogentisic acid in connective tissues). The pigmentation found on physical examination further supports this diagnosis. Alkaptonuria is inherited in an autosomal recessive pattern.&lt;/li&gt;&lt;li&gt;\u27a4 Alkaptonuria&lt;/li&gt;&lt;li&gt;\u27a4 homogentisate dioxygenase&lt;/li&gt;&lt;li&gt;\u27a4 homogentisic acid&lt;/li&gt;&lt;li&gt;\u27a4 darkening of the urine upon exposure&lt;/li&gt;&lt;li&gt;\u27a4 to air&lt;/li&gt;&lt;li&gt;\u27a4 joint pain&lt;/li&gt;&lt;li&gt;\u27a4 ochronosis (buildup of homogentisic acid in connective tissues).&lt;/li&gt;&lt;li&gt;\u27a4 pigmentation&lt;/li&gt;&lt;li&gt;\u27a4 autosomal recessive&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 103 \u2013 Page No 3149-3150&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 103 \u2013 Page No 3149-3150&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 4-month-old infant presents to the pediatric department with a distinct fair complexion, blue eyes, blond hair, an eczematous rash, and a musty odor in the diapers. The mother reports concerns raised by a medical student about the child&#x27;s unusual features. After evaluating the clinical presentation, the physician suspects Phenylketonuria (PKU). Which of the following statements about Phenylketonuria is incorrect?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;It is an Autosomal Recessive disorder&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Tendon reflexes in the baby is hyperreactive&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Decrease phenylalanine and Tyrosine in diet&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Most of the babies are normal during birth&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Decrease phenylalanine and Tyrosine in diet&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture5_sNq2OQo.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Decrease phenylalanine and Tyrosine in diet&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Autosomal Recessive disorder: PKU is indeed an autosomal recessive disorder, meaning that a child must inherit one defective gene from each parent to manifest the disease.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Autosomal Recessive disorder:&lt;/li&gt;&lt;li&gt;\u2022 child&lt;/li&gt;&lt;li&gt;\u2022 one defective gene&lt;/li&gt;&lt;li&gt;\u2022 parent&lt;/li&gt;&lt;li&gt;\u2022 Option B. Tendon reflexes in the baby are hyperreactive: Neurological abnormalities, such as hyperactive reflexes , can occur in PKU due to the accumulation of phenylalanine , which can be toxic to the brain .&lt;/li&gt;&lt;li&gt;\u2022 Option B. Tendon reflexes in the baby are hyperreactive:&lt;/li&gt;&lt;li&gt;\u2022 hyperactive reflexes&lt;/li&gt;&lt;li&gt;\u2022 accumulation of phenylalanine&lt;/li&gt;&lt;li&gt;\u2022 toxic to the brain&lt;/li&gt;&lt;li&gt;\u2022 Option D. Most babies with PKU appear normal at birth: Newborns with PKU typically appear normal at birth because maternal metabolism compensates for the enzyme deficiency during fetal development . Symptoms and signs develop later if the condition remains untreated .&lt;/li&gt;&lt;li&gt;\u2022 Option D. Most babies with PKU appear normal at birth:&lt;/li&gt;&lt;li&gt;\u2022 Newborns&lt;/li&gt;&lt;li&gt;\u2022 PKU&lt;/li&gt;&lt;li&gt;\u2022 normal at birth&lt;/li&gt;&lt;li&gt;\u2022 maternal metabolism compensates for the enzyme deficiency during fetal development&lt;/li&gt;&lt;li&gt;\u2022 Symptoms and signs&lt;/li&gt;&lt;li&gt;\u2022 remains untreated&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Phenylketonuria (PKU) is a metabolic disorder characterized by a deficiency of the enzyme phenylalanine hydroxylase , which is necessary for converting phenylalanine to tyrosine . Dietary management of PKU involves reducing the intake of phenylalanine , which accumulates due to the enzyme deficiency. However, since tyrosine becomes an essential amino acid in individuals with PKU , it is necessary to ensure adequate tyrosine intake , not decrease it. Therefore, the correct dietary management should be to decrease phenylalanine and ensure sufficient tyrosine in the diet .&lt;/li&gt;&lt;li&gt;\u27a4 Phenylketonuria (PKU)&lt;/li&gt;&lt;li&gt;\u27a4 deficiency of the enzyme phenylalanine hydroxylase&lt;/li&gt;&lt;li&gt;\u27a4 phenylalanine to tyrosine&lt;/li&gt;&lt;li&gt;\u27a4 reducing&lt;/li&gt;&lt;li&gt;\u27a4 intake of phenylalanine&lt;/li&gt;&lt;li&gt;\u27a4 tyrosine becomes an essential amino acid in individuals with PKU&lt;/li&gt;&lt;li&gt;\u27a4 ensure adequate tyrosine intake&lt;/li&gt;&lt;li&gt;\u27a4 decrease phenylalanine and ensure sufficient tyrosine in the diet&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 103 \u2013 Page No 3131&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 103 \u2013 Page No 3131&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following disorders with their respective urinary findings:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A1 B2 C3 D4&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A4 B3 C1 D2&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B2 C4 D1&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. A4 B3 C1 D2&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture10_CWdz8Xi.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture9_O9jx3aA.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) A4 B3 C1 D2&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 A4: Isovaleric Acidemia - Sweaty Feet Odour: isovaleric Acidemia, particularly Type II , is known for producing a distinctive \&quot;sweaty feet \&quot; odour due to the accumulation of organic acids .&lt;/li&gt;&lt;li&gt;\u2022 A4: Isovaleric Acidemia - Sweaty Feet Odour:&lt;/li&gt;&lt;li&gt;\u2022 Type II&lt;/li&gt;&lt;li&gt;\u2022 \&quot;sweaty feet&lt;/li&gt;&lt;li&gt;\u2022 organic acids&lt;/li&gt;&lt;li&gt;\u2022 B3: Maple Syrup Urine Disease - Burned Sugar Smell: This condition is named for the sweet, maple syrup-like smell of the affected infants&#x27; urine , which is a result of the accumulation of branched chain amino acids leucine, isoleucine, and valine , due to deficiency of branched chain alpha-ketoacid dehydrogenase enzyme .&lt;/li&gt;&lt;li&gt;\u2022 B3: Maple Syrup Urine Disease - Burned Sugar Smell:&lt;/li&gt;&lt;li&gt;\u2022 maple syrup-like smell&lt;/li&gt;&lt;li&gt;\u2022 infants&#x27; urine&lt;/li&gt;&lt;li&gt;\u2022 accumulation&lt;/li&gt;&lt;li&gt;\u2022 leucine, isoleucine, and valine&lt;/li&gt;&lt;li&gt;\u2022 deficiency of&lt;/li&gt;&lt;li&gt;\u2022 alpha-ketoacid dehydrogenase enzyme&lt;/li&gt;&lt;li&gt;\u2022 C1: Multiple Carboxylase Deficiency - Tom Cat Urine: This disorder, often presenting with a range of neurological and dermatological symptoms , can produce a urine odor reminiscent of a tom cat , due to the accumulation of various organic acids .&lt;/li&gt;&lt;li&gt;\u2022 C1: Multiple Carboxylase Deficiency - Tom Cat Urine:&lt;/li&gt;&lt;li&gt;\u2022 neurological and dermatological symptoms&lt;/li&gt;&lt;li&gt;\u2022 reminiscent of a tom cat&lt;/li&gt;&lt;li&gt;\u2022 various organic acids&lt;/li&gt;&lt;li&gt;\u2022 D2: Phenylketonuria - Mousy or Musty Odour: Phenylketonuria (PKU) leads to a build up of phenylalanine, causing a characteristic \&quot;mousy\&quot; or \&quot;musty\&quot; odour in the urine and on the breath .&lt;/li&gt;&lt;li&gt;\u2022 D2: Phenylketonuria - Mousy or Musty Odour: Phenylketonuria (PKU)&lt;/li&gt;&lt;li&gt;\u2022 phenylalanine,&lt;/li&gt;&lt;li&gt;\u2022 \&quot;mousy\&quot; or \&quot;musty\&quot; odour in the urine and on the breath&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition page 3107&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition page 3107&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A concerned mother presents to a pediatric clinic in a suburban area of India with her 4-month-old infant, reporting significant feeding difficulties, recurrent vomiting, diarrhea, and a noticeable lack of weight gain since birth. The infant, who was previously healthy, now appears lethargic and uninterested in feeding. Upon examination, the pediatrician notes jaundice, hepatomegaly, and splenomegaly. A distinctive boiled cabbage odor is also observed, which raises suspicion for a metabolic disorder. Based on the clinical presentation and the specific odor noted, what is the most likely diagnosis, and what is the treatment of choice?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Hereditary tyrosinemia and Nitisinone&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Richner hanhart syndrome and nitisinone&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Both a and b are correct&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Hereditary tyrosinemia and Nitisinone&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Hereditary tyrosinemia and Nitisinone&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B: Richner-Hanhart syndrome (tyrosinemia type II) is caused by a deficiency of tyrosine aminotransferase and is characterized by painful palmoplantar keratoderma, corneal ulcers, and sometimes intellectual disability, but not typically by the systemic symptoms seen in hereditary tyrosinemia type I.&lt;/li&gt;&lt;li&gt;\u2022 Option B:&lt;/li&gt;&lt;li&gt;\u2022 Richner-Hanhart syndrome (tyrosinemia type II)&lt;/li&gt;&lt;li&gt;\u2022 deficiency&lt;/li&gt;&lt;li&gt;\u2022 tyrosine aminotransferase&lt;/li&gt;&lt;li&gt;\u2022 painful palmoplantar keratoderma, corneal ulcers,&lt;/li&gt;&lt;li&gt;\u2022 Option C: Incorrect because Richner-Hanhart syndrome does not present with the systemic symptoms described, and its treatment may involve dietary restrictions of phenylalanine and tyrosine rather than Nitisinone.&lt;/li&gt;&lt;li&gt;\u2022 Option C:&lt;/li&gt;&lt;li&gt;\u2022 Incorrect&lt;/li&gt;&lt;li&gt;\u2022 Richner-Hanhart syndrome&lt;/li&gt;&lt;li&gt;\u2022 systemic symptoms&lt;/li&gt;&lt;li&gt;\u2022 restrictions of phenylalanine and tyrosine&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hereditary tyrosinemia type I is a rare metabolic disorder characterized by the deficient activity of the enzyme fumarylacetoacetate hydrolase (characteristic boiled cabbage odor). Nitisinone is the treatment of choice.&lt;/li&gt;&lt;li&gt;\u27a4 Hereditary tyrosinemia type I&lt;/li&gt;&lt;li&gt;\u27a4 deficient activity&lt;/li&gt;&lt;li&gt;\u27a4 fumarylacetoacetate hydrolase&lt;/li&gt;&lt;li&gt;\u27a4 Nitisinone&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 103 \u2013 Page No 3143 -3153&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 103 \u2013 Page No 3143 -3153&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 11-month-old child is brought to the paediatric clinic by his mother due to concerns about the child&#x27;s poor feeding, frequent vomiting, and noticeable lack of growth and developmental progress. Physical examination reveals hepatosplenomegaly and generalized muscle weakness. Laboratory investigations identify elevated levels of hawkinsin and other unusual metabolites in both blood and urine samples. Which of the following is the most likely underlying cause of these findings?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Defect in fumarylacetoacetate hydrolase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Defect in tyrosine transaminase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Mutation in 4-HPPD&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Mutation in 3-HPPD&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Mutation in 4-HPPD&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C Mutation in 4-HPPD&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 4-month-old infant is brought to the paediatric clinic by a concerned mother who reports that her child is not gaining weight adequately, has thin extremities, and appears shorter than expected for his age. Physical examination reveals a protruding abdomen. The child&#x27;s medical history includes recurrent infections. Laboratory tests show hypoglycemia, lactic acidosis, hyperuricemia, and neutropenia. Based on the clinical presentation and laboratory findings, what is the most likely diagnosis, and which enzyme is defective or deficient in this condition?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Type 1a GSD and glucose 6 phosphatases&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Type1b GSD and glucose 6 phosphate translocase&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Type IIIa GSD and liver and muscle debranching enzyme&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Type IV GSD and branching enzyme&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Type1b GSD and glucose 6 phosphate translocase&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture15_djiFI6a.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Type1b GSD and glucose 6 phosphate translocase&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Type 1a GSD and glucose-6-phosphatase: While Type 1a GSD shares many clinical and laboratory features with Type 1b, including hypoglycemia, lactic acidosis , and a protruding abdomen due to hepatomegaly , it does not typically present with neutropenia and recurrent infections.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Type 1a GSD and glucose-6-phosphatase:&lt;/li&gt;&lt;li&gt;\u2022 Type 1a GSD&lt;/li&gt;&lt;li&gt;\u2022 Type 1b,&lt;/li&gt;&lt;li&gt;\u2022 hypoglycemia, lactic acidosis&lt;/li&gt;&lt;li&gt;\u2022 protruding abdomen&lt;/li&gt;&lt;li&gt;\u2022 hepatomegaly&lt;/li&gt;&lt;li&gt;\u2022 it does not typically present with neutropenia and recurrent infections.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Type IIIa GSD and liver and muscle glycogen debranching enzyme: Type IIIa GSD (Cori or Forbes disease) involves a deficiency in the debranching enzyme , affecting both liver and muscle , but the clinical picture is more commonly associated with myopathy and cardiomyopathy rather than neutropenia.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Type IIIa GSD and liver and muscle glycogen debranching enzyme:&lt;/li&gt;&lt;li&gt;\u2022 Type IIIa GSD&lt;/li&gt;&lt;li&gt;\u2022 deficiency in the debranching enzyme&lt;/li&gt;&lt;li&gt;\u2022 liver and muscle&lt;/li&gt;&lt;li&gt;\u2022 Option D: Type IV GSD and glycogen branching enzyme: Type IV GSD (Andersen&#x27;s disease) is caused by a deficiency in the glycogen branching enzyme , leading to the accumulation of abnormal glycogen structure , but it is more commonly associated with progressive liver disease and does not typically present with neutropenia.&lt;/li&gt;&lt;li&gt;\u2022 Option D: Type IV GSD and glycogen branching enzyme:&lt;/li&gt;&lt;li&gt;\u2022 Type IV GSD&lt;/li&gt;&lt;li&gt;\u2022 deficiency in the glycogen branching enzyme&lt;/li&gt;&lt;li&gt;\u2022 accumulation of abnormal glycogen structure&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Type 1b Glycogen Storage Disease (GSD) is characterized by a deficiency in glucose-6-phosphate translocase , leading to impaired glucose production from glycogenolysis and gluconeogenesis . This results in the clinical presentation of hypoglycemia, lactic acidosis, and hyperuricemia. The neutropenia and recurrent infections are distinctive for Type 1b GSD, differentiating it from Type 1a, which is primarily associated with glucose-6-phosphatase deficiency but does not typically present with neutropenia and recurrent infections.&lt;/li&gt;&lt;li&gt;\u27a4 Type 1b Glycogen Storage Disease&lt;/li&gt;&lt;li&gt;\u27a4 deficiency in glucose-6-phosphate translocase&lt;/li&gt;&lt;li&gt;\u27a4 impaired glucose production&lt;/li&gt;&lt;li&gt;\u27a4 glycogenolysis and gluconeogenesis&lt;/li&gt;&lt;li&gt;\u27a4 The neutropenia and recurrent infections are distinctive for Type 1b GSD,&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No 3441-3446&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 105 \u2013 Page No 3441-3446&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A paediatric resident is reviewing metabolic disorders for an upcoming exam and is focusing on enzyme deficiencies associated with various paediatric diseases. Match the following paediatric diseases with their corresponding enzyme deficiencies:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;1-iii,2-iv,3-i,4-ii&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;1-iv,2-iii,3-I,4-ii&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;1-i,2-iv,3-ii,4-iii&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;1-ii,2-iv,3-I,4-iii&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. 1-iii,2-iv,3-i,4-ii&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture13.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/05/24/screenshot-2024-05-24-183613.JPG&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) 1-iii, 2-iv, 3-I ,4-ii&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Alkaptonuria is caused by a deficiency in homogentisic acid oxidase (iii), leading to the accumulation of homogentisic acid , which causes darkening of urine and potentially arthritic complications. Phenylketonuria results from a deficiency in phenylalanine hydroxylase (iv), which leads to elevated levels of phenylalanine in the blood and can cause intellectual disability if untreated. Tyrosinemia (Type I) is due to a deficiency in fumarylacetoacetate hydrolase (i), resulting in liver and kidney dysfunction , along with a cabbage-like odor . Richner-Hanhart syndrome (Tyrosinemia Type II) is associated with a deficiency in tyrosine transaminase (ii), leading to painful palmoplantar keratoderma and corneal ulcers .&lt;/li&gt;&lt;li&gt;\u2022 Alkaptonuria is caused by a deficiency in homogentisic acid oxidase (iii), leading to the accumulation of homogentisic acid , which causes darkening of urine and potentially arthritic complications.&lt;/li&gt;&lt;li&gt;\u2022 Alkaptonuria is caused by a deficiency in homogentisic acid oxidase&lt;/li&gt;&lt;li&gt;\u2022 accumulation of homogentisic acid&lt;/li&gt;&lt;li&gt;\u2022 darkening of urine&lt;/li&gt;&lt;li&gt;\u2022 potentially arthritic complications.&lt;/li&gt;&lt;li&gt;\u2022 Phenylketonuria results from a deficiency in phenylalanine hydroxylase (iv), which leads to elevated levels of phenylalanine in the blood and can cause intellectual disability if untreated.&lt;/li&gt;&lt;li&gt;\u2022 Phenylketonuria&lt;/li&gt;&lt;li&gt;\u2022 deficiency in phenylalanine hydroxylase&lt;/li&gt;&lt;li&gt;\u2022 elevated levels of phenylalanine in the blood&lt;/li&gt;&lt;li&gt;\u2022 cause intellectual disability if untreated.&lt;/li&gt;&lt;li&gt;\u2022 Tyrosinemia (Type I) is due to a deficiency in fumarylacetoacetate hydrolase (i), resulting in liver and kidney dysfunction , along with a cabbage-like odor .&lt;/li&gt;&lt;li&gt;\u2022 Tyrosinemia&lt;/li&gt;&lt;li&gt;\u2022 deficiency in fumarylacetoacetate hydrolase&lt;/li&gt;&lt;li&gt;\u2022 liver and kidney dysfunction&lt;/li&gt;&lt;li&gt;\u2022 cabbage-like odor&lt;/li&gt;&lt;li&gt;\u2022 Richner-Hanhart syndrome (Tyrosinemia Type II) is associated with a deficiency in tyrosine transaminase (ii), leading to painful palmoplantar keratoderma and corneal ulcers .&lt;/li&gt;&lt;li&gt;\u2022 Richner-Hanhart syndrome&lt;/li&gt;&lt;li&gt;\u2022 deficiency in tyrosine transaminase&lt;/li&gt;&lt;li&gt;\u2022 painful palmoplantar keratoderma&lt;/li&gt;&lt;li&gt;\u2022 corneal ulcers&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 103.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 103.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-month-old boy is brought to the pediatric emergency department due to multiple episodes of loose stools. The child appears dehydrated, with a dry mouth, but drinks water eagerly when offered. Following the administration of oral rehydration solution (ORS) according to protocol, further examination reveals photosensitivity and an ataxic gait. The mother reports a family history of two siblings with similar symptoms, though she and her husband are unaffected. Based on the clinical findings and family history, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Alkaptonuria&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hartnup Disease&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Phenylketonuria&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Maple Syrup Urine Disease&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Hartnup Disease&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture2_fXbtLrQ.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Hartnup Disease&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Alkaptonuria results from the deficiency of Homogentisate oxidase and has a clinical feature of changing of urine colour and Ochronosis.&lt;/li&gt;&lt;li&gt;\u2022 Option A:&lt;/li&gt;&lt;li&gt;\u2022 Alkaptonuria&lt;/li&gt;&lt;li&gt;\u2022 deficiency of Homogentisate oxidase&lt;/li&gt;&lt;li&gt;\u2022 Option C: Phenylketonuria results from the deficiency of phenylalanine hydroxylase and has clinical features of blond hair and skin changes.&lt;/li&gt;&lt;li&gt;\u2022 Option C:&lt;/li&gt;&lt;li&gt;\u2022 Option D: Maple Syrup Urine Disease has a clinical feature of burnt sugar smell of urine.&lt;/li&gt;&lt;li&gt;\u2022 Option D:&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hartnup disease, an autosomal recessive disorder characterized by diarrhea, dehydration, photosensitivity, and neurological symptoms such as ataxia. The family history of similarly affected siblings with unaffected parents supports the autosomal recessive inheritance pattern.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st edition, Chapter 103 \u2013 Page No 3178&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st edition, Chapter 103 \u2013 Page No 3178&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 12-year-old boy presents with fever, chills, abdominal pain, and diarrhea in a malaria-prevalent area. Following a positive rapid antigen test for malaria, he is started on Primaquine therapy. Four days into treatment, he develops hematuria, with his hemoglobin level dropping from 11.3 g/dL to 7.12 g/dL, total bilirubin rising from 1.38 mg/dL to 4.52 mg/dL, and lactate dehydrogenase (LDH) increasing from 236 IU/L to 509 IU/L. What is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Pyruvate dehydrogenase complex (PDC)&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Pyruvate kinase deficiency&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Glucose-6-phosphate dehydrogenase deficiency&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Glucose-6-Phosphatase deficiency&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Glucose-6-phosphate dehydrogenase deficiency&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Glucose-6-phosphate dehydrogenase deficiency&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Pyruvate dehydrogenase complex (PDC) deficiency: This metabolic disorder primarily affects the neurological system and is not associated with drug-induced hemolysis.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Pyruvate dehydrogenase complex (PDC) deficiency:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Pyruvate kinase deficiency: While this enzyme deficiency can cause hemolytic anemia, it is less likely to be triggered by Primaquine therapy compared to G6PD deficiency.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Pyruvate kinase deficiency:&lt;/li&gt;&lt;li&gt;\u2022 Option D. Glucose-6-Phosphatase deficiency: This condition is related to glycogen storage disease type I and presents with metabolic issues rather than acute hemolytic anemia triggered by medication.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Glucose-6-Phosphatase deficiency:&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Primaquine and other oxidative drugs can precipitate hemolysis in individuals with G6PD deficiency, as seen in this case with the sudden drop in hemoglobin, increase in total bilirubin, and rise in LDH levels, which are markers of hemolysis.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 490 \u2013 Page No 10068-10069&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 490 \u2013 Page No 10068-10069&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-month-old child presents with recurrent infections, fatigue, and bleeding episodes. The attending physician notes anemia, leukopenia, and thrombocytopenia on a complete blood count. Upon examination, the child exhibits features suggestive of Mucopolysaccharidoses. Considering the clinical presentation and laboratory findings, the physician considers diseases for which enzyme replacement therapy (ERT) is not enough to treat the condition as a single aid. Which of the following diseases cannot be treated with enzyme replacement therapy alone?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Gauchers disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hurler\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hunters\u2019 disease&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Fabry\u2019s disease&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Hunters\u2019 disease&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture4.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Hunter\u2019s disease&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Gaucher&#x27;s disease: Gaucher&#x27;s disease is treatable with enzyme replacement therapy using imiglucerase, velaglucerase alfa, or taliglucerase alfa , which are recombinant forms of the deficient enzyme glucocerebrosidase.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Gaucher&#x27;s disease:&lt;/li&gt;&lt;li&gt;\u2022 treatable&lt;/li&gt;&lt;li&gt;\u2022 enzyme replacement therapy&lt;/li&gt;&lt;li&gt;\u2022 imiglucerase, velaglucerase alfa, or taliglucerase alfa&lt;/li&gt;&lt;li&gt;\u2022 Option B. Hurler\u2019s disease: Although Hurler&#x27;s disease also requires more than ERT due to its severe and systemic nature, if addressing specifically enzyme replacement efficacy, it can still be part of the treatment protocol alongside other interventions like hematopoietic stem cell transplantation.&lt;/li&gt;&lt;li&gt;\u2022 Option B.&lt;/li&gt;&lt;li&gt;\u2022 Hurler\u2019s disease:&lt;/li&gt;&lt;li&gt;\u2022 Option D. Fabry\u2019s disease: Fabry\u2019s disease can be treated with enzyme replacement therapy using agalsidase beta or agalsidase alfa .&lt;/li&gt;&lt;li&gt;\u2022 Option D. Fabry\u2019s disease:&lt;/li&gt;&lt;li&gt;\u2022 Fabry\u2019s disease&lt;/li&gt;&lt;li&gt;\u2022 treated&lt;/li&gt;&lt;li&gt;\u2022 agalsidase beta or agalsidase alfa&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hunter&#x27;s disease, a form of Mucopolysaccharidosis, requires treatment approaches beyond enzyme replacement therapy due to its neurological involvement, which ERT alone cannot address.&lt;/li&gt;&lt;li&gt;\u27a4 Enzyme replacement therapy is available for Gauchers disease, Hurler\u2019s disease, Fabry\u2019s disease and Pompes disease .&lt;/li&gt;&lt;li&gt;\u27a4 Enzyme replacement therapy&lt;/li&gt;&lt;li&gt;\u27a4 Gauchers disease, Hurler\u2019s disease, Fabry\u2019s disease and Pompes disease&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 107 \u2013 Page No 3551&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 107 \u2013 Page No 3551&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 8-month-old child is brought to the pediatric clinic with a history of recurrent infections and easy bruisability. Examination reveals excessive pallor, cloudy cornea, and coarse facial features. A complete blood count (CBC) indicates the presence of anemia, leukopenia, and thrombocytopenia. Based on the clinical history and examination findings, what is the most likely diagnosis and the associated enzyme deficiency?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Gaucher\u2019s disease and Glucocerabrosidase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hurler\u2019s disease and Glucocerabrosidase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Gaucher\u2019s disease and Galactocerabrosidase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Hurler\u2019s disease and Alpha-L-iduronidase&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Hurler\u2019s disease and Alpha-L-iduronidase&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture8_Yqjllww.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. \u00a0D) Hurler\u2019s disease and Alpha-L-iduronidase&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Gaucher\u2019s disease and Glucocerebrosidase: Gaucher\u2019s disease is caused by a deficiency in the enzyme glucocerebrosidase , leading to the accumulation of glucocerebrosides . While it can cause anemia, thrombocytopenia, and bone abnormalities , it does not typically present with cloudy corneas or the coarse facial features seen in Hurler\u2019s disease.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Gaucher\u2019s disease and Glucocerebrosidase:&lt;/li&gt;&lt;li&gt;\u2022 Gaucher\u2019s disease&lt;/li&gt;&lt;li&gt;\u2022 deficiency in the enzyme glucocerebrosidase&lt;/li&gt;&lt;li&gt;\u2022 glucocerebrosides&lt;/li&gt;&lt;li&gt;\u2022 anemia, thrombocytopenia, and bone abnormalities&lt;/li&gt;&lt;li&gt;\u2022 Option B. Hurler\u2019s disease and Glucocerebrosidase: This is incorrect; Hurler\u2019s disease is associated with a deficiency of alpha-L-iduronidase .&lt;/li&gt;&lt;li&gt;\u2022 Option B. Hurler\u2019s disease and Glucocerebrosidase:&lt;/li&gt;&lt;li&gt;\u2022 Hurler\u2019s disease&lt;/li&gt;&lt;li&gt;\u2022 deficiency of alpha-L-iduronidase&lt;/li&gt;&lt;li&gt;\u2022 Option C. Gaucher\u2019s disease and Galactocerebrosidase: This is incorrect; Gaucher\u2019s disease is associated with a deficiency of glucocerebrosidase , not galactocerebrosidase.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Gaucher\u2019s disease and Galactocerebrosidase:&lt;/li&gt;&lt;li&gt;\u2022 Gaucher\u2019s disease&lt;/li&gt;&lt;li&gt;\u2022 deficiency of glucocerebrosidase&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hurler\u2019s disease is characterized by features such as coarse facial features, cloudy corneas, recurrent infections, and hematological abnormalities , with the underlying enzyme deficiency being alpha-L-iduronidase.&lt;/li&gt;&lt;li&gt;\u27a4 Hurler\u2019s disease&lt;/li&gt;&lt;li&gt;\u27a4 coarse facial features, cloudy corneas, recurrent infections, and hematological abnormalities&lt;/li&gt;&lt;li&gt;\u27a4 enzyme deficiency&lt;/li&gt;&lt;li&gt;\u27a4 alpha-L-iduronidase.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 104 \u2013 Page No 3413-3416&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 104 \u2013 Page No 3413-3416&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 12-year-old boy is brought to a pediatric outpatient department in an urban hospital in India with his parents, who are concerned about his recent onset of hand tremors and occasional jerking movements. The boy, previously healthy and an active cricket player, has noticed these symptoms worsening over the past month, affecting his ability to play. An ophthalmological examination reveals Kayser-Fleischer (KF) rings, and an MRI indicates bilateral hypodense lesions in the basal ganglia. Laboratory tests show elevated liver enzymes (AST and ALT), and a liver biopsy reveals increased copper levels. Based on these findings, a diagnosis of Wilson&#x27;s disease is made. Which of the following statements about Wilson&#x27;s disease is NOT true?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;ATP 7B gene mutation is responsible for Wilsons disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Wing beating tremors can be seen in this disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;D-penicillamine is used in the 1 st line of management&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Increased serum ceruloplasmin levels is seen&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Increased serum ceruloplasmin levels is seen&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Increased serum ceruloplasmin levels is seen&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother from a rural community in India brings her 3-year-old son to a local health clinic. She reports that her child has experienced episodes of yellowing skin and eyes since infancy, particularly during episodes of common childhood illnesses like colds and flu. She is worried as these episodes seem to recur with each illness. The child appears well between episodes. On examination, the physician notes a slight enlargement of the liver and spleen. Laboratory tests reveal elevated levels of indirect bilirubin with normal liver enzyme levels, and there is no evidence of hemolysis. Considering the intermittent nature of the jaundice, especially during infections, and the specific lab findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Criggler Najar Syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Dubin Johnson syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Rotor syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Gilbert syndrome&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Gilbert syndrome&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Gilbert syndrome&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Crigler-Najjar Syndrome (A): Is a much rarer condition characterized by severe , persistent jaundice due to a complete or severe deficiency in the enzyme that conjugates bilirubin , leading to significantly elevated levels of unconjugated bilirubin .&lt;/li&gt;&lt;li&gt;\u2022 Option A: Crigler-Najjar Syndrome (A):&lt;/li&gt;&lt;li&gt;\u2022 severe&lt;/li&gt;&lt;li&gt;\u2022 persistent jaundice&lt;/li&gt;&lt;li&gt;\u2022 deficiency&lt;/li&gt;&lt;li&gt;\u2022 conjugates bilirubin&lt;/li&gt;&lt;li&gt;\u2022 elevated levels of unconjugated bilirubin&lt;/li&gt;&lt;li&gt;\u2022 Option B: Dubin-Johnson Syndrome (B) and Rotor Syndrome (C): Both involve conjugated hyperbilirubinemia with normal liver enzyme levels but typically present with dark liver (Dubin-Johnson) or normal liver appearance (Rotor) on imaging, not applicable in this case.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Dubin-Johnson Syndrome (B) and Rotor Syndrome (C):&lt;/li&gt;&lt;li&gt;\u2022 Both&lt;/li&gt;&lt;li&gt;\u2022 conjugated hyperbilirubinemia&lt;/li&gt;&lt;li&gt;\u2022 normal liver enzyme&lt;/li&gt;&lt;li&gt;\u2022 dark liver (Dubin-Johnson)&lt;/li&gt;&lt;li&gt;\u2022 normal liver appearance (Rotor)&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Gilbert Syndrome is a common, mild liver disorder in which the liver doesn&#x27;t properly process bilirubin . It is characterized by intermittent episodes of jaundice , particularly during periods of illness, fasting, or stress, due to mildly elevated levels of unconjugated (indirect) bilirubin in the absence of liver damage or hemolysis. The key feature of Gilbert Syndrome is the preservation of normal liver enzyme levels and the absence of other signs of liver disease , distinguishing it from other conditions listed.&lt;/li&gt;&lt;li&gt;\u27a4 Gilbert Syndrome&lt;/li&gt;&lt;li&gt;\u27a4 liver doesn&#x27;t properly process bilirubin&lt;/li&gt;&lt;li&gt;\u27a4 intermittent episodes of jaundice&lt;/li&gt;&lt;li&gt;\u27a4 illness, fasting, or stress,&lt;/li&gt;&lt;li&gt;\u27a4 mildly elevated levels of unconjugated (indirect) bilirubin&lt;/li&gt;&lt;li&gt;\u27a4 preservation of normal liver enzyme levels&lt;/li&gt;&lt;li&gt;\u27a4 absence&lt;/li&gt;&lt;li&gt;\u27a4 signs of liver disease&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition Page No- 1937-1939.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition Page No- 1937-1939.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-year-old child is brought to the paediatric clinic by their mother, who is concerned about the child&#x27;s delayed growth and developmental milestones. During the examination, the paediatrician notes the child&#x27;s breathing difficulties and decreased visual acuity. Fundoscopic examination reveals a cherry-red spot on the macula, and further physical examination shows hepatosplenomegaly. A peripheral blood smear reveals the presence of Zebra bodies. Based on these findings, what is the most likely diagnosis, and which enzyme deficiency is responsible?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Niemann pick disease and sphingomyelinase&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Gaucher disease and glucocerebrosidase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Farbers disease and ceramidase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Wolman disease and acid lipase&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Niemann pick disease and sphingomyelinase&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Niemann pick disease and sphingomyelinase&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Gaucher disease and glucocerebrosidase: Gaucher disease results from a deficiency in glucocerebrosidase, leading to the accumulation of glucocerebroside . While it can present with hepatosplenomegaly and growth delay , the cherry-red spot is not a typical feature, and Gaucher cells, not Zebra bodies, are seen on peripheral smear.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Gaucher disease and glucocerebrosidase:&lt;/li&gt;&lt;li&gt;\u2022 deficiency in glucocerebrosidase,&lt;/li&gt;&lt;li&gt;\u2022 accumulation of glucocerebroside&lt;/li&gt;&lt;li&gt;\u2022 hepatosplenomegaly and growth delay&lt;/li&gt;&lt;li&gt;\u2022 Option C. Farber&#x27;s disease and ceramidase: Farber&#x27;s disease involves a deficiency in ceramidase , leading to the accumulation of ceramides . It typically presents with joint deformities , subcutaneous nodules , and progressive hoarseness , which are not described in this scenario.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Farber&#x27;s disease and ceramidase:&lt;/li&gt;&lt;li&gt;\u2022 deficiency in ceramidase&lt;/li&gt;&lt;li&gt;\u2022 accumulation of ceramides&lt;/li&gt;&lt;li&gt;\u2022 presents with joint deformities&lt;/li&gt;&lt;li&gt;\u2022 subcutaneous nodules&lt;/li&gt;&lt;li&gt;\u2022 progressive hoarseness&lt;/li&gt;&lt;li&gt;\u2022 Option D. Wolman disease and acid lipase: Wolman disease is caused by a deficiency in acid lipase , leading to the accumulation of cholesteryl esters and triglycerides. It presents early in life with severe malabsorption, failure to thrive, and hepatosplenomegaly, but not typically with a cherry-red spot or Zebra bodies.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Wolman disease and acid lipase:&lt;/li&gt;&lt;li&gt;\u2022 deficiency in acid lipase&lt;/li&gt;&lt;li&gt;\u2022 accumulation of cholesteryl esters and triglycerides.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Niemann-Pick disease , particularly type A and B , is characterized by a deficiency in the enzyme sphingomyelinase , leading to the accumulation of sphingomyelin in various tissues , including the liver, spleen, lungs, and brain . The clinical presentation of delayed growth , developmental delay , hepatosplenomegaly , and the cherry-red spot on the macula , along with the finding of Zebra bodies on peripheral smear , are classic for Niemann-Pick disease .&lt;/li&gt;&lt;li&gt;\u27a4 Niemann-Pick disease&lt;/li&gt;&lt;li&gt;\u27a4 type A and B&lt;/li&gt;&lt;li&gt;\u27a4 deficiency in the enzyme sphingomyelinase&lt;/li&gt;&lt;li&gt;\u27a4 accumulation of sphingomyelin&lt;/li&gt;&lt;li&gt;\u27a4 tissues&lt;/li&gt;&lt;li&gt;\u27a4 liver, spleen, lungs, and brain&lt;/li&gt;&lt;li&gt;\u27a4 delayed growth&lt;/li&gt;&lt;li&gt;\u27a4 developmental delay&lt;/li&gt;&lt;li&gt;\u27a4 hepatosplenomegaly&lt;/li&gt;&lt;li&gt;\u27a4 cherry-red spot on the macula&lt;/li&gt;&lt;li&gt;\u27a4 Zebra bodies on peripheral smear&lt;/li&gt;&lt;li&gt;\u27a4 Niemann-Pick disease&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 104 \u2013 Page No 3413-3416.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 104 \u2013 Page No 3413-3416.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-month-old infant is brought to the pediatric clinic by their mother, who is concerned about the child&#x27;s apparent weakness and poor muscle tone. The mother also reports difficulty with feeding and the child&#x27;s failure to gain weight appropriately. Physical examination reveals respiratory distress, hepatosplenomegaly, and an enlarged cardiac silhouette on chest X-ray. Given these findings and a suspicion of Glycogen Storage Disease (GSD), what is the most common cause of death in patients with this presentation?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Recurrent infection&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Liver failure&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Cardiorespiratory failure&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Respiratory failure&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Cardiorespiratory failure&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture16_J8oCkk0.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/02/picture16_J8oCkk0.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Cardiorespiratory failure&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Recurrent infection: While infections can be a concern, especially in immunocompromised patients , they are not the primary cause of death in patients with the type of GSD described in the scenario.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Recurrent infection:&lt;/li&gt;&lt;li&gt;\u2022 infections&lt;/li&gt;&lt;li&gt;\u2022 immunocompromised patients&lt;/li&gt;&lt;li&gt;\u2022 not&lt;/li&gt;&lt;li&gt;\u2022 primary cause of death in patients&lt;/li&gt;&lt;li&gt;\u2022 Option B. Liver failure: Liver involvement is common in several types of GSD, but liver failure is not the primary cause of death in Pompe disease , where cardiac and respiratory involvement is more significant .&lt;/li&gt;&lt;li&gt;\u2022 Option B. Liver failure:&lt;/li&gt;&lt;li&gt;\u2022 liver failure&lt;/li&gt;&lt;li&gt;\u2022 not&lt;/li&gt;&lt;li&gt;\u2022 primary cause of death in Pompe disease&lt;/li&gt;&lt;li&gt;\u2022 cardiac and respiratory involvement&lt;/li&gt;&lt;li&gt;\u2022 significant&lt;/li&gt;&lt;li&gt;\u2022 Option D. Respiratory failure: Although respiratory failure is a critical component , it usually occurs in conjunction with cardiac failure in Pompe disease , making cardiorespiratory failure (C) a more comprehensive answer.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Respiratory failure:&lt;/li&gt;&lt;li&gt;\u2022 respiratory failure&lt;/li&gt;&lt;li&gt;\u2022 critical component&lt;/li&gt;&lt;li&gt;\u2022 occurs in conjunction with cardiac failure in Pompe disease&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Pompe disease (Glycogen Storage Disease Type II), characterized by lysosomal alpha-1, 4-glucosidase (acid maltase) deficiency . This leads to glycogen accumulation in lysosomes , particularly affecting cardiac and skeletal muscles . The early infantile form presents with hypotonia, cardiomegaly, hepatomegaly , and respiratory distress . The most common cause of death in these patients is cardiorespiratory failure due to progressive hypertrophic cardiomyopathy and respiratory muscle weakness.&lt;/li&gt;&lt;li&gt;\u27a4 Pompe disease&lt;/li&gt;&lt;li&gt;\u27a4 lysosomal alpha-1, 4-glucosidase&lt;/li&gt;&lt;li&gt;\u27a4 deficiency&lt;/li&gt;&lt;li&gt;\u27a4 glycogen accumulation in lysosomes&lt;/li&gt;&lt;li&gt;\u27a4 cardiac and skeletal muscles&lt;/li&gt;&lt;li&gt;\u27a4 early infantile form&lt;/li&gt;&lt;li&gt;\u27a4 hypotonia, cardiomegaly, hepatomegaly&lt;/li&gt;&lt;li&gt;\u27a4 respiratory distress&lt;/li&gt;&lt;li&gt;\u27a4 death in these patients&lt;/li&gt;&lt;li&gt;\u27a4 cardiorespiratory failure&lt;/li&gt;&lt;li&gt;\u27a4 progressive hypertrophic cardiomyopathy&lt;/li&gt;&lt;li&gt;\u27a4 respiratory muscle weakness.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No 3441-3446&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 105 \u2013 Page No 3441-3446&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-year-old child is brought in by their mother due to a recurrent rash upon sun exposure and the passage of purple-colored urine. Following an examination, the child is diagnosed with Congenital Erythropoietic Porphyria, a disorder of heme biosynthesis. Which of the following is NOT a feature of Congenital Erythropoietic Porphyria?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Osteodystrophy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Erythrodontia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Clear Cornea&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Mutilation and Disfigurement&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Clear Cornea&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Clear Cornea&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Osteodystrophy: Bone abnormalities can occur in CEP due to porphyrin accumulation.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Osteodystrophy:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Erythrodontia: This refers to reddish-brown discoloration of the teeth, a hallmark sign of CEP, caused by the deposition of porphyrins in dental tissues.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Erythrodontia:&lt;/li&gt;&lt;li&gt;\u2022 Option D. Mutilation and Disfigurement: Severe skin damage from photosensitivity reactions can lead to significant mutilation and disfigurement in CEP.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Mutilation and Disfigurement:&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Congenital erythropoietic porphyria :&lt;/li&gt;&lt;li&gt;\u27a4 Congenital erythropoietic porphyria&lt;/li&gt;&lt;li&gt;\u27a4 Enzyme defect: Uroporphyrinogen III cosynthase.&lt;/li&gt;&lt;li&gt;\u27a4 Characteristic features - It is a rare congenital disorder. Mostly contained in erythropoietic tissues (bone). Clinical features include;&lt;/li&gt;&lt;li&gt;\u27a4 Characteristic features&lt;/li&gt;&lt;li&gt;\u27a4 Severe cutaneous photosensitivity with blistering and increased friability of the skin over light-exposed areas. The first manifestation is often pink-to-dark red discoloration of the urine. Porphyrin deposition may lead to corneal ulcers and scarring, reddish-brown discoloration of the teeth (erythrodontia), and Bone loss and/or expansion of the bone marrow. Mutilation and Disfigurement.&lt;/li&gt;&lt;li&gt;\u27a4 Severe cutaneous photosensitivity with blistering and increased friability of the skin over light-exposed areas.&lt;/li&gt;&lt;li&gt;\u27a4 The first manifestation is often pink-to-dark red discoloration of the urine.&lt;/li&gt;&lt;li&gt;\u27a4 pink-to-dark red discoloration of the urine.&lt;/li&gt;&lt;li&gt;\u27a4 Porphyrin deposition may lead to corneal ulcers and scarring,&lt;/li&gt;&lt;li&gt;\u27a4 reddish-brown discoloration of the teeth (erythrodontia), and&lt;/li&gt;&lt;li&gt;\u27a4 Bone loss and/or expansion of the bone marrow.&lt;/li&gt;&lt;li&gt;\u27a4 Mutilation and Disfigurement.&lt;/li&gt;&lt;li&gt;\u27a4 The diagnosis of CEP in a proband with suggestive clinical and biochemical findings is most commonly established by identification of biallelic pathogenic variants in UROS.&lt;/li&gt;&lt;li&gt;\u27a4 diagnosis&lt;/li&gt;&lt;li&gt;\u27a4 clinical and biochemical findings&lt;/li&gt;&lt;li&gt;\u27a4 UROS.&lt;/li&gt;&lt;li&gt;\u27a4 Treatment of manifestations: There is no specific treatment for the photosensitivity. Currently, the only effective management is prevention of blistering by avoidance of sun and light exposure.&lt;/li&gt;&lt;li&gt;\u27a4 of sun and light exposure.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 110 \u2013 Page No 3656-3662&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 110 \u2013 Page No 3656-3662&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 8-months-old boy was brought to the emergency department after several episodes of vomiting and lethargy. After a careful evaluation and history, the mother admits that these episodes occur after ingestion of certain types of sweet food which are high in fructose. His blood sugar was extremely low (42 mg/dL). The test for reducing sugar in urine was positive. What is the most likely diagnosis and the enzyme deficient based on the clinical scenario?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Galactosemia and GALT&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hereditary fructose intolerance and aldolase B&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Galactosemia and aldolase B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Hereditary fructose intolerance and Fructokinase&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Hereditary fructose intolerance and aldolase B&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Hereditary fructose intolerance and aldolase B&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Galactosemia and GALT: Galactosemia is caused by a deficiency of the enzyme Galactose-1-phosphate uridyltransferase (GALT). It leads to an accumulation of galactose in the blood , manifesting symptoms when a child is exposed to lactose from milk . The clinical presentation would not be triggered specifically by fructose ingestion.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Galactosemia and GALT:&lt;/li&gt;&lt;li&gt;\u2022 enzyme Galactose-1-phosphate uridyltransferase (GALT).&lt;/li&gt;&lt;li&gt;\u2022 galactose in the blood&lt;/li&gt;&lt;li&gt;\u2022 lactose from milk&lt;/li&gt;&lt;li&gt;\u2022 Option C. Galactosemia and Aldolase B: This option is incorrect as Galactosemia is associated with a deficiency of GALT , not Aldolase B. Aldolase B deficiency is related to Hereditary Fructose Intolerance .&lt;/li&gt;&lt;li&gt;\u2022 Option C. Galactosemia and Aldolase B:&lt;/li&gt;&lt;li&gt;\u2022 Galactosemia&lt;/li&gt;&lt;li&gt;\u2022 deficiency of GALT&lt;/li&gt;&lt;li&gt;\u2022 Aldolase B deficiency&lt;/li&gt;&lt;li&gt;\u2022 Hereditary Fructose Intolerance&lt;/li&gt;&lt;li&gt;\u2022 Option D. Hereditary Fructose Intolerance and Fructokinase: Fructokinase deficiency leads to essential fructosuria , a benign condition where fructose is excreted in the urine. It does not cause hypoglycemia or other serious symptoms seen in HFI.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Hereditary Fructose Intolerance and Fructokinase:&lt;/li&gt;&lt;li&gt;\u2022 Fructokinase deficiency&lt;/li&gt;&lt;li&gt;\u2022 essential fructosuria&lt;/li&gt;&lt;li&gt;\u2022 does not&lt;/li&gt;&lt;li&gt;\u2022 hypoglycemia&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hereditary fructose intolerance (HFI) is caused by a deficiency of the enzyme Aldolase B , which is involved in the metabolism of fructose . This condition leads to an accumulation of fructose-1-phosphate in the liver, kidney, and intestines, causing inhibition of glycogenolysis and gluconeogenesis , which in turn leads to hypoglycemia after fructose ingestion . The clinical symptoms of HFI, including vomiting, lethargy, and hypoglycemia after ingesting fructose. The presence of reducing sugars in the urine is indicative of an inherited disorder of carbohydrate metabolism, such as HFI .&lt;/li&gt;&lt;li&gt;\u27a4 Hereditary fructose intolerance (HFI)&lt;/li&gt;&lt;li&gt;\u27a4 enzyme Aldolase B&lt;/li&gt;&lt;li&gt;\u27a4 fructose&lt;/li&gt;&lt;li&gt;\u27a4 fructose-1-phosphate&lt;/li&gt;&lt;li&gt;\u27a4 inhibition of glycogenolysis and gluconeogenesis&lt;/li&gt;&lt;li&gt;\u27a4 hypoglycemia after fructose ingestion&lt;/li&gt;&lt;li&gt;\u27a4 reducing sugars in the urine&lt;/li&gt;&lt;li&gt;\u27a4 carbohydrate metabolism,&lt;/li&gt;&lt;li&gt;\u27a4 HFI&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 105 \u2013 Page No-3479-3481&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 105 \u2013 Page No-3479-3481&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 5-year-old child with mucopolysaccharidoses (MPS) presents for regular follow-up. Upon evaluation, severe pallor, signs of easy bruisability, coarse facies, and clear cornea are noted. Genetic reports indicate CAG trinucleotide repeats. Suspecting Hunter&#x27;s disease, what is the pattern of inheritance for this condition?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;X-Linked Dominant&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;X-Linked Recessive&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Autosomal Recessive&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Autosomal Dominant&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. X-Linked Recessive&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) X-Linked Recessive&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A, C and D are not appropriate as Hunters disease is a X-Linked Recessive disease.&lt;/li&gt;&lt;li&gt;\u2022 Option A, C and D&lt;/li&gt;&lt;li&gt;\u2022 X-Linked Recessive disease.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hunter syndrome , also known as mucopolysaccharidosis type II (MPS II), is an X-linked recessive disorder caused by a deficiency of the enzyme iduronate sulfatase (IDS). This deficiency leads to the accumulation of glycosaminoglycans (GAGs) in various tissues.&lt;/li&gt;&lt;li&gt;\u27a4 Hunter syndrome&lt;/li&gt;&lt;li&gt;\u27a4 mucopolysaccharidosis type II (MPS II),&lt;/li&gt;&lt;li&gt;\u27a4 X-linked recessive disorder&lt;/li&gt;&lt;li&gt;\u27a4 deficiency of the enzyme iduronate sulfatase (IDS).&lt;/li&gt;&lt;li&gt;\u27a4 accumulation of glycosaminoglycans (GAGs)&lt;/li&gt;&lt;li&gt;\u27a4 Hunter syndrome is X-linked recessive , it primarily affects males , while females may be carriers of the condition.&lt;/li&gt;&lt;li&gt;\u27a4 X-linked recessive&lt;/li&gt;&lt;li&gt;\u27a4 affects males&lt;/li&gt;&lt;li&gt;\u27a4 females may be carriers&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 107 \u2013 Page No 3551&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 107 \u2013 Page No 3551&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 6-month-old infant is brought to a pediatric outpatient department by his mother, who is concerned about her child&#x27;s eyes, which have been showing excessive tearing, redness, and sensitivity to light for the past few weeks. She also mentions that her baby seems to be in pain when touching his feet. On examination, the pediatrician observes nonpruritic hyperkeratotic plaques on the soles of the infant&#x27;s feet, a finding that is unusual and concerning. Laboratory investigations reveal elevated levels of tyrosine in the blood (hypertyrosinemia) and increased 4-hydroxyphenylpyruvic acid in the urine. Given these clinical features and laboratory findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Tyrosinemia type 1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Tyrosinemia type 2&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Tyrosinemia type 3&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Tyrosinemia type 4&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Tyrosinemia type 2&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Tyrosinemia type 2&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Tyrosinemia type 1 is characterized by liver and kidney dysfunction, neurological crises, and a cabbage-like odor , but not typically by the skin and ocular findings seen in Tyrosinemia type II.&lt;/li&gt;&lt;li&gt;\u2022 Option A:&lt;/li&gt;&lt;li&gt;\u2022 Tyrosinemia type 1&lt;/li&gt;&lt;li&gt;\u2022 liver and kidney dysfunction, neurological crises, and a cabbage-like odor&lt;/li&gt;&lt;li&gt;\u2022 Option C: Tyrosinemia type 3 is very rare and typically presents with neurological symptoms ; the characteristic skin and ocular features of Tyrosinemia type II are absent.&lt;/li&gt;&lt;li&gt;\u2022 Option C:&lt;/li&gt;&lt;li&gt;\u2022 Tyrosinemia type 3&lt;/li&gt;&lt;li&gt;\u2022 neurological symptoms&lt;/li&gt;&lt;li&gt;\u2022 Option D: Tyrosinemia type 4 is not a recognized classification within the medical community for tyrosinemia, making it an incorrect option.&lt;/li&gt;&lt;li&gt;\u2022 Option D:&lt;/li&gt;&lt;li&gt;\u2022 Tyrosinemia type 4&lt;/li&gt;&lt;li&gt;\u2022 not a recognized classification&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Tyrosinemia type II (Richner-Hanhart syndrome) is an autosomal recessive disorder caused by tyrosine aminotransferase deficiency , leading to elevated tyrosine and 4-hydroxyphenylpyruvic acid levels . Tyrosinemia type I involves liver and renal issues , while type III is associated with neurological symptoms , distinguishing them from type II. Tyrosinemia type IV is not recognized .&lt;/li&gt;&lt;li&gt;\u27a4 Tyrosinemia type II (Richner-Hanhart syndrome)&lt;/li&gt;&lt;li&gt;\u27a4 autosomal recessive&lt;/li&gt;&lt;li&gt;\u27a4 tyrosine aminotransferase deficiency&lt;/li&gt;&lt;li&gt;\u27a4 elevated tyrosine and 4-hydroxyphenylpyruvic acid levels&lt;/li&gt;&lt;li&gt;\u27a4 Tyrosinemia type I&lt;/li&gt;&lt;li&gt;\u27a4 liver and renal issues&lt;/li&gt;&lt;li&gt;\u27a4 type III&lt;/li&gt;&lt;li&gt;\u27a4 with neurological symptoms&lt;/li&gt;&lt;li&gt;\u27a4 type IV is not recognized&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 103 \u2013 Page No 3143 -3153&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 103 \u2013 Page No 3143 -3153&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A worried mother rushes her 1-year-old son to the emergency department of a district hospital in India, reporting that her child has just experienced a convulsive episode. She mentions that the child was healthy at birth and reached early developmental milestones on time, but she has been increasingly concerned about his slow growth and a persistent rash that she describes as similar to eczema. Upon examination, the emergency physician notes the distinctive eczematous rash and also detects a \&quot;mousy\&quot; odor in the child&#x27;s urine, raising suspicion for a metabolic disorder. Given the combination of developmental concerns, seizure, eczematoid rash, and characteristic urine odor, which condition is most likely, and how should the diagnosis be confirmed?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Alkaptonuria and ferric chloride urine test&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Alkaptonuria and Agno3 test&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Phenylketonuria and ferric chloride urine test&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Phenylketonuria and Agno3 test&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Phenylketonuria and ferric chloride urine test&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Phenylketonuria and ferric chloride urine test&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Alkaptonuria (Options A and B) is a different metabolic disorder characterized by the accumulation of homogentisic acid , leading to darkening of the urine upon standing and ochronosis (bluish-black discoloration of connective tissue), but it does not present with the clinical features described in the question, such as eczematoid rash and mousy odor urine.&lt;/li&gt;&lt;li&gt;\u2022 Alkaptonuria&lt;/li&gt;&lt;li&gt;\u2022 (Options A and B)&lt;/li&gt;&lt;li&gt;\u2022 accumulation of homogentisic acid&lt;/li&gt;&lt;li&gt;\u2022 darkening of the urine upon standing and ochronosis&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Phenylketonuria , a treatable metabolic disorder , and the simple diagnostic tests like the ferric chloride urine test is used in initial screening , particularly in areas where more sophisticated diagnostic facilities may not be readily available .&lt;/li&gt;&lt;li&gt;\u27a4 Phenylketonuria&lt;/li&gt;&lt;li&gt;\u27a4 metabolic disorder&lt;/li&gt;&lt;li&gt;\u27a4 ferric chloride urine test&lt;/li&gt;&lt;li&gt;\u27a4 initial screening&lt;/li&gt;&lt;li&gt;\u27a4 diagnostic facilities may not be readily available&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st edition, Chapter 103 \u2013 Page No 3178&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st edition, Chapter 103 \u2013 Page No 3178&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 37 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

