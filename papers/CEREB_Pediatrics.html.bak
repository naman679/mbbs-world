&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-results-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;As the chief pediatrician in a regional hospital in India, you are called to assess a full-term newborn 16 hours after birth. The initial examination reveals no abnormalities, and you relay this information to the parents. However, the father expresses concern that the baby has not yet passed its first stool or urine. To address his concerns, how would you explain the normal time frame within which a newborn is expected to pass urine and meconium?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Urine 24 hrs and Meconium 48 hrs.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Urine 48 hrs and Meconium 24 hrs.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Urine 12 hrs and Meconium 24 hrs.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Urine 24 hrs and Meconium 12 hrs&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Urine 24 hrs and Meconium 48 hrs.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Urine 24 hrs and Meconium 48 hrs.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The normal newborn will pass urine within 24 hrs and Meconium within 48 hrs .&lt;/li&gt;&lt;li&gt;\u2022 normal newborn will pass urine&lt;/li&gt;&lt;li&gt;\u2022 24 hrs and Meconium within 48 hrs&lt;/li&gt;&lt;li&gt;\u2022 The time taken to reach air to the descending colon is 8-9 hrs .&lt;/li&gt;&lt;li&gt;\u2022 time taken to reach air to the descending colon is 8-9 hrs&lt;/li&gt;&lt;li&gt;\u2022 Delayed passage of meconium is seen in case of Hirschsprung&#x27;s disease for which rectal biopsy is done and most common area affected is rectum&lt;/li&gt;&lt;li&gt;\u2022 Delayed passage of meconium&lt;/li&gt;&lt;li&gt;\u2022 Hirschsprung&#x27;s disease&lt;/li&gt;&lt;li&gt;\u2022 rectal biopsy is done&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 It is normal for a newborn to pass urine within 24 hours and meconium within 48 hours of birth. Delay beyond these time frames should prompt further evaluation for possible underlying issues.&lt;/li&gt;&lt;li&gt;\u27a4 normal for a newborn to pass urine within 24 hours&lt;/li&gt;&lt;li&gt;\u27a4 meconium within 48 hours of birth.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21st Edition, Section 3, Chapter 344&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21st Edition, Section 3, Chapter 344&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-year-old boy is brought to a pediatric outpatient department with a 5-month history of rectal bleeding, characterized by fresh blood clearly visible on the stool. The boy reports no significant constipation, vomiting, diarrhea, or weight loss. His diet is typical for his age, and he is growing appropriately. On examination, his abdomen is soft with mild tenderness on the left side, and stool is palpable in the descending colon. A sentinel skin tag is observed in the perianal area, but no fissures are present. Complete blood count (CBC) is within normal range, and both X-ray and histopathological examination (HPE) of the bowel show no abnormalities. Considering the clinical presentation, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Constipation&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Inflammatory bowel disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Campylobacter enterocolitis&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Meckel\u2019s diverticulum&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Meckel\u2019s diverticulum&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Meckel\u2019s diverticulum&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Constipation: Could cause rectal bleeding due to anal fissures , but the patient denies significant constipation, and no fissure was found on examination.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Constipation:&lt;/li&gt;&lt;li&gt;\u2022 rectal bleeding due to anal fissures&lt;/li&gt;&lt;li&gt;\u2022 Option B. Inflammatory bowel disease: Usually presents with diarrhea, weight loss, and systemic symptoms, which are not observed in this boy.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Inflammatory bowel disease:&lt;/li&gt;&lt;li&gt;\u2022 Option C. Campylobacter enterocolitis: This typically presents with diarrhea, fever, and abdominal pain , which are not consistent with this patient\u2019s history.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Campylobacter enterocolitis:&lt;/li&gt;&lt;li&gt;\u2022 presents with diarrhea, fever, and abdominal pain&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Meckel\u2019s diverticulum is a congenital abnormality of the small intestine and can present with symptoms such as painless rectal bleeding , abdominal pain , and occasionally intestinal obstruction .&lt;/li&gt;&lt;li&gt;\u27a4 Meckel\u2019s diverticulum&lt;/li&gt;&lt;li&gt;\u27a4 congenital abnormality of the small intestine&lt;/li&gt;&lt;li&gt;\u27a4 painless rectal bleeding&lt;/li&gt;&lt;li&gt;\u27a4 abdominal pain&lt;/li&gt;&lt;li&gt;\u27a4 intestinal obstruction&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a routine visit, a mother expresses concern about her 6-month-old child&#x27;s frequent vomiting, which seems to be non-pathological upon examination. The child appears otherwise healthy with no detectable abnormalities. To address the mother&#x27;s concerns and provide reassurance, you explain that this is a common occurrence in infants and not indicative of a serious condition. What would you identify as the most common cause of this vomiting in an otherwise healthy infant?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Aerophagia&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hydrophagia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Milkophagia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Esophageal atresia.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Aerophagia&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Hydrophagia : Hydrophagia refers to excessive drinking of water, which is not typically associated with frequent vomiting in infants unless it leads to water intoxication, which is rare and usually not a common cause of vomiting in this age group.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Hydrophagia&lt;/li&gt;&lt;li&gt;\u2022 excessive drinking of water,&lt;/li&gt;&lt;li&gt;\u2022 Option C. Milkophagia : \&quot;Milkophagia\&quot; is not a recognized medical term. However, excessive milk intake or overfeeding can lead to vomiting in infants , but it is less common compared to aerophagia, especially in the absence of other symptoms like poor weight gain or discomfort during feeding.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Milkophagia&lt;/li&gt;&lt;li&gt;\u2022 excessive milk intake or overfeeding can lead to vomiting in infants&lt;/li&gt;&lt;li&gt;\u2022 Option D. Esophageal atresia: Esophageal atresia is a congenital condition where the esophagus does not develop properly , leading to a gap or blockage . It typically presents with difficulty swallowing, choking, and regurgitation of feedings shortly after birth, rather than at 6 months of age. Additionally, there would likely be abnormalities seen on examination or imaging studies.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Esophageal atresia:&lt;/li&gt;&lt;li&gt;\u2022 congenital condition where the esophagus does not develop properly&lt;/li&gt;&lt;li&gt;\u2022 gap or blockage&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Aerophagia refers to the swallowing of air , which can occur during feeding or crying in infants , leading to frequent episodes of vomiting . This is a common and benign cause of vomiting in infants, especially during the first few months of life when their feeding patterns are still developing.&lt;/li&gt;&lt;li&gt;\u27a4 Aerophagia&lt;/li&gt;&lt;li&gt;\u27a4 swallowing of air&lt;/li&gt;&lt;li&gt;\u27a4 occur during feeding or crying in infants&lt;/li&gt;&lt;li&gt;\u27a4 frequent episodes of vomiting&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition Chapter 368, Page No- 8087&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition Chapter 368, Page No- 8087&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother consults a pediatrician during a routine visit for her 9-month-old baby, expressing concern that the child isn&#x27;t gaining adequate weight and frequently regurgitates feed hours after eating. The child also has recurrent episodes of coughing associated with the regurgitation. After evaluating the baby, the pediatrician reassures the mother that this is a case of physiological regurgitation, which is common and typically not a cause for concern. The mother then inquires about the age up to which this regurgitation is considered normal without indicating a more serious underlying issue. How should the pediatrician respond?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Till 3 years of life.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Till 2 years of life.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Till 1 year of life.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Till 4 years of life.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Till 1 year of life.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Till 1 year of life.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Clinical Manifestations Infantile reflux manifests more often with regurgitation (especially postprandially), signs of esophagitis (irritability, arching, choking, gagging, feeding aversion), and resulting failure to thrive ; symptoms resolve spontaneously in the majority by 12 months.&lt;/li&gt;&lt;li&gt;\u2022 Clinical Manifestations&lt;/li&gt;&lt;li&gt;\u2022 Infantile reflux&lt;/li&gt;&lt;li&gt;\u2022 regurgitation&lt;/li&gt;&lt;li&gt;\u2022 signs of esophagitis&lt;/li&gt;&lt;li&gt;\u2022 failure to thrive&lt;/li&gt;&lt;li&gt;\u2022 Treatment \u2013 reassure the patient till 12 months.&lt;/li&gt;&lt;li&gt;\u2022 reassure the patient till 12 months.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Physiological regurgitation of feeds is a common occurrence in infants , typically improving as they grow older and develop better control over their feeding and digestive systems . It is considered normal for regurgitation to occur until around 1 year of age in the absence of any concerning symptoms or underlying medical conditions.&lt;/li&gt;&lt;li&gt;\u27a4 Physiological regurgitation&lt;/li&gt;&lt;li&gt;\u27a4 feeds&lt;/li&gt;&lt;li&gt;\u27a4 occurrence in infants&lt;/li&gt;&lt;li&gt;\u27a4 improving as they grow older&lt;/li&gt;&lt;li&gt;\u27a4 better control over their feeding and digestive systems&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter- 349\u2013 Page No- 7683.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter- 349\u2013 Page No- 7683.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 2-day-old newborn is brought to a hospital with symptoms of vomiting and an inability to pass meconium since birth. The physical examination reveals a noticeably distended abdomen and visible peristaltic waves. An X-ray of the abdomen shows a dilated stomach and proximal duodenum with air-fluid levels, but no air is seen beyond the proximal duodenum, suggesting a lack of passage through the distal duodenum and small intestine. Based on the clinical presentation and X-ray findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Esophageal atresia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Duodenal atresia&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hirschsprung&#x27;s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Jejunal atresia.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Duodenal atresia&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture13_T4f72b2.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Duodenal atresia&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Esophageal atresia: Esophageal atresia is a congenital condition characterized by a gap or blockage in the esophagus . It typically presents shortly after birth with drooling , choking , and difficulty swallowing , but it does not typically present with failure to pass meconium or a distended abdomen with visible peristaltic waves. Additionally, the X-ray findings described are not consistent with esophageal atresia.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Esophageal atresia:&lt;/li&gt;&lt;li&gt;\u2022 congenital condition&lt;/li&gt;&lt;li&gt;\u2022 gap or blockage in the esophagus&lt;/li&gt;&lt;li&gt;\u2022 presents shortly after birth with drooling&lt;/li&gt;&lt;li&gt;\u2022 choking&lt;/li&gt;&lt;li&gt;\u2022 difficulty swallowing&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hirschsprung&#x27;s disease: Hirschsprung&#x27;s disease is a congenital condition characterized by the absence of nerve cells in parts of the large intestine , leading to difficulty passing stool . It typically presents with symptoms of intestinal obstruction, such as failure to pass meconium, abdominal distension, and vomiting. However, the X-ray findings described, including a dilated stomach and proximal duodenum with air-fluid levels, are more indicative of a small bowel obstruction rather than Hirschsprung&#x27;s disease, which primarily affects the large intestine.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hirschsprung&#x27;s disease:&lt;/li&gt;&lt;li&gt;\u2022 congenital condition characterized by the absence of nerve cells&lt;/li&gt;&lt;li&gt;\u2022 large intestine&lt;/li&gt;&lt;li&gt;\u2022 difficulty passing stool&lt;/li&gt;&lt;li&gt;\u2022 Option D. Jejunal atresia: Jejunal atresia is a congenital condition characterized by a blockage or narrowing in the jejunum , a part of the small intestine . It can present with symptoms similar to duodenal atresia , including vomiting , failure to pass meconium , and abdominal distension . However, the X-ray findings described, specifically the visualization of a dilated stomach and proximal duodenum with air-fluid levels, are more suggestive of a proximal small bowel obstruction, which is consistent with duodenal atresia.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Jejunal atresia:&lt;/li&gt;&lt;li&gt;\u2022 congenital condition&lt;/li&gt;&lt;li&gt;\u2022 blockage or narrowing in the jejunum&lt;/li&gt;&lt;li&gt;\u2022 small intestine&lt;/li&gt;&lt;li&gt;\u2022 duodenal atresia&lt;/li&gt;&lt;li&gt;\u2022 vomiting&lt;/li&gt;&lt;li&gt;\u2022 failure to pass meconium&lt;/li&gt;&lt;li&gt;\u2022 abdominal distension&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Duodenal atresia is a congenital condition characterized by a blockage or narrowing in the duodenum , the first part of the small intestine . It commonly presents in newborns with vomiting , failure to pass meconium , and a distended abdomen with visible peristaltic waves . X-ray findings typically show a dilated stomach and proximal duodenum with air-fluid levels.&lt;/li&gt;&lt;li&gt;\u27a4 Duodenal atresia&lt;/li&gt;&lt;li&gt;\u27a4 congenital&lt;/li&gt;&lt;li&gt;\u27a4 blockage or narrowing in the duodenum&lt;/li&gt;&lt;li&gt;\u27a4 first part of the small intestine&lt;/li&gt;&lt;li&gt;\u27a4 newborns with vomiting&lt;/li&gt;&lt;li&gt;\u27a4 failure to pass meconium&lt;/li&gt;&lt;li&gt;\u27a4 distended abdomen with visible peristaltic waves&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter- 356, \u2013 Page No- 7749.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter- 356, \u2013 Page No- 7749.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 6-month-old infant with complaints of sudden onset of intermittent, severe abdominal pain and bilious vomiting. The infant draws their legs up to their abdomen and cries loudly when the pain is present. On physical examination, there is a palpable sausage-shaped mass in the right upper quadrant of the abdomen. An abdominal x-ray reveals air-fluid levels and an USG revealed a target or bulls eye sign. What is the likely diagnosis based on the clinical scenario and the radiographical findings?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Meckel&#x27;s diverticulum&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Duodenal atresia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hirschsprung&#x27;s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Intussusception&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Intussusception&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Meckel&#x27;s diverticulum: It can cause pain and bleeding but is less likely to present with a palpable abdominal mass and the \&quot;bull&#x27;s-eye\&quot; sign on ultrasound.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Meckel&#x27;s diverticulum:&lt;/li&gt;&lt;li&gt;\u2022 cause pain and bleeding&lt;/li&gt;&lt;li&gt;\u2022 Option B. Duodenal atresia: Presents with early-onset vomiting , typically in neonates , and is associated with a \&quot;double bubble\&quot; sign on X-ray, not the findings described.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Duodenal atresia:&lt;/li&gt;&lt;li&gt;\u2022 early-onset vomiting&lt;/li&gt;&lt;li&gt;\u2022 neonates&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hirschsprung&#x27;s disease: Characterized by chronic constipation and abdominal distension due to a lack of enteric nervous system cells in the distal colon ; it does not typically present acutely with a palpable mass and \&quot;bull&#x27;s-eye\&quot; sign.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hirschsprung&#x27;s disease:&lt;/li&gt;&lt;li&gt;\u2022 chronic constipation&lt;/li&gt;&lt;li&gt;\u2022 abdominal distension&lt;/li&gt;&lt;li&gt;\u2022 lack of enteric nervous system cells in the distal colon&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The classic presentation and ultrasound findings of intussusception in infants , which include sudden, intermittent abdominal pain , bilious vomiting , a palpable sausage-shaped mass , and the \&quot;bull&#x27;s-eye\&quot; sign on imaging . Early identification and treatment are crucial to prevent complications such as bowel necrosis.&lt;/li&gt;&lt;li&gt;\u27a4 classic presentation&lt;/li&gt;&lt;li&gt;\u27a4 ultrasound findings of intussusception in infants&lt;/li&gt;&lt;li&gt;\u27a4 sudden, intermittent abdominal pain&lt;/li&gt;&lt;li&gt;\u27a4 bilious vomiting&lt;/li&gt;&lt;li&gt;\u27a4 palpable sausage-shaped mass&lt;/li&gt;&lt;li&gt;\u27a4 \&quot;bull&#x27;s-eye\&quot; sign on imaging&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1812-1814.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No 1812-1814.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A worried mother brings her 3-year-old son, who has no significant medical history, to the pediatric clinic after discovering bright red blood in his diaper. The child seems relatively comfortable, except for when his right lower quadrant (RLQ) is palpated, causing him to cry. An ultrasound reveals a tubular blind-ending structure originating from an ileal loop, and a technetium-99m scan confirms the presence of Meckel&#x27;s diverticulum. Considering the diagnosis of Meckel&#x27;s diverticulum, which of the following statements is NOT true about its features?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;It\u2019s a true diverticulum.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;It is due to persistence of omphalomesenteric duct.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;May have ectopic acid-secreting gastric mucosa.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Least common congenital anomaly of gastrointestinal tract.&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Least common congenital anomaly of gastrointestinal tract.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Least common congenital anomaly of gastrointestinal tract&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. True Diverticulum: Correct . Meckel&#x27;s diverticulum involves all layers of the bowel wall.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. True Diverticulum:&lt;/li&gt;&lt;li&gt;\u2022 Correct&lt;/li&gt;&lt;li&gt;\u2022 Option B. Persistence of Omphalomesenteric Duct: Correct , as Meckel&#x27;s diverticulum results from the failure of the omphalomesenteric duct to completely obliterate during development.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Persistence of Omphalomesenteric Duct:&lt;/li&gt;&lt;li&gt;\u2022 Correct&lt;/li&gt;&lt;li&gt;\u2022 Option C. Ectopic Acid-Secreting Gastric Mucosa: Correct . The presence of ectopic gastric mucosa can lead to acid secretion and subsequent ulceration, causing bleeding, which might explain the rectal bleeding in this case.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Ectopic Acid-Secreting Gastric Mucosa:&lt;/li&gt;&lt;li&gt;\u2022 Correct&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Most common congenital anomaly of gastrointestinal tract - Meckel\u2019s diverticulum&lt;/li&gt;&lt;li&gt;\u27a4 Most common congenital anomaly of gastrointestinal tract - Meckel\u2019s diverticulum&lt;/li&gt;&lt;li&gt;\u27a4 Rule of 2\u2019s&lt;/li&gt;&lt;li&gt;\u27a4 Rule of 2\u2019s&lt;/li&gt;&lt;li&gt;\u27a4 Affects 2% of population 2 feet from ileocecal valve 2 inches long 2 types of epithelia tissue: gastric and pancreatic Male: female ratio 2:1 Patients &amp;lt; 2 years old 2% symptomatic&lt;/li&gt;&lt;li&gt;\u27a4 Affects 2% of population&lt;/li&gt;&lt;li&gt;\u27a4 2 feet from ileocecal valve&lt;/li&gt;&lt;li&gt;\u27a4 2 inches long&lt;/li&gt;&lt;li&gt;\u27a4 2 types of epithelia tissue: gastric and pancreatic&lt;/li&gt;&lt;li&gt;\u27a4 Male: female ratio 2:1&lt;/li&gt;&lt;li&gt;\u27a4 Patients &amp;lt; 2 years old&lt;/li&gt;&lt;li&gt;\u27a4 2% symptomatic&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition Chapter 357 \u2013 Page No- 7762&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition Chapter 357 \u2013 Page No- 7762&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A concerned father rushes his 13-year-old son to the emergency department from school due to 2 days of persistent nausea, vomiting, and diarrhea. The boy is in evident distress, experiencing severe pain upon palpation of the abdomen, particularly in the right lower quadrant (RLQ). He describes the pain as initially starting around the periumbilical area before localizing to the RLQ. The boy is tachycardic, febrile, and presents with mild hypertension. Physical examination reveals diffuse abdominal tenderness with notable rebound tenderness in the RLQ, leading to a clinical diagnosis of appendicitis. Among the following statements about appendicitis, which one is correct?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;The most common site of appendix is Retro iliac&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Obturator sign has a significance in appendicitis.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Contrast Enhanced CT is the initial investigation in children&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Psoas sign has no significance in appendicitis.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Obturator sign has a significance in appendicitis.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Obturator sign has a significance in appendicitis.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Retroiliac: The most common location of the appendix is not retroiliac but rather in the RLQ of the abdomen, specifically at the McBurney&#x27;s point.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Retroiliac:&lt;/li&gt;&lt;li&gt;\u2022 most common location&lt;/li&gt;&lt;li&gt;\u2022 appendix&lt;/li&gt;&lt;li&gt;\u2022 Option C. Contrast-Enhanced CT: In children , ultrasound is often the initial imaging modality of choice for suspected appendicitis to avoid radiation exposure . CT may be used subsequently if ultrasound findings are inconclusive and the clinical suspicion remains high.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Contrast-Enhanced CT:&lt;/li&gt;&lt;li&gt;\u2022 children&lt;/li&gt;&lt;li&gt;\u2022 ultrasound&lt;/li&gt;&lt;li&gt;\u2022 initial imaging modality&lt;/li&gt;&lt;li&gt;\u2022 suspected appendicitis&lt;/li&gt;&lt;li&gt;\u2022 avoid radiation exposure&lt;/li&gt;&lt;li&gt;\u2022 Option D. Psoas Sign: The psoas sign is actually significant in appendicitis , especially when the inflamed appendix is positioned against the iliopsoas muscle . The sign is elicited by extending the hip, with the patient lying on their left side, which can cause pain in cases of appendicitis.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Psoas Sign:&lt;/li&gt;&lt;li&gt;\u2022 appendicitis&lt;/li&gt;&lt;li&gt;\u2022 inflamed appendix is positioned against the iliopsoas muscle&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The clinical signs significant in diagnosing appendicitis , are the obturator sign and psoas sign , and to recognize the appropriate initial imaging modality in children suspected of having appendicitis, is an ultrasound to avoid unnecessary radiation exposure.&lt;/li&gt;&lt;li&gt;\u27a4 clinical signs&lt;/li&gt;&lt;li&gt;\u27a4 diagnosing appendicitis&lt;/li&gt;&lt;li&gt;\u27a4 obturator sign and psoas sign&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Chapter- 370, \u2013 Page No- 8106.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter- 370, \u2013 Page No- 8106.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During pediatric rounds, you&#x27;re reviewing a case involving hyperbilirubinemia. The attending consultant quizzes the team, asking, \&quot;In pediatric patients, what is the foremost reason for undergoing liver transplantation?\&quot; How should you respond?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Weil\u2019s disease.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Fulminant hepatic failure&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Biliary atresia&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Wilsons disease&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Biliary atresia&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Biliary atresia&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Weil\u2019s disease: This condition, caused by Leptospira bacteria , can lead to severe liver damage but is not the leading cause of liver transplantation in children.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Weil\u2019s disease:&lt;/li&gt;&lt;li&gt;\u2022 Leptospira bacteria&lt;/li&gt;&lt;li&gt;\u2022 lead to severe liver damage&lt;/li&gt;&lt;li&gt;\u2022 Option B. Fulminant hepatic failure: While this acute liver failure could necessitate urgent liver transplantation , it is not as common as biliary atresia in pediatric patients requiring this intervention.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Fulminant hepatic failure:&lt;/li&gt;&lt;li&gt;\u2022 acute liver failure&lt;/li&gt;&lt;li&gt;\u2022 urgent liver transplantation&lt;/li&gt;&lt;li&gt;\u2022 Option D. Wilson&#x27;s disease: A genetic disorder that causes copper accumulation in organs , including the liver . Although it can lead to liver failure, biliary atresia is more frequently the cause of liver transplantation in the pediatric population.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Wilson&#x27;s disease:&lt;/li&gt;&lt;li&gt;\u2022 genetic disorder&lt;/li&gt;&lt;li&gt;\u2022 copper accumulation in organs&lt;/li&gt;&lt;li&gt;\u2022 liver&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Biliary atresia is the most prevalent indication for liver transplantation in the pediatric demographic , underscoring the significance of early detection and intervention to avert the progression to irreversible liver damage.&lt;/li&gt;&lt;li&gt;\u27a4 Biliary atresia&lt;/li&gt;&lt;li&gt;\u27a4 liver transplantation in the pediatric demographic&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter-383. Page No 8277.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter-383. Page No 8277.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An anxious mother consults about her 2-year-old child, who exhibits delayed developmental milestones, signs of intellectual disability, and sandal gap toes. The child, recently diagnosed with a heart condition, is also identified to have a trisomy disorder. Accompanying this information is an image depicting the child&#x27;s eye findings characteristic of the trisomy disorder. Given this clinical background, what is the most common cause of intestinal obstruction in this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Meckel\u2019s diverticulum&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Duodenal atresia&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hirschsprung disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Jejunal atresia&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Duodenal atresia&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture14_E9y44hu.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A . Meckel&#x27;s Diverticulum : While Meckel&#x27;s diverticulum is a common congenital anomaly , it is not particularly associated with Down syndrome more than duodenal atresia.&lt;/li&gt;&lt;li&gt;\u2022 Option A&lt;/li&gt;&lt;li&gt;\u2022 Meckel&#x27;s Diverticulum&lt;/li&gt;&lt;li&gt;\u2022 common congenital anomaly&lt;/li&gt;&lt;li&gt;\u2022 Option C . Hirschsprung Disease : This condition involves the absence of ganglion cells in the bowel leading to functional obstruction . It is not specifically associated with Down syndrome.&lt;/li&gt;&lt;li&gt;\u2022 Option C&lt;/li&gt;&lt;li&gt;\u2022 Hirschsprung Disease&lt;/li&gt;&lt;li&gt;\u2022 absence of ganglion cells in the bowel&lt;/li&gt;&lt;li&gt;\u2022 functional obstruction&lt;/li&gt;&lt;li&gt;\u2022 Option D . Jejunal Atresia : Though a possible cause of intestinal obstruction in neonates , jejunal atresia does not have a specific association with Down syndrome like duodenal atresia does.&lt;/li&gt;&lt;li&gt;\u2022 Option D&lt;/li&gt;&lt;li&gt;\u2022 Jejunal Atresia&lt;/li&gt;&lt;li&gt;\u2022 intestinal obstruction in neonates&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The most common cause of intestinal obstruction in the Down Syndrome child is duodenal atresia .&lt;/li&gt;&lt;li&gt;\u27a4 intestinal obstruction in the Down Syndrome child is duodenal atresia&lt;/li&gt;&lt;li&gt;\u27a4 Duodenal atresia is notably associated with Down syndrome , with up to 30% of infants with duodenal atresia having Down syndrome.&lt;/li&gt;&lt;li&gt;\u27a4 Duodenal atresia&lt;/li&gt;&lt;li&gt;\u27a4 associated with Down syndrome&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 98- Page No 3011.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 98- Page No 3011.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a routine pediatric visit, an 8-month-old girl named Saheli is brought in by her mother, who is concerned about her daughter&#x27;s chronic diarrhea lasting over a month and failure to thrive. Saheli presents with abdominal distension and facial pallor, and a routine complete blood count (CBC) reveals severe anemia. The mother reports that these symptoms began after weaning Saheli off breast milk and introducing supplementary feeds. Further evaluation indicates Saheli has a hypersensitivity to gliadin in her diet. Given this clinical picture, which specific antibody is most likely to be present in Saheli?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Anti-Saccharomyces cerevisiae antibody.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Anti endomysial antibody.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Antinuclear antibody.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Antineutrophil Cytoplasmic Antibodies (ANCA).&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Anti endomysial antibody.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Anti endomysial antibody&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Anti-Saccharomyces cerevisiae antibody (ASCA): This antibody is more commonly associated with Crohn&#x27;s disease , an inflammatory bowel disease , rather than with celiac disease.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Anti-Saccharomyces cerevisiae antibody (ASCA):&lt;/li&gt;&lt;li&gt;\u2022 Crohn&#x27;s disease&lt;/li&gt;&lt;li&gt;\u2022 inflammatory bowel disease&lt;/li&gt;&lt;li&gt;\u2022 Option C. Antinuclear antibody (ANA): ANA is a marker of autoimmune diseases in general and is not specific to celiac disease.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Antinuclear antibody (ANA):&lt;/li&gt;&lt;li&gt;\u2022 marker of autoimmune diseases&lt;/li&gt;&lt;li&gt;\u2022 Option D. Antineutrophil Cytoplasmic Antibodies (ANCA): ANCA is associated with vasculitis and some inflammatory bowel diseases like ulcerative colitis, not celiac disease.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Antineutrophil Cytoplasmic Antibodies (ANCA):&lt;/li&gt;&lt;li&gt;\u2022 vasculitis and some inflammatory bowel diseases&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Anti-endomysial antibodies are highly specific for celiac disease , particularly in the context of symptoms like chronic diarrhea, failure to thrive , and onset after the introduction of gluten-containing foods in infants.&lt;/li&gt;&lt;li&gt;\u27a4 Anti-endomysial antibodies&lt;/li&gt;&lt;li&gt;\u27a4 celiac disease&lt;/li&gt;&lt;li&gt;\u27a4 chronic diarrhea, failure to thrive&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 387- Page No 8386.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 387- Page No 8386.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 14-year-old boy presents with right-sided abdominal discomfort. His father, who has a history of a similar condition in his teenage years and is currently being treated for a gastrointestinal malignancy, accompanies him. The pediatrician&#x27;s examination and ultrasound (USG) do not reveal any significant abnormalities. Given the family history, the boy undergoes a colonoscopy, and the findings from this procedure are provided. Based on the diagnosis made from the colonoscopy results, which associated syndromes could be related to this patient&#x27;s condition?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Attenuated FAP&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Turcot Syndrome.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Gardner Syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;All of the above&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. All of the above&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture15_8BTnCU7.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) All of the above.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Attenuated FAP: A variant of FAP that presents with fewer polyps (often less than 100) and a later onset of cancer compared to classic FAP.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Attenuated FAP:&lt;/li&gt;&lt;li&gt;\u2022 presents with fewer polyps&lt;/li&gt;&lt;li&gt;\u2022 Option B. Turcot Syndrome: Characterized by the presence of colorectal polyps and a predisposition to brain tumors.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Turcot Syndrome:&lt;/li&gt;&lt;li&gt;\u2022 presence of colorectal polyps&lt;/li&gt;&lt;li&gt;\u2022 Option C. Gardner Syndrome: A variant of FAP that, in addition to colorectal polyps, includes extracolonic manifestations such as osteomas , dental anomalies , and soft tissue tumors .&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Gardner Syndrome:&lt;/li&gt;&lt;li&gt;\u2022 extracolonic manifestations&lt;/li&gt;&lt;li&gt;\u2022 osteomas&lt;/li&gt;&lt;li&gt;\u2022 dental anomalies&lt;/li&gt;&lt;li&gt;\u2022 soft tissue tumors&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Recognize the association between familial adenomatous polyposis (FAP) syndromes and the development of gastrointestinal malignancies , highlighting the importance of early screening and surveillance in individuals with a family history suggestive of hereditary cancer syndromes .&lt;/li&gt;&lt;li&gt;\u27a4 association between familial adenomatous polyposis&lt;/li&gt;&lt;li&gt;\u27a4 syndromes&lt;/li&gt;&lt;li&gt;\u27a4 development of gastrointestinal malignancies&lt;/li&gt;&lt;li&gt;\u27a4 hereditary cancer syndromes&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 372 Page No-8164 -8166.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 372 Page No-8164 -8166.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An anxious mother presents her 10-year-old child to the clinic, concerned about a lesion in his mouth, shown in an accompanying image. The child&#x27;s uncle was recently diagnosed with a gastrointestinal malignancy, heightening her concern about her son&#x27;s risk for developing cancer. Upon examination, you note the oral lesion and identify a hamartomatous polyp. Given these clinical findings, what is the most likely diagnosis, and which gene is implicated?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Familial adenomatous polyposis and APC gene.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Peutz-Jeghers syndrome and STK 1 gene.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Peutz-Jeghers syndrome and STK 11 gene.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Familial adenomatous polyposis and STK 1 gene.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Peutz-Jeghers syndrome and STK 11 gene.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture16_eYi22rC.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Peutz-Jeghers syndrome and STK 11 gene.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Familial Adenomatous Polyposis (FAP) and APC gene: FAP is characterized by the development of hundreds to thousands of adenomatous polyps in the colon and rectum , with an increased risk of colorectal cancer. It is associated with mutations in the APC gene, not with mucocutaneous pigmentation or hamartomatous polyps.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Familial Adenomatous Polyposis (FAP) and APC gene:&lt;/li&gt;&lt;li&gt;\u2022 development of hundreds to thousands of adenomatous polyps in the colon&lt;/li&gt;&lt;li&gt;\u2022 rectum&lt;/li&gt;&lt;li&gt;\u2022 Option B. Peutz-Jeghers syndrome and STK 1 gene: This option is incorrect because Peutz-Jeghers syndrome is associated with the STK11 gene , not STK1.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Peutz-Jeghers syndrome and STK 1 gene:&lt;/li&gt;&lt;li&gt;\u2022 Peutz-Jeghers syndrome is associated with the STK11 gene&lt;/li&gt;&lt;li&gt;\u2022 Option D. Familial Adenomatous Polyposis and STK 1 gene: This option is incorrect on both counts; FAP is associated with the APC gene , and STK1 is not the gene involved in FAP or PJS.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Familial Adenomatous Polyposis and STK 1 gene:&lt;/li&gt;&lt;li&gt;\u2022 FAP is associated with the APC gene&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The clinical features of Peutz-Jeghers syndrome are mucocutaneous pigmentation and hamartomatous polyps , and it is associated with mutations in the STK11 gene . Early diagnosis is crucial for managing the increased cancer risk associated with the syndrome.&lt;/li&gt;&lt;li&gt;\u27a4 Peutz-Jeghers syndrome are mucocutaneous pigmentation&lt;/li&gt;&lt;li&gt;\u27a4 hamartomatous polyps&lt;/li&gt;&lt;li&gt;\u27a4 mutations in the STK11 gene&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 372 Page No-8163-8164.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 372 Page No-8163-8164.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A child exhibiting HLA-DQ8 positivity presents with chronic diarrhea, fatigue, pallor, and failure to thrive. To confirm the diagnosis, a biopsy is conducted, revealing crypt hyperplasia and increased intraepithelial lymphocytes, leading to a diagnosis of celiac disease. Considering what is known about celiac disease, which of the following statements is NOT true?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Celiac disease is most commonly confused with IBS&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;10% of adults with iron deficiency anemia have undiagnosed celiac disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;On histology Increase in thickness of the mucosa&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Celiac disease not responding to gluten free diet has poor prognosis&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. On histology Increase in thickness of the mucosa&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture17_treogKc.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture17_treogKc.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) On histology Increase in thickness of the mucosa&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A . Misdiagnosis as IBS: It is true that celiac disease can be confused with IBS due to overlapping gastrointestinal symptoms, making this statement correct.&lt;/li&gt;&lt;li&gt;\u2022 Option A&lt;/li&gt;&lt;li&gt;\u2022 Option B . Iron deficiency anemia: It is also true that a significant proportion of adults with iron deficiency anemia may have undiagnosed celiac disease, as celiac disease can lead to malabsorption of nutrients, including iron.&lt;/li&gt;&lt;li&gt;\u2022 Option B&lt;/li&gt;&lt;li&gt;\u2022 Option D . Non-responsive celiac disease: Celiac disease that does not respond to a strict gluten-free diet, known as refractory celiac disease, does indeed have a poorer prognosis and may require further medical intervention.&lt;/li&gt;&lt;li&gt;\u2022 Option D&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The histological hallmark of celiac disease involves villous atrophy and not an increase in mucosal thickness.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 387- Page No 8386.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 387- Page No 8386.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following clinical findings with their diagnosis :&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A1 B2 C3 D4&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A4 B3 C2 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B1 C4 D2&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. A3 B1 C4 D2&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture18_6dgRFdZ.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture19.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following most common findings in children and their associated conditions.&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A3 B4 C2 D1&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A3 B2 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B1 C4 D2&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. A3 B4 C2 D1&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture20.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture21.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) A3 B4 C2 D1&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 5-year-old child is brought in by their mother due to acute onset watery diarrhea, having experienced six episodes in the past 24 hours. The child presents without fever, abdominal pain, or vomiting and appears alert and well-hydrated. Physical examination reveals a soft, non-tender abdomen. Considering the clinical presentation, what is the most common infectious cause of diarrhea in children?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Rhino virus.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Rota virus.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Noro virus&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Zika virus&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Rota virus.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Rota virus.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 Option A. Rhinovirus: Primarily associated with the common cold , rhinovirus mainly affects the respiratory system , causing symptoms like runny nose, sore throat, and cough, rather than gastrointestinal symptoms like diarrhea.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Rhinovirus:&lt;/li&gt;&lt;li&gt;\u2022 common cold&lt;/li&gt;&lt;li&gt;\u2022 rhinovirus&lt;/li&gt;&lt;li&gt;\u2022 respiratory system&lt;/li&gt;&lt;li&gt;\u2022 Option C. Norovirus: While norovirus is a common cause of gastroenteritis and can lead to outbreaks , especially in semi-closed environments such as schools and cruise ships , it is not as commonly associated with acute gastroenteritis in children as rotavirus. Norovirus tends to affect people of all ages and is characterized by sudden onset of vomiting and watery diarrhea.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Norovirus:&lt;/li&gt;&lt;li&gt;\u2022 cause of gastroenteritis&lt;/li&gt;&lt;li&gt;\u2022 lead to outbreaks&lt;/li&gt;&lt;li&gt;\u2022 semi-closed environments such as schools and cruise ships&lt;/li&gt;&lt;li&gt;\u2022 Option D. Zika virus: Known for its association with outbreaks in tropical regions and its link to birth defects when infections occur during pregnancy , Zika virus is primarily transmitted by mosquitoes and does not commonly cause diarrhea as a primary symptom.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Zika virus:&lt;/li&gt;&lt;li&gt;\u2022 association with outbreaks in tropical regions&lt;/li&gt;&lt;li&gt;\u2022 birth defects when infections occur during pregnancy&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Rotavirus is the most common cause of acute gastroenteritis in children , characterized by watery diarrhea. Rhino virus is the most common cause of upper respiratory tract infection in children Noro virus is the most common cause of diarrhoea in adults Zika virus will results in microcephaly.&lt;/li&gt;&lt;li&gt;\u27a4 Rotavirus is the most common cause of acute gastroenteritis in children , characterized by watery diarrhea.&lt;/li&gt;&lt;li&gt;\u27a4 Rotavirus&lt;/li&gt;&lt;li&gt;\u27a4 most common cause of acute gastroenteritis in children&lt;/li&gt;&lt;li&gt;\u27a4 Rhino virus is the most common cause of upper respiratory tract infection in children&lt;/li&gt;&lt;li&gt;\u27a4 Rhino virus&lt;/li&gt;&lt;li&gt;\u27a4 common cause of upper respiratory tract infection&lt;/li&gt;&lt;li&gt;\u27a4 Noro virus is the most common cause of diarrhoea in adults&lt;/li&gt;&lt;li&gt;\u27a4 Noro virus&lt;/li&gt;&lt;li&gt;\u27a4 cause of diarrhoea in adults&lt;/li&gt;&lt;li&gt;\u27a4 Zika virus will results in microcephaly.&lt;/li&gt;&lt;li&gt;\u27a4 Zika virus&lt;/li&gt;&lt;li&gt;\u27a4 microcephaly.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 292 Page No- 7022.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 292 Page No- 7022.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 5-month-old infant is brought to the pediatric department due to experiencing five episodes of loose stools. Upon examination, the child shows a keen interest in drinking water and has normal skin turgor. Following WHO guidelines, you initiate Oral Rehydration Solution (ORS) therapy and counsel the mother accordingly. What is the recommended dosage of zinc supplementation for this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;10 mg for 5 days&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;20 mg for 5 days&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;10 mg for 10-14 days&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;20 mg for 10-14 days&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. 10 mg for 10-14 days&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) 10 mg for 10-14 days.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 For infants and children with acute diarrhea , the WHO recommends zinc supplementation as part of the management . The recommended dosage for infants under 6 months of age is 10 mg of zinc per day for 10-14 days . Zinc supplementation during diarrhea episodes has been shown to reduce the duration and severity of the episode and may also have a prophylactic effect against future episodes for 2-3 months.&lt;/li&gt;&lt;li&gt;\u2022 infants and children with acute diarrhea&lt;/li&gt;&lt;li&gt;\u2022 zinc supplementation as part of the management&lt;/li&gt;&lt;li&gt;\u2022 dosage for infants under 6 months of age is 10 mg of zinc per day&lt;/li&gt;&lt;li&gt;\u2022 10-14 days&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The dosage of Zinc given in the child is&lt;/li&gt;&lt;li&gt;\u27a4 &amp;lt;6 months of age \u2013 10 mg/day .&lt;/li&gt;&lt;li&gt;\u27a4 &amp;lt;6 months of age \u2013 10 mg/day&lt;/li&gt;&lt;li&gt;\u27a4 &amp;gt;6 months of age \u2013 20 mg/day .&lt;/li&gt;&lt;li&gt;\u27a4 &amp;gt;6 months of age \u2013 20 mg/day&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A concerned mother brings her 5-month-old infant to the clinic due to three episodes of vomiting and diarrhea over the past three days. Examination reveals a perianal rash and the presence of acidic stools. The mother shares that she recently returned to work and began substituting breast milk with cow&#x27;s milk. You advise her on the benefits of expressing and storing breast milk for feeding. Considering the clinical presentation and history, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Primary Lactose Intolerance&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Secondary Lactose Intolerance&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Tertiary Lactose Intolerance&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Both primary and secondary Lactose Intolerance&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Secondary Lactose Intolerance&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Secondary Lactose Intolerance&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A . Primary Lactose Intolerance : Rare in infants , it&#x27;s a genetic condition where babies are born with low levels of lactase enzyme . Symptoms would likely have appeared earlier if this were the case.&lt;/li&gt;&lt;li&gt;\u2022 Option A&lt;/li&gt;&lt;li&gt;\u2022 Primary Lactose Intolerance&lt;/li&gt;&lt;li&gt;\u2022 Rare in infants&lt;/li&gt;&lt;li&gt;\u2022 genetic condition&lt;/li&gt;&lt;li&gt;\u2022 babies are born with low levels of lactase enzyme&lt;/li&gt;&lt;li&gt;\u2022 Option C. Cow&#x27;s Milk Protein Allergy: While similar in presentation, the immediate onset of symptoms after introducing cow&#x27;s milk suggests intolerance to lactose rather than an allergic reaction to milk proteins.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Cow&#x27;s Milk Protein Allergy:&lt;/li&gt;&lt;li&gt;\u2022 immediate onset of symptoms&lt;/li&gt;&lt;li&gt;\u2022 intolerance to lactose&lt;/li&gt;&lt;li&gt;\u2022 Option D. Gastroenteritis: Typically associated with infectious agents , it could present with vomiting and diarrhea but less likely to be directly linked to the introduction of cow&#x27;s milk.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Gastroenteritis:&lt;/li&gt;&lt;li&gt;\u2022 infectious agents&lt;/li&gt;&lt;li&gt;\u2022 vomiting and diarrhea&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Lactose intolerance can either be primary (lactase activity that gradually declines with aging) or secondary (an infection or enteropathy damages the villi, resulting in lactose intolerance).&lt;/li&gt;&lt;li&gt;\u27a4 Lactose intolerance&lt;/li&gt;&lt;li&gt;\u27a4 primary&lt;/li&gt;&lt;li&gt;\u27a4 secondary&lt;/li&gt;&lt;li&gt;\u27a4 Many patients who have lactose intolerance diagnosed can tolerate Yoghurt.&lt;/li&gt;&lt;li&gt;\u27a4 Yoghurt.&lt;/li&gt;&lt;li&gt;\u27a4 Other products, such as whole or skim milk, ice cream, or buttermilk, have more lactose (approximately 10 g/serving) and are less likely to be tolerated.&lt;/li&gt;&lt;li&gt;\u27a4 whole or skim milk, ice cream, or buttermilk, have more lactose&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1854-1874. O P Ghai \u2013 Page No-293&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;li&gt;\u27a4 O P Ghai \u2013 Page No-293&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 2 months old child with complaints of recurrent infections and the skin findings as shown in the image. On examination the following skin findings are noted. What is the micro element that is deficient in this child and its dosage for the treatment of diarrhoea in his cousin who is 8 months old?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Copper deficiency and 10 mg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Zinc deficiency and 20 mg&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Copper deficiency and 20 mg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Zinc deficiency and 10 mg&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Zinc deficiency and 20 mg&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2023/04/29/picture10_FOi3yL4.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B. Zinc deficiency and 20 mg&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A and C : Copper deficiency doesn\u2019t manifest as the features mentioned above.&lt;/li&gt;&lt;li&gt;\u2022 Option A and C&lt;/li&gt;&lt;li&gt;\u2022 Copper deficiency&lt;/li&gt;&lt;li&gt;\u2022 Option D: Dose of zinc in a 8 month old child is 20mg/kg for 14 days not 10mg/kg.&lt;/li&gt;&lt;li&gt;\u2022 Option D:&lt;/li&gt;&lt;li&gt;\u2022 Dose of zinc in a 8 month old child is 20mg/kg&lt;/li&gt;&lt;li&gt;\u2022 14 days&lt;/li&gt;&lt;li&gt;\u2022 Ref ; Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;li&gt;\u2022 Ref&lt;/li&gt;&lt;li&gt;\u2022 Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother presents her 6-year-old son to the clinic, reporting dysphagia. Upon examination, the child shows no signs of respiratory distress. A chest X-ray reveals radiopaque findings suggestive of a foreign body aspiration. What is the most appropriate next step in management?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Immediate Tracheoscopic removal.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Immediate Esophagoscopic removal.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Wait and Watch&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Immediate Laryngoscopic removal.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Wait and Watch&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture22.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Wait and Watch&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Immediate Tracheoscopic removal: Tracheoscopic removal is indicated if there are signs of severe airway obstruction or respiratory distress . However, in stable patients without such signs, immediate intervention may not be necessary.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Immediate Tracheoscopic removal:&lt;/li&gt;&lt;li&gt;\u2022 there are signs of severe airway obstruction&lt;/li&gt;&lt;li&gt;\u2022 respiratory distress&lt;/li&gt;&lt;li&gt;\u2022 Option B. Immediate Esophagoscopic removal: Esophagoscopic removal is appropriate if the foreign body is confirmed to be lodged in the esophagus and causing symptoms. However, if the location is uncertain or if the patient is asymptomatic, immediate intervention may not be warranted.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Immediate Esophagoscopic removal:&lt;/li&gt;&lt;li&gt;\u2022 foreign body is confirmed to be lodged in the esophagus&lt;/li&gt;&lt;li&gt;\u2022 Option D. Immediate Laryngoscopic removal: Laryngoscopic removal is indicated if the foreign body is visible in the larynx or upper airway and causing significant obstruction. However, if there are no signs of upper airway compromise, immediate intervention may not be required.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Immediate Laryngoscopic removal:&lt;/li&gt;&lt;li&gt;\u2022 foreign body is visible in the larynx or upper airway&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Foreign body in the esophagus - Since it doesn\u2019t produce any major symptoms and it will dislodge into stomach and will be removed out itself. So, the best management is to wait and watch.&lt;/li&gt;&lt;li&gt;\u27a4 Foreign body in the esophagus&lt;/li&gt;&lt;li&gt;\u27a4 doesn\u2019t produce any major symptoms&lt;/li&gt;&lt;li&gt;\u27a4 dislodge into stomach&lt;/li&gt;&lt;li&gt;\u27a4 In case of Coin in the trachea immediate removal is advised.&lt;/li&gt;&lt;li&gt;\u27a4 Coin in the trachea immediate removal is advised.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 21 st Edition, Chapter 360Page No 7818-7821.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter 360Page No 7818-7821.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 3-year-old daughter to the clinic due to 6 episodes of loose stools. Upon examination, the child is alert and exhibits normal skin turgor. When offered water, the child drinks adequately. What is the most appropriate next step in management?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Plan A&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Plan B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Plan C&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Plan D&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Plan A&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture23.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture24.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture23.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture24.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Plan A&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 In the child , he is alert , and his skin pinch test skin goes back quickly and on offering water the child drink , these are the features of no dehydration . So, to treat this case we will use Plan-A.&lt;/li&gt;&lt;li&gt;\u2022 child&lt;/li&gt;&lt;li&gt;\u2022 he is alert&lt;/li&gt;&lt;li&gt;\u2022 skin pinch test skin goes back quickly&lt;/li&gt;&lt;li&gt;\u2022 offering water the child drink&lt;/li&gt;&lt;li&gt;\u2022 no dehydration&lt;/li&gt;&lt;li&gt;\u2022 Plan A - ORS per loose stool (10cc/Kg or stool volume)&lt;/li&gt;&lt;li&gt;\u2022 Plan A&lt;/li&gt;&lt;li&gt;\u2022 ORS per loose stool&lt;/li&gt;&lt;li&gt;\u2022 Plan B- B is used for some dehydration - ORS 75ml/kg over 4 hrs&lt;/li&gt;&lt;li&gt;\u2022 Plan B-&lt;/li&gt;&lt;li&gt;\u2022 ORS 75ml/kg over 4 hrs&lt;/li&gt;&lt;li&gt;\u2022 Plan C- is used for severe dehydration&lt;/li&gt;&lt;li&gt;\u2022 Plan C-&lt;/li&gt;&lt;li&gt;\u2022 severe dehydration&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother rushes her 2-year-old child to the emergency department, concerned about severe dehydration. Upon examination, the child appears lethargic and weak. The healthcare provider notices several physical signs. Which of the following features is least likely to be observed in cases of severe dehydration?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Very sunken&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Skin Goes back Slowly&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Very Dry buccal mucosa&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Drinks Eagerly on offering water&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Drinks Eagerly on offering water&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture25.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture25.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Drinks Eagerly on offering water&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Very sunken eyes: This is a typical sign of severe dehydration due to decreased fluid volume.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Very sunken eyes:&lt;/li&gt;&lt;li&gt;\u2022 typical sign of severe dehydration&lt;/li&gt;&lt;li&gt;\u2022 Option B. Skin goes back slowly after a skin pinch test : Also characteristic of severe dehydration , indicating decreased skin turgor.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Skin goes back slowly after a skin pinch test&lt;/li&gt;&lt;li&gt;\u2022 severe dehydration&lt;/li&gt;&lt;li&gt;\u2022 Option C. Very dry buccal mucosa : Another hallmark sign of severe dehydration due to decreased saliva production and fluid loss.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Very dry buccal mucosa&lt;/li&gt;&lt;li&gt;\u2022 hallmark sign of severe dehydration&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 In case of severe dehydration, the child will be unable to drink the offered water.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No 1854-1874.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her child with a history of episodes of loose stools for 1 day along with features of irritability and restlessness. There is no history of fever or blood in stools. On examination, the child&#x27;s eyes are sunken, and skin pinch goes back slowly within 2 seconds. On giving water, the child accepts and drinks readily. What will be the best management for this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Start intravenous fluids Immediately and immediately refer to a higher center.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Give Zinc supplementation and ORS only and ask mother to come back if there is development of any danger signs.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Administer intravenous antibiotic and immediately refer to a higher center&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Start oral antibiotics and send the child home&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Give Zinc supplementation and ORS only and ask mother to come back if there is development of any danger signs.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture28.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture27.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture28.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture27.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Give Zinc supplementation and oral rehydration and ask mother to come back if some danger signs develop.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Start intravenous fluids immediately and immediately refer to a higher center: Intravenous fluids are typically reserved for cases of severe dehydration or if the child cannot tolerate oral fluids . Immediate referral to a higher center may not be necessary if the child responds well to oral rehydration therapy.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Start intravenous fluids immediately and immediately refer to a higher center:&lt;/li&gt;&lt;li&gt;\u2022 severe dehydration or if the child cannot tolerate oral fluids&lt;/li&gt;&lt;li&gt;\u2022 Option C. Administer intravenous antibiotics and immediately refer to a higher center: Antibiotics are not indicated in uncomplicated cases of acute diarrhea without specific indications such as dysentery. Immediate referral may not be necessary unless there are signs of severe illness or complications.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Administer intravenous antibiotics and immediately refer to a higher center: Antibiotics&lt;/li&gt;&lt;li&gt;\u2022 not indicated in uncomplicated cases of acute diarrhea&lt;/li&gt;&lt;li&gt;\u2022 Option D. Start oral antibiotics and send the child home : Antibiotics are not routinely recommended for the management of acute diarrhea unless specific bacterial etiology like dysentery is suspected. Starting oral antibiotics without proper indication can contribute to antibiotic resistance and is not appropriate in this scenario.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Start oral antibiotics and send the child home&lt;/li&gt;&lt;li&gt;\u2022 Antibiotics&lt;/li&gt;&lt;li&gt;\u2022 not routinely recommended for the management of acute diarrhea&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Management-&lt;/li&gt;&lt;li&gt;\u27a4 Management-&lt;/li&gt;&lt;li&gt;\u27a4 Ref: OP Ghai 8 th Edition, Page No-290-295.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai 8 th Edition, Page No-290-295.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 1-year-old infant with a history of 10\u201312 episodes of watery stools per day for the last 2 days. Recognizing the severity of the condition, you decide to initiate zinc supplementation along with additional measures to manage the diarrhea effectively. Considering the comprehensive approach to management, what else should be prescribed to the 1-year-old child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;ORS with antibiotics&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;ORS only&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;ORS with low-lactose diet&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;ORS with low-lactose diet and probiotics&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. ORS only&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture29.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture29.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) ORS only&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. ORS with antibiotics: Antibiotics are not routinely recommended for acute watery diarrhea unless there is evidence of bacterial infection or specific indications for antibiotic therapy.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. ORS with antibiotics:&lt;/li&gt;&lt;li&gt;\u2022 not routinely recommended for acute watery diarrhea&lt;/li&gt;&lt;li&gt;\u2022 Option C. ORS with low-lactose diet: While a low-lactose diet may be beneficial in cases of lactose intolerance , it is not the primary intervention for managing acute diarrhea, especially in the initial stages of treatment.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. ORS with low-lactose diet:&lt;/li&gt;&lt;li&gt;\u2022 low-lactose diet may be beneficial in cases of lactose intolerance&lt;/li&gt;&lt;li&gt;\u2022 Option D. ORS with low-lactose diet and probiotics: While these interventions may have potential benefits , they are not the initial management priority in acute diarrhea, which requires prompt rehydration with ORS.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. ORS with low-lactose diet and probiotics:&lt;/li&gt;&lt;li&gt;\u2022 interventions may have potential benefits&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 In managing acute diarrhea in infants , oral rehydration solution (ORS) plays a central role in restoring hydration and electrolyte balance , which are essential for recovery. ORS contains the optimal balance of electrolytes and glucose to replace fluid losses due to diarrhea and prevent dehydration . It is the cornerstone of treatment recommended by the World Health Organization (WHO) for managing acute diarrhea in children.&lt;/li&gt;&lt;li&gt;\u27a4 acute diarrhea in infants&lt;/li&gt;&lt;li&gt;\u27a4 oral rehydration solution&lt;/li&gt;&lt;li&gt;\u27a4 central role in restoring hydration and electrolyte balance&lt;/li&gt;&lt;li&gt;\u27a4 ORS&lt;/li&gt;&lt;li&gt;\u27a4 optimal balance of electrolytes&lt;/li&gt;&lt;li&gt;\u27a4 glucose to replace fluid losses&lt;/li&gt;&lt;li&gt;\u27a4 diarrhea and prevent dehydration&lt;/li&gt;&lt;li&gt;\u27a4 While zinc supplementation , low-lactose diet , and probiotics can be beneficial in certain cases, the initial management priority is to ensure adequate rehydration with ORS . Antibiotics are not routinely indicated in cases of acute watery diarrhea unless there is evidence of bacterial etiology or severe illness requiring targeted treatment. A low-lactose diet and probiotics may be considered in cases of lactose intolerance or persistent diarrhea, but they do not replace the primary role of ORS in managing acute diarrhea.&lt;/li&gt;&lt;li&gt;\u27a4 zinc supplementation&lt;/li&gt;&lt;li&gt;\u27a4 low-lactose diet&lt;/li&gt;&lt;li&gt;\u27a4 probiotics&lt;/li&gt;&lt;li&gt;\u27a4 initial management priority is to ensure adequate rehydration with ORS&lt;/li&gt;&lt;li&gt;\u27a4 Ref: OP Ghai 8 th Edition, Page No-290-295.&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai 8 th Edition, Page No-290-295.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 7-month-old child Rajni with a few episodes of loose stools suggestive of acute gastroenteritis. On examination, the child weighs 6 kg, with sunken eyes and skin pinch that goes back slowly in 2 seconds. What will be your next step in the management of this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;RL infusion 180mL in the first hour followed by 420 mL in the next 5 hours&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;RL infusion 180 mL in the first hour followed by 480 mL in the next 2 hours&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;RL infusion 240 mL in the first hour followed by 360 mL in the next 5 hours&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;RL infusion 120 mL in the first hour followed by 360 mL in the next 5 hours&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. RL infusion 180mL in the first hour followed by 420 mL in the next 5 hours&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture30.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture31.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture30.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture31.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) RL infusion 180 mL in the first hour followed by 420 mL in the next 5 hours&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Assessment of dehydration in a patient with diarrhoea&lt;/li&gt;&lt;li&gt;\u27a4 Assessment of dehydration in a patient with diarrhoea&lt;/li&gt;&lt;li&gt;\u27a4 Ref: OP Ghai 9 th Edition, Page No-289&lt;/li&gt;&lt;li&gt;\u27a4 Ref:&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai 9 th Edition, Page No-289&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 2-year-old baby Somu to a pediatrician with a history of multiple episodes of loose, watery stools for 2 days. His mother mentions that he has been restless and irritated since yesterday. However, he can drink water when offered. Physical examination reveals an irritated and thirsty baby with a heart rate of 140/min and a respiratory rate of 39/min. The pediatrician pinches the abdominal skin, which returns within 2 seconds. Based on the history and physical examination findings, which of the following is the best management plan in this case?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Plan A&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Plan C&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Plan D&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Plan B&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Plan B&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture32.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture32.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Plan B&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A - Plan A is the treatment of No dehydration .&lt;/li&gt;&lt;li&gt;\u2022 Option A -&lt;/li&gt;&lt;li&gt;\u2022 Plan A&lt;/li&gt;&lt;li&gt;\u2022 treatment of No dehydration&lt;/li&gt;&lt;li&gt;\u2022 Option B - Plan C is the treatment of Severe dehydration.&lt;/li&gt;&lt;li&gt;\u2022 Option B&lt;/li&gt;&lt;li&gt;\u2022 Plan C&lt;/li&gt;&lt;li&gt;\u2022 treatment of Severe dehydration.&lt;/li&gt;&lt;li&gt;\u2022 Option C- Plan D is not a recommended plan for the treatment of dehydration .&lt;/li&gt;&lt;li&gt;\u2022 Option C-&lt;/li&gt;&lt;li&gt;\u2022 Plan D&lt;/li&gt;&lt;li&gt;\u2022 not&lt;/li&gt;&lt;li&gt;\u2022 treatment of dehydration&lt;/li&gt;&lt;li&gt;\u2022 Ref: OP Ghai 9 th Edition, Page No-290.&lt;/li&gt;&lt;li&gt;\u2022 Ref:&lt;/li&gt;&lt;li&gt;\u2022 OP Ghai 9 th Edition, Page No-290.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following Plan of treatment with level of dehydration:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A3 B4 C1 D2&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A3 B2 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B4 C2 D1&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. A2 B3 C4 D1&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture33.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture34.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) A2 B3 C4 D1&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 11-year-old girl is brought to a clinic by her mother in a small town in India, with a history of intermittent diarrhea, periumbilical pain, and bloating that have persisted for the last three years. The symptoms occasionally exacerbate after the intake of milk and dairy products. On physical examination, rashes around the umbilicus are noted. A Benedict&#x27;s test performed during the visit yields positive results, indicating the presence of reducing sugars in the urine. Given that an enzyme deficiency affecting lactose metabolism is suspected, which of the following food items is the girl most likely to tolerate?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Whole milk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Yoghurt&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Butter milk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Skimmed milk&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Yoghurt&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Yoghurt.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Whole milk: Whole milk contains a significant amount of lactose and is therefore unlikely to be tolerated by someone with lactose intolerance.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Whole milk:&lt;/li&gt;&lt;li&gt;\u2022 significant amount of lactose&lt;/li&gt;&lt;li&gt;\u2022 Option C. Buttermilk: Buttermilk generally contains less lactose than whole milk but still may contain enough to cause symptoms in someone with lactose intolerance.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Buttermilk:&lt;/li&gt;&lt;li&gt;\u2022 less lactose than whole milk&lt;/li&gt;&lt;li&gt;\u2022 Option D. Skimmed milk: Skimmed milk contains a similar amount of lactose as whole milk and is therefore unlikely to be tolerated by someone with lactose intolerance.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Skimmed milk:&lt;/li&gt;&lt;li&gt;\u2022 similar amount of lactose as whole milk&lt;/li&gt;&lt;li&gt;\u2022 Educational objective:&lt;/li&gt;&lt;li&gt;\u2022 Educational objective:&lt;/li&gt;&lt;li&gt;\u2022 Yoghurt , is the most likely food that will be tolerated due to its lower lactose content compared to whole milk and skimmed milk , making it a suitable alternative for individuals with lactose intolerance.&lt;/li&gt;&lt;li&gt;\u2022 Yoghurt&lt;/li&gt;&lt;li&gt;\u2022 most likely food that will be tolerated due to its lower lactose content&lt;/li&gt;&lt;li&gt;\u2022 whole milk&lt;/li&gt;&lt;li&gt;\u2022 skimmed milk&lt;/li&gt;&lt;li&gt;\u2022 Ref: Nelson 20 th Edition, Page No 1854-1874. O P Ghai \u2013 Page No-293&lt;/li&gt;&lt;li&gt;\u2022 Ref:&lt;/li&gt;&lt;li&gt;\u2022 Nelson 20 th Edition, Page No 1854-1874. O P Ghai \u2013 Page No-293&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following signs along with the levels of dehydration:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A2 B1 C3 D2&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A3 B1 C1 D3&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A3 B3 C2 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B1 C3 D2&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. A3 B1 C3 D2&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture35.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture36.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) A3 B1 C3 D2&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 40 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

