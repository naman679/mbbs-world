&lt;button class=&quot;bg-yellow-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-yellow-400 transition w-full md:w-auto&quot; id=&quot;mark-review&quot;&gt;Mark for Review&lt;/button&gt;
&lt;button class=&quot;bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition w-full md:w-auto&quot; id=&quot;next-btn&quot;&gt;Next&lt;/button&gt;
&lt;button class=&quot;bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full md:w-auto&quot; id=&quot;nav-toggle&quot;&gt;Questions Navigation&lt;/button&gt;
&lt;button class=&quot;bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition w-full md:w-auto&quot; id=&quot;submit-test&quot;&gt;Submit Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/section&gt;
&lt;!-- Results Section --&gt;
&lt;section class=&quot;container mx-auto p-4 md:p-6 hidden section-transition&quot; id=&quot;results&quot;&gt;
&lt;div class=&quot;bg-white rounded-lg shadow-md p-4 md:p-6&quot;&gt;
&lt;h2 class=&quot;text-2xl font-semibold mb-4&quot;&gt;Micronutrients - Results&lt;/h2&gt;
&lt;div class=&quot;grid grid-cols-1 md:grid-cols-2 gap-4 mb-6&quot;&gt;
&lt;p&gt;&lt;strong&gt;Correct:&lt;/strong&gt; &lt;span id=&quot;correct-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Wrong:&lt;/strong&gt; &lt;span id=&quot;wrong-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unanswered:&lt;/strong&gt; &lt;span id=&quot;unanswered-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Marked for Review:&lt;/strong&gt; &lt;span id=&quot;marked-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;h3 class=&quot;text-lg font-semibold mb-4&quot; id=&quot;result-question-number&quot;&gt;Question &lt;span&gt;1&lt;/span&gt; of 20&lt;/h3&gt;
&lt;div class=&quot;space-y-6&quot; id=&quot;results-content&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;result-nav&quot;&gt;
&lt;button aria-label=&quot;Previous question result&quot; class=&quot;result-nav-btn&quot; disabled=&quot;&quot; id=&quot;prev-result&quot;&gt;Previous&lt;/button&gt;
&lt;button aria-label=&quot;Toggle results navigation panel&quot; class=&quot;result-nav-btn&quot; id=&quot;results-nav-toggle&quot;&gt;Results Navigation&lt;/button&gt;
&lt;button aria-label=&quot;Next question result&quot; class=&quot;result-nav-btn&quot; id=&quot;next-result&quot;&gt;Next&lt;/button&gt;
&lt;/div&gt;
&lt;div class=&quot;mt-6 flex space-x-4 button-group md:flex-row flex-col&quot;&gt;
&lt;button class=&quot;bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition&quot; id=&quot;take-again&quot;&gt;Take Again&lt;/button&gt;
&lt;button class=&quot;bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition&quot; id=&quot;review-test&quot;&gt;Review Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/section&gt;
&lt;!-- Exit Confirmation Modal --&gt;
&lt;div class=&quot;fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden&quot; id=&quot;exit-modal&quot;&gt;
&lt;div class=&quot;bg-white rounded-lg p-6 max-w-sm w-full&quot;&gt;
&lt;h2 class=&quot;text-xl font-semibold mb-4&quot;&gt;Leave Test?&lt;/h2&gt;
&lt;p class=&quot;text-gray-700 mb-4&quot;&gt;Your progress will be lost if you leave this page. Are you sure you want to exit?&lt;/p&gt;
&lt;div class=&quot;flex justify-end space-x-4&quot;&gt;
&lt;button class=&quot;bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition&quot; id=&quot;continue-test&quot;&gt;No, Continue&lt;/button&gt;
&lt;button class=&quot;bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition&quot; id=&quot;exit-test&quot;&gt;Yes, Exit&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;!-- Submit Confirmation Modal --&gt;
&lt;div class=&quot;fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden&quot; id=&quot;submit-modal&quot;&gt;
&lt;div class=&quot;bg-white rounded-lg p-6 max-w-sm w-full&quot;&gt;
&lt;h2 class=&quot;text-xl font-semibold mb-4&quot;&gt;Confirm Submission&lt;/h2&gt;
&lt;p class=&quot;text-gray-700 mb-2&quot;&gt;You have attempted &lt;span id=&quot;attempted-count&quot;&gt;0&lt;/span&gt; of 20 questions.&lt;/p&gt;
&lt;p class=&quot;text-gray-700 mb-4&quot;&gt;&lt;span id=&quot;unattempted-count&quot;&gt;0&lt;/span&gt; questions are unattempted.&lt;/p&gt;
&lt;div class=&quot;flex justify-end space-x-4&quot;&gt;
&lt;button class=&quot;bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition&quot; id=&quot;cancel-submit&quot;&gt;Cancel&lt;/button&gt;
&lt;button class=&quot;bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition&quot; id=&quot;confirm-submit&quot;&gt;Submit Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;!-- Quiz Navigation Panel --&gt;
&lt;div class=&quot;fixed inset-y-0 right-0 nav-panel bg-white shadow-lg p-4 hidden overflow-y-auto&quot; id=&quot;nav-panel&quot;&gt;
&lt;h2 class=&quot;text-lg font-semibold mb-4&quot;&gt;Questions Navigation&lt;/h2&gt;
&lt;div class=&quot;mb-4&quot;&gt;
&lt;select class=&quot;w-full p-2 border rounded-lg text-gray-700&quot; id=&quot;nav-filter&quot;&gt;
&lt;option value=&quot;all&quot;&gt;All Questions&lt;/option&gt;
&lt;option value=&quot;answered&quot;&gt;Answered&lt;/option&gt;
&lt;option value=&quot;unanswered&quot;&gt;Unanswered&lt;/option&gt;
&lt;option value=&quot;marked&quot;&gt;Marked for Review&lt;/option&gt;
&lt;/select&gt;
&lt;/div&gt;
&lt;div class=&quot;grid grid-cols-5 gap-2 md:gap-3&quot; id=&quot;nav-grid&quot;&gt;&lt;/div&gt;
&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- Results Navigation Panel --&gt;
&lt;div class=&quot;fixed inset-y-0 right-0 results-nav-panel bg-white shadow-lg p-4 hidden overflow-y-auto&quot; id=&quot;results-nav-panel&quot;&gt;
&lt;h2 class=&quot;text-lg font-semibold mb-4&quot;&gt;Results Navigation&lt;/h2&gt;
&lt;div class=&quot;mb-4&quot;&gt;
&lt;select class=&quot;w-full p-2 border rounded-lg text-gray-700&quot; id=&quot;results-nav-filter&quot;&gt;
&lt;option value=&quot;all&quot;&gt;All Questions&lt;/option&gt;
&lt;option value=&quot;answered&quot;&gt;Answered&lt;/option&gt;
&lt;option value=&quot;unanswered&quot;&gt;Unanswered&lt;/option&gt;
&lt;option value=&quot;marked&quot;&gt;Marked for Review&lt;/option&gt;
&lt;/select&gt;
&lt;/div&gt;
&lt;div class=&quot;grid grid-cols-5 gap-2 md:gap-3&quot; id=&quot;results-nav-grid&quot;&gt;&lt;/div&gt;
&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-results-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;A 6-year-old child from northern part of Russia is brought to the paediatrician with complaints of pain in the legs and difficulty walking. As they were in their tour to Goa, they wanted to treat their child as early as possible and need to return to their country before their visa expires. On taking history, the child has been exclusively breastfed and does not receive any sunlight exposure due to climatic conditions over there. What is the most likely diagnosis based on the history of this patient?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Scurvy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Rickets&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Osteopetrosis&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Rheumatoid arthritis&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Rickets&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Rickets&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Scurvy: Caused by vitamin C deficiency , scurvy presents with symptoms such as bleeding gums , bruising , and anemia , but it does not typically cause bone pain or issues related to bone growth.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Scurvy:&lt;/li&gt;&lt;li&gt;\u2022 vitamin C deficiency&lt;/li&gt;&lt;li&gt;\u2022 scurvy&lt;/li&gt;&lt;li&gt;\u2022 symptoms such as bleeding gums&lt;/li&gt;&lt;li&gt;\u2022 bruising&lt;/li&gt;&lt;li&gt;\u2022 anemia&lt;/li&gt;&lt;li&gt;\u2022 Option C. Osteopetrosis: This is a rare genetic disorder characterized by increased bone density and brittle bones . While it can cause bone pain, it is not related to sunlight exposure or dietary intake.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Osteopetrosis:&lt;/li&gt;&lt;li&gt;\u2022 rare genetic disorder&lt;/li&gt;&lt;li&gt;\u2022 increased bone density&lt;/li&gt;&lt;li&gt;\u2022 brittle bones&lt;/li&gt;&lt;li&gt;\u2022 Option D. Rheumatoid arthritis: While juvenile rheumatoid arthritis can cause joint pain and difficulty walking , it is less likely in this scenario without other systemic symptoms and given the specific context of the child&#x27;s history with sunlight exposure.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Rheumatoid arthritis:&lt;/li&gt;&lt;li&gt;\u2022 juvenile rheumatoid arthritis&lt;/li&gt;&lt;li&gt;\u2022 cause joint pain&lt;/li&gt;&lt;li&gt;\u2022 difficulty walking&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Lack of exposure to sunlight and exclusive breastfeeding can lead to vitamin D deficiency , causing rickets in children . The radiological image shows cupping, splaying and fraying of the metaphysis typically seen in case of rickets.&lt;/li&gt;&lt;li&gt;\u27a4 Lack of exposure to sunlight&lt;/li&gt;&lt;li&gt;\u27a4 exclusive breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 vitamin D deficiency&lt;/li&gt;&lt;li&gt;\u27a4 rickets in children&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page No- 336- 340.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 20 th Edition, Page No- 336- 340.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 14-year-old boy is brought to the emergency department in a collapsed state after experiencing 12 episodes of vomiting. On examination, he is found to have a feeble pulse and cold, clammy limbs. An emergency ECG reveals significant abnormalities. Which electrolyte imbalance is most likely responsible for the findings observed in this patient&#x27;s ECG?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Hypokalemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hyperkalemia&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hypocalcemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Hypomagnesemia&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Hyperkalemia&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture28.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-152237.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Hyperkalemia&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Hypokalemia results in the ECG findings of Prolonged PR interval , Reduction in T wave amplitude / flattening / inversion, ST depression and Appearance of U wave.&lt;/li&gt;&lt;li&gt;\u2022 Option A.&lt;/li&gt;&lt;li&gt;\u2022 Hypokalemia&lt;/li&gt;&lt;li&gt;\u2022 ECG findings of Prolonged PR interval&lt;/li&gt;&lt;li&gt;\u2022 Reduction in T wave amplitude&lt;/li&gt;&lt;li&gt;\u2022 flattening&lt;/li&gt;&lt;li&gt;\u2022 inversion,&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hypocalcemia results in the ECG findings of Prolonged QTs segment (secondary to lengthening of ST segment).&lt;/li&gt;&lt;li&gt;\u2022 Option C.&lt;/li&gt;&lt;li&gt;\u2022 Hypocalcemia&lt;/li&gt;&lt;li&gt;\u2022 ECG findings of Prolonged QTs segment&lt;/li&gt;&lt;li&gt;\u2022 Option D. Hypomagnesemia results in the ECG findings of ST segment depression , Flat T waves or depression in the precordium , U waves and PR prolongation.&lt;/li&gt;&lt;li&gt;\u2022 Option D.&lt;/li&gt;&lt;li&gt;\u2022 Hypomagnesemia&lt;/li&gt;&lt;li&gt;\u2022 ECG findings of ST segment depression&lt;/li&gt;&lt;li&gt;\u2022 Flat T waves&lt;/li&gt;&lt;li&gt;\u2022 depression&lt;/li&gt;&lt;li&gt;\u2022 precordium&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 8 th Edition, Page No-76.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai 8 th Edition, Page No-76.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-year-old child is brought to the emergency department after being rescued from a house fire. The child has sustained second-degree burns over 15% of their body surface area. The medical team decides to initiate fluid resuscitation as part of the initial management. Considering the need for an isotonic solution to restore intravascular volume, which of the following solutions would be most appropriate for this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;77 mEq of sodium in 1000 mL of fluid&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;130 mEq of sodium in 1000 mL of fluid&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;513 mEq of sodium in 1000 mL of fluid&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;26 mEq of sodium in 1000 mL of fluid&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. 130 mEq of sodium in 1000 mL of fluid&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-152004.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-152004.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) 130 mEq of sodium in 1000 mL of fluid.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The solution containing 130 mEq of sodium per 1000 mL of fluid is Ringer&#x27;s lactate , which is an isotonic solution often used in fluid resuscitation for burn patients . It contains electrolytes closely resembling those of the body&#x27;s plasma , making it suitable for restoring intravascular volume without causing significant shifts in electrolyte balance.&lt;/li&gt;&lt;li&gt;\u2022 solution containing 130 mEq of sodium per 1000 mL&lt;/li&gt;&lt;li&gt;\u2022 fluid is Ringer&#x27;s lactate&lt;/li&gt;&lt;li&gt;\u2022 isotonic solution&lt;/li&gt;&lt;li&gt;\u2022 fluid resuscitation for burn patients&lt;/li&gt;&lt;li&gt;\u2022 electrolytes closely resembling those of the body&#x27;s plasma&lt;/li&gt;&lt;li&gt;\u2022 restoring intravascular volume&lt;/li&gt;&lt;li&gt;\u2022 The sodium concentration of RL is 130 mEq.&lt;/li&gt;&lt;li&gt;\u2022 The sodium concentration of RL is 130 mEq.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition, Page No-289&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : OP Ghai 9 th Edition, Page No-289&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A concerned mother presents to the pediatric clinic with her child, who has experienced 7 episodes of loose stools from morning till evening. Upon examination, the pediatrician notes mild dehydration in the child. Considering the clinical presentation and the need for rehydration, which of the following is the most appropriate initial fluid choice for managing diarrhea in this infant?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Salt water&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Sugar water&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;ORS&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Normal Saline&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. ORS&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) ORS&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Salt Water: While rehydration requires salt , salt water alone is not recommended due to its high sodium concentration , which can worsen dehydration and lead to hypernatremia.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Salt Water:&lt;/li&gt;&lt;li&gt;\u2022 rehydration requires salt&lt;/li&gt;&lt;li&gt;\u2022 salt water&lt;/li&gt;&lt;li&gt;\u2022 high sodium concentration&lt;/li&gt;&lt;li&gt;\u2022 worsen dehydration&lt;/li&gt;&lt;li&gt;\u2022 lead to hypernatremia.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Sugar Water: Sugar water can provide some energy but lacks the necessary electrolytes needed to correct the electrolyte imbalances caused by diarrhea . It is not sufficient for rehydration purposes.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Sugar Water:&lt;/li&gt;&lt;li&gt;\u2022 provide some energy but lacks the necessary electrolytes&lt;/li&gt;&lt;li&gt;\u2022 correct the electrolyte imbalances&lt;/li&gt;&lt;li&gt;\u2022 diarrhea&lt;/li&gt;&lt;li&gt;\u2022 Option D. Normal Saline: Normal Saline is an intravenous solution that can be used in more severe cases of dehydration or when oral rehydration is not possible . However, for mild dehydration and when oral intake is feasible, ORS is preferred due to its ease of use and effectiveness in promoting intestinal water and electrolyte absorption.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Normal Saline:&lt;/li&gt;&lt;li&gt;\u2022 intravenous solution&lt;/li&gt;&lt;li&gt;\u2022 used in more severe cases of dehydration&lt;/li&gt;&lt;li&gt;\u2022 oral rehydration is not possible&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective&lt;/li&gt;&lt;li&gt;\u27a4 Oral Rehydration Solution (ORS) is the recommended first-line treatment for rehydration in infants and children with mild to moderate dehydration due to diarrhea . ORS is specifically formulated to contain the ideal balance of salts and sugars to facilitate water absorption in the intestine.&lt;/li&gt;&lt;li&gt;\u27a4 Oral Rehydration Solution&lt;/li&gt;&lt;li&gt;\u27a4 first-line treatment for rehydration&lt;/li&gt;&lt;li&gt;\u27a4 infants&lt;/li&gt;&lt;li&gt;\u27a4 children&lt;/li&gt;&lt;li&gt;\u27a4 mild to moderate dehydration&lt;/li&gt;&lt;li&gt;\u27a4 diarrhea&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition, Page No-289.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition, Page No-289.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;You are reviewing a newborn in the neonatal unit who was delivered 2 hours ago to a mother with a history of diabetes. The infant&#x27;s initial blood glucose measurement is 60 mg/dl. Considering the maternal history of diabetes and the current blood glucose level of the infant, which of the following additional tests is most appropriate to order next for this newborn?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Serum potassium&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;CBC&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Serum calcium&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Serum chloride&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Serum calcium&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Serum calcium&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 Option A. Serum Potassium: While important in assessing overall electrolyte balance , potassium levels are not the immediate concern in the context of an infant of a diabetic mother without any specific symptoms of hyperkalemia or hypokalemia.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Serum Potassium:&lt;/li&gt;&lt;li&gt;\u2022 assessing overall electrolyte balance&lt;/li&gt;&lt;li&gt;\u2022 Option B. Complete Blood Count (CBC): A CBC can provide valuable information about an infant&#x27;s hematologic status but is not the most relevant test for a newborn of a diabetic mother in the absence of clinical signs suggestive of infection, anemia, or polycythemia.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Complete Blood Count (CBC):&lt;/li&gt;&lt;li&gt;\u2022 valuable information&lt;/li&gt;&lt;li&gt;\u2022 infant&#x27;s hematologic status&lt;/li&gt;&lt;li&gt;\u2022 Option D. Serum Chloride: Serum chloride levels, though part of the electrolyte panel , are not specifically indicated in this scenario. The focus is on the more common metabolic derangements associated with infants of diabetic mothers, such as hypocalcemia.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Serum Chloride:&lt;/li&gt;&lt;li&gt;\u2022 part of the electrolyte panel&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Infants of a diabetic mother are at a higher risk of metabolic complications as complications to normal infants. These complications include: Hypoglycemia Hypocalcemia Hypomagnesemia Hence the infant needs to be checked for these as soon as possible. Therefore, the correct options will be Serum Calcium levels.&lt;/li&gt;&lt;li&gt;\u27a4 Infants of a diabetic mother are at a higher risk of metabolic complications as complications to normal infants.&lt;/li&gt;&lt;li&gt;\u27a4 Infants of a diabetic mother&lt;/li&gt;&lt;li&gt;\u27a4 higher risk of metabolic complications&lt;/li&gt;&lt;li&gt;\u27a4 These complications include: Hypoglycemia Hypocalcemia Hypomagnesemia&lt;/li&gt;&lt;li&gt;\u27a4 Hypoglycemia Hypocalcemia Hypomagnesemia&lt;/li&gt;&lt;li&gt;\u27a4 Hypoglycemia&lt;/li&gt;&lt;li&gt;\u27a4 Hypocalcemia&lt;/li&gt;&lt;li&gt;\u27a4 Hypomagnesemia&lt;/li&gt;&lt;li&gt;\u27a4 Hence the infant needs to be checked for these as soon as possible.&lt;/li&gt;&lt;li&gt;\u27a4 Therefore, the correct options will be Serum Calcium levels.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : nelson 21 st edition page 4206&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : nelson 21 st edition page 4206&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 17-month-old child is brought to a pediatric clinic in India for a routine eye examination. The examining physician notes a thinned-out cornea during the assessment. Further history reveals that the child has been diagnosed with iron deficiency anemia. The child&#x27;s current weight is recorded at 10 kg. Considering the child&#x27;s age and clinical findings suggestive of vitamin A deficiency, what is the appropriate dose of vitamin A supplementation for this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;50,000 IU&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;1,00,000 IU&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;2,00,000 IU&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;2,50,000 IU&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. 2,00,000 IU&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture29_iS2dyws.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture29_iS2dyws.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) 2,00,000 IU&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The clinical features mentioned in this are suggestive of keratomalacia and the dose of vitamin A given in this child of 17 months is 2,00,000 IU.&lt;/li&gt;&lt;li&gt;\u2022 keratomalacia&lt;/li&gt;&lt;li&gt;\u2022 dose of vitamin A&lt;/li&gt;&lt;li&gt;\u2022 child of 17 months&lt;/li&gt;&lt;li&gt;\u2022 2,00,000 IU.&lt;/li&gt;&lt;li&gt;\u2022 keratomalacia&lt;/li&gt;&lt;li&gt;\u2022 Vitamin A deficiency is characterized by night blindness and conjunctival xerosis . Bitot\u2019s spots, Keratomalacia and fundus changes in severe cases.&lt;/li&gt;&lt;li&gt;\u2022 Vitamin A deficiency&lt;/li&gt;&lt;li&gt;\u2022 night blindness&lt;/li&gt;&lt;li&gt;\u2022 conjunctival xerosis&lt;/li&gt;&lt;li&gt;\u2022 Clouding of cornea in a child with Vit A deficiency is emergency \u2192 requires parenteral administration of 50,000 -100,000 IU Retinol&lt;/li&gt;&lt;li&gt;\u2022 Clouding of cornea&lt;/li&gt;&lt;li&gt;\u2022 child with Vit A deficiency is emergency&lt;/li&gt;&lt;li&gt;\u2022 In keratomalacia \u2192 Local treatment with antibiotic drops &amp;amp; ointment, padding of eye \u2192 enhances healing.&lt;/li&gt;&lt;li&gt;\u2022 In keratomalacia \u2192 Local treatment with antibiotic drops &amp;amp; ointment, padding of eye \u2192 enhances healing.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Treatment of Vitamin A deficiency:&lt;/li&gt;&lt;li&gt;\u27a4 Treatment of Vitamin A deficiency:&lt;/li&gt;&lt;li&gt;\u27a4 &amp;lt;6 months of age Vitamin A 50,000 IU orally/dose&lt;/li&gt;&lt;li&gt;\u27a4 6-12 months of age Vitamin A 100,000 IU orally/dose&lt;/li&gt;&lt;li&gt;\u27a4 \u226512 months of age Vitamin A 2,00,000 1U orally/dose&lt;/li&gt;&lt;li&gt;\u27a4 The same dose is repeated next day &amp;amp; weeks later.&lt;/li&gt;&lt;li&gt;\u27a4 The same dose is repeated next day &amp;amp; weeks later.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Op Ghai 9 th Edition, Page No- 118.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Op Ghai 9 th Edition, Page No- 118.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-month-old infant is brought to a pediatric clinic for a routine health check-up. The child appears well-nourished and is meeting developmental milestones appropriately. The pediatrician decides to administer a prophylactic dose of vitamin A as part of the National Program for the Prevention of Nutritional Blindness. Considering the child&#x27;s age and the national guidelines, what is the appropriate dose of vitamin A to be given?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;50,000 IU&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;1 Lakh IU&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;2 Lakh IU&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;2.5 lakh IU&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. 1 Lakh IU&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 For infants aged 9 completed months , the recommended prophylactic vitamin A dose is 100,000 IU . This initiative aims to reduce the risk of vitamin A deficiency , which can lead to xerophthalmia and an increased susceptibility to infections , contributing to child morbidity and mortality .&lt;/li&gt;&lt;li&gt;\u2022 infants aged 9 completed months&lt;/li&gt;&lt;li&gt;\u2022 prophylactic vitamin A dose is 100,000 IU&lt;/li&gt;&lt;li&gt;\u2022 initiative aims to reduce&lt;/li&gt;&lt;li&gt;\u2022 risk of vitamin A deficiency&lt;/li&gt;&lt;li&gt;\u2022 xerophthalmia&lt;/li&gt;&lt;li&gt;\u2022 increased susceptibility to infections&lt;/li&gt;&lt;li&gt;\u2022 child morbidity and mortality&lt;/li&gt;&lt;li&gt;\u2022 Educational objective:&lt;/li&gt;&lt;li&gt;\u2022 Educational objective:&lt;/li&gt;&lt;li&gt;\u2022 As per, NEW National Immunization Schedule (NIS) 2023-24&lt;/li&gt;&lt;li&gt;\u2022 As per, NEW National Immunization Schedule (NIS) 2023-24&lt;/li&gt;&lt;li&gt;\u2022 9 completed months \u2013 1 Lakh IU;&lt;/li&gt;&lt;li&gt;\u2022 9 completed months \u2013 1 Lakh IU;&lt;/li&gt;&lt;li&gt;\u2022 Every 6 months: 2 Lac IU (each dose) till 5 years\u2019 age of the child.&lt;/li&gt;&lt;li&gt;\u2022 Every 6 months: 2 Lac IU (each dose) till 5 years\u2019 age of the child.&lt;/li&gt;&lt;li&gt;\u2022 (In, total 17 Lac IU is given to a completely immunized child by 5 years of age)&lt;/li&gt;&lt;li&gt;\u2022 (In, total 17 Lac IU is given to a completely immunized child by 5 years of age)&lt;/li&gt;&lt;li&gt;\u2022 Ref : Nelson 21 st Edition page number 1926&lt;/li&gt;&lt;li&gt;\u2022 Ref : Nelson 21 st Edition page number 1926&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A pediatrician evaluates a 3-month-old infant brought in by the mother due to recurrent infections, persistent diarrhea, and notable skin lesions. Considering the clinical presentation, as shown in the images, which micronutrient deficiency is most commonly associated with these symptoms, and what is the recommended starting dosage for treatment?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Copper deficiency and 10 mg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Zinc deficiency and 20 mg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Copper deficiency and 20 mg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Zinc deficiency and 10 mg&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Zinc deficiency and 10 mg&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture30.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-153635.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Zinc deficiency and 10 mg.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The clinical presentation is highly suggestive of Acrodermatitis enteropathica , a rare genetic disorder resulting from the impaired absorption and metabolism of zinc , leading to its deficiency. This condition is characterized by dermatitis, alopecia, and diarrhea . The skin findings typically present around the body orifices and extremities, as shown in the image. The recommended treatment is zinc supplementation , which is usually given at a dose of 10 mg per day for &amp;lt;6 months\u2019 infants.&lt;/li&gt;&lt;li&gt;\u2022 Acrodermatitis enteropathica&lt;/li&gt;&lt;li&gt;\u2022 rare genetic disorder&lt;/li&gt;&lt;li&gt;\u2022 impaired absorption&lt;/li&gt;&lt;li&gt;\u2022 metabolism of zinc&lt;/li&gt;&lt;li&gt;\u2022 dermatitis, alopecia, and diarrhea&lt;/li&gt;&lt;li&gt;\u2022 treatment&lt;/li&gt;&lt;li&gt;\u2022 zinc supplementation&lt;/li&gt;&lt;li&gt;\u2022 dose of 10 mg per day for &amp;lt;6 months\u2019 infants.&lt;/li&gt;&lt;li&gt;\u2022 Acrodermatitis Enteropathica (AE)&lt;/li&gt;&lt;li&gt;\u2022 Acrodermatitis Enteropathica (AE)&lt;/li&gt;&lt;li&gt;\u2022 Autosomal recessive trait (Defect in SLC39A4 - encode hZIP4 protein) 5D\u2019s Dermatological changes, Diarrhea, Developmental impairment, Depression &amp;amp; death&lt;/li&gt;&lt;li&gt;\u2022 Autosomal recessive trait (Defect in SLC39A4 - encode hZIP4 protein)&lt;/li&gt;&lt;li&gt;\u2022 5D\u2019s Dermatological changes, Diarrhea, Developmental impairment, Depression &amp;amp; death&lt;/li&gt;&lt;li&gt;\u2022 Diagnosis &amp;amp; Treatment of Zinc deficiency&lt;/li&gt;&lt;li&gt;\u2022 Diagnosis &amp;amp; Treatment of Zinc deficiency&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Dosage of Zinc for diarrhea:&lt;/li&gt;&lt;li&gt;\u27a4 Dosage of Zinc for diarrhea:&lt;/li&gt;&lt;li&gt;\u27a4 &amp;lt;6 months of age \u2013 10 mg/day.&lt;/li&gt;&lt;li&gt;\u27a4 &amp;gt;6 months of age \u2013 20 mg/day.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page No 1854-1874&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page No 1854-1874&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 1-year-old infant is seen in a clinic in India with a history of difficulty walking and frequent falls. The infant was exclusively breastfed for the first six months and has had a diet primarily consisting of milk and cereal since then. According to the mother, the child has limited outdoor activities and is always fully covered when outside. Physical examination reveals bowed legs and tenderness in the lower limbs. An X-ray of the legs is performed, showing the characteristic changes as depicted in the provided radiograph. Based on the clinical history and the radiographic findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Iron deficiency anemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Vitamin D deficiency&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Calcium deficiency&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Hypophosphatemic rickets&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Vitamin D deficiency&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture31.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Vitamin D deficiency&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Iron deficiency anemia : Iron deficiency anemia may cause fatigue and pallor but is not associated with difficulty walking and radiographic findings of rickets, which are present in this case.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Iron deficiency anemia&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 cause fatigue and pallor&lt;/li&gt;&lt;li&gt;\u2022 Option C. Calcium deficiency: Calcium deficiency can lead to weakened bones , but it is not typically associated with the radiographic findings of rickets.&lt;/li&gt;&lt;li&gt;\u2022 Option C.&lt;/li&gt;&lt;li&gt;\u2022 Calcium deficiency:&lt;/li&gt;&lt;li&gt;\u2022 lead to weakened bones&lt;/li&gt;&lt;li&gt;\u2022 Option D. Hypophosphatemic rickets: Hypophosphatemic rickets is a genetic disorder that affects the renal phosphate reabsorption and is associated with decreased serum phosphate levels, which are not present in this case.&lt;/li&gt;&lt;li&gt;\u2022 Option D.&lt;/li&gt;&lt;li&gt;\u2022 Hypophosphatemic rickets:&lt;/li&gt;&lt;li&gt;\u2022 genetic disorder that affects the renal phosphate reabsorption&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The X-ray finding of rickets - widening , fraying , and irregularity of the metaphyses , commonly seen in the wrist and knee joints .&lt;/li&gt;&lt;li&gt;\u27a4 X-ray finding of rickets&lt;/li&gt;&lt;li&gt;\u27a4 widening&lt;/li&gt;&lt;li&gt;\u27a4 fraying&lt;/li&gt;&lt;li&gt;\u27a4 irregularity of the metaphyses&lt;/li&gt;&lt;li&gt;\u27a4 wrist and knee joints&lt;/li&gt;&lt;li&gt;\u27a4 The risk factors for vitamin D deficiency , including exclusive breastfeeding without supplementation , lack of sunlight exposure , and protective clothing practices that limit skin exposure to sunlight . Early recognition and treatment with vitamin D supplementation can prevent progression and complications associated with this condition.&lt;/li&gt;&lt;li&gt;\u27a4 risk factors for vitamin D deficiency&lt;/li&gt;&lt;li&gt;\u27a4 exclusive breastfeeding without supplementation&lt;/li&gt;&lt;li&gt;\u27a4 lack of sunlight exposure&lt;/li&gt;&lt;li&gt;\u27a4 protective clothing practices&lt;/li&gt;&lt;li&gt;\u27a4 limit skin exposure to sunlight&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page NO- 336- 340.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page NO- 336- 340.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-year-old child is brought to a healthcare facility with a presenting complaint of lethargy, irritability, and bleeding gums noted during tooth brushing. The dietary history taken from the parents reveals a restricted diet predominantly composed of carbohydrates and fats, with an absence of fresh fruits and vegetables for several months. On physical examination, the child has multiple petechiae and ecchymoses scattered across the skin. The gums are swollen, tender, and bleed upon slight manipulation. Laboratory tests show a hemoglobin level of 8.5 g/dL. Based on the child&#x27;s clinical presentation and nutritional history, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Iron deficiency anemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Vitamin D deficiency&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Vitamin C deficiency&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Folate deficiency anemia&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Vitamin C deficiency&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-153816.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-153816.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 Option A. Iron deficiency anemia: While the child&#x27;s hemoglobin level is low , the symptoms of lethargy and irritability could be consistent with anemia ; however, the bleeding gums and skin findings are more specific to vitamin C deficiency.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Iron deficiency anemia:&lt;/li&gt;&lt;li&gt;\u2022 child&#x27;s hemoglobin level is low&lt;/li&gt;&lt;li&gt;\u2022 lethargy and irritability&lt;/li&gt;&lt;li&gt;\u2022 consistent with anemia&lt;/li&gt;&lt;li&gt;\u2022 Option B. Vitamin D deficiency: This typically presents with bone-related symptoms and signs such as rickets , muscle weakness , or pain and does not usually cause bleeding disorders or anemia.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Vitamin D deficiency:&lt;/li&gt;&lt;li&gt;\u2022 bone-related symptoms&lt;/li&gt;&lt;li&gt;\u2022 signs such as rickets&lt;/li&gt;&lt;li&gt;\u2022 muscle weakness&lt;/li&gt;&lt;li&gt;\u2022 pain&lt;/li&gt;&lt;li&gt;\u2022 Option D. Folate deficiency anemia: Although folate deficiency can lead to anemia , it is not typically associated with bleeding gums or skin petechiae , which are indicative of a problem with blood vessel integrity or platelet function.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Folate deficiency anemia:&lt;/li&gt;&lt;li&gt;\u2022 folate deficiency can lead to anemia&lt;/li&gt;&lt;li&gt;\u2022 not&lt;/li&gt;&lt;li&gt;\u2022 associated with bleeding gums&lt;/li&gt;&lt;li&gt;\u2022 skin petechiae&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page No-329-331&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 20 th Edition, Page No-329-331&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 7-year-old boy is brought to the clinic by his mother due to concerns about delayed dentition and poor growth. The child&#x27;s diet is noted to be low in dairy products and vegetables. On physical examination, the boy is shorter than his peers, and his dentition is notably delayed. A wrist X-ray is performed, findings shown below. Based on the clinical features and radiographic findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Osteogenesis Imperfecta.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Scurvy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Rickets&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Osteopetrosis&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Rickets&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture32.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Rickets&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Osteogenesis Imperfecta: This condition is characterized by bone fragility and is typically diagnosed based on a history of frequent fractures and blue sclerae . Radiographs would show thin bones with multiple fracture sites, not the findings seen in the provided image.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Osteogenesis Imperfecta:&lt;/li&gt;&lt;li&gt;\u2022 bone fragility&lt;/li&gt;&lt;li&gt;\u2022 diagnosed based on a history of frequent fractures&lt;/li&gt;&lt;li&gt;\u2022 blue sclerae&lt;/li&gt;&lt;li&gt;\u2022 Option B. Scurvy: Caused by a deficiency of vitamin C , scurvy can lead to swollen , bleeding gums and bruising , but the radiographic signs would show &#x27;scorbutic rosaries&#x27; at the costochondral junctions, not the metaphyseal changes seen in rickets.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Scurvy:&lt;/li&gt;&lt;li&gt;\u2022 deficiency of vitamin C&lt;/li&gt;&lt;li&gt;\u2022 scurvy can lead to swollen&lt;/li&gt;&lt;li&gt;\u2022 bleeding gums&lt;/li&gt;&lt;li&gt;\u2022 bruising&lt;/li&gt;&lt;li&gt;\u2022 Option D. Osteopetrosis: This is a rare genetic disorder leading to abnormally dense bones , with radiographs showing increased bone density and bone within a bone appearance , which does not match the findings in the image.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Osteopetrosis:&lt;/li&gt;&lt;li&gt;\u2022 rare genetic disorder&lt;/li&gt;&lt;li&gt;\u2022 abnormally dense bones&lt;/li&gt;&lt;li&gt;\u2022 radiographs&lt;/li&gt;&lt;li&gt;\u2022 increased bone density&lt;/li&gt;&lt;li&gt;\u2022 bone within a bone appearance&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Differential Diagnosis \u2013 based on Radiological findings&lt;/li&gt;&lt;li&gt;\u27a4 Differential Diagnosis \u2013 based on Radiological findings&lt;/li&gt;&lt;li&gt;\u27a4 Rickets - Cupping and fraying of the metaphyses.&lt;/li&gt;&lt;li&gt;\u27a4 Rickets&lt;/li&gt;&lt;li&gt;\u27a4 Osteogenesis Imperfecta - Thin bones with multiple fracture&lt;/li&gt;&lt;li&gt;\u27a4 Osteogenesis Imperfecta&lt;/li&gt;&lt;li&gt;\u27a4 Scurvy - &#x27;Scorbutic rosaries&#x27; at the costochondral junctions&lt;/li&gt;&lt;li&gt;\u27a4 Scurvy&lt;/li&gt;&lt;li&gt;\u27a4 Osteopetrosis - Increased bone density and bone within a bone appearance&lt;/li&gt;&lt;li&gt;\u27a4 Osteopetrosis&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page NO- 336- 340.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page NO- 336- 340.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 6-year-old child presents to the pediatric clinic with symptoms of fatigue, weakness, easy bruisability, and bleeding gums. The parents report a dietary history that is heavily reliant on junk food, with a notable absence of fresh fruits and vegetables. An X-ray of the child\u2019s legs shows changes suggestive of a nutritional deficiency. What is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Scurvy&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Rickets&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Osteopetrosis&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Rheumatoid arthritis&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Scurvy&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture34.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Scurvy&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Rickets: This condition is related to vitamin D, calcium, or phosphate deficiency and would more commonly present with bone pain and skeletal deformities , not the soft tissue and vascular symptoms seen in scurvy.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Rickets:&lt;/li&gt;&lt;li&gt;\u2022 vitamin D, calcium, or phosphate deficiency&lt;/li&gt;&lt;li&gt;\u2022 present with bone pain&lt;/li&gt;&lt;li&gt;\u2022 skeletal deformities&lt;/li&gt;&lt;li&gt;\u2022 Option C. Osteopetrosis: Also known as &#x27;marble bone disease&#x27;, osteopetrosis is characterized by increased bone density and abnormal bone growth but does not cause easy bruising or gum bleeding.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Osteopetrosis:&lt;/li&gt;&lt;li&gt;\u2022 &#x27;marble bone disease&#x27;,&lt;/li&gt;&lt;li&gt;\u2022 increased bone density&lt;/li&gt;&lt;li&gt;\u2022 abnormal bone growth&lt;/li&gt;&lt;li&gt;\u2022 Option D. Rheumatoid arthritis: This autoimmune condition is rare in this age group and would typically present with joint swelling and pain , rather than bleeding and dietary deficiency.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Rheumatoid arthritis:&lt;/li&gt;&lt;li&gt;\u2022 autoimmune condition&lt;/li&gt;&lt;li&gt;\u2022 rare in this age group&lt;/li&gt;&lt;li&gt;\u2022 joint swelling and pain&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Scurvy (d/to vitamin C deficiency) - Radiological features include Wimberger\u2019s ring , White line of Frankel and Pelkan\u2019s spur .&lt;/li&gt;&lt;li&gt;\u27a4 Scurvy&lt;/li&gt;&lt;li&gt;\u27a4 Radiological&lt;/li&gt;&lt;li&gt;\u27a4 Wimberger\u2019s ring&lt;/li&gt;&lt;li&gt;\u27a4 White line of Frankel&lt;/li&gt;&lt;li&gt;\u27a4 Pelkan\u2019s spur&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page No-329-331&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 20 th Edition, Page No-329-331&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a family trip to Manali, a 10-month-old child is involved in a severe car accident, sustaining a head injury with significant bleeding after colliding with the rear-view mirror. Upon examination, the child exhibits cold extremities and an elevated pulse rate. Given the clinical scenario, what type of shock is most commonly expected in this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Septic shock&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hypovolemic shock&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Cardiogenic shock&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Anaphylactic shock&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Hypovolemic shock&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Hypovolemic shock&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Septic shock : This is the last and most severe stage of sepsis . Sepsis occurs when your immune system has an extreme reaction to an infection . The inflammation throughout your body can cause dangerously low blood pressure.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Septic shock&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 last and most severe stage of sepsis&lt;/li&gt;&lt;li&gt;\u2022 Sepsis&lt;/li&gt;&lt;li&gt;\u2022 immune system has an extreme reaction to an infection&lt;/li&gt;&lt;li&gt;\u2022 Option C. Cardiogenic shock: Cardiogenic shock takes place when the heart has been damaged so much that it is unable to supply enough blood and oxygen to the organs of the body .&lt;/li&gt;&lt;li&gt;\u2022 Option C. Cardiogenic shock:&lt;/li&gt;&lt;li&gt;\u2022 heart has been damaged so much&lt;/li&gt;&lt;li&gt;\u2022 unable to supply enough blood&lt;/li&gt;&lt;li&gt;\u2022 oxygen&lt;/li&gt;&lt;li&gt;\u2022 organs of the body&lt;/li&gt;&lt;li&gt;\u2022 Option D. Anaphylactic shock: Anaphylactic shock results from a severe allergic reaction . It causes blood pressure to drop and narrows your airway , making breathing difficult .&lt;/li&gt;&lt;li&gt;\u2022 Option D. Anaphylactic shock:&lt;/li&gt;&lt;li&gt;\u2022 severe allergic reaction&lt;/li&gt;&lt;li&gt;\u2022 causes blood pressure to drop&lt;/li&gt;&lt;li&gt;\u2022 narrows your airway&lt;/li&gt;&lt;li&gt;\u2022 .&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 Hypovolemic shock as the most likely type of shock in a child with significant blood loss due to trauma , characterized by symptoms such as cold extremities and tachycardia.&lt;/li&gt;&lt;li&gt;\u27a4 Hypovolemic shock&lt;/li&gt;&lt;li&gt;\u27a4 most likely type of shock&lt;/li&gt;&lt;li&gt;\u27a4 child&lt;/li&gt;&lt;li&gt;\u27a4 blood loss due to trauma&lt;/li&gt;&lt;li&gt;\u27a4 cold extremities&lt;/li&gt;&lt;li&gt;\u27a4 tachycardia.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page number 2720&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition page number 2720&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;As you are concluding your shift, a junior resident requests you to collect one final arterial blood gas (ABG) sample for the day, hinting at the possibility of metabolic abnormalities, along with elevated osmolality and an increased anion gap. Which of the following conditions is most likely associated with these findings? Diarrhea Distal renal tubular acidosis Ammonium chloride intake Urinary tract diversion Methanol poisoning&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;All are correct&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;B, C, D and E are correct&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;D and E are correct&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Only E is correct&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Only E is correct&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Only E is correct&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 A. Diarrhea: This typically leads to non-anion gap (hyperchloremic) metabolic acidosis due to the loss of bicarbonate in stool rather than an anion gap acidosis. Osmolality is not typically affected to the degree seen in methanol poisoning.&lt;/li&gt;&lt;li&gt;\u2022 A. Diarrhea:&lt;/li&gt;&lt;li&gt;\u2022 leads to non-anion gap&lt;/li&gt;&lt;li&gt;\u2022 metabolic acidosis&lt;/li&gt;&lt;li&gt;\u2022 loss of bicarbonate in stool&lt;/li&gt;&lt;li&gt;\u2022 B. Distal Renal Tubular Acidosis (Type 1 RTA): This condition results in non-anion gap metabolic acidosis due to the kidney&#x27;s inability to acidify urine . It does not typically cause an increased osmolality or a high anion gap.&lt;/li&gt;&lt;li&gt;\u2022 B. Distal Renal Tubular Acidosis (Type 1 RTA):&lt;/li&gt;&lt;li&gt;\u2022 non-anion gap metabolic acidosis&lt;/li&gt;&lt;li&gt;\u2022 kidney&#x27;s inability to acidify urine&lt;/li&gt;&lt;li&gt;\u2022 C. Ammonium Chloride Intake: This can cause non-anion gap metabolic acidosis by providing an acid load , but it does not lead to increased osmolality or a high anion gap.&lt;/li&gt;&lt;li&gt;\u2022 C. Ammonium Chloride Intake:&lt;/li&gt;&lt;li&gt;\u2022 cause non-anion gap metabolic acidosis&lt;/li&gt;&lt;li&gt;\u2022 acid load&lt;/li&gt;&lt;li&gt;\u2022 D. Urinary Tract Diversion: This can lead to metabolic acidosis due to the absorption of urinary ammonium and chloride ions , but it usually presents as hyperchloremic metabolic acidosis without a significant increase in osmolality or anion gap.&lt;/li&gt;&lt;li&gt;\u2022 D. Urinary Tract Diversion:&lt;/li&gt;&lt;li&gt;\u2022 metabolic acidosis&lt;/li&gt;&lt;li&gt;\u2022 absorption of urinary ammonium&lt;/li&gt;&lt;li&gt;\u2022 chloride ions&lt;/li&gt;&lt;li&gt;\u2022 presents as hyperchloremic metabolic acidosis&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Methanol poisoning&#x27;s unique presentation with high anion gap metabolic acidosis and elevated osmolality . Understanding the different causes of metabolic acidosis , including those that affect the anion gap and osmolality , is crucial for diagnosing and managing various metabolic disturbances . Methanol poisoning requires prompt recognition and treatment to prevent severe toxicity and complications.&lt;/li&gt;&lt;li&gt;\u27a4 Methanol poisoning&#x27;s unique presentation&lt;/li&gt;&lt;li&gt;\u27a4 high anion gap metabolic acidosis&lt;/li&gt;&lt;li&gt;\u27a4 elevated osmolality&lt;/li&gt;&lt;li&gt;\u27a4 different causes of metabolic acidosis&lt;/li&gt;&lt;li&gt;\u27a4 affect the anion gap&lt;/li&gt;&lt;li&gt;\u27a4 osmolality&lt;/li&gt;&lt;li&gt;\u27a4 diagnosing&lt;/li&gt;&lt;li&gt;\u27a4 managing various metabolic disturbances&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition, Page No-83.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : OP Ghai 9 th Edition, Page No-83.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 6-year-old boy is brought to the emergency department, following a road traffic accident. The child was found bleeding and unresponsive at the scene. On examination, the medical team notes pallor, a rapid pulse, and delayed capillary refill. The child&#x27;s blood pressure is low, and he is not responding to verbal commands. A diagnosis of hypovolemic shock is made, and immediate resuscitation is initiated. Which of the following statements is correct regarding the signs of shock in this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Tachycardia is a very sensitive indicator of depletion of intravascular volume&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Mottling of extremities is seen in early shock&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Confusion, stupor and coma are early signs&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Respiratory rate is more sensitive than heart rate indicator of early shock&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Tachycardia is a very sensitive indicator of depletion of intravascular volume&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-153454.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-153454.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Tachycardia is a very sensitive indicator of depletion of intravascular volume.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 Option B. Mottling of extremities is a sign that can be seen in shock but is more indicative of severe or late-stage shock rather than early shock. It reflects poor perfusion and can indicate a progression towards more severe circulatory compromise.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Mottling of extremities&lt;/li&gt;&lt;li&gt;\u2022 sign that can be seen in shock&lt;/li&gt;&lt;li&gt;\u2022 severe or late-stage shock&lt;/li&gt;&lt;li&gt;\u2022 Option C. Confusion, stupor, and coma are not early signs of shock ; rather, they indicate a more advanced stage of shock, where decreased cerebral perfusion leads to altered mental status.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Confusion, stupor, and coma are not early signs&lt;/li&gt;&lt;li&gt;\u2022 shock&lt;/li&gt;&lt;li&gt;\u2022 Option D. While the respiratory rate can increase in shock as part of the body&#x27;s compensatory mechanism to maintain oxygenation and offload carbon dioxide , it is less sensitive than heart rate as an indicator of early shock in children. Tachycardia is generally recognized as a more sensitive and earlier marker of shock than changes in respiratory rate.&lt;/li&gt;&lt;li&gt;\u2022 Option D. While the respiratory&lt;/li&gt;&lt;li&gt;\u2022 increase in shock as part of the body&#x27;s compensatory mechanism&lt;/li&gt;&lt;li&gt;\u2022 maintain oxygenation&lt;/li&gt;&lt;li&gt;\u2022 offload carbon dioxide&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition, Page No-728.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : OP Ghai 9 th Edition, Page No-728.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following diseases with their respective radiological changes:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A2 B4 C3 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A1 B2 C3 D4&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A1 B2 C4 D3&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. A2 B3 C4 D1&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-154002.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/screenshot-2024-03-20-154121_8hfmJhJ.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) A2 B3 C4 D1&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Wimberger\u2019s ring: A classic radiologic sign seen in Scurvy , representing a ring of calcification surrounding an epiphyseal ossification center.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Wimberger\u2019s ring:&lt;/li&gt;&lt;li&gt;\u2022 classic radiologic sign&lt;/li&gt;&lt;li&gt;\u2022 Scurvy&lt;/li&gt;&lt;li&gt;\u2022 ring of calcification&lt;/li&gt;&lt;li&gt;\u2022 Option C. Sclerosis of bones : A characteristic feature of Osteopetrosis , a condition also known as marble bone disease , where the bones become overly dense and structurally abnormal.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Sclerosis of bones&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 Osteopetrosis&lt;/li&gt;&lt;li&gt;\u2022 marble bone disease&lt;/li&gt;&lt;li&gt;\u2022 Option D. Multiple healing fractures: A hallmark of Osteogenesis Imperfecta , a genetic disorder characterized by bones that fracture easily , often with minimal or no apparent cause.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Multiple healing fractures:&lt;/li&gt;&lt;li&gt;\u2022 Osteogenesis Imperfecta&lt;/li&gt;&lt;li&gt;\u2022 genetic disorder&lt;/li&gt;&lt;li&gt;\u2022 bones&lt;/li&gt;&lt;li&gt;\u2022 fracture easily&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page number 1983&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition page number 1983&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 5-year-old child presents with a continuous fever, signs of sepsis, a blood pressure of 90/60 mm Hg, a pulse rate of 144/min, and a respiratory rate of 30/min. Considering the initial management of this child, what is the fluid of choice?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;10 mL/kg of 10% dextrose&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;10 mL/kg of 5% dextrose&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;20 mL/kg of 0.45% normal saline&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;20 mL/kg of 0.9% normal saline&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. 20 mL/kg of 0.9% normal saline&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) 20 mL/kg of 0.9% normal saline&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 In a septic child presenting with signs of shock , the initial fluid of choice for resuscitation is isotonic saline . A bolus of 20 mL/kg of 0.9% normal saline is recommended to restore circulating volume and improve hemodynamics .&lt;/li&gt;&lt;li&gt;\u2022 septic child&lt;/li&gt;&lt;li&gt;\u2022 signs of shock&lt;/li&gt;&lt;li&gt;\u2022 initial fluid of choice for resuscitation is isotonic saline&lt;/li&gt;&lt;li&gt;\u2022 bolus of 20 mL/kg&lt;/li&gt;&lt;li&gt;\u2022 0.9% normal saline&lt;/li&gt;&lt;li&gt;\u2022 restore circulating volume&lt;/li&gt;&lt;li&gt;\u2022 improve hemodynamics&lt;/li&gt;&lt;li&gt;\u2022 Management of Shock in Children&lt;/li&gt;&lt;li&gt;\u2022 Management of Shock in Children&lt;/li&gt;&lt;li&gt;\u2022 First step in the management is insertion of two large-bore peripheral IV catheters and prompt administration of crystalloids . Either normal saline or ringer lactate solution is given at 20 mL/kg until perfusion , tachycardia &amp;amp; hypotension resolve If vitals do not improve even after the administration of 60 mL/kg of crystalloid, myocardial dysfunction is likely and inotropes such as dopamine or norepinephrine should be given. Phosphodiesterase inhibitors (milrinone, amrinone) improve contractility , facilitate diastolic relaxation &amp;amp; decrease SVR . Endogenous vasopressin levels decrease during vasodilatory septic shock &amp;amp; administration of low-dose vasopressin (0.02\u20130.04 unit/ min) restores SVR Metabolic acidosis &amp;amp; elevated lactate levels occur secondary to tissue hypoperfusion; however, administration of sodium bicarbonate has not been shown to decrease morbidity or mortality. Rather, the base deficit &amp;amp; serum lactate is used to monitor the adequacy of resuscitation. Calcium &amp;amp; potassium ions are integral to conduction &amp;amp; contractility of myocardium &amp;amp; their levels must be monitored &amp;amp; supplemented as needed&lt;/li&gt;&lt;li&gt;\u2022 First step in the management is insertion of two large-bore peripheral IV catheters and prompt administration of crystalloids .&lt;/li&gt;&lt;li&gt;\u2022 First step in the management&lt;/li&gt;&lt;li&gt;\u2022 insertion of two large-bore peripheral IV catheters&lt;/li&gt;&lt;li&gt;\u2022 prompt administration of crystalloids&lt;/li&gt;&lt;li&gt;\u2022 Either normal saline or ringer lactate solution is given at 20 mL/kg until perfusion , tachycardia &amp;amp; hypotension resolve&lt;/li&gt;&lt;li&gt;\u2022 normal saline&lt;/li&gt;&lt;li&gt;\u2022 ringer lactate solution&lt;/li&gt;&lt;li&gt;\u2022 20 mL/kg until perfusion&lt;/li&gt;&lt;li&gt;\u2022 tachycardia&lt;/li&gt;&lt;li&gt;\u2022 hypotension resolve&lt;/li&gt;&lt;li&gt;\u2022 If vitals do not improve even after the administration of 60 mL/kg of crystalloid, myocardial dysfunction is likely and inotropes such as dopamine or norepinephrine should be given.&lt;/li&gt;&lt;li&gt;\u2022 Phosphodiesterase inhibitors (milrinone, amrinone) improve contractility , facilitate diastolic relaxation &amp;amp; decrease SVR .&lt;/li&gt;&lt;li&gt;\u2022 Phosphodiesterase inhibitors&lt;/li&gt;&lt;li&gt;\u2022 improve contractility&lt;/li&gt;&lt;li&gt;\u2022 diastolic relaxation&lt;/li&gt;&lt;li&gt;\u2022 decrease SVR&lt;/li&gt;&lt;li&gt;\u2022 Endogenous vasopressin levels decrease during vasodilatory septic shock &amp;amp; administration of low-dose vasopressin (0.02\u20130.04 unit/ min) restores SVR&lt;/li&gt;&lt;li&gt;\u2022 Endogenous vasopressin levels decrease during vasodilatory septic shock&lt;/li&gt;&lt;li&gt;\u2022 administration of low-dose vasopressin&lt;/li&gt;&lt;li&gt;\u2022 Metabolic acidosis &amp;amp; elevated lactate levels occur secondary to tissue hypoperfusion; however, administration of sodium bicarbonate has not been shown to decrease morbidity or mortality.&lt;/li&gt;&lt;li&gt;\u2022 Rather, the base deficit &amp;amp; serum lactate is used to monitor the adequacy of resuscitation.&lt;/li&gt;&lt;li&gt;\u2022 Calcium &amp;amp; potassium ions are integral to conduction &amp;amp; contractility of myocardium &amp;amp; their levels must be monitored &amp;amp; supplemented as needed&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The initial management of septic shock in children , emphasizing the use of isotonic saline (0.9% normal saline) for fluid resuscitation . The goal is to restore circulating volume and improve hemodynamic stability , distinguishing the use of isotonic solutions from dextrose-containing solutions which are more appropriate for correcting hypoglycemia.&lt;/li&gt;&lt;li&gt;\u27a4 initial management of septic shock in children&lt;/li&gt;&lt;li&gt;\u27a4 use of isotonic saline&lt;/li&gt;&lt;li&gt;\u27a4 fluid resuscitation&lt;/li&gt;&lt;li&gt;\u27a4 restore circulating volume&lt;/li&gt;&lt;li&gt;\u27a4 improve hemodynamic stability&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition, Page No-289&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai 9 th Edition, Page No-289&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;You are counseling a group of new parents about the nutritional needs of their infants. One parent asks about the daily potassium requirement for their healthy child, who is under 2 years of age and receives a mix of breastfeeding, solid foods, and formula feeding to ensure a balanced intake of vitamins and minerals. Based on the child&#x27;s dietary regimen, what is the recommended daily potassium intake for this age group?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;1-2 mEq/kg&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;4-7mEq/kg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;10-12mEq/kg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;13-14mEq/kg&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. 1-2 mEq/kg&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) 1-2 mEq/kg&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 For a healthy child under 2 years of age who is receiving a well-rounded diet including breastfeeding , solid foods , and formula , the recommended daily potassium intake is 1-2 mEq/kg . This range accounts for the potassium needs for normal growth , cellular function , and the maintenance of electrolyte balance and acid-base homeostasis in the body . It is designed to match the intake with the physiological requirements of infants and young children in this age group, considering their rapid growth and development.&lt;/li&gt;&lt;li&gt;\u2022 healthy child under 2 years of age&lt;/li&gt;&lt;li&gt;\u2022 well-rounded diet&lt;/li&gt;&lt;li&gt;\u2022 breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 solid foods&lt;/li&gt;&lt;li&gt;\u2022 formula&lt;/li&gt;&lt;li&gt;\u2022 daily potassium intake is 1-2 mEq/kg&lt;/li&gt;&lt;li&gt;\u2022 range accounts for the potassium&lt;/li&gt;&lt;li&gt;\u2022 normal growth&lt;/li&gt;&lt;li&gt;\u2022 cellular function&lt;/li&gt;&lt;li&gt;\u2022 maintenance of electrolyte balance&lt;/li&gt;&lt;li&gt;\u2022 acid-base homeostasis in the body&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective&lt;/li&gt;&lt;li&gt;\u27a4 Recommended dietary requirement of potassium is 1-2 mEq/kg&lt;/li&gt;&lt;li&gt;\u27a4 dietary requirement of potassium is 1-2 mEq/kg&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Edition.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : OP Ghai 9 th Edition.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-year-old boy presents with a limp and localized leg pain worsening over two months. Examination reveals swelling in the mid-tibia without erythema or warmth. The X-ray finding shows below; and biopsy findings include cells with grooved nuclei, giant cells, and fibroblastic proliferation. What is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Langerhans cell histiocytosis.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Giant cell tumor&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Chondroblastoma&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Osteoid osteoma&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Langerhans cell histiocytosis.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/20/picture33.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Langerhans cell histiocytosis.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Giant cell tumor: This is more common in the epiphyseal region of long bones in young adults , not typically seen in children, and would usually present as a lytic lesion without the characteristic histological findings of LCH.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Giant cell tumor:&lt;/li&gt;&lt;li&gt;\u2022 more common in the epiphyseal region of long bones&lt;/li&gt;&lt;li&gt;\u2022 young adults&lt;/li&gt;&lt;li&gt;\u2022 Option C. Chondroblastoma: Typically occurring in the epiphyseal plate of the long bones during childhood and adolescence , but the histological description does not match that of chondroblastoma.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Chondroblastoma:&lt;/li&gt;&lt;li&gt;\u2022 epiphyseal plate of the long bones&lt;/li&gt;&lt;li&gt;\u2022 childhood&lt;/li&gt;&lt;li&gt;\u2022 adolescence&lt;/li&gt;&lt;li&gt;\u2022 Option D. Osteoid osteoma: This benign bone tumor usually presents with nocturnal pain that relieves with NSAIDs and would not show the histological features of LCH.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Osteoid osteoma:&lt;/li&gt;&lt;li&gt;\u2022 benign bone tumor&lt;/li&gt;&lt;li&gt;\u2022 nocturnal pain&lt;/li&gt;&lt;li&gt;\u2022 relieves with NSAIDs&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Langerhans cell histiocytosis can present with a variety of symptoms depending on the organ involved , and when affecting the bone , it can lead to localized pain , swelling , and lesions that appear lytic on X-ray . Recognizing the unique histological features of Langerhans cells is critical for a definitive diagnosis.&lt;/li&gt;&lt;li&gt;\u27a4 Langerhans cell histiocytosis&lt;/li&gt;&lt;li&gt;\u27a4 present with a variety of symptoms&lt;/li&gt;&lt;li&gt;\u27a4 organ involved&lt;/li&gt;&lt;li&gt;\u27a4 affecting the bone&lt;/li&gt;&lt;li&gt;\u27a4 lead to localized pain&lt;/li&gt;&lt;li&gt;\u27a4 swelling&lt;/li&gt;&lt;li&gt;\u27a4 lesions that appear lytic on X-ray&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page number 10,626&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition page number 10,626&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 4-year-old girl is brought to the clinic by her mother due to excessive thirst and frequent urination for the past month. The child&#x27;s physical examination reveals no significant abnormalities except for mild dehydration. Laboratory tests show low serum potassium levels, hypercalciuria, and metabolic alkalosis. Given these findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Gitelman syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Liddle syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Bartter syndrome&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Alport\u2019s syndrome&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Bartter syndrome&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Bartter syndrome.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A . Gitelman syndrome will have the features of hypokalemic metabolic alkalosis , hypocalciuria and hypomagnesemia.&lt;/li&gt;&lt;li&gt;\u2022 Option A&lt;/li&gt;&lt;li&gt;\u2022 Gitelman syndrome&lt;/li&gt;&lt;li&gt;\u2022 hypokalemic metabolic alkalosis&lt;/li&gt;&lt;li&gt;\u2022 hypocalciuria&lt;/li&gt;&lt;li&gt;\u2022 hypomagnesemia.&lt;/li&gt;&lt;li&gt;\u2022 Option B . Liddle Syndrome will have the features of hypertension with hypokalemia and suppressed aldosterone&lt;/li&gt;&lt;li&gt;\u2022 Option B&lt;/li&gt;&lt;li&gt;\u2022 Liddle Syndrome&lt;/li&gt;&lt;li&gt;\u2022 hypertension&lt;/li&gt;&lt;li&gt;\u2022 hypokalemia&lt;/li&gt;&lt;li&gt;\u2022 suppressed aldosterone&lt;/li&gt;&lt;li&gt;\u2022 Option D. Alport syndrome will have the features of Asymptomatic intermittent microscopic hematuria .&lt;/li&gt;&lt;li&gt;\u2022 Option D.&lt;/li&gt;&lt;li&gt;\u2022 Alport syndrome&lt;/li&gt;&lt;li&gt;\u2022 features of Asymptomatic intermittent microscopic hematuria&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 Bartter syndrome results from defects in the renal tubular function , leading to increased excretion of potassium and chloride , which in turn causes the observed electrolyte imbalances and metabolic disturbances .&lt;/li&gt;&lt;li&gt;\u27a4 Bartter syndrome&lt;/li&gt;&lt;li&gt;\u27a4 defects in the renal tubular function&lt;/li&gt;&lt;li&gt;\u27a4 increased excretion of potassium and chloride&lt;/li&gt;&lt;li&gt;\u27a4 observed electrolyte imbalances&lt;/li&gt;&lt;li&gt;\u27a4 metabolic disturbances&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page number 10861&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition page number 10861&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 30 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

