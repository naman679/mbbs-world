&lt;option value=&quot;marked&quot;&gt;Marked for Review&lt;/option&gt;
&lt;/select&gt;
&lt;/div&gt;
&lt;div class=&quot;grid grid-cols-5 gap-2 md:gap-3&quot; id=&quot;nav-grid&quot;&gt;&lt;/div&gt;
&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- Results Navigation Panel --&gt;
&lt;div class=&quot;fixed inset-y-0 right-0 results-nav-panel bg-white shadow-lg p-4 hidden overflow-y-auto&quot; id=&quot;results-nav-panel&quot;&gt;
&lt;h2 class=&quot;text-lg font-semibold mb-4&quot;&gt;Results Navigation&lt;/h2&gt;
&lt;div class=&quot;mb-4&quot;&gt;
&lt;select class=&quot;w-full p-2 border rounded-lg text-gray-700&quot; id=&quot;results-nav-filter&quot;&gt;
&lt;option value=&quot;all&quot;&gt;All Questions&lt;/option&gt;
&lt;option value=&quot;answered&quot;&gt;Answered&lt;/option&gt;
&lt;option value=&quot;unanswered&quot;&gt;Unanswered&lt;/option&gt;
&lt;option value=&quot;marked&quot;&gt;Marked for Review&lt;/option&gt;
&lt;/select&gt;
&lt;/div&gt;
&lt;div class=&quot;grid grid-cols-5 gap-2 md:gap-3&quot; id=&quot;results-nav-grid&quot;&gt;&lt;/div&gt;
&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-results-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;A mother brings her child with features of multiple teeth and a soft skull. On examination, the child is able to touch his both shoulder joints. On further evaluation, he is found to have defective membranous ossification. The images of his findings are given below. What is your diagnosis based on the features?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Chondro-osteodystrophy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Shoulder Dislocation&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Cleidocranial dysostosis&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Osteogenesis Imperfecta&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Cleidocranial dysostosis&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture5_88c0u6E.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C. Cleidocranial dysostosis&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Chondro-osteodystrophy: This term is not commonly used in clinical practice and does not specifically match the features described in the scenario.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A:&lt;/li&gt;&lt;li&gt;\u2022 Chondro-osteodystrophy:&lt;/li&gt;&lt;li&gt;\u2022 term is not commonly used in clinical practice&lt;/li&gt;&lt;li&gt;\u2022 Option B: Shoulder Dislocation: While the ability to touch the shoulder joints together might suggest joint laxity , the systemic features of multiple teeth and a soft skull are not consistent with a simple shoulder dislocation.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Shoulder Dislocation:&lt;/li&gt;&lt;li&gt;\u2022 ability to touch the shoulder joints together&lt;/li&gt;&lt;li&gt;\u2022 joint laxity&lt;/li&gt;&lt;li&gt;\u2022 systemic features&lt;/li&gt;&lt;li&gt;\u2022 multiple teeth&lt;/li&gt;&lt;li&gt;\u2022 soft skull&lt;/li&gt;&lt;li&gt;\u2022 Option D: Osteogenesis Imperfecta: This condition is primarily characterized by brittle bones that fracture easily , which is not described in the provided scenario.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Osteogenesis Imperfecta:&lt;/li&gt;&lt;li&gt;\u2022 primarily characterized by brittle bones&lt;/li&gt;&lt;li&gt;\u2022 fracture easily&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Cleidocranial dysostosis/ cleidocranial dysplasia , is a rare genetic (autosomal dominant) associated with mutations in the RUNX2 gene , which plays a critical role in bone development and ossification .&lt;/li&gt;&lt;li&gt;\u27a4 Cleidocranial dysostosis/ cleidocranial dysplasia&lt;/li&gt;&lt;li&gt;\u27a4 rare genetic&lt;/li&gt;&lt;li&gt;\u27a4 mutations in the RUNX2 gene&lt;/li&gt;&lt;li&gt;\u27a4 bone development and ossification&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st EDITION page 14389&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 - Nelson 21 st EDITION page 14389&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 4-year-old child is brought to the clinic by their mother due to pain in the right hip and difficulty walking. Physical examination reveals no significant external abnormalities. An X-ray of the hip is performed, showing increased bone density and abnormal bone structure. Based on the clinical presentation and the radiographic findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Osteopetrosis&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Paget\u2019s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Marble bone disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Both A and C&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Both A and C&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture7_62YQqVU.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D. Both A and C&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Osteopetrosis: This option is correct as osteopetrosis presents with increased bone density, which can lead to symptoms like pain and movement difficulties.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Osteopetrosis:&lt;/li&gt;&lt;li&gt;\u2022 correct&lt;/li&gt;&lt;li&gt;\u2022 Option B: Paget\u2019s disease: Paget&#x27;s disease typically affects older adults and is characterized by abnormal bone remodelling , leading to enlarged and misshapen bones. It is less likely to be the cause of symptoms in a 4-year-old.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Paget\u2019s disease:&lt;/li&gt;&lt;li&gt;\u2022 affects older adults&lt;/li&gt;&lt;li&gt;\u2022 abnormal bone remodelling&lt;/li&gt;&lt;li&gt;\u2022 Option C: Marble bone disease: This is another name for osteopetrosis, making this option also correct . The condition is named for the marble-like appearance of bones on an X-ray due to their increased density.&lt;/li&gt;&lt;li&gt;\u2022 Option C: Marble bone disease:&lt;/li&gt;&lt;li&gt;\u2022 correct&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Osteopetrosis , also known as Marble Bone Disease , is characterized by increased bone density due to a defect in osteoclast-mediated bone resorption . This leads to bones that are denser but more brittle , which can cause pain and difficulty in movement , such as walking .&lt;/li&gt;&lt;li&gt;\u27a4 Osteopetrosis&lt;/li&gt;&lt;li&gt;\u27a4 Marble Bone Disease&lt;/li&gt;&lt;li&gt;\u27a4 increased bone density&lt;/li&gt;&lt;li&gt;\u27a4 defect in osteoclast-mediated bone resorption&lt;/li&gt;&lt;li&gt;\u27a4 leads to bones&lt;/li&gt;&lt;li&gt;\u27a4 denser but more brittle&lt;/li&gt;&lt;li&gt;\u27a4 cause pain&lt;/li&gt;&lt;li&gt;\u27a4 difficulty in movement&lt;/li&gt;&lt;li&gt;\u27a4 walking&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No-3375-3376.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 - Nelson 20 th Edition, Page No-3375-3376.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her child with features of fever, swelling and pain during movement of leg. On physical examination, signs of inflammation were present. CBC examination reveals the increased levels of neutrophils along with a microcytic anaemia. A case of osteomyelitis is suspected. On taking history, the child is found to have sickle cell disease. Which of the following organisms is responsible for osteomyelitis in this case?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Streptococcus pyogenes&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Staphylococcus aureus&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Pseudomonas&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Salmonella enteritidis&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Salmonella enteritidis&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Salmonella enteritidis&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Streptococcus pyogenes: While this organism can cause osteomyelitis , it is less commonly associated with osteomyelitis in patients with sickle cell disease compared to Salmonella species.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Streptococcus pyogenes:&lt;/li&gt;&lt;li&gt;\u2022 organism can cause osteomyelitis&lt;/li&gt;&lt;li&gt;\u2022 Option B. Staphylococcus aureus: Although S. aureus is the most common cause of osteomyelitis overall, in the context of sickle cell disease, Salmonella species are more commonly implicated.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Staphylococcus aureus:&lt;/li&gt;&lt;li&gt;\u2022 common cause of osteomyelitis&lt;/li&gt;&lt;li&gt;\u2022 Option C. Pseudomonas: This organism is more commonly associated with osteomyelitis in IV drug users , individuals with puncture wounds or those who are immunocompromised, but not specifically in sickle cell disease.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Pseudomonas:&lt;/li&gt;&lt;li&gt;\u2022 organism&lt;/li&gt;&lt;li&gt;\u2022 commonly associated with osteomyelitis in IV drug users&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Organisms responsible for osteomyelitis are:&lt;/li&gt;&lt;li&gt;\u27a4 In normal population - Staphylococcus aureus In sickle cell patients - Salmonella enteritidis is the M/C cause.&lt;/li&gt;&lt;li&gt;\u27a4 In normal population - Staphylococcus aureus&lt;/li&gt;&lt;li&gt;\u27a4 normal population&lt;/li&gt;&lt;li&gt;\u27a4 Staphylococcus aureus&lt;/li&gt;&lt;li&gt;\u27a4 In sickle cell patients - Salmonella enteritidis is the M/C cause.&lt;/li&gt;&lt;li&gt;\u27a4 sickle cell patients&lt;/li&gt;&lt;li&gt;\u27a4 Salmonella enteritidis&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition page 6044&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 - Nelson 21 st Edition page 6044&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 8-year-old boy is brought to the clinic by his mother, who is concerned about his difficulty climbing stairs and combing his hair. Upon physical examination, the boy&#x27;s bilateral calves are noted to be hypertrophic (swollen). The child utilizes his hands to push on his legs to stand up, which resembles him climbing up on himself. Given these clinical findings, what is the next step in diagnosing the condition in this child?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Creatine kinase levels&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;EMG&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Nerve conduction velocity&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;RA factor&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Creatine kinase levels&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A. Creatine kinase levels&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Electromyography (EMG): While EMG can help assess the health of muscles and the nerve cells that control them , it is not the initial diagnostic test for suspected muscular dystrophy.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Electromyography (EMG):&lt;/li&gt;&lt;li&gt;\u2022 help assess the health of muscles&lt;/li&gt;&lt;li&gt;\u2022 nerve cells that control them&lt;/li&gt;&lt;li&gt;\u2022 Option C: Nerve conduction velocity (NCV): This test measures how fast an electrical signal can travel through a nerve and would be more appropriate if a nerve disorder was suspected, not a primary muscle disorder.&lt;/li&gt;&lt;li&gt;\u2022 Option C: Nerve conduction velocity (NCV):&lt;/li&gt;&lt;li&gt;\u2022 fast an electrical signal can travel through a nerve&lt;/li&gt;&lt;li&gt;\u2022 Option D: Rheumatoid factor (RA factor): This test is used to help diagnose rheumatoid arthritis , not muscular dystrophy.&lt;/li&gt;&lt;li&gt;\u2022 Option D: Rheumatoid factor (RA factor):&lt;/li&gt;&lt;li&gt;\u2022 used to help diagnose rheumatoid arthritis&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Duchenne muscular dystrophy (DMD) is one of the most severe forms of inherited muscular dystrophies . It is the most common hereditary neuromuscular disease and does not exhibit a predilection for any race or ethnic group . Mutations in the dystrophin gene lead to progressive muscle fibre degeneration and weakness.&lt;/li&gt;&lt;li&gt;\u27a4 Duchenne muscular dystrophy&lt;/li&gt;&lt;li&gt;\u27a4 most severe forms of inherited muscular dystrophies&lt;/li&gt;&lt;li&gt;\u27a4 common hereditary neuromuscular disease&lt;/li&gt;&lt;li&gt;\u27a4 does not exhibit a predilection&lt;/li&gt;&lt;li&gt;\u27a4 race or ethnic group&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No- 2976 to 2977.&lt;/li&gt;&lt;li&gt;\u27a4 Ref -&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No- 2976 to 2977.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her child Ramini to the clinic, reporting weakness in the lower limbs, with the child being unable to stand up from a sitting position. Upon examination, a positive Gower\u2019s sign is noted, and further evaluation reveals elevated creatine phosphokinase (CPK) levels. Considering the clinical findings and history provided, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Myotonic dystrophy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Spinal Muscular atrophy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Myotonia dystrophica congenita&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Duchenne muscular dystrophy&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Duchenne muscular dystrophy&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture12.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D. Duchenne muscular dystrophy&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Myotonic dystrophy: This is a different form of muscular dystrophy that typically includes myotonia (difficulty relaxing muscles) and would not usually present with a positive Gower&#x27;s sign as an early symptom.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Myotonic dystrophy:&lt;/li&gt;&lt;li&gt;\u2022 different form of muscular dystrophy&lt;/li&gt;&lt;li&gt;\u2022 myotonia&lt;/li&gt;&lt;li&gt;\u2022 Option B: Spinal Muscular atrophy: While this condition also leads to muscle weakness , it does not typically present with elevated CPK levels and Gower\u2019s sign.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Spinal Muscular atrophy:&lt;/li&gt;&lt;li&gt;\u2022 leads to muscle weakness&lt;/li&gt;&lt;li&gt;\u2022 Option C: Myotonia dystrophica congenita: This term is not commonly used; congenital myotonic dystrophy might present early in life but with different clinical features and not typically with a positive Gower\u2019s sign.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C: Myotonia dystrophica congenita:&lt;/li&gt;&lt;li&gt;\u2022 congenital myotonic dystrophy&lt;/li&gt;&lt;li&gt;\u2022 present early in life&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The child&#x27;s difficulty standing up from a sitting position , demonstrated by a positive Gower\u2019s sign , along with elevated CPK levels , is characteristic of Duchenne muscular dystrophy (DMD)&lt;/li&gt;&lt;li&gt;\u27a4 child&#x27;s difficulty standing up&lt;/li&gt;&lt;li&gt;\u27a4 sitting position&lt;/li&gt;&lt;li&gt;\u27a4 positive Gower\u2019s sign&lt;/li&gt;&lt;li&gt;\u27a4 elevated CPK levels&lt;/li&gt;&lt;li&gt;\u27a4 Duchenne muscular dystrophy&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No- 2976 to 2977.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 -&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 20 th Edition, Page No- 2976 to 2977.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 3-year-old girl is brought to the pediatric department by her mother, who is concerned about the child&#x27;s delayed developmental milestones, hypermobility, and frequent dislocations of her shoulders and knees. Upon examination, the pediatrician also notes decreased visual acuity and suspects a condition related to a protein defect with an autosomal dominant inheritance pattern. Which of the following statements about the suspected disease is NOT true?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;It is due to the mutation in the gene responsible for collagen&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Superotemporal dislocation of lens can be seen&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Child will present with features of tall stature and joint hypermobility&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Can be associated with Cardiac abnormalities&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. It is due to the mutation in the gene responsible for collagen&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture1_0nXU9YG.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A. It is due to the mutation in the gene responsible for Collagen&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 Option B: Superotemporal dislocation of the lens: This is true for Marfan syndrome . Lens dislocation (ectopia lentis) is a common ocular manifestation, with the lens typically dislocating in a superotemporal direction.  Other Ocular manifestations can include near-sightedness and retinal detachment.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Superotemporal dislocation of the lens:&lt;/li&gt;&lt;li&gt;\u2022 true for Marfan syndrome&lt;/li&gt;&lt;li&gt;\u2022 Option C: Tall stature and joint hypermobility: Patients with Marfan syndrome often present with a tall stature , long limbs , and joint hypermobility , which are characteristic features of the condition. May include a curved spine, and chest deformities such as pectus excavatum. Patients may also experience joint hypermobility.&lt;/li&gt;&lt;li&gt;\u2022 Option C: Tall stature and joint hypermobility:&lt;/li&gt;&lt;li&gt;\u2022 present with a tall stature&lt;/li&gt;&lt;li&gt;\u2022 long limbs&lt;/li&gt;&lt;li&gt;\u2022 joint hypermobility&lt;/li&gt;&lt;li&gt;\u2022 Option D: Cardiac abnormalities: Marfan syndrome can be associated with various cardiac issues , most notably aortic dilatation and dissection (aortic aneurysms), which are significant causes of morbidity and mortality in affected individuals.&lt;/li&gt;&lt;li&gt;\u2022 Option D: Cardiac abnormalities:&lt;/li&gt;&lt;li&gt;\u2022 associated with various cardiac issues&lt;/li&gt;&lt;li&gt;\u2022 notably aortic dilatation&lt;/li&gt;&lt;li&gt;\u2022 dissection&lt;/li&gt;&lt;li&gt;\u2022 Early diagnosis and careful monitoring are crucial to managing the condition and preventing severe complications. Treatment options focus on symptom management and surgical interventions if necessary.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Marfan syndrome , which is indeed due to a mutation in the FBN1 gene responsible for the production of fibrillin-1 , not collagen.&lt;/li&gt;&lt;li&gt;\u27a4 Marfan syndrome&lt;/li&gt;&lt;li&gt;\u27a4 mutation in the FBN1 gene&lt;/li&gt;&lt;li&gt;\u27a4 production of fibrillin-1&lt;/li&gt;&lt;li&gt;\u27a4 Ref- Nelson 20 th Edition, Page No- 618-619&lt;/li&gt;&lt;li&gt;\u27a4 Ref- Nelson 20 th Edition, Page No- 618-619&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A child is brought to the clinic by their mother due to restricted neck movements. Upon examination, an X-ray reveals non-segmentation of the cervical vertebrae. Considering the clinical presentation and radiographic findings, all of the following statements are accurate about the condition except:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;The diagnosis based on the clinical feature is Klippel Feil Syndrome&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Pathology is due to defective somite development between 3rd and 8th week of foetal development&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Torticollis is a key finding in this syndrome&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Triad of this disease includes low posterior hair line, short neck and limitations of neck movement&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Torticollis is a key finding in this syndrome&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture4.png&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C. Torticollis is a key finding in this Syndrome&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Klippel-Feil Syndrome diagnosis : This is true based on the described clinical presentation and radiographic findings.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Klippel-Feil Syndrome diagnosis&lt;/li&gt;&lt;li&gt;\u2022 true&lt;/li&gt;&lt;li&gt;\u2022 Option B: Defective somite development : This is accurate as the syndrome results from errors in the segmentation of somites during early fetal development.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Defective somite development&lt;/li&gt;&lt;li&gt;\u2022 accurate&lt;/li&gt;&lt;li&gt;\u2022 Option D: Disease triad : The described triad is characteristic of Klippel-Feil Syndrome and is accurate .&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Disease triad&lt;/li&gt;&lt;li&gt;\u2022 accurate&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Klippel-Feil Syndrome is characterized by the congenital fusion of any two of the seven cervical vertebrae . It is indeed due to abnormal segmentation during early fetal development . The classical clinical triad includes a low posterior hairline , a short neck , and limited neck movement .&lt;/li&gt;&lt;li&gt;\u27a4 Klippel-Feil Syndrome&lt;/li&gt;&lt;li&gt;\u27a4 congenital fusion of any two of the seven cervical vertebrae&lt;/li&gt;&lt;li&gt;\u27a4 abnormal segmentation&lt;/li&gt;&lt;li&gt;\u27a4 early fetal development&lt;/li&gt;&lt;li&gt;\u27a4 low posterior hairline&lt;/li&gt;&lt;li&gt;\u27a4 short neck&lt;/li&gt;&lt;li&gt;\u27a4 limited neck movement&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition page 3803&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition page 3803&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 2-month-old male infant is brought to the clinic by his mother due to irregular bowel movements, abdominal distension, and bilious vomiting. The mother reports a delayed passage of meconium. Pediatric examination reveals a distended abdomen with visible peristaltic waves, and a rectal examination shows an empty rectum. An abdominal X-ray demonstrates a dilated colon with a transition zone at the rectosigmoid junction. Considering the history and clinical findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Esophageal atresia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Duodenal atresia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hirschsprung&#x27;s disease&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Jejunal atresia.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Hirschsprung&#x27;s disease&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C. Hirschsprung&#x27;s disease&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Esophageal atresia: This condition involves the esophagus and would not cause the symptoms of delayed meconium passage or the specific radiographic findings seen in the colon.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Esophageal atresia:&lt;/li&gt;&lt;li&gt;\u2022 esophagus&lt;/li&gt;&lt;li&gt;\u2022 not cause the symptoms of delayed meconium passage&lt;/li&gt;&lt;li&gt;\u2022 Option B. Duodenal atresia: Presents with bilious vomiting shortly after birth and a \&quot;double bubble\&quot; sign on X-ray , not the findings described.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Duodenal atresia:&lt;/li&gt;&lt;li&gt;\u2022 bilious vomiting shortly after birth&lt;/li&gt;&lt;li&gt;\u2022 \&quot;double bubble\&quot; sign on X-ray&lt;/li&gt;&lt;li&gt;\u2022 Option D: Jejunal atresia: Would present earlier in the neonatal period with symptoms of intestinal obstruction and does not typically involve delayed meconium passage or a transition zone in the rectosigmoid area.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Jejunal atresia:&lt;/li&gt;&lt;li&gt;\u2022 present earlier in the neonatal period&lt;/li&gt;&lt;li&gt;\u2022 intestinal obstruction&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Hirschsprung&#x27;s disease in infants is indicated by delayed meconium passage , abdominal distension , and bile-stained vomiting , leading to diagnostic tests like anorectal manometry and rectal biopsy . Treatment involves isotonic enemas , stool softeners , and potentially a two-step surgical procedure including colostomy and definitive surgery.&lt;/li&gt;&lt;li&gt;\u27a4 Hirschsprung&#x27;s disease&lt;/li&gt;&lt;li&gt;\u27a4 infants&lt;/li&gt;&lt;li&gt;\u27a4 delayed meconium passage&lt;/li&gt;&lt;li&gt;\u27a4 abdominal distension&lt;/li&gt;&lt;li&gt;\u27a4 bile-stained vomiting&lt;/li&gt;&lt;li&gt;\u27a4 diagnostic tests like anorectal manometry&lt;/li&gt;&lt;li&gt;\u27a4 rectal biopsy&lt;/li&gt;&lt;li&gt;\u27a4 Treatment&lt;/li&gt;&lt;li&gt;\u27a4 isotonic enemas&lt;/li&gt;&lt;li&gt;\u27a4 stool softeners&lt;/li&gt;&lt;li&gt;\u27a4 two-step surgical procedure&lt;/li&gt;&lt;li&gt;\u27a4 colostomy&lt;/li&gt;&lt;li&gt;\u27a4 Ref ; Nelson 21 st Edition, Chapter- 358, \u2013 Page No- 7769.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 ;&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter- 358, \u2013 Page No- 7769.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a routine pediatric evaluation, a 4-year-old child presents with no remarkable findings on physical or hematological examination. However, upon reviewing the mother&#x27;s hand, you notice an old hospital file containing an X-ray of the child that shows the presence of Wormian bones. Wormian bones are additional bone pieces within a suture of the cranium and can be associated with several conditions. Aside from hypothyroidism and Cleidocranial dysostosis, which of the following conditions is also known to be associated with the presence of Wormian bones?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Paget&#x27;s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Scheuermann&#x27;s disease&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Osteogenesis imperfecta&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;All of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Osteogenesis imperfecta&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture6_sNakQim.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Paget&#x27;s disease: While Paget&#x27;s disease affects bone remodeling and can lead to enlarged and misshapen bones , it is not typically associated with the presence of Wormian bones.&lt;/li&gt;&lt;li&gt;\u2022 Option A: Paget&#x27;s disease:&lt;/li&gt;&lt;li&gt;\u2022 affects bone remodeling&lt;/li&gt;&lt;li&gt;\u2022 lead to enlarged&lt;/li&gt;&lt;li&gt;\u2022 misshapen bones&lt;/li&gt;&lt;li&gt;\u2022 Option B: Scheuermann&#x27;s disease: This condition primarily affects the spine , leading to vertebral abnormalities and a hunched back posture , but does not involve the formation of Wormian bones.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Scheuermann&#x27;s disease:&lt;/li&gt;&lt;li&gt;\u2022 affects the spine&lt;/li&gt;&lt;li&gt;\u2022 vertebral abnormalities&lt;/li&gt;&lt;li&gt;\u2022 hunched back posture&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Wormian bones can be seen in the following conditions:&lt;/li&gt;&lt;li&gt;\u27a4 Wormian bones can be seen in the following conditions:&lt;/li&gt;&lt;li&gt;\u27a4 Cleidocranial dysostosis Hypothyroidism/hypophosphatasia Osteogenesis imperfect Rickets.&lt;/li&gt;&lt;li&gt;\u27a4 Cleidocranial dysostosis&lt;/li&gt;&lt;li&gt;\u27a4 Hypothyroidism/hypophosphatasia&lt;/li&gt;&lt;li&gt;\u27a4 Osteogenesis imperfect&lt;/li&gt;&lt;li&gt;\u27a4 Rickets.&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No-3423.&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No-3423.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 24-day-old male infant to the clinic with a 4-day history of vomiting. The infant appears dehydrated and irritable upon physical examination. Laboratory tests reveal hypochloremic, hypokalemic metabolic alkalosis. With these findings, a diagnosis of Infantile Hypertrophic Pyloric Stenosis (IHPS) is made. Which of the following statements about IHPS is true?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;It is due to the hypertrophy of longitudinal muscles&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;1 st born female child has more risk of developing it&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Paradoxical Aciduria is a feature of this disease.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Baby manifests on the day of delivery itself.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Paradoxical Aciduria is a feature of this disease.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: It is due to the hypertrophy of longitudinal muscles: This statement is false . IHPS is primarily characterized by the hypertrophy of the circular muscles of the pylorus, not the longitudinal muscles.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: It is due to the hypertrophy of longitudinal muscles:&lt;/li&gt;&lt;li&gt;\u2022 false&lt;/li&gt;&lt;li&gt;\u2022 Option B: The first-born female child has a higher risk of developing it: This statement is false . IHPS is more common in first-born male infants, not females.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: The first-born female child has a higher risk of developing it:&lt;/li&gt;&lt;li&gt;\u2022 false&lt;/li&gt;&lt;li&gt;\u2022 Option D: The baby manifests symptoms on the day of delivery itself: This statement is false . Symptoms of IHPS typically start between the 2nd and 8th weeks of life, not on the day of delivery.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: The baby manifests symptoms on the day of delivery itself:&lt;/li&gt;&lt;li&gt;\u2022 false&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 IHPS involves hypertrophy of the circular pyloric muscle , is more common in first-born males, typically presents between 6 weeks to 3 months age after birth , and can lead to paradoxical aciduria is crucial for accurate diagnosis and management.&lt;/li&gt;&lt;li&gt;\u27a4 IHPS involves hypertrophy&lt;/li&gt;&lt;li&gt;\u27a4 circular pyloric muscle&lt;/li&gt;&lt;li&gt;\u27a4 common in first-born males,&lt;/li&gt;&lt;li&gt;\u27a4 6 weeks to 3 months age&lt;/li&gt;&lt;li&gt;\u27a4 after birth&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition Chapter- 355\u2013 Page No- 7733.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition Chapter- 355\u2013 Page No- 7733.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 27-day-old male infant is brought to the clinic by his mother due to episodes of projectile vomiting. Physical examination reveals a palpable mass on palpation/auscultation (P/A) with observable peristaltic waves moving from left to the right side. Ultrasonography shows a \&quot;target sign,\&quot; and blood tests indicate hypokalemia with acidic urine. Considering the clinical presentation and ultrasound findings, which medication taken prenatally is most associated with the development of this condition?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Penicillin&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Dexamethasone&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Lithium&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Erythromycin&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Erythromycin&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/27/picture14.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D. Erythromycin&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Penicillin: There is no established link between prenatal penicillin exposure and the development of hypertrophic pyloric stenosis .&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Penicillin:&lt;/li&gt;&lt;li&gt;\u2022 no established link&lt;/li&gt;&lt;li&gt;\u2022 prenatal penicillin exposure&lt;/li&gt;&lt;li&gt;\u2022 development of hypertrophic pyloric stenosis&lt;/li&gt;&lt;li&gt;\u2022 Option B. Dexamethasone: This medication is not typically associated with HPS . It is a corticosteroid often used prenatally to accelerate lung maturity but does not have a known causal relationship with HPS.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. Dexamethasone:&lt;/li&gt;&lt;li&gt;\u2022 not typically associated with HPS&lt;/li&gt;&lt;li&gt;\u2022 Option C. Lithium: Lithium use during pregnancy is associated with congenital cardiac anomalies , particularly Ebstein anomaly, rather than HPS.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Lithium:&lt;/li&gt;&lt;li&gt;\u2022 during pregnancy&lt;/li&gt;&lt;li&gt;\u2022 congenital cardiac anomalies&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 An infant presenting with non-bilious projectile vomiting , palpable abdominal mass , hypokalemia , and aciduria , alongside ultrasound evidence of the \&quot;target sign,\&quot; is indicative of Infantile Hypertrophic Pyloric Stenosis (IHPS). Maternal erythromycin intake is a risk factor for IHPS . Diagnosis is primarily clinical, supported by ultrasonography findings of increased pyloric muscle thickness. While IHPS is a medical emergency, the definitive treatment is surgical via Ramstedt pyloromyotomy.&lt;/li&gt;&lt;li&gt;\u27a4 infant presenting with non-bilious projectile vomiting&lt;/li&gt;&lt;li&gt;\u27a4 palpable abdominal mass&lt;/li&gt;&lt;li&gt;\u27a4 hypokalemia&lt;/li&gt;&lt;li&gt;\u27a4 aciduria&lt;/li&gt;&lt;li&gt;\u27a4 ultrasound&lt;/li&gt;&lt;li&gt;\u27a4 \&quot;target sign,\&quot;&lt;/li&gt;&lt;li&gt;\u27a4 Infantile Hypertrophic Pyloric Stenosis&lt;/li&gt;&lt;li&gt;\u27a4 Maternal erythromycin intake&lt;/li&gt;&lt;li&gt;\u27a4 risk factor for IHPS&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition Chapter- 355\u2013 Page No- 7733.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 -&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition Chapter- 355\u2013 Page No- 7733.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 8-year-old girl named Rohini is brought to the clinic by her father due to a history of frequent falls. Initial X-rays reveal multiple fractures at various stages of healing, accompanied by numerous bruises on her skin. Given the suspicious nature of the injuries, child abuse is considered. However, upon a thorough examination, Rohini is found to have short stature, blue sclera, and deformities in her long bones and spine, leading to a re-evaluation of the initial suspicion towards a genetic disorder involving collagen. Based on Rohini&#x27;s clinical presentation, what is the most likely diagnosis, and which gene is implicated in her condition?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Osteogenesis imperfecta and COL4A1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Marfan\u2019s syndrome and COL1A1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Osteogenesis imperfecta and COL1A1&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Marfan\u2019s syndrome and COL4A1&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Osteogenesis imperfecta and COL1A1&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture2_6c3xOzj.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C. Osteogenesis imperfecta and COL1A1&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 Option A: Osteogenesis imperfecta and COL4A1: This option is incorrect because OI is typically associated with mutations in the COL1A1 or COL1A2 genes , not COL4A1.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Osteogenesis imperfecta and COL4A1:&lt;/li&gt;&lt;li&gt;\u2022 incorrect&lt;/li&gt;&lt;li&gt;\u2022 associated with mutations&lt;/li&gt;&lt;li&gt;\u2022 COL1A1 or COL1A2 genes&lt;/li&gt;&lt;li&gt;\u2022 Option B: Marfan\u2019s syndrome and COL1A1 : Marfan syndrome is a disorder that affects connective tissue , characterized by tall stature, long limbs , and cardiovascular abnormalities , among others. It is most commonly caused by mutations in the FBN1 gene, not COL1A1, and does not typically result in fractures or blue sclera as seen in OI.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Marfan\u2019s syndrome and COL1A1&lt;/li&gt;&lt;li&gt;\u2022 disorder that affects connective tissue&lt;/li&gt;&lt;li&gt;\u2022 tall stature, long limbs&lt;/li&gt;&lt;li&gt;\u2022 cardiovascular abnormalities&lt;/li&gt;&lt;li&gt;\u2022 Option D: Marfan\u2019s syndrome and COL4A1: Marfan syndrome is not associated with mutations in the COL4A1 gene . COL4A1 mutations are linked to different conditions, such as certain types of cerebral small vessel disease.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Marfan\u2019s syndrome and COL4A1:&lt;/li&gt;&lt;li&gt;\u2022 not associated with mutations in the COL4A1 gene&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Blue sclera , bone deformities , short stature , and a history of multiple fractures , are classic for Osteogenesis Imperfecta (OI), a genetic disorder caused by mutations in the COL1A1 or COL1A2 genes , which encode type I collagen , a crucial component of bone, skin, and other connective tissues.&lt;/li&gt;&lt;li&gt;\u27a4 Blue sclera&lt;/li&gt;&lt;li&gt;\u27a4 bone deformities&lt;/li&gt;&lt;li&gt;\u27a4 short stature&lt;/li&gt;&lt;li&gt;\u27a4 multiple fractures&lt;/li&gt;&lt;li&gt;\u27a4 classic for Osteogenesis Imperfecta&lt;/li&gt;&lt;li&gt;\u27a4 genetic disorder&lt;/li&gt;&lt;li&gt;\u27a4 mutations in the COL1A1&lt;/li&gt;&lt;li&gt;\u27a4 COL1A2 genes&lt;/li&gt;&lt;li&gt;\u27a4 encode type I collagen&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No-3423 .&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 20 th Edition, Page No-3423&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a routine pediatric consultation, you observe a 4-year-old child accompanied by his family, all of whom share a similar height. Upon examination, you notice limb shortening and disproportionate short stature in the child. Considering the family history and clinical presentation, you suspect a genetic condition characterized by an inherited defect in enchondral ossification due to an FGFR3 mutation. After a thorough evaluation, you explain to the parents that this condition is inherited and, unfortunately, there are limited treatment options available. Based on the history and clinical findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Osteogenesis imperfecta&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Growth hormone deficiency&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Achondroplasia.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Constitutional delay&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Achondroplasia.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture3_g3lZW2C.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture3_g3lZW2C.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C. Achondroplasia&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Osteogenesis imperfecta: This condition involves a genetic defect leading to brittle bones that fracture easily , not primarily associated with short stature or FGFR3 mutations.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Osteogenesis imperfecta:&lt;/li&gt;&lt;li&gt;\u2022 genetic defect&lt;/li&gt;&lt;li&gt;\u2022 brittle bones&lt;/li&gt;&lt;li&gt;\u2022 fracture easily&lt;/li&gt;&lt;li&gt;\u2022 Option B: Growth hormone deficiency: This condition leads to short stature due to insufficient growth hormone production , but it does not typically result in disproportionate limb shortening and is not caused by FGFR3 mutations.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B:&lt;/li&gt;&lt;li&gt;\u2022 Growth hormone deficiency:&lt;/li&gt;&lt;li&gt;\u2022 leads to short stature&lt;/li&gt;&lt;li&gt;\u2022 insufficient growth hormone production&lt;/li&gt;&lt;li&gt;\u2022 Option D: Constitutional delay: This refers to a temporary delay in growth and development , with children eventually catching up to their peers. It does not involve disproportionate limb shortening or FGFR3 mutations.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Constitutional delay:&lt;/li&gt;&lt;li&gt;\u2022 temporary delay in growth&lt;/li&gt;&lt;li&gt;\u2022 development&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Achondroplasia , an autosomal dominant condition , characterized by disproportionate short stature , limb shortening , and a normal-sized torso . It is caused by a mutation in the FGFR3 gene , which leads to abnormal cartilage formation and enchondral ossification&lt;/li&gt;&lt;li&gt;\u27a4 Achondroplasia&lt;/li&gt;&lt;li&gt;\u27a4 autosomal dominant condition&lt;/li&gt;&lt;li&gt;\u27a4 disproportionate short stature&lt;/li&gt;&lt;li&gt;\u27a4 limb shortening&lt;/li&gt;&lt;li&gt;\u27a4 normal-sized torso&lt;/li&gt;&lt;li&gt;\u27a4 caused by a mutation&lt;/li&gt;&lt;li&gt;\u27a4 FGFR3 gene&lt;/li&gt;&lt;li&gt;\u27a4 abnormal cartilage formation&lt;/li&gt;&lt;li&gt;\u27a4 enchondral ossification&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition, Chapter \u2013 721 Page No 14415.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Chapter \u2013 721 Page No 14415.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A full-term newborn is brought to the clinic by her mother, who reports that the baby starts coughing during feeding attempts, leading to significant feeding difficulties over the last 2 days. The examination reveals signs of dehydration in the baby. An X-ray is performed, showing an anomaly suggestive of a congenital condition affecting the esophagus. Based on the clinical presentation and X-ray findings, what is the most likely diagnosis?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Esophageal atresia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Esophageal atresia with TEF&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Physiological phenomenon&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Galactosemia&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Esophageal atresia with TEF&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture9_PGWDHGU.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture10_SCnXUl0.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/26/picture11_RgoveEZ.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B. Esophageal atresia with TEF&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Esophageal atresia: While esophageal atresia alone can cause feeding difficulties , the coughing during feeding is more indicative of the additional presence of TEF.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Esophageal atresia:&lt;/li&gt;&lt;li&gt;\u2022 cause feeding difficulties&lt;/li&gt;&lt;li&gt;\u2022 Option C. Physiological phenomenon: Coughing during feeding and signs of dehydration in a newborn are not physiological and suggest a pathological process.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Physiological phenomenon:&lt;/li&gt;&lt;li&gt;\u2022 Coughing during feeding&lt;/li&gt;&lt;li&gt;\u2022 dehydration&lt;/li&gt;&lt;li&gt;\u2022 newborn&lt;/li&gt;&lt;li&gt;\u2022 Option D: Galactosemia: This is a metabolic disorder that present with acidic stool , not with coughing during feeding as an initial symptom and is not detectable on an X-ray.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Galactosemia:&lt;/li&gt;&lt;li&gt;\u2022 metabolic disorder&lt;/li&gt;&lt;li&gt;\u2022 present with acidic stool&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The symptoms of coughing during feeds and signs of dehydration in a newborn , along with an abnormal X-ray of the esophagus , are highly suggestive of esophageal atresia with or without tracheoesophageal fistula (TEF).&lt;/li&gt;&lt;li&gt;\u27a4 symptoms of coughing during feeds&lt;/li&gt;&lt;li&gt;\u27a4 signs of dehydration in a newborn&lt;/li&gt;&lt;li&gt;\u27a4 abnormal X-ray of the esophagus&lt;/li&gt;&lt;li&gt;\u27a4 esophageal atresia&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition \u2013 Page No- 7661-7667.&lt;/li&gt;&lt;li&gt;\u27a4 Ref -&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition \u2013 Page No- 7661-7667.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 24 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

