&lt;a class=&quot;bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition&quot; href=&quot;https://t.me/Dams_new_robot&quot; target=&quot;_top&quot;&gt;Contact Admin&lt;/a&gt;
