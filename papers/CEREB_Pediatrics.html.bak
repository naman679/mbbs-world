&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;A 6-month-old boy is brought to the rural health clinic for his scheduled vaccination. As you are preparing the vaccine, a newly joined nurse assisting you points out the sticker on the vial and asks about its significance. The sticker is as shown in the image. Which of the following statements is incorrect regarding the sticker on the vaccine vial?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;It indicates the cumulative heat exposure over time.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;We can use the vial if the inner square is lighter than the outer circle.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;The sticker indicates the efficacy of the vaccine over a period of time.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;We can\u2019t use the vial if the inner square is of darker than the outer circle.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. The sticker indicates the efficacy of the vaccine over a period of time.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture1.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture2.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) The sticker indicates the efficacy of the vaccine over a period of time.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. This statement is true. The VVM does indicate the cumulative heat exposure over time , which helps health workers determine if the vaccine has been stored appropriately.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. This statement is true.&lt;/li&gt;&lt;li&gt;\u2022 VVM&lt;/li&gt;&lt;li&gt;\u2022 indicate the cumulative heat exposure over time&lt;/li&gt;&lt;li&gt;\u2022 Option B. This statement is also true. The VVM allows health workers to use the vial if the inner square is lighter than the outer circle, suggesting that the vaccine has not been compromised by excessive heat.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. This statement is also true.&lt;/li&gt;&lt;li&gt;\u2022 VVM allows health workers&lt;/li&gt;&lt;li&gt;\u2022 use the vial if the inner square is lighter&lt;/li&gt;&lt;li&gt;\u2022 Grade I &amp;amp; II \u2013 can be used&lt;/li&gt;&lt;li&gt;\u2022 Grade III &amp;amp; IV \u2013 CANNOT be used&lt;/li&gt;&lt;li&gt;\u2022 Option D. This statement is true as well. If the inner square is darker than the outer circle , it is an indication that the vaccine may have been exposed to heat beyond the recommended levels and therefore should not be used.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. This statement is true as well.&lt;/li&gt;&lt;li&gt;\u2022 inner square is darker than the outer circle&lt;/li&gt;&lt;li&gt;\u2022 indication that the vaccine may have been exposed to heat&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Vaccine Vial Monitor (VVM)&lt;/li&gt;&lt;li&gt;\u27a4 Vaccine Vial Monitor&lt;/li&gt;&lt;li&gt;\u27a4 (VVM)&lt;/li&gt;&lt;li&gt;\u27a4 It indicates the cumulative heat exposure over time . We can use the vial if the inner square is lighter than the outer circle . We can\u2019t use the vial if the inner square is of darker than the outer circle.&lt;/li&gt;&lt;li&gt;\u27a4 It indicates the cumulative heat exposure over time .&lt;/li&gt;&lt;li&gt;\u27a4 cumulative heat exposure over time&lt;/li&gt;&lt;li&gt;\u27a4 We can use the vial if the inner square is lighter than the outer circle .&lt;/li&gt;&lt;li&gt;\u27a4 use the vial&lt;/li&gt;&lt;li&gt;\u27a4 inner square is lighter than the outer circle&lt;/li&gt;&lt;li&gt;\u27a4 We can\u2019t use the vial if the inner square is of darker than the outer circle.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: OP Ghai 9 th Edition Page No-203.&lt;/li&gt;&lt;li&gt;\u27a4 Ref: OP Ghai 9 th Edition Page No-203.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 6-month-old infant, Krish, is presented to the pediatric clinic with symptoms of a high-pitched cough, runny nose, and a mild fever. Upon inquiry, the mother reveals that Krish received his pertussis vaccine two days ago. The physician considers the possibility of a vaccine-related adverse event. Which of the following is the most common side effect of the pertussis vaccine, and how should it be managed in this case?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Severe allergic reaction- recommend immediate administration of epinephrine&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Febrile seizure- recommend antipyretic therapy and observation&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Localized pain and swelling at the injection site- recommend cold compresses and pain relief medication&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Anaphylaxis- recommend referral to the emergency department for further management&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Localized pain and swelling at the injection site- recommend cold compresses and pain relief medication&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Localized pain and swelling at the injection site, recommend cold compresses and pain relief medication&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option . A severe allergic reaction would present immediately after vaccination and would be more acute and severe than the symptoms described.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A severe allergic reaction&lt;/li&gt;&lt;li&gt;\u2022 present immediately after vaccination&lt;/li&gt;&lt;li&gt;\u2022 more acute&lt;/li&gt;&lt;li&gt;\u2022 severe&lt;/li&gt;&lt;li&gt;\u2022 Option B. Febrile seizures are a rare side effect of the pertussis vaccine and are associated with high fever , which is not the case here as the fever is described as mild.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Febrile seizures&lt;/li&gt;&lt;li&gt;\u2022 rare side effect of the pertussis vaccine&lt;/li&gt;&lt;li&gt;\u2022 high fever&lt;/li&gt;&lt;li&gt;\u2022 Option D. Anaphylaxis is a very rare but serious reaction that would typically occur within minutes to hours after vaccination , presenting with signs such as difficulty breathing, hives, swelling of the face and throat , a rapid heartbeat , and severe weakness.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Anaphylaxis&lt;/li&gt;&lt;li&gt;\u2022 very rare but serious reaction&lt;/li&gt;&lt;li&gt;\u2022 occur within minutes to hours after vaccination&lt;/li&gt;&lt;li&gt;\u2022 difficulty breathing, hives, swelling of the face and throat&lt;/li&gt;&lt;li&gt;\u2022 rapid heartbeat&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Localized pain and swelling are the most common side effects of the pertussis vaccine , typically resolving within a few days . Management includes cold compresses and pain relief medication, with parental monitoring for any signs of infection at the injection site.&lt;/li&gt;&lt;li&gt;\u27a4 Localized pain&lt;/li&gt;&lt;li&gt;\u27a4 swelling&lt;/li&gt;&lt;li&gt;\u27a4 most common side effects of the pertussis vaccine&lt;/li&gt;&lt;li&gt;\u27a4 resolving within a few days&lt;/li&gt;&lt;li&gt;\u27a4 Management&lt;/li&gt;&lt;li&gt;\u27a4 cold compresses and pain relief medication,&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-195.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-195.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In the midst of a busy day at the outpatient department, a junior doctor opens a vial of the DPT vaccine. Following the Open Vial Policy, you remind her to document the time the vial was opened for potential reuse later on. To test her knowledge on the policy, you question her about which vaccine listed below does not follow the Open Vial Policy.&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;OPV&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hepatitis- B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Pentavalent&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;MMR&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. MMR&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) MMR&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Open Vial Policy 2015&lt;/li&gt;&lt;li&gt;\u2022 Open Vial Policy 2015&lt;/li&gt;&lt;li&gt;\u2022 Applicable for Vaccines : OPV, DPT, Hepatitis B, DT/TT, Liquid Pentavalent, IPV Not applicable for Vaccines : Measles/ MMR, BCG, JE, rotavirus Opened vaccine vials can be used in subsequent session \u2018UP TO 4 WEEKS\u2019 Expiry date should not pass, VVM within usability limits, Cold chain maintenance Vaccine vial septum not submerged in water or contaminated, Aseptic technique used to withdraw doses Record date and time of each vial opening At end of session return all open vials to Cold chain: Reusable open vials: DPT, DT, Hepatitis B, Pentavalent Non-reusable open vials: Measles/MMR, BCG, JE (Destroy after 48 hours or Next session whichever earlier) If any AEFI reported: Store all vials in Cold chain till completion of investigation&lt;/li&gt;&lt;li&gt;\u2022 Applicable for Vaccines : OPV, DPT, Hepatitis B, DT/TT, Liquid Pentavalent, IPV&lt;/li&gt;&lt;li&gt;\u2022 Applicable for Vaccines&lt;/li&gt;&lt;li&gt;\u2022 OPV, DPT, Hepatitis B, DT/TT, Liquid Pentavalent, IPV&lt;/li&gt;&lt;li&gt;\u2022 Not applicable for Vaccines : Measles/ MMR, BCG, JE, rotavirus&lt;/li&gt;&lt;li&gt;\u2022 Not applicable for Vaccines&lt;/li&gt;&lt;li&gt;\u2022 Measles/ MMR, BCG, JE, rotavirus&lt;/li&gt;&lt;li&gt;\u2022 Opened vaccine vials can be used in subsequent session \u2018UP TO 4 WEEKS\u2019&lt;/li&gt;&lt;li&gt;\u2022 Expiry date should not pass, VVM within usability limits, Cold chain maintenance&lt;/li&gt;&lt;li&gt;\u2022 Vaccine vial septum not submerged in water or contaminated, Aseptic technique used to&lt;/li&gt;&lt;li&gt;\u2022 withdraw doses&lt;/li&gt;&lt;li&gt;\u2022 Record date and time of each vial opening&lt;/li&gt;&lt;li&gt;\u2022 At end of session return all open vials to Cold chain: Reusable open vials: DPT, DT, Hepatitis B, Pentavalent Non-reusable open vials: Measles/MMR, BCG, JE (Destroy after 48 hours or Next session whichever earlier) If any AEFI reported: Store all vials in Cold chain till completion of investigation&lt;/li&gt;&lt;li&gt;\u2022 Reusable open vials: DPT, DT, Hepatitis B, Pentavalent Non-reusable open vials: Measles/MMR, BCG, JE (Destroy after 48 hours or Next session whichever earlier) If any AEFI reported: Store all vials in Cold chain till completion of investigation&lt;/li&gt;&lt;li&gt;\u2022 Reusable open vials: DPT, DT, Hepatitis B, Pentavalent&lt;/li&gt;&lt;li&gt;\u2022 Non-reusable open vials: Measles/MMR, BCG, JE (Destroy after 48 hours or Next session whichever earlier)&lt;/li&gt;&lt;li&gt;\u2022 If any AEFI reported: Store all vials in Cold chain till completion of investigation&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Open Vial Policy is used for the multidosing vials for reuse within 4 weeks under proper cold chain maintenance and within the expiry date.&lt;/li&gt;&lt;li&gt;\u27a4 Open Vial Policy&lt;/li&gt;&lt;li&gt;\u27a4 reuse within 4 weeks&lt;/li&gt;&lt;li&gt;\u27a4 The vaccines following open vial policy are \u2013 TT, OPV, DPT, Hep-B, Pentavalent and IPV.&lt;/li&gt;&lt;li&gt;\u27a4 The vaccines following open vial policy are \u2013 TT, OPV, DPT, Hep-B, Pentavalent and IPV.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-193.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-193.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a review session with interns, you decide to test their knowledge on vaccine strains with a matching exercise. Match the following vaccines with their respective strains:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A3 B4 C1 D2&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A3 B2 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B4 C2 D1&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. A3 B4 C1 D2&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture6.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture7_8ERNaT2.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture8.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) A3 B4 C1 D2&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. (OPV ) is matched with 3 (Sabin), which refers to the oral polio vaccine developed by Albert Sabin.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. (OPV&lt;/li&gt;&lt;li&gt;\u2022 3 (Sabin),&lt;/li&gt;&lt;li&gt;\u2022 Option B: (IPV) is matched with 4 (Salk), indicating the inactivated polio vaccine developed by Jonas Salk.&lt;/li&gt;&lt;li&gt;\u2022 Option B:&lt;/li&gt;&lt;li&gt;\u2022 (IPV)&lt;/li&gt;&lt;li&gt;\u2022 4 (Salk),&lt;/li&gt;&lt;li&gt;\u2022 Option C. (Measles) is matched with 1 (Edmonston-Zagreb), a strain used in the measles vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. (Measles)&lt;/li&gt;&lt;li&gt;\u2022 1 (Edmonston-Zagreb),&lt;/li&gt;&lt;li&gt;\u2022 Option D. (Mumps) is matched with 2 (Jeryl Lynn), a strain used in the mumps vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. (Mumps)&lt;/li&gt;&lt;li&gt;\u2022 2 (Jeryl Lynn),&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page 741&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition page 741&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;While taking a brief pause in the hospital cafeteria, you notice your junior colleague distressed, clutching her previous year&#x27;s examination paper. Upon inquiry, you discover her concern is related to a question about vaccine storage in an Ice-Lined Refrigerator (ILR). She seeks clarity on which vaccines are typically stored in the ILR&#x27;s lowest compartment. You decide to assist her in understanding this by presenting a scenario that includes all the options except one. Which of the following vaccines is NOT stored in the lowest compartment of an ILR?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;MMR&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hep B&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;OPV&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Reconstituted BCG&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Hep B&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture4.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture4.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Hep B&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. MMR vaccine, being sensitive to freezing , is usually stored in the lower compartments of an ILR to maintain its required cold temperature without freezing.&lt;/li&gt;&lt;li&gt;\u2022 Option A. MMR vaccine,&lt;/li&gt;&lt;li&gt;\u2022 sensitive to freezing&lt;/li&gt;&lt;li&gt;\u2022 stored in the lower compartments of an ILR&lt;/li&gt;&lt;li&gt;\u2022 Option C. OPV , sensitive to higher temperatures but not to freezing , is often placed in the lower compartments of an ILR to keep it cool enough.&lt;/li&gt;&lt;li&gt;\u2022 Option C. OPV&lt;/li&gt;&lt;li&gt;\u2022 sensitive to higher temperatures&lt;/li&gt;&lt;li&gt;\u2022 not to freezing&lt;/li&gt;&lt;li&gt;\u2022 placed in the lower compartments of an ILR&lt;/li&gt;&lt;li&gt;\u2022 Option D. Reconstituted BCG , once mixed, has a very short shelf life and requires storage in the lower compartments of an ILR to maintain its efficacy.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Reconstituted BCG&lt;/li&gt;&lt;li&gt;\u2022 very short shelf life and requires storage in the lower compartments of an ILR&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Heat sensitive vaccines are kept in the lowest part of ILR.&lt;/li&gt;&lt;li&gt;\u27a4 Heat sensitive vaccines are kept in the lowest part of ILR.&lt;/li&gt;&lt;li&gt;\u27a4 The heat sensitive vaccines are OPV , Reconstituted BCG and Measles vaccine .&lt;/li&gt;&lt;li&gt;\u27a4 heat sensitive vaccines are OPV&lt;/li&gt;&lt;li&gt;\u27a4 Reconstituted BCG&lt;/li&gt;&lt;li&gt;\u27a4 Measles vaccine&lt;/li&gt;&lt;li&gt;\u27a4 The freeze sensitive vaccines include Hep B &amp;gt; HPV &amp;gt;DPT &amp;gt;DT &amp;gt; TT .&lt;/li&gt;&lt;li&gt;\u27a4 Hep B &amp;gt; HPV &amp;gt;DPT &amp;gt;DT &amp;gt; TT&lt;/li&gt;&lt;li&gt;\u27a4 The freeze sensitive vaccines are kept at the top of the ILR.&lt;/li&gt;&lt;li&gt;\u27a4 The freeze sensitive vaccines are kept at the top of the ILR.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;On your first day in the pediatric department, while acquainting yourself with the surroundings dedicated to the care of children, you encounter a distinctive logo featuring a rainbow and a baby. This emblem represents a particular immunization program. You ponder which vaccines are encompassed by this program. Based on your knowledge, which of the following vaccines is NOT typically included in the program symbolized by the rainbow and baby logo?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Influenza vaccine&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hep B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;OPV&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Tetanus&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Influenza vaccine&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture5.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Influenza&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 Option B, Option C and Option D are the standard inclusion in childhood immunization schedules.&lt;/li&gt;&lt;li&gt;\u2022 Option B, Option C and Option D&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Mission Indradhanush&lt;/li&gt;&lt;li&gt;\u27a4 Mission Indradhanush&lt;/li&gt;&lt;li&gt;\u27a4 Launched on 25 December 2014. Cover all those children by 2020 who are either unvaccinated, or are partially vaccinated against 7 vaccine preventable diseases (7 VPD\u2019s) \u2013 Diphtheria, Pertussis, Tetanus, Childhood Tuberculosis, Poliomyelitis, Hepatitis B, Measles&lt;/li&gt;&lt;li&gt;\u27a4 25 December 2014.&lt;/li&gt;&lt;li&gt;\u27a4 children by 2020&lt;/li&gt;&lt;li&gt;\u27a4 unvaccinated,&lt;/li&gt;&lt;li&gt;\u27a4 partially vaccinated against 7 vaccine preventable diseases&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-185.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-185.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a rural primary health centre, a mother presents with her 17-month-old child, concerned about the child&#x27;s failure to thrive. Despite the child&#x27;s active demeanour, you learn that the child has not received any vaccinations due to prevailing community myths. After discussing the importance and benefits of immunizations, the mother consents to begin the vaccination process for her child. Based on the child&#x27;s age and vaccination status, which combination of vaccines would you prioritize for administration?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;BCG and OPV&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;MMR, OPV and Rota&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Pentavalent vaccine with Hep B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;DPT, OPV and MMR&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. DPT, OPV and MMR&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture13.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture13.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) DPT, OPV and MMR&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Ideally, He should get: OPV-1, Measles-1 or MMR-1, Vitamin A (2 lac IU), DPT-1, HiB-1&lt;/li&gt;&lt;li&gt;\u2022 But as per the options mentioned the correct answer is \u2013 DPT, OPV, MMR&lt;/li&gt;&lt;li&gt;\u2022 DPT, OPV, MMR&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Delayed Immunization&lt;/li&gt;&lt;li&gt;\u27a4 Delayed Immunization&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-193.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-193.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a health awareness event at a local orphanage, the director approaches you for advice on their vaccination schedule. He shares several practices they follow based on previous guidelines but is unsure about one particular aspect. He asks for your input to identify the incorrect statement among the following:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Live vaccines can be administered together at a different place in a same day&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Live vaccines can be administered at the same place with a time duration of 4 weeks&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Oral Polio vaccine and rota vaccines are killed vaccines, that\u2019s why they are given orally&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Hepatitis B can be administered along with the Hepatitis Immunoglobulin&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Oral Polio vaccine and rota vaccines are killed vaccines, that\u2019s why they are given orally&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture14.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture14.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Oral Polio vaccine and rota vaccines are killed vaccines, that\u2019s why they are given orally.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 OPV is a live attenuated vaccine , not a killed vaccine, which is why it is administered orally to induce immunity in the gut , the primary entry site for the poliovirus.&lt;/li&gt;&lt;li&gt;\u2022 OPV&lt;/li&gt;&lt;li&gt;\u2022 live attenuated vaccine&lt;/li&gt;&lt;li&gt;\u2022 administered orally to induce immunity in the gut&lt;/li&gt;&lt;li&gt;\u2022 Rotavirus vaccines are also live attenuated and given orally to mimic the natural infection route and induce a robust immune response .&lt;/li&gt;&lt;li&gt;\u2022 Rotavirus vaccines&lt;/li&gt;&lt;li&gt;\u2022 live attenuated&lt;/li&gt;&lt;li&gt;\u2022 orally to mimic the natural infection route&lt;/li&gt;&lt;li&gt;\u2022 induce a robust immune response&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-195.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-195.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A concerned mother brings her infant son, Raghav, to the local clinic in rural India for his scheduled vaccinations. After receiving the oral live rotavirus vaccine, the mother inquires about potential side effects. The nurse, seeking to provide accurate information, turns to you and asks what the most common side effect of the rotavirus vaccine in infants is and how it should be managed. Which of the following is the correct response?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Fever and irritability- recommend Paracetamol for fever control.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Vomiting and diarrhoea- recommend increased fluid intake and oral rehydration therapy.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Rash and itching- recommend topical steroids for symptomatic relief.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Cough and congestion- recommend antihistamines for symptomatic relief.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Vomiting and diarrhoea- recommend increased fluid intake and oral rehydration therapy.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Vomiting and diarrhoea- recommend increased fluid intake and oral rehydration therapy.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Fever and irritability may occur following many types of vaccinations and are generally managed with antipyretics like Paracetamol . However, these are not the most common side effects of the rotavirus vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Fever and irritability&lt;/li&gt;&lt;li&gt;\u2022 managed with antipyretics like Paracetamol&lt;/li&gt;&lt;li&gt;\u2022 Option C. Rash and itching are not typical side effects of the rotavirus vaccine and would not be the first concern following vaccination.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Rash and itching&lt;/li&gt;&lt;li&gt;\u2022 not typical side effects of the rotavirus vaccine&lt;/li&gt;&lt;li&gt;\u2022 Option D. Cough and congestion are more commonly associated with respiratory vaccines , like the influenza vaccine, and are not typical side effects of the rotavirus vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Cough and congestion&lt;/li&gt;&lt;li&gt;\u2022 commonly associated with respiratory vaccines&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The most common side effect of Rota vaccine in infants is vomiting and diarrhoea. This side effect typically occurs within the first week after vaccination and resolves within a few days without any specific treatment. However, the child should be monitored closely for signs of dehydration, such as decreased urine output, dry mouth, and sunken fontanelles. The appropriate management of Rota vaccine-associated vomiting and diarrhoea is to increase fluid intake and provide oral rehydration therapy. Oral rehydration therapy should be given to prevent dehydration and electrolyte imbalances.&lt;/li&gt;&lt;li&gt;\u27a4 The most common side effect of Rota vaccine in infants is vomiting and diarrhoea.&lt;/li&gt;&lt;li&gt;\u27a4 most common&lt;/li&gt;&lt;li&gt;\u27a4 Rota vaccine in infants&lt;/li&gt;&lt;li&gt;\u27a4 vomiting and diarrhoea.&lt;/li&gt;&lt;li&gt;\u27a4 This side effect typically occurs within the first week after vaccination and resolves within a few days without any specific treatment.&lt;/li&gt;&lt;li&gt;\u27a4 within the first week&lt;/li&gt;&lt;li&gt;\u27a4 resolves within a few days&lt;/li&gt;&lt;li&gt;\u27a4 However, the child should be monitored closely for signs of dehydration, such as decreased urine output, dry mouth, and sunken fontanelles.&lt;/li&gt;&lt;li&gt;\u27a4 The appropriate management of Rota vaccine-associated vomiting and diarrhoea is to increase fluid intake and provide oral rehydration therapy.&lt;/li&gt;&lt;li&gt;\u27a4 increase fluid intake and provide oral rehydration therapy.&lt;/li&gt;&lt;li&gt;\u27a4 Oral rehydration therapy should be given to prevent dehydration and electrolyte imbalances.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 185-193.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 185-193.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother visits the pediatric clinic for her 2-year-old child&#x27;s routine check-up. During the visit, she expresses concerns about the scheduled administration of a live vaccine. As the pediatrician, how would you explain what a live vaccine is, and what safety guidance would you provide regarding these vaccines?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A live vaccine is a vaccine that contains a killed virus, and it is safe for all children&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A live vaccine is a vaccine that contains a weakened or attenuated virus, and it is safe for most children&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A live vaccine is a vaccine that contains a live virus, and it is not recommended for any child&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A live vaccine is a vaccine that contains both live and killed virus, and it is safe for most children, but not recommended for children with weakened immune systems&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. A live vaccine is a vaccine that contains a weakened or attenuated virus, and it is safe for most children&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A . This statement is incorrect as live vaccines do not contain a killed virus ; that would be an inactivated vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option A&lt;/li&gt;&lt;li&gt;\u2022 incorrect&lt;/li&gt;&lt;li&gt;\u2022 live vaccines do not contain a killed virus&lt;/li&gt;&lt;li&gt;\u2022 Option C. This statement is misleading . Live vaccines do contain a live virus , but it is attenuated and safe for most children, not all.&lt;/li&gt;&lt;li&gt;\u2022 Option C.&lt;/li&gt;&lt;li&gt;\u2022 misleading&lt;/li&gt;&lt;li&gt;\u2022 Live vaccines do contain a live virus&lt;/li&gt;&lt;li&gt;\u2022 Option D. This statement is partially correct but is misleading in suggesting that live vaccines can contain both live and killed viruses . While live vaccines are safe for most children, they are indeed not recommended for children with weakened immune systems.&lt;/li&gt;&lt;li&gt;\u2022 Option D.&lt;/li&gt;&lt;li&gt;\u2022 partially correct&lt;/li&gt;&lt;li&gt;\u2022 misleading&lt;/li&gt;&lt;li&gt;\u2022 live vaccines can contain both live and killed viruses&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Live vaccines , such as MMR, varicella, and rotavirus, are generally safe for most children but may not be suitable for those with certain medical conditions or compromised immune systems, who could face serious complications from vaccine-preventable diseases&lt;/li&gt;&lt;li&gt;\u27a4 Live vaccines&lt;/li&gt;&lt;li&gt;\u27a4 MMR, varicella, and rotavirus,&lt;/li&gt;&lt;li&gt;\u27a4 safe for most children&lt;/li&gt;&lt;li&gt;\u27a4 Ref - Nelson 21 st Edition page 739&lt;/li&gt;&lt;li&gt;\u27a4 Ref -&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition page 739&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Match the following vaccines with their type:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A2 B3 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A3 B2 C4 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A3 B4 C2 D1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A3 B4 C1 D2&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. A3 B4 C1 D2&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture9.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture10.jpg&quot;, &quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture11.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) A3 B4 C1 D2&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. OPV is a live vaccine , utilizing a live attenuated virus to elicit an immune response without causing the disease itself.&lt;/li&gt;&lt;li&gt;\u2022 Option A. OPV is a live vaccine&lt;/li&gt;&lt;li&gt;\u2022 Option B. IPV is a killed vaccine , using an inactivated poliovirus to induce immunity without the risk of vaccine-derived polio.&lt;/li&gt;&lt;li&gt;\u2022 Option B. IPV is a killed vaccine&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hep B is a sub-unit vaccine, containing only a part of the virus (the surface antigen) to stimulate a protective immune response.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hep B is a sub-unit vaccine,&lt;/li&gt;&lt;li&gt;\u2022 Option D. H. Influenza B vaccine is a conjugated vaccine , which links the bacterial polysaccharide to a protein carrier to enhance the immune response.&lt;/li&gt;&lt;li&gt;\u2022 Option D.&lt;/li&gt;&lt;li&gt;\u2022 H. Influenza B vaccine&lt;/li&gt;&lt;li&gt;\u2022 conjugated vaccine&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page 740&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition page 740&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 6-week-old infant to your clinic for a follow-up visit. The infant received the BCG vaccine at birth as part of the tuberculosis prevention program. The mother is concerned about a noticeable swelling that developed at the site of injection a few weeks\u2019 post-vaccination. Upon examination, you identify the swelling as a common reaction to the BCG vaccine. Based on this information, what is the most likely side effect the infant is experiencing?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Fever&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Lymphadenopathy&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Anaphylaxis&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Ulceration at the injection site&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Lymphadenopathy&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Lymphadenopathy&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Fever is a potential side effect of many vaccines but is not the most characteristic side effect associated with the BCG vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Fever&lt;/li&gt;&lt;li&gt;\u2022 potential side effect of many vaccines&lt;/li&gt;&lt;li&gt;\u2022 Option C. Anaphylaxis is an extremely rare and severe allergic reaction that can occur with any vaccine, but it is not a common side effect of the BCG vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Anaphylaxis&lt;/li&gt;&lt;li&gt;\u2022 extremely rare and severe allergic reaction&lt;/li&gt;&lt;li&gt;\u2022 Option D. Ulceration at the injection site is a possible side effect of the BCG vaccine ; however, it is less common compared to lymphadenopathy and usually resolves on its own.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Ulceration at the injection site&lt;/li&gt;&lt;li&gt;\u2022 possible side effect of the BCG vaccine&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Lymphadenopathy , is the most common side effect of the BCG vaccine.&lt;/li&gt;&lt;li&gt;\u27a4 Lymphadenopathy&lt;/li&gt;&lt;li&gt;\u27a4 most common side effect of the BCG vaccine.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-185.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-185.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother visits your clinic with her 14-week-old child for routine vaccination. Upon examination, the child appears active and exhibits normal growth parameters. Based on the child&#x27;s age, which of the following vaccines is NOT recommended at this visit?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Inactivated poliovirus vaccine (IPV)&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Measles, mumps, and rubella (MMR) vaccine&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Haemophilus influenzae type b (Hib) vaccine&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Pneumococcal conjugate vaccine (PCV)&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Measles, mumps, and rubella (MMR) vaccine&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture16.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture16.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Measles, mumps, and rubella (MMR) vaccine&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 At the age of 14 weeks , children are recommended vaccines - fIPV, Pentavalent including Hib, Rotavirus vaccine and PCV.&lt;/li&gt;&lt;li&gt;\u2022 At the age of 14 weeks&lt;/li&gt;&lt;li&gt;\u2022 children&lt;/li&gt;&lt;li&gt;\u2022 fIPV, Pentavalent&lt;/li&gt;&lt;li&gt;\u2022 Hib, Rotavirus vaccine and PCV.&lt;/li&gt;&lt;li&gt;\u2022 MR is administered at the 9 months of age.&lt;/li&gt;&lt;li&gt;\u2022 MR is administered at the 9 months of age.&lt;/li&gt;&lt;li&gt;\u2022 So, Option A, C and D are given in the child of 14 weeks.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 NEW National Immunization Schedule (NIS) 2023-24&lt;/li&gt;&lt;li&gt;\u27a4 NEW National Immunization Schedule (NIS) 2023-24&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-187.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-187.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;Regarding the vaccine displayed in the image, which of the following statements is NOT true?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;It is a live attenuated vaccine given along with a dose of Vitamin A&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Distilled water is used as a diluent&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;It follows the Open Vial policy&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Edmonston Zagreb strain is used for this preparation&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. It follows the Open Vial policy&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture18.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) It follows the Open Vial policy&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. The MMR vaccine is indeed a live attenuated vaccine and is administered with a dose of Vitamin A .&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. The MMR&lt;/li&gt;&lt;li&gt;\u2022 vaccine&lt;/li&gt;&lt;li&gt;\u2022 live attenuated vaccine&lt;/li&gt;&lt;li&gt;\u2022 administered with a dose of Vitamin A&lt;/li&gt;&lt;li&gt;\u2022 Option B. The appropriate diluent is Distilled / Sterile water for Measles/ MR/MMR&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. The appropriate diluent is Distilled&lt;/li&gt;&lt;li&gt;\u2022 Option D. The Edmonston Zagreb strain is MC strains used in the measles component of MMR vaccines .&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. The Edmonston Zagreb&lt;/li&gt;&lt;li&gt;\u2022 strain&lt;/li&gt;&lt;li&gt;\u2022 MC strains&lt;/li&gt;&lt;li&gt;\u2022 measles component of MMR vaccines&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective&lt;/li&gt;&lt;li&gt;\u27a4 Measles&lt;/li&gt;&lt;li&gt;\u27a4 Measles&lt;/li&gt;&lt;li&gt;\u27a4 Edmonston Zagreb strain is used for this preparation. Distilled water is used as a diluent. It is given at 9 completed months along with Vitamin A.&lt;/li&gt;&lt;li&gt;\u27a4 Edmonston Zagreb strain is used for this preparation.&lt;/li&gt;&lt;li&gt;\u27a4 Distilled water is used as a diluent.&lt;/li&gt;&lt;li&gt;\u27a4 It is given at 9 completed months along with Vitamin A.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-195&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-195&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-month-old infant is rushed to the emergency department with severe abdominal pain, vomiting, and bloody stools. The mother reports that the child received an oral rotavirus vaccine two weeks prior. An ultrasound examination is performed, yielding the image displayed. Based on the clinical presentation and the ultrasound findings, the physician suspects intussusception. What is the most likely mechanism behind the association of intussusception with the rotavirus vaccine, and what is the most appropriate management?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;The vaccine causes bowel obstruction- immediate surgery is recommended.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;The vaccine stimulates the immune system- recommend immunosuppressants.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;The vaccine causes inflammation of the gastrointestinal tract- recommend anti-inflammatory drugs for symptom relief.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;The vaccine virus strain has a structural similarity to the host&#x27;s intestine, leading to intussusception- refer to a paediatric surgeon.&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. The vaccine virus strain has a structural similarity to the host&#x27;s intestine, leading to intussusception- refer to a paediatric surgeon.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture3.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) The vaccine virus strain has a structural similarity to the host&#x27;s intestine, leading to intussusception, refer to a paediatric surgeon.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. While bowel obstruction is a component of intussusception , the statement that the vaccine causes this obstruction is misleading . Immediate surgery may be recommended, but this is not due to the vaccine causing the obstruction directly.&lt;/li&gt;&lt;li&gt;\u2022 Option A. While bowel obstruction&lt;/li&gt;&lt;li&gt;\u2022 component of intussusception&lt;/li&gt;&lt;li&gt;\u2022 vaccine causes this obstruction is misleading&lt;/li&gt;&lt;li&gt;\u2022 Option B. The vaccine stimulates the immune system as part of its intended action , but recommending immunosuppressants is not appropriate and does not relate to the treatment of intussusception.&lt;/li&gt;&lt;li&gt;\u2022 Option B. The vaccine stimulates the immune system&lt;/li&gt;&lt;li&gt;\u2022 part of its intended action&lt;/li&gt;&lt;li&gt;\u2022 Option C. Anti-inflammatory drugs are not the primary treatment for intussusception , which is a mechanical obstruction and not merely an inflammatory process.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Anti-inflammatory drugs&lt;/li&gt;&lt;li&gt;\u2022 not the primary treatment for intussusception&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Intussusception post-Rotavirus vaccination is a rare but serious condition where the bowel telescopes into itself due to potential lymphoid hyperplasia induced by the vaccine . Management necessitates an urgent referral to a pediatric surgeon for potential surgical intervention to prevent life-threatening complications.&lt;/li&gt;&lt;li&gt;\u27a4 Intussusception post-Rotavirus vaccination&lt;/li&gt;&lt;li&gt;\u27a4 rare&lt;/li&gt;&lt;li&gt;\u27a4 serious condition where the bowel telescopes into itself&lt;/li&gt;&lt;li&gt;\u27a4 potential lymphoid hyperplasia induced by the vaccine&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-195.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-195.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a bustling Monday in a pediatric clinic, you are tasked with overseeing the vaccination schedule amidst a heavy patient load. Amid administering various vaccines, you take the moment to educate your junior staff. You present them with a scenario to identify which vaccine listed is not sensitive to freezing and can be safely stored in a freezer.&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;DPT&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;IPV&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hep B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;MMR&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. MMR&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) MMR&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. DPT is a freeze-sensitive vaccine . If a DPT vaccine is frozen, the pertussis component can be denatured, rendering the vaccine ineffective.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. DPT&lt;/li&gt;&lt;li&gt;\u2022 freeze-sensitive vaccine&lt;/li&gt;&lt;li&gt;\u2022 Option B. IPV is also sensitive to freezing . Freezing can affect the potency of the polio vaccine, leading to a reduced immune response when administered.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B. IPV&lt;/li&gt;&lt;li&gt;\u2022 sensitive to freezing&lt;/li&gt;&lt;li&gt;\u2022 Option C. Hep B is a freeze-sensitive vaccine . Freezing can cause the vaccine to lose its effectiveness, which may result in inadequate protection against the Hepatitis B virus.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Hep B&lt;/li&gt;&lt;li&gt;\u2022 freeze-sensitive vaccine&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Freeze sensitive vaccines include Hep B &amp;gt; HPV &amp;gt;DPT &amp;gt;DT &amp;gt; TT.&lt;/li&gt;&lt;li&gt;\u27a4 Hep B &amp;gt; HPV &amp;gt;DPT &amp;gt;DT &amp;gt; TT.&lt;/li&gt;&lt;li&gt;\u27a4 Freeze dried (Lyophilized) Vaccines are BCG, MMR, Measles, YF vaccine, HiB, JE&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition page 740&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition page 740&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A newborn has just arrived at the Primary Health Center (PHC) under your supervision, and you decide it&#x27;s time to administer the first set of vaccines. As your intern reaches for a vial of the BCG vaccine, you quiz him on the strain used in its preparation. What would his correct response be?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Danish 1331&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Sabin&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Salk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Danish 1431&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Danish 1331&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture12.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture12.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Danish 1331&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Sabin refers to the strain used in the oral polio vaccine (OPV).&lt;/li&gt;&lt;li&gt;\u2022 Option B. Sabin&lt;/li&gt;&lt;li&gt;\u2022 strain used in the oral polio vaccine&lt;/li&gt;&lt;li&gt;\u2022 Option C. Salk refers to the inactivated polio vaccine (IPV) strain .&lt;/li&gt;&lt;li&gt;\u2022 Option C. Salk&lt;/li&gt;&lt;li&gt;\u2022 inactivated polio vaccine&lt;/li&gt;&lt;li&gt;\u2022 strain&lt;/li&gt;&lt;li&gt;\u2022 Option D. Danish 1431 is not a recognized strain for the BCG vaccine.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Danish 1431&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-185.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-185.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 2-month-old infant named Mayur was brought to the clinic by his mother, who reported that he had recently received his routine pertussis vaccination. A few days post-vaccination, Mayur developed a high-pitched cough and experienced difficulty breathing, prompting his mother to seek medical advice. Considering the symptoms described, you consider a potential side effect of the vaccination. Which of the following is the most common side effect associated with the pertussis vaccine?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Fever&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Local pain and swelling at the injection site&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Anaphylaxis&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Pertussis-like symptoms&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Local pain and swelling at the injection site&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Local pain and swelling at the injection site&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Fever is a common side effect but not as prevalent as local reactions at the injection site.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A. Fever&lt;/li&gt;&lt;li&gt;\u2022 common side effect&lt;/li&gt;&lt;li&gt;\u2022 Option C. Anaphylaxis is a rare, severe allergic reaction that can occur with any vaccine but is not common.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C. Anaphylaxis&lt;/li&gt;&lt;li&gt;\u2022 rare, severe allergic reaction&lt;/li&gt;&lt;li&gt;\u2022 Option D. Pertussis-like symptoms , including a high-pitched cough and difficulty breathing , are very rare and unlikely to be caused by the vaccine . The symptoms described by Mayur&#x27;s mother are concerning and warrant further investigation.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D. Pertussis-like symptoms&lt;/li&gt;&lt;li&gt;\u2022 high-pitched cough&lt;/li&gt;&lt;li&gt;\u2022 difficulty breathing&lt;/li&gt;&lt;li&gt;\u2022 very rare&lt;/li&gt;&lt;li&gt;\u2022 caused by the vaccine&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The side effects of Pertussis Vaccine include:&lt;/li&gt;&lt;li&gt;\u27a4 Redness, swelling, or tenderness at the injection site Fever Irritability Fatigue Headache. Loss of appetite Vomiting Diarrhea Seizures (very rare) Allergic reactions (very rare) Pertussis-like symptoms, such as a high-pitched cough and difficulty breathing (common but usually mild and self-limiting)&lt;/li&gt;&lt;li&gt;\u27a4 Redness, swelling, or tenderness at the injection site&lt;/li&gt;&lt;li&gt;\u27a4 Fever&lt;/li&gt;&lt;li&gt;\u27a4 Irritability&lt;/li&gt;&lt;li&gt;\u27a4 Fatigue&lt;/li&gt;&lt;li&gt;\u27a4 Headache.&lt;/li&gt;&lt;li&gt;\u27a4 Loss of appetite&lt;/li&gt;&lt;li&gt;\u27a4 Vomiting&lt;/li&gt;&lt;li&gt;\u27a4 Diarrhea&lt;/li&gt;&lt;li&gt;\u27a4 Seizures (very rare)&lt;/li&gt;&lt;li&gt;\u27a4 Allergic reactions (very rare)&lt;/li&gt;&lt;li&gt;\u27a4 Pertussis-like symptoms, such as a high-pitched cough and difficulty breathing (common but usually mild and self-limiting)&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-193.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-193.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In the outpatient department, a new nurse from the Primary Health Center seeks clarification about the correct diluent to be used with a vaccine she has brought to you. The vaccine in question is shown in the image provided. What is the appropriate diluent for reconstituting this vaccine?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Distilled water.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Normal Saline&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Ringer Lactate.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Dextrose 5%&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Distilled water.&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture15.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Distilled water.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The given vaccine is the image of MMR , the diluent used in this case is Distilled water/ sterile water . It is important to use the correct diluent as provided by the manufacturer to ensure the vaccine&#x27;s efficacy and stability.&lt;/li&gt;&lt;li&gt;\u2022 image of MMR&lt;/li&gt;&lt;li&gt;\u2022 diluent used&lt;/li&gt;&lt;li&gt;\u2022 Distilled water/ sterile water&lt;/li&gt;&lt;li&gt;\u2022 Note - Use within 4 hours after reconstitution with diluent&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Diluents - Normal Saline for BCG and Distilled/Sterile Water for Measles&lt;/li&gt;&lt;li&gt;\u27a4 Diluents&lt;/li&gt;&lt;li&gt;\u27a4 Normal Saline for BCG&lt;/li&gt;&lt;li&gt;\u27a4 Distilled/Sterile Water for Measles&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai Page No- 183-193.&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 OP Ghai Page No- 183-193.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 29 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

</body>
</html>
