&lt;div class=&quot;space-y-3&quot; id=&quot;options&quot;&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;!-- Navigation Buttons --&gt;
&lt;div class=&quot;flex flex-col md:flex-row justify-between items-center gap-2 md:gap-4&quot;&gt;
&lt;button class=&quot;bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition w-full md:w-auto&quot; disabled=&quot;&quot; id=&quot;previous-btn&quot;&gt;Previous&lt;/button&gt;
&lt;button class=&quot;bg-yellow-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-yellow-400 transition w-full md:w-auto&quot; id=&quot;mark-review&quot;&gt;Mark for Review&lt;/button&gt;
&lt;button class=&quot;bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition w-full md:w-auto&quot; id=&quot;next-btn&quot;&gt;Next&lt;/button&gt;
&lt;button class=&quot;bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full md:w-auto&quot; id=&quot;nav-toggle&quot;&gt;Questions Navigation&lt;/button&gt;
&lt;button class=&quot;bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition w-full md:w-auto&quot; id=&quot;submit-test&quot;&gt;Submit Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/section&gt;
&lt;!-- Results Section --&gt;
&lt;section class=&quot;container mx-auto p-4 md:p-6 hidden section-transition&quot; id=&quot;results&quot;&gt;
&lt;div class=&quot;bg-white rounded-lg shadow-md p-4 md:p-6&quot;&gt;
&lt;h2 class=&quot;text-2xl font-semibold mb-4&quot;&gt;Behavioral Disorders - Results&lt;/h2&gt;
&lt;div class=&quot;grid grid-cols-1 md:grid-cols-2 gap-4 mb-6&quot;&gt;
&lt;p&gt;&lt;strong&gt;Correct:&lt;/strong&gt; &lt;span id=&quot;correct-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Wrong:&lt;/strong&gt; &lt;span id=&quot;wrong-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unanswered:&lt;/strong&gt; &lt;span id=&quot;unanswered-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Marked for Review:&lt;/strong&gt; &lt;span id=&quot;marked-count&quot;&gt;0&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;h3 class=&quot;text-lg font-semibold mb-4&quot; id=&quot;result-question-number&quot;&gt;Question &lt;span&gt;1&lt;/span&gt; of 10&lt;/h3&gt;
&lt;div class=&quot;space-y-6&quot; id=&quot;results-content&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;result-nav&quot;&gt;
&lt;button aria-label=&quot;Previous question result&quot; class=&quot;result-nav-btn&quot; disabled=&quot;&quot; id=&quot;prev-result&quot;&gt;Previous&lt;/button&gt;
&lt;button aria-label=&quot;Toggle results navigation panel&quot; class=&quot;result-nav-btn&quot; id=&quot;results-nav-toggle&quot;&gt;Results Navigation&lt;/button&gt;
&lt;button aria-label=&quot;Next question result&quot; class=&quot;result-nav-btn&quot; id=&quot;next-result&quot;&gt;Next&lt;/button&gt;
&lt;/div&gt;
&lt;div class=&quot;mt-6 flex space-x-4 button-group md:flex-row flex-col&quot;&gt;
&lt;button class=&quot;bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition&quot; id=&quot;take-again&quot;&gt;Take Again&lt;/button&gt;
&lt;button class=&quot;bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600 transition&quot; id=&quot;review-test&quot;&gt;Review Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/section&gt;
&lt;!-- Exit Confirmation Modal --&gt;
&lt;div class=&quot;fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden&quot; id=&quot;exit-modal&quot;&gt;
&lt;div class=&quot;bg-white rounded-lg p-6 max-w-sm w-full&quot;&gt;
&lt;h2 class=&quot;text-xl font-semibold mb-4&quot;&gt;Leave Test?&lt;/h2&gt;
&lt;p class=&quot;text-gray-700 mb-4&quot;&gt;Your progress will be lost if you leave this page. Are you sure you want to exit?&lt;/p&gt;
&lt;div class=&quot;flex justify-end space-x-4&quot;&gt;
&lt;button class=&quot;bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition&quot; id=&quot;continue-test&quot;&gt;No, Continue&lt;/button&gt;
&lt;button class=&quot;bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition&quot; id=&quot;exit-test&quot;&gt;Yes, Exit&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;!-- Submit Confirmation Modal --&gt;
&lt;div class=&quot;fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden&quot; id=&quot;submit-modal&quot;&gt;
&lt;div class=&quot;bg-white rounded-lg p-6 max-w-sm w-full&quot;&gt;
&lt;h2 class=&quot;text-xl font-semibold mb-4&quot;&gt;Confirm Submission&lt;/h2&gt;
&lt;p class=&quot;text-gray-700 mb-2&quot;&gt;You have attempted &lt;span id=&quot;attempted-count&quot;&gt;0&lt;/span&gt; of 10 questions.&lt;/p&gt;
&lt;p class=&quot;text-gray-700 mb-4&quot;&gt;&lt;span id=&quot;unattempted-count&quot;&gt;0&lt;/span&gt; questions are unattempted.&lt;/p&gt;
&lt;div class=&quot;flex justify-end space-x-4&quot;&gt;
&lt;button class=&quot;bg-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-400 transition&quot; id=&quot;cancel-submit&quot;&gt;Cancel&lt;/button&gt;
&lt;button class=&quot;bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition&quot; id=&quot;confirm-submit&quot;&gt;Submit Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;!-- Quiz Navigation Panel --&gt;
&lt;div class=&quot;fixed inset-y-0 right-0 nav-panel bg-white shadow-lg p-4 hidden overflow-y-auto&quot; id=&quot;nav-panel&quot;&gt;
&lt;h2 class=&quot;text-lg font-semibold mb-4&quot;&gt;Questions Navigation&lt;/h2&gt;
&lt;div class=&quot;mb-4&quot;&gt;
&lt;select class=&quot;w-full p-2 border rounded-lg text-gray-700&quot; id=&quot;nav-filter&quot;&gt;
&lt;option value=&quot;all&quot;&gt;All Questions&lt;/option&gt;
&lt;option value=&quot;answered&quot;&gt;Answered&lt;/option&gt;
&lt;option value=&quot;unanswered&quot;&gt;Unanswered&lt;/option&gt;
&lt;option value=&quot;marked&quot;&gt;Marked for Review&lt;/option&gt;
&lt;/select&gt;
&lt;/div&gt;
&lt;div class=&quot;grid grid-cols-5 gap-2 md:gap-3&quot; id=&quot;nav-grid&quot;&gt;&lt;/div&gt;
&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- Results Navigation Panel --&gt;
&lt;div class=&quot;fixed inset-y-0 right-0 results-nav-panel bg-white shadow-lg p-4 hidden overflow-y-auto&quot; id=&quot;results-nav-panel&quot;&gt;
&lt;h2 class=&quot;text-lg font-semibold mb-4&quot;&gt;Results Navigation&lt;/h2&gt;
&lt;div class=&quot;mb-4&quot;&gt;
&lt;select class=&quot;w-full p-2 border rounded-lg text-gray-700&quot; id=&quot;results-nav-filter&quot;&gt;
&lt;option value=&quot;all&quot;&gt;All Questions&lt;/option&gt;
&lt;option value=&quot;answered&quot;&gt;Answered&lt;/option&gt;
&lt;option value=&quot;unanswered&quot;&gt;Unanswered&lt;/option&gt;
&lt;option value=&quot;marked&quot;&gt;Marked for Review&lt;/option&gt;
&lt;/select&gt;
&lt;/div&gt;
&lt;div class=&quot;grid grid-cols-5 gap-2 md:gap-3&quot; id=&quot;results-nav-grid&quot;&gt;&lt;/div&gt;
&lt;button class=&quot;mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition w-full&quot; id=&quot;close-results-nav&quot;&gt;Close&lt;/button&gt;
&lt;/div&gt;
&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;A 4-year-old boy is brought to the pediatric clinic by his mother, who is concerned about his delayed speech development and lack of social interactions. She reports that he does not respond when his name is called, avoids making eye contact, and prefers to play alone. The child has a particular interest in lining up his toy cars and becomes extremely upset with any change in routine. His play is repetitive, and he shows little interest in playing with other children. On examination, the pediatrician notes that the child does not follow pointing gestures and does not point at objects to show interest. Based on the clinical presentation, the pediatrician suspects autism spectrum disorder (ASD). Which of the following is a common clinical feature of ASD?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Hyperactivity and impulsivity&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Intellectual disability&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Hypersensitivity to sensory input&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Rapid language acquisition&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Hypersensitivity to sensory input&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Hyperactivity and impulsivity - These symptoms are more characteristic of Attention Deficit Hyperactivity Disorder (ADHD) than ASD. Although some children with ASD can display hyperactivity and impulsivity, these are not core features of ASD.&lt;/li&gt;&lt;li&gt;• Option A.&lt;/li&gt;&lt;li&gt;• Hyperactivity and impulsivity&lt;/li&gt;&lt;li&gt;• characteristic of Attention Deficit Hyperactivity Disorder&lt;/li&gt;&lt;li&gt;• Option B. Intellectual disability - While some individuals with ASD may also have intellectual disability , it is not a defining characteristic of ASD. Intellectual abilities in individuals with ASD can range from superior to severely challenged.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• B.&lt;/li&gt;&lt;li&gt;• Intellectual disability&lt;/li&gt;&lt;li&gt;• individuals with ASD may also have intellectual disability&lt;/li&gt;&lt;li&gt;• Option D. Rapid language acquisition - This is not typically associated with ASD . In fact, individuals with ASD often experience delays in language development, and some may not develop significant spoken language.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• D.&lt;/li&gt;&lt;li&gt;• Rapid language acquisition&lt;/li&gt;&lt;li&gt;• not typically associated with ASD&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ ASD is characterized by challenges in social communication , repetitive behaviors , and in some cases, unusual responses to sensory stimuli , such as hypersensitivity or hyposensitivity . Recognizing these features is crucial for early diagnosis and intervention , which can significantly improve outcomes for children with ASD.&lt;/li&gt;&lt;li&gt;➤ ASD is characterized by challenges in social communication&lt;/li&gt;&lt;li&gt;➤ repetitive behaviors&lt;/li&gt;&lt;li&gt;➤ unusual responses to sensory stimuli&lt;/li&gt;&lt;li&gt;➤ hypersensitivity or hyposensitivity&lt;/li&gt;&lt;li&gt;➤ early diagnosis and intervention&lt;/li&gt;&lt;li&gt;➤ improve outcomes for children with ASD.&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56.&lt;/li&gt;&lt;li&gt;➤ Ref :&lt;/li&gt;&lt;li&gt;➤ O P Ghai 9 th Edition Page No- 56.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 9-year-old boy is brought to the pediatric clinic by his mother due to concerns about his performance in school. His teachers report that he often seems to be \&quot;in his own world\&quot; during class, frequently fails to complete assignments, and is easily distracted by minor noises or movements in the classroom. At home, his mother notes that he forgets to do his chores, has difficulty organizing his tasks, and loses his school supplies regularly. During the evaluation, the boy frequently interrupts the conversation, fidgets in his seat, and struggles to wait his turn to speak. After a thorough evaluation, it is determined that the boy meets 7 of the 9 criteria for inattention according to the DSM-5 guidelines and displays several impulsive behaviors. Which of the following is the most appropriate next step in management?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Give the child a 2-week trial of stimulant medication&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Arrange for special education placement&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Send the child for a complete psychoeducational assessment&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Reassure the child’s mother that this behavior is age appropriate&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Send the child for a complete psychoeducational assessment&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Send the child for a complete psychoeducational assessment&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Give the child a 2-week trial of stimulant medication - While stimulant medications are a cornerstone in the treatment of ADHD , initiating treatment should ideally follow a thorough assessment, including a psychoeducational evaluation, especially in complex cases or when comorbidities are suspected.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• A.&lt;/li&gt;&lt;li&gt;• Give the child a 2-week trial of stimulant medication&lt;/li&gt;&lt;li&gt;• stimulant medications are a cornerstone in the treatment of ADHD&lt;/li&gt;&lt;li&gt;• Option B. Arrange for special education placement - Special education placement may be part of the management for a child with ADHD , but it should be based on a comprehensive assessment of the child&#x27;s educational needs and not as an initial step without a complete evaluation.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• B.&lt;/li&gt;&lt;li&gt;• Arrange for special education placement&lt;/li&gt;&lt;li&gt;• part of the management for a child&lt;/li&gt;&lt;li&gt;• ADHD&lt;/li&gt;&lt;li&gt;• Option D. Reassure the child’s mother that this behavior is age appropriate - This option is inappropriate because the described behaviors significantly impair the child&#x27;s functioning in multiple settings , suggesting that they are beyond typical age-appropriate behavior.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• D.&lt;/li&gt;&lt;li&gt;• Reassure the child’s mother that this behavior is age appropriate&lt;/li&gt;&lt;li&gt;• inappropriate&lt;/li&gt;&lt;li&gt;• described behaviors significantly impair the child&#x27;s functioning in multiple settings&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ The appropriate management steps after an initial ADHD evaluation suggests a comprehensive psychoeducational assessment for confirming the diagnosis , and to rule out other conditions , understand the child&#x27;s unique needs , and guiding the management plan , which may include educational adjustments, behavioral strategies , and medication .&lt;/li&gt;&lt;li&gt;➤ appropriate management steps after an initial ADHD&lt;/li&gt;&lt;li&gt;➤ comprehensive psychoeducational assessment&lt;/li&gt;&lt;li&gt;➤ confirming the diagnosis&lt;/li&gt;&lt;li&gt;➤ rule out other conditions&lt;/li&gt;&lt;li&gt;➤ child&#x27;s unique needs&lt;/li&gt;&lt;li&gt;➤ guiding the management plan&lt;/li&gt;&lt;li&gt;➤ educational adjustments, behavioral strategies&lt;/li&gt;&lt;li&gt;➤ medication&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56.&lt;/li&gt;&lt;li&gt;➤ Ref&lt;/li&gt;&lt;li&gt;➤ : O P Ghai 9 th Edition Page No- 56.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 2-year-old girl is brought to the pediatric clinic by her mother, who is concerned about her daughter&#x27;s developmental progress. The mother reports that her daughter began walking at 18 months, later than most children, and has recently started to lose the ability to use her hands effectively; she often wrings her hands together and has difficulty grasping toys. The child was noted to have microcephaly at her 12-month check-up, and her growth has remained below the 3rd percentile for her age. The pediatrician also notes a history of feeding difficulties, including poor suck and swallow coordination. Given the history of normal early development followed by regression in motor skills, loss of purposeful hand movements, and the presence of stereotypic movements, the pediatrician suspects Rett’s syndrome. Which of the following is a common clinical feature of Rett’s syndrome?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Delayed language development&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hyperactivity and impulsivity&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Abnormalities in facial features&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Progressive loss of motor skills&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Progressive loss of motor skills&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Progressive loss of motor skills&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Delayed language development - While children with Rett’s syndrome may experience delays in language and communication skills , the most distinctive feature of the disorder is the regression in motor skills and the development of stereotypic hand movements.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• A.&lt;/li&gt;&lt;li&gt;• Delayed language development&lt;/li&gt;&lt;li&gt;• children with Rett’s syndrome&lt;/li&gt;&lt;li&gt;• delays in language&lt;/li&gt;&lt;li&gt;• communication skills&lt;/li&gt;&lt;li&gt;• Option B. Hyperactivity and impulsivity - These are not hallmark features of Rett’s syndrome and are more commonly associated with other disorders such as ADHD.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• B.&lt;/li&gt;&lt;li&gt;• Hyperactivity and impulsivity&lt;/li&gt;&lt;li&gt;• not hallmark features of Rett’s syndrome&lt;/li&gt;&lt;li&gt;• Option C. Abnormalities in facial features - While some genetic syndromes are characterized by distinct facial features , Rett’s syndrome is not typically associated with specific abnormalities in facial features.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• C.&lt;/li&gt;&lt;li&gt;• Abnormalities in facial features&lt;/li&gt;&lt;li&gt;• genetic syndromes&lt;/li&gt;&lt;li&gt;• distinct facial features&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ Rett’s syndrome , is a rare genetic neurological and developmental disorder that affects the way the brain develops , resulting in a progressive loss of motor skills and language . Recognizing the pattern of normal development (for the first 6-18 months) followed by regression in motor skills and the presence of stereotypic hand movements is the key to suspecting and diagnosing Rett’s syndrome.&lt;/li&gt;&lt;li&gt;➤ Rett’s syndrome&lt;/li&gt;&lt;li&gt;➤ rare genetic neurological&lt;/li&gt;&lt;li&gt;➤ developmental disorder&lt;/li&gt;&lt;li&gt;➤ affects the way the brain develops&lt;/li&gt;&lt;li&gt;➤ progressive loss of motor skills and language&lt;/li&gt;&lt;li&gt;➤ pattern of normal development&lt;/li&gt;&lt;li&gt;➤ regression in motor skills&lt;/li&gt;&lt;li&gt;➤ presence of stereotypic hand movements&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 60&lt;/li&gt;&lt;li&gt;➤ Ref&lt;/li&gt;&lt;li&gt;➤ : O P Ghai 9 th Edition Page No- 60&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 13-year-old boy is referred to a psychiatric clinic by his school due to concerns about his behavior. Teachers and his parents report a pattern of aggressive outbursts, physical fights, and deliberate destruction of property. The boy has been caught stealing from classmates and lying about his actions on multiple occasions. His academic performance has declined over the past year, and he has been suspended several times for vandalism and fighting. The boy shows little remorse for his actions and tends to blame others for provoking him. His past medical history is unremarkable, and there is no evidence of a significant learning disorder or intellectual disability. Based on the boy&#x27;s history of aggressive behavior, violation of social norms, and lack of empathy, the psychiatrist suspects a neurodevelopmental disorder characterized by these features. Which of the following is a common clinical feature of the suspected disorder?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Conduct disorder&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;ADHD&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Dyslexia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Autism spectrum disorder&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Conduct disorder&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Conduct disorder&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option B. ADHD: Inattention , hyperactivity , and impulsivity are core features of ADHD , along with potential difficulties in executive functions. ADHD does not inherently include aggressive or antisocial behaviors as defining features.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• B. ADHD:&lt;/li&gt;&lt;li&gt;• Inattention&lt;/li&gt;&lt;li&gt;• hyperactivity&lt;/li&gt;&lt;li&gt;• impulsivity&lt;/li&gt;&lt;li&gt;• core features of ADHD&lt;/li&gt;&lt;li&gt;• Option C. Dyslexia: This learning disorder is characterized by difficulties with accurate and/or fluent word recognition and by poor spelling and decoding abilities, not by aggressive or antisocial behavior.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• C. Dyslexia:&lt;/li&gt;&lt;li&gt;• learning disorder&lt;/li&gt;&lt;li&gt;• difficulties with accurate and/or fluent word recognition&lt;/li&gt;&lt;li&gt;• Option D. Autism spectrum disorder: ASD is characterized by difficulties in social communication and repetitive behaviors , but it does not typically include aggressive or antisocial behaviors as defining features unless in response to sensory overload or extreme stress.&lt;/li&gt;&lt;li&gt;• Option&lt;/li&gt;&lt;li&gt;• D. Autism spectrum disorder:&lt;/li&gt;&lt;li&gt;• difficulties in social communication and repetitive behaviors&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ Conduct disorder , a neurodevelopmental disorder characterized by a repetitive and persistent pattern of behavior that violates the rights of others or major societal norms . Recognizing the clinical features of conduct disorder is crucial for early intervention and management, which may include behavioral therapy and family counseling.&lt;/li&gt;&lt;li&gt;➤ Conduct disorder&lt;/li&gt;&lt;li&gt;➤ neurodevelopmental disorder&lt;/li&gt;&lt;li&gt;➤ repetitive and persistent pattern of behavior&lt;/li&gt;&lt;li&gt;➤ violates the rights of others or major societal norms&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56&lt;/li&gt;&lt;li&gt;➤ Ref&lt;/li&gt;&lt;li&gt;➤ : O P Ghai 9 th Edition Page No- 56&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 7-year-old boy is brought to the pediatric clinic by his mother, who is concerned about his frequent episodes of \&quot;daydreaming.\&quot; She reports that during these episodes, which last several seconds and occur multiple times a day, her son appears completely disengaged and unresponsive to verbal cues. Outside of these episodes, the boy is described as attentive and capable of completing tasks without difficulty. His academic performance is satisfactory, and he is not known to be disruptive in the classroom. The mother is worried these episodes are affecting his learning and social interactions. Which of the following is the best next step in management?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Obtain further information from his parents and teachers with the Conners rating scale.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Begin a program of behavioral modification.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Reassure the child’s mother that this behavior is age appropriate.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Send the child for an electroencephalogram.&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Send the child for an electroencephalogram.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Send the child for an electroencephalogram.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation&lt;/li&gt;&lt;li&gt;• :&lt;/li&gt;&lt;li&gt;• Option A. Obtain further information from his parents and teachers with the Conners rating scale - While the Conners rating scale is useful for assessing symptoms of ADHD, the child&#x27;s symptoms are more suggestive of absence seizures than attentional issues, making an EEG a more appropriate next step.&lt;/li&gt;&lt;li&gt;• Option A.&lt;/li&gt;&lt;li&gt;• Obtain further information from his parents and teachers with the Conners rating scale&lt;/li&gt;&lt;li&gt;• Conners rating scale&lt;/li&gt;&lt;li&gt;• assessing symptoms of ADHD,&lt;/li&gt;&lt;li&gt;• Option B. Begin a program of behavioral modification - Behavioral modification is a common approach for managing ADHD and other behavioral issues , but it would not address the underlying issue if the child&#x27;s symptoms are due to absence seizures.&lt;/li&gt;&lt;li&gt;• Option B.&lt;/li&gt;&lt;li&gt;• Begin a program of behavioral modification&lt;/li&gt;&lt;li&gt;• Behavioral modification&lt;/li&gt;&lt;li&gt;• approach for managing ADHD&lt;/li&gt;&lt;li&gt;• behavioral issues&lt;/li&gt;&lt;li&gt;• Option C. Reassure the child’s mother that this behavior is age appropriate - Given the frequency and nature of the episodes, reassurance without further investigation could lead to a delay in the diagnosis and treatment of a potential seizure disorder.&lt;/li&gt;&lt;li&gt;• Option C.&lt;/li&gt;&lt;li&gt;• Reassure the child’s mother that this behavior is age appropriate&lt;/li&gt;&lt;li&gt;• reassurance without further investigation&lt;/li&gt;&lt;li&gt;• delay in the diagnosis&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ Child with symptoms of frequent , brief episodes of apparent daydreaming and unresponsiveness , are suggestive of absence seizures , and an EEG is the appropriate diagnostic test to confirm this diagnosis and guide further management.&lt;/li&gt;&lt;li&gt;➤ Child with symptoms of frequent&lt;/li&gt;&lt;li&gt;➤ brief episodes of apparent daydreaming&lt;/li&gt;&lt;li&gt;➤ unresponsiveness&lt;/li&gt;&lt;li&gt;➤ absence seizures&lt;/li&gt;&lt;li&gt;➤ EEG is the appropriate diagnostic test&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;li&gt;➤ Ref&lt;/li&gt;&lt;li&gt;➤ : O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 8-year-old boy is brought to the outpatient pediatric department by his mother, who expresses concerns that her son might have Attention Deficit Hyperactivity Disorder (ADHD). She describes him as being extremely restless at home, having a persistent inability to focus on tasks, and frequently misplacing his belongings. Despite these concerns, the child appears cooperative during the visit and his physical examination does not reveal any abnormalities. The mother is eager for advice on how to manage her son&#x27;s symptoms and improve his ability to concentrate and remain organized. Which of the following is the best next step in management?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Give the child a 2-week trial of stimulant medication&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Obtain further information from the parents and teachers&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Reassure the child’s mother that this behavior is age appropriate&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Send the child for psychological assessment&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Obtain further information from the parents and teachers&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Obtain further information from the parents and teachers.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Give the child a 2-week trial of stimulant medication - Starting medication without a thorough assessment and definitive diagnosis is inappropriate . Stimulant medications are a mainstay in the treatment of ADHD but should only be considered after a comprehensive evaluation confirms the diagnosis.&lt;/li&gt;&lt;li&gt;• Option A. Give the child a 2-week trial of stimulant medication&lt;/li&gt;&lt;li&gt;• Starting medication without a thorough assessment&lt;/li&gt;&lt;li&gt;• definitive diagnosis is inappropriate&lt;/li&gt;&lt;li&gt;• Option C . Reassure the child’s mother that this behavior is age appropriate - While some level of inattention and restlessness can be normal for children , the mother&#x27;s concerns and the description of the child&#x27;s behavior warrant a thorough evaluation to rule out ADHD or other disorders.&lt;/li&gt;&lt;li&gt;• Option C&lt;/li&gt;&lt;li&gt;• Reassure the child’s mother that this behavior is age appropriate&lt;/li&gt;&lt;li&gt;• some level of inattention&lt;/li&gt;&lt;li&gt;• restlessness&lt;/li&gt;&lt;li&gt;• normal for children&lt;/li&gt;&lt;li&gt;• Option D. Send the child for psychological assessment - While a psychological assessment may be part of the evaluation process for ADHD , the initial step should involve gathering detailed information from those who observe the child in various settings. If the initial information supports the possibility of ADHD, a more in-depth psychological assessment might then be warranted.&lt;/li&gt;&lt;li&gt;• Option D.&lt;/li&gt;&lt;li&gt;• Send the child for psychological assessment&lt;/li&gt;&lt;li&gt;• psychological assessment&lt;/li&gt;&lt;li&gt;• part of the evaluation process for ADHD&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ The initial approach to evaluate a child suspected of having ADHD - Comprehensive evaluation including obtaining a detailed information from parents and teachers , is essential before considering a diagnosis of ADHD and discussing treatment options. This ensures that any intervention is based on a thorough understanding of the child&#x27;s behaviors across different environments.&lt;/li&gt;&lt;li&gt;➤ The initial approach to evaluate a child suspected of having ADHD&lt;/li&gt;&lt;li&gt;➤ Comprehensive evaluation&lt;/li&gt;&lt;li&gt;➤ detailed information from parents and teachers&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;li&gt;➤ Ref :&lt;/li&gt;&lt;li&gt;➤ O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her 10-year-old child to a neurology clinic concerned about her child&#x27;s sudden, involuntary movements. She reports that these movements involve the face and limbs and have been occurring for more than a year. Additionally, she mentions that her child occasionally makes unexpected vocal sounds, such as grunts or throat clearing, which seem involuntary. The child&#x27;s academic performance is good, and there are no concerns regarding cognitive development. However, the repetitive nature of the movements and sounds, along with their involuntary appearance, prompts the neurologist to consider a diagnosis of Tourette&#x27;s syndrome, a type of tic disorder. Which of the following is a common clinical feature of tic disorders?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Impaired coordination and balance&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hyperactivity and impulsivity&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Obsessive-compulsive symptoms&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Difficulty with memory and learning&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Obsessive-compulsive symptoms&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Impaired coordination and balance - This is not a defining feature of tic disorders , although some individuals with tic disorders might have motor tics that temporarily disrupt their coordination or balance.&lt;/li&gt;&lt;li&gt;• Option A.&lt;/li&gt;&lt;li&gt;• Impaired coordination and balance&lt;/li&gt;&lt;li&gt;• not a defining feature of tic disorders&lt;/li&gt;&lt;li&gt;• Option B. Hyperactivity and impulsivity - While ADHD is a common comorbidity with tic disorders , hyperactivity and impulsivity are not clinical features of tic disorders themselves but rather of ADHD.&lt;/li&gt;&lt;li&gt;• Option B.&lt;/li&gt;&lt;li&gt;• Hyperactivity and impulsivity&lt;/li&gt;&lt;li&gt;• ADHD is a common comorbidity with tic disorders&lt;/li&gt;&lt;li&gt;• Option D. Difficulty with memory and learning - Tic disorders do not inherently involve difficulties with memory and learning . Any such difficulties are more likely to be related to comorbid conditions or the social and academic impact of the tics.&lt;/li&gt;&lt;li&gt;• Option D.&lt;/li&gt;&lt;li&gt;• Difficulty with memory and learning&lt;/li&gt;&lt;li&gt;• do not inherently involve difficulties with memory and learning&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective&lt;/li&gt;&lt;li&gt;➤ :&lt;/li&gt;&lt;li&gt;➤ Obsessive-compulsive symptoms are common in individuals with tic disorders , especially those with Tourette&#x27;s syndrome . These symptoms can include repetitive behaviors, intrusive thoughts, and compulsions.&lt;/li&gt;&lt;li&gt;➤ Obsessive-compulsive symptoms&lt;/li&gt;&lt;li&gt;➤ common in individuals with tic disorders&lt;/li&gt;&lt;li&gt;➤ Tourette&#x27;s syndrome&lt;/li&gt;&lt;li&gt;➤ repetitive behaviors, intrusive thoughts, and compulsions.&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;li&gt;➤ Ref :&lt;/li&gt;&lt;li&gt;➤ O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother brings her child to the pediatric clinic concerned about developmental delays. The child has been previously diagnosed with an autosomal recessive disorder resulting from a deficiency of phenylalanine hydroxylase. The child presents with intellectual disability, a common manifestation of this metabolic condition. The pediatrician recognizes this as a classic presentation of Phenylketonuria (PKU), a disorder characterized by an inability to metabolize phenylalanine, leading to its accumulation and subsequent neurotoxic effects. Given the context of genetic disorders and their association with intellectual disability, the pediatrician considers other conditions that might present similarly. All of the following genetic disorders can lead to intellectual disability except?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Galactosemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Phenylketonuria&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Cystic fibrosis&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Neurofibromatosis.&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Cystic fibrosis&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Cystic fibrosis&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Galactosemia - This is a metabolic disorder that can lead to intellectual disability if untreated . It is caused by the inability to metabolize galactose properly.&lt;/li&gt;&lt;li&gt;• Option A.&lt;/li&gt;&lt;li&gt;• Galactosemia&lt;/li&gt;&lt;li&gt;• metabolic disorder&lt;/li&gt;&lt;li&gt;• lead to intellectual disability if untreated&lt;/li&gt;&lt;li&gt;• Option B. Phenylketonuria - PKU is directly related to the case described and is known to cause intellectual disability if not managed with a strict dietary regimen from an early age.&lt;/li&gt;&lt;li&gt;• Option B.&lt;/li&gt;&lt;li&gt;• Phenylketonuria&lt;/li&gt;&lt;li&gt;• directly related to the case described&lt;/li&gt;&lt;li&gt;• Option D. Neurofibromatosis - This genetic disorder can affect the nervous system, including the brain, spinal cord, and nerves. Neurofibromatosis can lead to learning disabilities and intellectual disabilities in some cases.&lt;/li&gt;&lt;li&gt;• Option D.&lt;/li&gt;&lt;li&gt;• Neurofibromatosis&lt;/li&gt;&lt;li&gt;• genetic disorder can affect the nervous system, including the brain, spinal cord, and nerves.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective&lt;/li&gt;&lt;li&gt;➤ :&lt;/li&gt;&lt;li&gt;➤ Common Genetic Disorders associated with Intellectual disability are –&lt;/li&gt;&lt;li&gt;➤ Common Genetic Disorders associated with Intellectual disability are –&lt;/li&gt;&lt;li&gt;➤ Galactosemia Phenylketonuria Homocystinuria Argininemia Lesch-nyhan disease Maple syrup urine disease Tyrosinemia Tuberous sclerosis Neurofibromatosis&lt;/li&gt;&lt;li&gt;➤ Galactosemia&lt;/li&gt;&lt;li&gt;➤ Phenylketonuria&lt;/li&gt;&lt;li&gt;➤ Homocystinuria&lt;/li&gt;&lt;li&gt;➤ Argininemia&lt;/li&gt;&lt;li&gt;➤ Lesch-nyhan disease&lt;/li&gt;&lt;li&gt;➤ Maple syrup urine disease&lt;/li&gt;&lt;li&gt;➤ Tyrosinemia&lt;/li&gt;&lt;li&gt;➤ Tuberous sclerosis&lt;/li&gt;&lt;li&gt;➤ Neurofibromatosis&lt;/li&gt;&lt;li&gt;➤ Ref : Nelson 21 st Edition page 8205&lt;/li&gt;&lt;li&gt;➤ Ref :&lt;/li&gt;&lt;li&gt;➤ Nelson 21 st Edition page 8205&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An 8-year-old child is referred to a psychologist by his school due to persistent academic difficulties, particularly in reading and writing. His teacher reports that despite average intelligence and effort, the child struggles to recognize words, confuses letters that look similar, and has difficulty understanding the sounds letters make. The child&#x27;s mother adds that he had delayed speech milestones and has always found rhyming games challenging, unlike his peers. The psychologist observes the child&#x27;s reading session and notes significant difficulty in decoding simple words, which impacts his reading fluency and comprehension. Given the child&#x27;s history of delayed speech, difficulty with phonological awareness, and specific challenges with reading and writing, dyslexia is suspected. Which of the following is a common clinical feature of dyslexia?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Difficulty with spelling&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Impaired motor coordination&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Difficulty with math&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Rapid language acquisition&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Difficulty with spelling&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Difficulty with spelling&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option B . Impaired motor coordination - While some individuals with dyslexia may experience challenges with motor coordination , it is not a defining feature of dyslexia and is more commonly associated with dyspraxia or developmental coordination disorder.&lt;/li&gt;&lt;li&gt;• Option B&lt;/li&gt;&lt;li&gt;• Impaired motor coordination&lt;/li&gt;&lt;li&gt;• individuals with dyslexia may experience challenges with motor coordination&lt;/li&gt;&lt;li&gt;• Option C. Difficulty with math - Known as dyscalculia, difficulty with math is a distinct condition from dyslexia , which primarily affects reading and related language-based processing skills.&lt;/li&gt;&lt;li&gt;• Option C.&lt;/li&gt;&lt;li&gt;• Difficulty with math&lt;/li&gt;&lt;li&gt;• dyscalculia, difficulty with math is a distinct condition from dyslexia&lt;/li&gt;&lt;li&gt;• Option D. Rapid language acquisition - This is not associated with dyslexia ; in fact, individuals with dyslexia often experience delayed language acquisition, particularly in the areas of speech and phonological awareness.&lt;/li&gt;&lt;li&gt;• Option D.&lt;/li&gt;&lt;li&gt;• Rapid language acquisition&lt;/li&gt;&lt;li&gt;• not associated with dyslexia&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ Dyslexia , a specific learning disorder that involves difficulty in reading due to problems identifying speech sounds and learning how they relate to letters and words (decoding). Recognizing the signs of dyslexia, such as difficulty with spelling and word recognition, is crucial for early intervention and support, which can significantly improve reading skills and academic performance.&lt;/li&gt;&lt;li&gt;➤ Dyslexia&lt;/li&gt;&lt;li&gt;➤ learning disorder that involves difficulty in reading&lt;/li&gt;&lt;li&gt;➤ problems identifying speech sounds&lt;/li&gt;&lt;li&gt;➤ learning how they relate to letters and words&lt;/li&gt;&lt;li&gt;➤ Ref : Nelson 21 st Edition page 1446&lt;/li&gt;&lt;li&gt;➤ Ref&lt;/li&gt;&lt;li&gt;➤ : Nelson 21 st Edition page 1446&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 13-year-old adolescent male is brought to a child psychiatrist by his parents due to concerns about his academic performance and behavior both at home and in school. He has been described as frequently distracted, forgetful in daily activities, and often fails to follow through on tasks and schoolwork. The boy also exhibits fidgetiness, has difficulty remaining seated, and often interrupts others. After a comprehensive evaluation, he has been diagnosed with Attention Deficit Hyperactivity Disorder (ADHD). Given the high comorbidity rates with ADHD, the psychiatrist decides to evaluate the adolescent for coexisting psychiatric disorders to provide a holistic treatment plan. Which of the following psychiatric disorders is the adolescent most likely to have in conjunction with ADHD?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Bipolar disorder&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Oppositional-defiant disorder&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Pervasive developmental disorder&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Posttraumatic stress disorder&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Oppositional-defiant disorder&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Oppositional-defiant disorder&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;• Explanation:&lt;/li&gt;&lt;li&gt;• Option A. Bipolar disorder - While ADHD can coexist with bipolar disorder , it is less common than ODD in individuals with ADHD . Bipolar disorder involves episodes of mood swings ranging from depressive lows to manic highs, which is different from the behavioral issues seen in ODD.&lt;/li&gt;&lt;li&gt;• Option A.&lt;/li&gt;&lt;li&gt;• Bipolar disorder&lt;/li&gt;&lt;li&gt;• ADHD can coexist with bipolar disorder&lt;/li&gt;&lt;li&gt;• less common than ODD in individuals with ADHD&lt;/li&gt;&lt;li&gt;• Option C. Pervasive developmental disorder - This category, primarily associated with autism spectrum disorders , represents a different set of developmental issues than those typically seen in ADHD. The core symptoms involve significant challenges in social interaction and communication.&lt;/li&gt;&lt;li&gt;• Option C.&lt;/li&gt;&lt;li&gt;• Pervasive developmental disorder&lt;/li&gt;&lt;li&gt;• primarily associated with autism spectrum disorders&lt;/li&gt;&lt;li&gt;• Option D. Posttraumatic stress disorder (PTSD) - PTSD can occur in children and adolescents who have experienced or witnessed a traumatic event . While it can coexist with ADHD, it is not as commonly comorbid with ADHD as ODD.&lt;/li&gt;&lt;li&gt;• Option D.&lt;/li&gt;&lt;li&gt;• Posttraumatic stress disorder (PTSD)&lt;/li&gt;&lt;li&gt;• occur in children and adolescents&lt;/li&gt;&lt;li&gt;• witnessed a traumatic event&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;➤ Educational Objective:&lt;/li&gt;&lt;li&gt;➤ Common coexisting psychiatric conditions with ADHD, includes :&lt;/li&gt;&lt;li&gt;➤ Common coexisting psychiatric conditions with ADHD, includes&lt;/li&gt;&lt;li&gt;➤ Oppositional defiant disorder (35.2%), Conduct disorder (25.7%), Anxiety disorder (25.8%), and Depressive disorder (18.2%).&lt;/li&gt;&lt;li&gt;➤ Oppositional defiant disorder (35.2%),&lt;/li&gt;&lt;li&gt;➤ Conduct disorder (25.7%),&lt;/li&gt;&lt;li&gt;➤ Anxiety disorder (25.8%), and&lt;/li&gt;&lt;li&gt;➤ Depressive disorder (18.2%).&lt;/li&gt;&lt;li&gt;➤ Ref : O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;li&gt;➤ Ref&lt;/li&gt;&lt;li&gt;➤ :&lt;/li&gt;&lt;li&gt;➤ O P Ghai 9 th Edition Page No- 56-59&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 20 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

