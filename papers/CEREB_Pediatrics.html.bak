&lt;/div&gt;
&lt;!-- JavaScript Logic --&gt;
&lt;script&gt;
        // Enable debug mode for detailed logging
        const DEBUG_MODE = true;

        // Log debug messages
        function debugLog(message) {
            if (DEBUG_MODE) {
                console.log(`[DEBUG] ${message}`);
            }
        }

        // Initialize questions with error handling
        let questions = [];
        let currentResultQuestion = 0; // State for current question in results
        try {
            debugLog(&quot;Attempting to parse questions_json&quot;);
            questions = [{&quot;text&quot;: &quot;A healthcare provider is assessing a postpartum mother with a viral infection for breastfeeding suitability. Given the mother&#x27;s diagnosis, the provider must decide if breastfeeding should be contraindicated. Which viral infection in the mother commonly requires temporary cessation of breastfeeding?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Hepatitis B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Hepatitis C&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Herpes Simplex&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Varicella Zoster&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Herpes Simplex&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Herpes Simplex&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Hepatitis B is not a contraindication for breastfeeding as long as the infant receives the appropriate vaccinations.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Hepatitis B&lt;/li&gt;&lt;li&gt;\u2022 not a contraindication for breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 Option B: Hepatitis C is generally not considered a contraindication for breastfeeding . Transmission through breast milk is not common, and breastfeeding may continue unless there is nipple bleeding.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Hepatitis C&lt;/li&gt;&lt;li&gt;\u2022 not considered a contraindication for breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 Option D: Varicella Zoster, responsible for chickenpox , is not a contraindication for breastfeeding if the mother has immunity before pregnancy or if the baby has received varicella zoster immune globulin.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Varicella Zoster,&lt;/li&gt;&lt;li&gt;\u2022 chickenpox&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 While most maternal viral infections do not prohibit breastfeeding , certain conditions like active herpes simplex lesions on the breasts can necessitate temporary discontinuation of breastfeeding on the affected side to prevent the risk of neonatal transmission.&lt;/li&gt;&lt;li&gt;\u27a4 maternal viral infections&lt;/li&gt;&lt;li&gt;\u27a4 not prohibit breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 active herpes simplex lesions&lt;/li&gt;&lt;li&gt;\u27a4 breasts&lt;/li&gt;&lt;li&gt;\u27a4 temporary discontinuation of breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 affected side&lt;/li&gt;&lt;li&gt;\u27a4 prevent the risk of neonatal transmission.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A Medical Officer in a Regional healthcare center is addressing concerns of a mother who is worried about her milk supply being inadequate for her infant&#x27;s needs. The MO assures her that breast milk composition typically provides all necessary nutrients in the right amounts. To demonstrate this point, she quizzes the interns present, about the sodium content of breast milk. What is the sodium content in breast milk measured in mEq/L?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;6 mEq/L&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;7 mEq/L&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;8 mEq/L&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;9 mEq/L&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. 7 mEq/L&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture21.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture21.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) 7 mEq/L&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Breast milk has a relatively low sodium content compared to other fluids , which is appropriate for the kidney&#x27;s filtering capacity of an infant . On average, breast milk contains 7 mEq/L of sodium , which meets the infant&#x27;s nutritional requirements without overloading their renal system.&lt;/li&gt;&lt;li&gt;\u2022 Breast milk&lt;/li&gt;&lt;li&gt;\u2022 relatively low sodium content&lt;/li&gt;&lt;li&gt;\u2022 other fluids&lt;/li&gt;&lt;li&gt;\u2022 appropriate for the kidney&#x27;s filtering capacity&lt;/li&gt;&lt;li&gt;\u2022 infant&lt;/li&gt;&lt;li&gt;\u2022 breast milk contains 7 mEq/L of sodium&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother with a recent diagnosis of tuberculosis is being counselled. She is concerned about the risk of transmitting the infection to her newborn through breastfeeding. The Pediatrician advises her on when it would be safe to resume breastfeeding after starting antitubercular therapy. For how many weeks should breastfeeding be avoided after initiating antitubercular therapy?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;1 week&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;2 weeks&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;3 weeks&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;4 weeks&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. 2 weeks&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) 2 weeks&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Breastfeeding is generally contraindicated in mothers with tuberculosis until they have been on antitubercular therapy for a sufficient period to minimize the risk of transmitting the infection to the infant . The mother should avoid breastfeeding for the initial 2 weeks of treatment , as this is typically the period necessary for the mother to become non-infectious.&lt;/li&gt;&lt;li&gt;\u2022 Breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 contraindicated in mothers with tuberculosis&lt;/li&gt;&lt;li&gt;\u2022 antitubercular therapy for a sufficient period&lt;/li&gt;&lt;li&gt;\u2022 minimize the risk of transmitting the infection to the infant&lt;/li&gt;&lt;li&gt;\u2022 mother should avoid breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 initial 2 weeks of treatment&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The recommendations for breastfeeding in the context of maternal tuberculosis and antitubercular therapy . Mothers can often resume breastfeeding safely after the infectious period has passed , which is generally after the first 2 weeks of therapy.&lt;/li&gt;&lt;li&gt;\u27a4 recommendations for breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 maternal tuberculosis&lt;/li&gt;&lt;li&gt;\u27a4 antitubercular therapy&lt;/li&gt;&lt;li&gt;\u27a4 Mothers&lt;/li&gt;&lt;li&gt;\u27a4 resume breastfeeding safely&lt;/li&gt;&lt;li&gt;\u27a4 infectious period has passed&lt;/li&gt;&lt;li&gt;\u27a4 after the first 2 weeks of therapy.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 32-year-old working mother in a multinational company brings her 3-month-old infant to your clinic for a routine pediatric visit. After returning to work postpartum, she expresses a desire to transition her baby from breast milk to cow&#x27;s milk due to her busy schedule. She inquires about the nutritional differences between human milk and cow&#x27;s milk, specifically asking which component is present in higher quantities in human milk compared to cow&#x27;s milk. Which of the following is the correct response?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Lactose&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Calcium&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Protein&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Fat&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Lactose&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/09/14/screenshot-2024-09-14-123244.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/09/14/screenshot-2024-09-14-123244.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Lactose&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B. Calcium: Cow&#x27;s milk actually contains higher levels of calcium than human milk . However, the bioavailability of calcium in human milk is better, meaning infants can absorb it more efficiently.&lt;/li&gt;&lt;li&gt;\u2022 Option B. Calcium:&lt;/li&gt;&lt;li&gt;\u2022 contains higher levels of calcium than human milk&lt;/li&gt;&lt;li&gt;\u2022 Option C. Protein: Cow&#x27;s milk contains a higher concentration of total protein than human milk . The protein composition in cow&#x27;s milk is also different, which can be harder for infants to digest and may lead to an increased risk of allergic reactions.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Protein:&lt;/li&gt;&lt;li&gt;\u2022 higher concentration of total protein than human milk&lt;/li&gt;&lt;li&gt;\u2022 Option D. Fat: While the total fat content may be similar in both human and cow&#x27;s milk , the composition of fat in human milk is uniquely suited to the human infant&#x27;s needs, including essential fatty acids crucial for brain development that are not present in cow&#x27;s milk in the same ratios.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Fat:&lt;/li&gt;&lt;li&gt;\u2022 total fat content may be similar in both human&lt;/li&gt;&lt;li&gt;\u2022 cow&#x27;s milk&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : OP Ghai 9 th Page No- 145.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : OP Ghai 9 th Page No- 145.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 30-year-old first-time mother has just given birth to a healthy baby boy and is eager to begin breastfeeding. She consults you for advice on starting breastfeeding. Knowing that breastfeeding can typically commence immediately following a normal vaginal delivery, you review her medical history and note she has untreated tuberculosis, which is a known contraindication to breastfeeding. Concerned for the well-being of both mother and child, you plan to discuss alternative feeding options. Based on this scenario, which of the following are also considered contraindications to breastfeeding?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Galactosemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Active HSV of the breast&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Both A and B&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Only A&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Both A and B&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Both A and B&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 :&lt;/li&gt;&lt;li&gt;\u2022 Option A: Galactosemia in the infant is a rare genetic metabolic disorder where the infant cannot properly metabolize galactose , a sugar present in milk . Breastfeeding is contraindicated in infants with galactosemia because it can lead to serious complications , including liver damage , sepsis , and intellectual disability .&lt;/li&gt;&lt;li&gt;\u2022 Option A: Galactosemia&lt;/li&gt;&lt;li&gt;\u2022 infant is a rare genetic metabolic disorder&lt;/li&gt;&lt;li&gt;\u2022 infant cannot properly metabolize galactose&lt;/li&gt;&lt;li&gt;\u2022 sugar present in milk&lt;/li&gt;&lt;li&gt;\u2022 Breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 contraindicated&lt;/li&gt;&lt;li&gt;\u2022 infants with galactosemia&lt;/li&gt;&lt;li&gt;\u2022 lead to serious complications&lt;/li&gt;&lt;li&gt;\u2022 liver damage&lt;/li&gt;&lt;li&gt;\u2022 sepsis&lt;/li&gt;&lt;li&gt;\u2022 intellectual disability&lt;/li&gt;&lt;li&gt;\u2022 Option B: Active HSV lesions on the breast pose a risk of transmitting the virus to the infant during breastfeeding. If the lesions are present on the breast , direct breastfeeding is contraindicated to prevent neonatal herpes , a potentially severe infection in newborns. However, if the lesions are not on the breast, breastfeeding can continue with precautions, including covering the lesions and practicing meticulous hand hygiene.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Active HSV&lt;/li&gt;&lt;li&gt;\u2022 breast pose a risk of transmitting the virus&lt;/li&gt;&lt;li&gt;\u2022 infant during breastfeeding.&lt;/li&gt;&lt;li&gt;\u2022 lesions&lt;/li&gt;&lt;li&gt;\u2022 present on the breast&lt;/li&gt;&lt;li&gt;\u2022 direct breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 contraindicated to prevent neonatal herpes&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Infant with Galactosemia and Active HSV of the breast are the contraindications of Breastfeeding.&lt;/li&gt;&lt;li&gt;\u27a4 Infant with Galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 Active HSV of the breast&lt;/li&gt;&lt;li&gt;\u27a4 Breastfeeding.&lt;/li&gt;&lt;li&gt;\u27a4 Absolute contraindications to Breastfeeding are&lt;/li&gt;&lt;li&gt;\u27a4 contraindications to Breastfeeding are&lt;/li&gt;&lt;li&gt;\u27a4 HIV in the developed world Active HSV of the breast Mother on radiotherapy Galactosemia Chemotherapy drugs Infant galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 HIV in the developed world&lt;/li&gt;&lt;li&gt;\u27a4 Active HSV of the breast&lt;/li&gt;&lt;li&gt;\u27a4 Mother on radiotherapy&lt;/li&gt;&lt;li&gt;\u27a4 Galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 Chemotherapy drugs&lt;/li&gt;&lt;li&gt;\u27a4 Infant galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 Relative contraindications&lt;/li&gt;&lt;li&gt;\u27a4 Relative contraindications&lt;/li&gt;&lt;li&gt;\u27a4 Active untreated TB Active drug use (Meth, Cocaine, Heroin THC controversial)&lt;/li&gt;&lt;li&gt;\u27a4 Active untreated TB&lt;/li&gt;&lt;li&gt;\u27a4 Active drug use (Meth, Cocaine, Heroin THC controversial)&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 3793-3794.&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 3793-3794.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 28-year-old woman has just given birth to her first child, a healthy baby boy, via uncomplicated vaginal delivery at a local hospital that is known for its adherence to the Baby-Friendly Hospital Initiative (BFHI). She is eager to start breastfeeding and asks for guidance to ensure the best start for her newborn. As her pediatrician, you discuss the BFHI guidelines with her to support her breastfeeding journey. Which of the following pieces of advice would NOT be consistent with the Baby-Friendly Hospital Initiative guidelines?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Mothers and infant to be together for 24 hours a day&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Mother to initiate breast feeding within 3 hours of normal delivery&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Giving newborn infants no food or drink other then breast milk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Encouraging breast feeding on demand&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. Mother to initiate breast feeding within 3 hours of normal delivery&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) Mother to initiate breast feeding within 3 hours of normal delivery&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A. Mothers and infants to be together 24 hours a day: This guideline is part of the BFHI and is critical for promoting bonding , facilitating breastfeeding on demand, and helping both the mother and infant to recognize each other&#x27;s cues.&lt;/li&gt;&lt;li&gt;\u2022 Option A. Mothers and infants to be together 24 hours a day:&lt;/li&gt;&lt;li&gt;\u2022 part of the BFHI&lt;/li&gt;&lt;li&gt;\u2022 critical for promoting bonding&lt;/li&gt;&lt;li&gt;\u2022 Option C. Giving newborn infants no food or drink other than breast milk, unless medically indicated : This is a core principle of the BFHI . Exclusive breastfeeding is recommended for the first six months of life to achieve optimal growth, development, and health.&lt;/li&gt;&lt;li&gt;\u2022 Option C. Giving newborn infants no food or drink other than breast milk,&lt;/li&gt;&lt;li&gt;\u2022 unless medically indicated&lt;/li&gt;&lt;li&gt;\u2022 core principle of the BFHI&lt;/li&gt;&lt;li&gt;\u2022 Option D. Encouraging breastfeeding on demand: This guideline aligns with the BFHI&#x27;s emphasis on feeding infants whenever they show signs of hunger , which supports effective breastfeeding and ensures the infant&#x27;s needs are met promptly.&lt;/li&gt;&lt;li&gt;\u2022 Option D. Encouraging breastfeeding on demand:&lt;/li&gt;&lt;li&gt;\u2022 guideline aligns with the BFHI&#x27;s emphasis on feeding infants&lt;/li&gt;&lt;li&gt;\u2022 signs of hunger&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Baby- Friendly practices&lt;/li&gt;&lt;li&gt;\u27a4 Baby- Friendly practices&lt;/li&gt;&lt;li&gt;\u27a4 Have a written breastfeeding policy that is routinely communicated to all health care staff Train all health care staff in skills necessary to implement this policy Inform all pregnant women about the benefits and management of breastfeeding Help mothers initiate breastfeeding with 1 hour of birth Show mothers h ow to breastfeed and how to maintain lactation, even if they should be separated from their infants Give newborn infants no food or drink other than breast milk unless medically indicated Practice \u201crooming in\u201d by allowing mothers and infants to remain together 24h/d Encourage breastfeeding on demand Give no artificial teats, pacifiers, dummies, or soothers to breastfeeding infants Foster the establishment of breastfeeding support groups and refer mothers to them on discharge from the hospital or clinic&lt;/li&gt;&lt;li&gt;\u27a4 Have a written breastfeeding policy that is routinely communicated to all health care staff&lt;/li&gt;&lt;li&gt;\u27a4 Train all health care staff in skills necessary to implement this policy&lt;/li&gt;&lt;li&gt;\u27a4 Inform all pregnant women about the benefits and management of breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 Help mothers initiate breastfeeding with 1 hour of birth&lt;/li&gt;&lt;li&gt;\u27a4 Show mothers h ow to breastfeed and how to maintain lactation, even if they should be separated from their infants&lt;/li&gt;&lt;li&gt;\u27a4 Give newborn infants no food or drink other than breast milk unless medically indicated&lt;/li&gt;&lt;li&gt;\u27a4 Practice \u201crooming in\u201d by allowing mothers and infants to remain together 24h/d&lt;/li&gt;&lt;li&gt;\u27a4 Encourage breastfeeding on demand&lt;/li&gt;&lt;li&gt;\u27a4 Give no artificial teats, pacifiers, dummies, or soothers to breastfeeding infants&lt;/li&gt;&lt;li&gt;\u27a4 Foster the establishment of breastfeeding support groups and refer mothers to them on discharge from the hospital or clinic&lt;/li&gt;&lt;li&gt;\u27a4 EBF should be initiated as soon as possible (NVD it is 30 minutes)&lt;/li&gt;&lt;li&gt;\u27a4 EBF should be initiated as soon as possible (NVD it is 30 minutes)&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Op Ghai 8 th Edition. Page No- From 97.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Op Ghai 8 th Edition. Page No- From 97.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A 6-month-old infant is brought to a well-baby clinic in a suburban area near Mumbai for a routine check-up. The mother is a first-time parent and is concerned about her baby&#x27;s nutrition, as she has been exclusively breastfeeding. She reports that the baby is active, achieving developmental milestones appropriately, and has good urine output. However, she is worried if her breast milk alone is sufficient for the baby&#x27;s nutritional needs, especially considering the energy and nutrient requirements for optimal growth. The pediatrician decides to educate her about the nutritional content of breast milk. Considering the average composition of breast milk, how much energy (in kcal) and what amounts of protein, fat, and carbohydrates (in grams) would you expect to find in 100 ml of breast milk?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;67 kcal, 1.1g protein, 4g fat, 7.4g carbohydrates&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;97 kcal, 1.1g protein, 4g fat, 7.4g carbohydrates&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;67 kcal, 7.1g protein, 4g fat, 7.4g carbohydrates&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;77 kcal, 2.1g protein, 5.7g fat, 4.8g carbohydrates&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. 67 kcal, 1.1g protein, 4g fat, 7.4g carbohydrates&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) 67 kcal, 1.1g protein, 4g fat, 7.4g carbohydrates&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Breast milk is known for its optimal mix of nutrients , vital for the growth and development of infants . On average, each 100 ml of breast milk provides about 67 kcal of energy . It contains approximately 1.1 grams of protein , which is essential for growth and development . The 4 grams of fat in breast milk are crucial for brain development and provide a significant portion of the energy. The 7.4 grams of carbohydrates , primarily lactose , not only supply energy but also aid in the absorption of calcium.&lt;/li&gt;&lt;li&gt;\u2022 Breast milk&lt;/li&gt;&lt;li&gt;\u2022 optimal mix of nutrients&lt;/li&gt;&lt;li&gt;\u2022 vital for the growth&lt;/li&gt;&lt;li&gt;\u2022 development of infants&lt;/li&gt;&lt;li&gt;\u2022 each 100 ml of breast milk provides about 67 kcal of energy&lt;/li&gt;&lt;li&gt;\u2022 approximately 1.1 grams of protein&lt;/li&gt;&lt;li&gt;\u2022 growth and development&lt;/li&gt;&lt;li&gt;\u2022 4 grams of fat in breast milk&lt;/li&gt;&lt;li&gt;\u2022 brain development&lt;/li&gt;&lt;li&gt;\u2022 7.4 grams of carbohydrates&lt;/li&gt;&lt;li&gt;\u2022 lactose&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Breast milk provides a balanced mix of energy , protein, fat, and carbohydrates , making it the ideal food for infants.&lt;/li&gt;&lt;li&gt;\u27a4 Breast milk&lt;/li&gt;&lt;li&gt;\u27a4 balanced mix of energy&lt;/li&gt;&lt;li&gt;\u27a4 protein, fat, and carbohydrates&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 3789&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 3789&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A pediatrician demonstrates a feeding technique to a mother who is unable to breastfeed due to a recent surgery. Which feeding method is being demonstrated in the below image?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Supplementary suckling technique&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Breastfeeding&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Cup feeding&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Supplementary suckling technique&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/04/30/picture1.jpg&quot;], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Supplementary suckling technique&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B: Breastfeeding typically involves direct latching to the breast without the aid of devices; thus, it is not the correct answer.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 involves direct latching to the breast&lt;/li&gt;&lt;li&gt;\u2022 Option D: Cup feeding is another alternative feeding method where a baby is fed using a small cup , which is not what is depicted in the image.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: Cup feeding&lt;/li&gt;&lt;li&gt;\u2022 alternative feeding method&lt;/li&gt;&lt;li&gt;\u2022 baby is fed using a small cup&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Supplementary suckling technique helps to maintain the breastfeeding bond and stimulates milk production while ensuring the baby receives adequate nutrition.&lt;/li&gt;&lt;li&gt;\u27a4 Supplementary suckling technique&lt;/li&gt;&lt;li&gt;\u27a4 maintain the breastfeeding bond&lt;/li&gt;&lt;li&gt;\u27a4 stimulates milk production&lt;/li&gt;&lt;li&gt;\u27a4 baby receives adequate nutrition.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 3789&lt;/li&gt;&lt;li&gt;\u27a4 Ref :&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 3789&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a clinical session, a pediatrician discusses the nutritional aspects of various milk options. The discussion turns to the topic of Vitamin K, which is crucial for blood clotting and bone development. The students are presented with three different milk sources for infants and are asked to arrange them in descending order of Vitamin K content. Which of the following represents the correct sequence?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;More in formula milk &amp;gt; cow milk &amp;gt; breast milk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;More in cow&#x27;s milk &amp;gt; breast milk &amp;gt; formula milk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;More in cow&#x27;s milk &amp;gt; buffalo milk &amp;gt; breast milk&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;More in cow&#x27;s milk &amp;gt; formula milk &amp;gt; breast milk&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. More in cow&#x27;s milk &gt; formula milk &gt; breast milk&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) More in cow&#x27;s milk &amp;gt; formula milk &amp;gt; breast milk&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Cow&#x27;s milk naturally contains higher levels of Vitamin K compared to human breast milk . While infant formula is fortified with various vitamins , the amount of Vitamin K is usually less than that found in cow&#x27;s milk but more than that in human breast milk. The answer reflects the typical Vitamin K content hierarchy among the given milk sources.&lt;/li&gt;&lt;li&gt;\u2022 Cow&#x27;s milk naturally contains higher levels of Vitamin K&lt;/li&gt;&lt;li&gt;\u2022 human breast milk&lt;/li&gt;&lt;li&gt;\u2022 infant formula is fortified&lt;/li&gt;&lt;li&gt;\u2022 various vitamins&lt;/li&gt;&lt;li&gt;\u2022 amount of Vitamin K&lt;/li&gt;&lt;li&gt;\u2022 less than that found in cow&#x27;s milk&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Breast milk is deficient vitamin d , vitamin k and vitamin b 12 ( if mother is a pure vegetarian)&lt;/li&gt;&lt;li&gt;\u27a4 Breast milk&lt;/li&gt;&lt;li&gt;\u27a4 deficient vitamin d&lt;/li&gt;&lt;li&gt;\u27a4 vitamin k&lt;/li&gt;&lt;li&gt;\u27a4 vitamin b 12&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a discussion about the prevention of mother-to-child transmission of HIV, a pediatrician is advising a postpartum patient with HIV on feeding practices for her newborn. The pediatrician emphasizes the importance of one feeding method to reduce the risk of transmission. Which feeding method is contraindicated for infants born to HIV-positive mothers due to an increased risk of transmission?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Exclusive breastfeeding only&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Replacement feeding only&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Mixed feeding&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Mixed feeding&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Mixed feeding&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Exclusive breastfeeding is recommended when replacement feeding (like formula) is not acceptable , feasible , affordable , sustainable , and safe (AFASS criteria). When these conditions are met, exclusive breastfeeding for the first six months, combined with antiretroviral therapy (ART) for the mother, can be a safe option.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Exclusive breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 replacement feeding&lt;/li&gt;&lt;li&gt;\u2022 not acceptable&lt;/li&gt;&lt;li&gt;\u2022 feasible&lt;/li&gt;&lt;li&gt;\u2022 affordable&lt;/li&gt;&lt;li&gt;\u2022 sustainable&lt;/li&gt;&lt;li&gt;\u2022 safe&lt;/li&gt;&lt;li&gt;\u2022 Option B: Replacement feeding with formula or animal milk may be recommended if it meets the AFASS criteria and if the mother has access to a regular supply of nutritionally adequate and safe formula, as well as the means to prepare it safely.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Replacement feeding&lt;/li&gt;&lt;li&gt;\u2022 formula or animal milk&lt;/li&gt;&lt;li&gt;\u2022 recommended&lt;/li&gt;&lt;li&gt;\u2022 meets the AFASS criteria&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The key takeaway is that mixed feeding increases the risk of HIV transmission , while exclusive breastfeeding and replacement feeding have their indications based on specific criteria and availability of safe alternatives.&lt;/li&gt;&lt;li&gt;\u27a4 key takeaway&lt;/li&gt;&lt;li&gt;\u27a4 mixed feeding increases the risk of HIV transmission&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A new mother asks about the differences in the composition of breast milk throughout a feeding session. She is curious about what the \&quot;hind milk,\&quot; produced towards the end of the feeding, is known to be particularly rich in. What is the primary nutrient that hind milk is rich in?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Fat&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Amino Acids&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A + B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Fat&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Fat&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Hind milk , which is the milk at the end of a breastfeeding session , is rich in fat . This higher fat content contributes to its satiety value , helping the infant feel full and satisfied after feeding , and it is essential for the baby&#x27;s growth and energy .&lt;/li&gt;&lt;li&gt;\u2022 Hind milk&lt;/li&gt;&lt;li&gt;\u2022 milk at the end of a breastfeeding session&lt;/li&gt;&lt;li&gt;\u2022 rich in fat&lt;/li&gt;&lt;li&gt;\u2022 higher fat content&lt;/li&gt;&lt;li&gt;\u2022 satiety value&lt;/li&gt;&lt;li&gt;\u2022 infant feel full and satisfied after feeding&lt;/li&gt;&lt;li&gt;\u2022 baby&#x27;s growth and energy&lt;/li&gt;&lt;li&gt;\u2022 Note - Amino acids are the building blocks of proteins, and while they are present in all milk, they are not specifically abundant in hind milk compared to the foremilk .&lt;/li&gt;&lt;li&gt;\u2022 Note - Amino acids are the building blocks of proteins, and while they are present in all milk, they are not specifically abundant in hind milk compared to the foremilk&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Foremilk , the initial milk expressed at the start of feeding , is typically higher in vitamins and protein . In contrast, hind milk is rich in fat and provides the calories needed for the infant to grow and feel satiated . This is crucial for advising breastfeeding mothers about the importance of allowing the baby to feed until they naturally release the breast, ensuring they receive both the foremilk and the hind milk.&lt;/li&gt;&lt;li&gt;\u27a4 Foremilk&lt;/li&gt;&lt;li&gt;\u27a4 initial milk expressed at the start of feeding&lt;/li&gt;&lt;li&gt;\u27a4 higher in vitamins and protein&lt;/li&gt;&lt;li&gt;\u27a4 hind milk is rich in fat&lt;/li&gt;&lt;li&gt;\u27a4 provides the calories needed for the infant to grow and feel satiated&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a clinic, a pediatrician discusses with new parents the complex composition of breast milk and its benefits beyond basic nutrition. She highlights a specific component that plays a crucial role in the development and healing of the infant&#x27;s digestive system, especially important for premature babies or those with gastrointestinal issues. Which component in breast milk is specifically known for its role in aiding the repair of the infant&#x27;s intestinal lining?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Secretory IgA&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Lactoferrin&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Cytokines&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Epidermal Growth Factor&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Epidermal Growth Factor&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Epidermal Growth Factor&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Secretory IgA is primarily involved in providing immunity to the infant , not in tissue repair.&lt;/li&gt;&lt;li&gt;\u2022 Option A: Secretory IgA&lt;/li&gt;&lt;li&gt;\u2022 providing immunity to the infant&lt;/li&gt;&lt;li&gt;\u2022 Option B: Lactoferrin has antibacterial properties and supports the infant&#x27;s immune system rather than directly repairing tissues.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Lactoferrin&lt;/li&gt;&lt;li&gt;\u2022 antibacterial properties&lt;/li&gt;&lt;li&gt;\u2022 supports the infant&#x27;s immune system&lt;/li&gt;&lt;li&gt;\u2022 Option C: Cytokines are involved in immune responses and signalling , rather than the direct repair of the intestinal lining.&lt;/li&gt;&lt;li&gt;\u2022 Option C: Cytokines&lt;/li&gt;&lt;li&gt;\u2022 involved in immune responses&lt;/li&gt;&lt;li&gt;\u2022 signalling&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The presence of EGF in breast milk is support the structural development and healing of the infant&#x27;s intestinal tract , thereby enhancing overall gastrointestinal health.&lt;/li&gt;&lt;li&gt;\u27a4 presence of EGF in breast milk&lt;/li&gt;&lt;li&gt;\u27a4 support the structural development&lt;/li&gt;&lt;li&gt;\u27a4 healing of the infant&#x27;s intestinal tract&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A mother, anxious about her newborn&#x27;s nutrition, consults a nurse about breastfeeding effectiveness. The nurse reassures her by explaining the natural changes in breast fullness associated with milk production and removal. She mentions a particular postpartum day by which the mother can expect her breasts to feel noticeably emptier after each feed, indicating a well-established feeding pattern and effective milk removal. What is this significant day postpartum?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Day 1&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Day 2&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Day 4&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Day 6&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Day 6&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Day 6&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation&lt;/li&gt;&lt;li&gt;\u2022 Option A, Option B, Option C : These earlier days are part of the initial milk production phase , where the feeling of breast fullness might still be adjusting and does not necessarily indicate the efficiency of breastfeeding.&lt;/li&gt;&lt;li&gt;\u2022 Option A, Option B, Option C&lt;/li&gt;&lt;li&gt;\u2022 earlier days are part of the initial milk production phase&lt;/li&gt;&lt;li&gt;\u2022 feeling of breast fullness&lt;/li&gt;&lt;li&gt;\u2022 adjusting&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The reduction in breast fullness after feeds by day 6 is a positive sign of effective breastfeeding , providing reassurance to new mothers about their breastfeeding journey.&lt;/li&gt;&lt;li&gt;\u27a4 reduction in breast fullness after feeds by day 6&lt;/li&gt;&lt;li&gt;\u27a4 positive sign of effective breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 reassurance to new mothers&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A working mother concerned about maintaining her breast milk supply for her newborn consults a lactation expert. The expert emphasizes the importance of mimicking the baby&#x27;s natural feeding frequency to maintain milk production, even when separated. She advises a minimum number of daily expressions to ensure lactation is sustained. What is the recommended minimum frequency of milk expression for a mother to maintain an adequate supply?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;3-4 times/day&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;4-6 times/day&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;6-8 times/day&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;8-10 times/day&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. 8-10 times/day&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) 8-10 times/day&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A, Option B, Option C : These frequencies might be insufficient for some mothers to maintain an optimal milk supply, potentially leading to a decrease in lactation over time.&lt;/li&gt;&lt;li&gt;\u2022 Option A, Option B, Option C&lt;/li&gt;&lt;li&gt;\u2022 frequencies might be insufficient&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The necessity of expressing milk 8-10 times a day for working mothers or those unable to breastfeed directly , ensuring the continuation of lactation and the availability of breast milk for the infant.&lt;/li&gt;&lt;li&gt;\u27a4 necessity of expressing milk 8-10 times a day for working mothers&lt;/li&gt;&lt;li&gt;\u27a4 unable to breastfeed directly&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A pediatrician is counseling new parents on the nutritional needs of their newborn. While discussing the comprehensive benefits of breast milk, she points out a limitation regarding its Vitamin D content. She explains that breast milk has a certain range of Vitamin D per liter, which is not sufficient to meet the daily requirements of an infant, necessitating supplementation. What is the average Vitamin D content in breast milk?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;4-10 U&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;400 U&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;100-200 U&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;12-60 U&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. 12-60 U&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) 12-60 U&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Breast milk contains between 12-60 units of Vitamin D per liter , which is below the recommended daily intake for infants. Given this deficiency, supplemental Vitamin D is advised for breastfed infants to ensure they receive adequate amounts for healthy bone development.&lt;/li&gt;&lt;li&gt;\u2022 Breast milk contains between 12-60 units of Vitamin D per liter&lt;/li&gt;&lt;li&gt;\u2022 supplemental Vitamin D is advised for breastfed infants&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Mother\u2019s milk is deficient in vitamin D \u2013 it has 12-60 units of vitamin D .&lt;/li&gt;&lt;li&gt;\u27a4 Mother\u2019s milk is deficient in vitamin D&lt;/li&gt;&lt;li&gt;\u27a4 12-60 units of vitamin D&lt;/li&gt;&lt;li&gt;\u27a4 A term newborn baby is given around 400 international units &amp;amp; preterm 800-1000 IU of vitamin D till 1 year of life&lt;/li&gt;&lt;li&gt;\u27a4 term newborn baby is given around 400 international units&lt;/li&gt;&lt;li&gt;\u27a4 preterm 800-1000 IU of vitamin D&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a routine checkup, a neonatologist discusses Kangaroo Mother Care (KMC) with the parents of a premature infant. The doctor emphasizes the benefits of KMC for both the infant and the parents but notes that there&#x27;s an ideal weight at which KMC is generally initiated to ensure the infant&#x27;s safety and well-being. What is the minimum weight recommended for starting KMC with a hemodynamically stable infant?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;1 kg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;1.5 kg&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;1.8 kg&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;2 kg&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. 1.8 kg&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) 1.8 kg&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Kangaroo Mother Care is typically recommended for infants weighing at least 1.8 kg who are also hemodynamically stable , as this weight suggests a level of physiological stability conducive to the practice .&lt;/li&gt;&lt;li&gt;\u2022 Kangaroo Mother Care&lt;/li&gt;&lt;li&gt;\u2022 infants weighing at least 1.8 kg&lt;/li&gt;&lt;li&gt;\u2022 hemodynamically stable&lt;/li&gt;&lt;li&gt;\u2022 level of physiological stability conducive to the practice&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Kangaroo Mother Care , a method beneficial for the development and bonding of infants , especially preterm ones , is typically initiated when an infant reaches a certain weight threshold , ensuring the practice&#x27;s safety and effectiveness.&lt;/li&gt;&lt;li&gt;\u27a4 Kangaroo Mother Care&lt;/li&gt;&lt;li&gt;\u27a4 development and bonding of infants&lt;/li&gt;&lt;li&gt;\u27a4 preterm ones&lt;/li&gt;&lt;li&gt;\u27a4 initiated when an infant reaches a certain weight threshold&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a discussion on infant care practices, a pediatrician highlights the importance of post-feeding positioning to reduce the risk of a particular syndrome. She advises against placing the infant in a prone position immediately after feeding to minimize this risk. What condition is primarily being prevented by this recommendation?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Sudden Infant Death Syndrome (SIDS)&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Bradycardia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A+B&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Sudden Infant Death Syndrome (SIDS)&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Sudden Infant Death Syndrome (SIDS)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The recommendation to avoid the prone position immediately after feeding is primarily aimed at reducing the risk of Sudden Infant Death Syndrome (SIDS), as this position can compromise an infant&#x27;s airway and breathing post-feeding .&lt;/li&gt;&lt;li&gt;\u2022 prone position immediately after feeding&lt;/li&gt;&lt;li&gt;\u2022 aimed at reducing the risk of Sudden Infant Death Syndrome&lt;/li&gt;&lt;li&gt;\u2022 compromise an infant&#x27;s airway&lt;/li&gt;&lt;li&gt;\u2022 breathing post-feeding&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The aim is to reinforce safe infant care practices , particularly the avoidance of the prone position immediately after feeding , to lower the risk of Sudden Infant Death Syndrome (SIDS), thereby promoting safer sleep and care environments for infants.&lt;/li&gt;&lt;li&gt;\u27a4 aim is to reinforce safe infant care practices&lt;/li&gt;&lt;li&gt;\u27a4 avoidance of the prone position&lt;/li&gt;&lt;li&gt;\u27a4 after feeding&lt;/li&gt;&lt;li&gt;\u27a4 lower the risk of Sudden Infant Death Syndrome&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a breastfeeding support group session, a nurse explains the physiological mechanisms facilitating successful breastfeeding. She elaborates on a crucial reflex that enables milk flow from the glands to the nipple, essential for effective feeding. This reflex is triggered by the infant&#x27;s suckling and is known by a more common term in lactation discussions. What is the widely recognized name for the draught reflex, crucial for the breastfeeding process?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Milk Ejection Reflex / Let Down Reflex&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Milk Secretion Reflex&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Milk Discharge Reflex&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;This is an Abnormal Phenomenon&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Milk Ejection Reflex / Let Down Reflex&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Milk Ejection Reflex / Let Down Reflex&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The draught reflex , integral to successful breastfeeding , is more commonly referred to as the Milk Ejection Reflex or the Let Down Reflex . This reflex is crucial for moving milk from the mammary glands to the ducts and then to the nipple , facilitating breastfeeding.&lt;/li&gt;&lt;li&gt;\u2022 draught reflex&lt;/li&gt;&lt;li&gt;\u2022 integral to successful breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 Milk Ejection Reflex or the Let Down Reflex&lt;/li&gt;&lt;li&gt;\u2022 moving milk from the mammary glands&lt;/li&gt;&lt;li&gt;\u2022 ducts&lt;/li&gt;&lt;li&gt;\u2022 then to the nipple&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Milk Ejection Reflex (also known as the Draught Reflex or Let Down Reflex) is a key physiological process in breastfeeding , enabling the transfer of milk from the mother to the infant and ensuring effective lactation.&lt;/li&gt;&lt;li&gt;\u27a4 Milk Ejection Reflex&lt;/li&gt;&lt;li&gt;\u27a4 physiological process in breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 transfer of milk from the mother to the infant&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a routine pediatric visit, a doctor assesses a mother and her newborn to ensure effective breastfeeding. She observes the breastfeeding technique, focusing on the baby&#x27;s latch and attachment, which are pivotal for successful feeding. The doctor looks for specific signs indicating a good latch, contributing to an efficient and comfortable breastfeeding experience for both the mother and the infant. Which of the following represents the correct combination of signs indicative of good attachment? Chin touching the breast Mouth wide open with fullness of cheeks Lower lip everted out Upper areola exposed out&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Only option 1 is right&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Only option 2 is right&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Only options 1, 2, and 3 are right&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Options 1, 2, 3, and 4 are right&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Options 1, 2, 3, and 4 are right&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Options 1, 2, 3, and 4 are right&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Good attachment is characterized by the infant&#x27;s chin touching the breast , a wide-open mouth with full cheeks , the lower lip everted outwards , and more of the upper areola being visible , ensuring efficient milk transfer and a comfortable breastfeeding experience .&lt;/li&gt;&lt;li&gt;\u2022 Good attachment&lt;/li&gt;&lt;li&gt;\u2022 infant&#x27;s chin touching the breast&lt;/li&gt;&lt;li&gt;\u2022 wide-open mouth with full cheeks&lt;/li&gt;&lt;li&gt;\u2022 lower lip everted outwards&lt;/li&gt;&lt;li&gt;\u2022 more of the upper areola being visible&lt;/li&gt;&lt;li&gt;\u2022 efficient milk transfer&lt;/li&gt;&lt;li&gt;\u2022 comfortable breastfeeding experience&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The critical signs of good attachment during breastfeeding , including the infant&#x27;s chin , mouth , cheeks , lips , and areola positioning , which are essential for effective milk transfer and a positive breastfeeding experience.&lt;/li&gt;&lt;li&gt;\u27a4 critical signs of good attachment&lt;/li&gt;&lt;li&gt;\u27a4 breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 infant&#x27;s chin&lt;/li&gt;&lt;li&gt;\u27a4 mouth&lt;/li&gt;&lt;li&gt;\u27a4 cheeks&lt;/li&gt;&lt;li&gt;\u27a4 lips&lt;/li&gt;&lt;li&gt;\u27a4 areola positioning&lt;/li&gt;&lt;li&gt;\u27a4 effective milk transfer&lt;/li&gt;&lt;li&gt;\u27a4 positive breastfeeding experience.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A common misconception is addressed regarding which hormone is responsible for milk production versus milk ejection. Is it true or false that prolactin oozes out the milk, and oxytocin produces the milk?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;True&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;False&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;No updates available&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;B. False&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. B) False&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The statement is false . Prolactin is the hormone responsible for stimulating milk production within the mammary glands . In contrast, oxytocin triggers the milk ejection reflex , enabling the milk to be released from the nipple .&lt;/li&gt;&lt;li&gt;\u2022 false&lt;/li&gt;&lt;li&gt;\u2022 Prolactin&lt;/li&gt;&lt;li&gt;\u2022 hormone&lt;/li&gt;&lt;li&gt;\u2022 stimulating milk production within the mammary glands&lt;/li&gt;&lt;li&gt;\u2022 oxytocin triggers the milk ejection reflex&lt;/li&gt;&lt;li&gt;\u2022 milk to be released from the nipple&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Remember P = P&lt;/li&gt;&lt;li&gt;\u27a4 P = P&lt;/li&gt;&lt;li&gt;\u27a4 PROLACTIN PRODUCES THE MILK&lt;/li&gt;&lt;li&gt;\u27a4 PROLACTIN PRODUCES THE MILK&lt;/li&gt;&lt;li&gt;\u27a4 O=O&lt;/li&gt;&lt;li&gt;\u27a4 OXYTOCIN OOZES OUT THE MILK&lt;/li&gt;&lt;li&gt;\u27a4 OXYTOCIN OOZES OUT THE MILK&lt;/li&gt;&lt;li&gt;\u27a4 Role of Prolactin and Oxytocin in lactation: prolactin for milk production and oxytocin for the milk ejection reflex.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a discussion on the nutritional composition of breast milk, a lactation expert emphasizes the importance of understanding the key nutrients that contribute to infant growth and development. She points out that breast milk contains a predominant carbohydrate that not only serves as a crucial energy source for infants but also aids in the absorption of calcium and other minerals. What is the primary carbohydrate found in breast milk, known for its sweet taste and nutritional benefits?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Lactose&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Galactocerebrosidase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Minerals&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A+B&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. Lactose&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) Lactose&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Lactose is the predominant carbohydrate in breast milk , contributing to its sweet taste . It plays a vital role in providing energy to the infant and facilitating the absorption of essential minerals , such as calcium.&lt;/li&gt;&lt;li&gt;\u2022 Lactose&lt;/li&gt;&lt;li&gt;\u2022 predominant carbohydrate in breast milk&lt;/li&gt;&lt;li&gt;\u2022 sweet taste&lt;/li&gt;&lt;li&gt;\u2022 providing energy to the infant&lt;/li&gt;&lt;li&gt;\u2022 facilitating the absorption of essential minerals&lt;/li&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B: Galactocerebrosidase is an enzyme , not a carbohydrate.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Galactocerebrosidase&lt;/li&gt;&lt;li&gt;\u2022 enzyme&lt;/li&gt;&lt;li&gt;\u2022 Option C: Minerals are a component of breast milk but not carbohydrates.&lt;/li&gt;&lt;li&gt;\u2022 Option C: Minerals&lt;/li&gt;&lt;li&gt;\u2022 component of breast milk&lt;/li&gt;&lt;li&gt;\u2022 Option D: Combining lactose and galactocerebrosidase does not make sense in this context, as the question asks for the predominant carbohydrate.&lt;/li&gt;&lt;li&gt;\u2022 Option D: Combining lactose and galactocerebrosidase&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Lactose is the primary carbohydrate in breast milk , providing energy and supporting the absorption of minerals , highlighting the nutritional completeness of breast milk for infant growth and development.&lt;/li&gt;&lt;li&gt;\u27a4 Lactose&lt;/li&gt;&lt;li&gt;\u27a4 primary carbohydrate in breast milk&lt;/li&gt;&lt;li&gt;\u27a4 energy and supporting the absorption of minerals&lt;/li&gt;&lt;li&gt;\u27a4 nutritional completeness of breast milk&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a nutrition-based seminar, a speaker discusses the critical components of breast milk that support the neurological development of infants. One particular fatty acid in breast milk is highlighted for its significant role in the growth and development of the central nervous system and visual acuity. Which fatty acid is recognized for its crucial contribution to brain and eye development in infants?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;TGF Beta&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Para Amino Benzoic Acid&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Docosahexaenoic Acid (DHA)&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the Above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Docosahexaenoic Acid (DHA)&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Docosahexaenoic Acid (DHA)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: TGF Beta is involved in immune regulation, not directly related to CNS or eye development.&lt;/li&gt;&lt;li&gt;\u2022 Option A: TGF Beta is involved in immune regulation,&lt;/li&gt;&lt;li&gt;\u2022 CNS or eye development.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Para Amino Benzoic Acid is not a fatty acid linked to CNS or eye development in the context of breast milk.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Para Amino Benzoic Acid&lt;/li&gt;&lt;li&gt;\u2022 fatty acid linked to CNS or eye development&lt;/li&gt;&lt;li&gt;\u2022 Option D: None of the Above is incorrect as DHA is indeed present in breast milk and crucial for CNS and eye development.&lt;/li&gt;&lt;li&gt;\u2022 Option D: None of the Above&lt;/li&gt;&lt;li&gt;\u2022 incorrect&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Docosahexaenoic Acid (DHA) is a key component in breast milk essential for the development of the infant&#x27;s brain and eyes, underscoring the importance of breast milk in supporting early neurological and visual development.&lt;/li&gt;&lt;li&gt;\u27a4 Docosahexaenoic Acid&lt;/li&gt;&lt;li&gt;\u27a4 breast milk&lt;/li&gt;&lt;li&gt;\u27a4 development of the infant&#x27;s brain&lt;/li&gt;&lt;li&gt;\u27a4 eyes,&lt;/li&gt;&lt;li&gt;\u27a4 importance of breast milk&lt;/li&gt;&lt;li&gt;\u27a4 early neurological and visual development.&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a pediatric care unit, a nurse educates a concerned mother whose newborn is experiencing jaundice. She explains that a certain component in breast milk can contribute to this condition, known as breast milk jaundice, which typically appears in the first week of life and can persist longer than typical newborn jaundice. This component affects bilirubin metabolism and promotes enterohepatic circulation of bilirubin. What is this component associated with breast milk jaundice?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;3 Alpha 20 Beta Diol &amp;amp; Beta Glucuronidase enzyme&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Galactokinase&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;No component available&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;20 Beta Prednione&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. 3 Alpha 20 Beta Diol &amp; Beta Glucuronidase enzyme&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) 3 Alpha 20 Beta Diol &amp;amp; Beta Glucuronidase enzyme&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option B: Galactokinase is involved in carbohydrate metabolism , not directly related to bilirubin metabolism and jaundice.&lt;/li&gt;&lt;li&gt;\u2022 Option B: Galactokinase&lt;/li&gt;&lt;li&gt;\u2022 carbohydrate metabolism&lt;/li&gt;&lt;li&gt;\u2022 Option C: This option is incorrect as there are known components in breast milk that can contribute to jaundice.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C: This option&lt;/li&gt;&lt;li&gt;\u2022 components in breast milk&lt;/li&gt;&lt;li&gt;\u2022 contribute to jaundice.&lt;/li&gt;&lt;li&gt;\u2022 Option D: 20 Beta Prednione is not a recognized component in breast milk affecting bilirubin metabolism.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 D: 20 Beta Prednione&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Certain components in breast milk , specifically 3 Alpha 20 Beta Diol and Beta Glucuronidase , can contribute to the development of breast milk jaundice by affecting bilirubin metabolism and promoting its enterohepatic circulation , leading to a prolonged jaundice period in affected infants .&lt;/li&gt;&lt;li&gt;\u27a4 breast milk&lt;/li&gt;&lt;li&gt;\u27a4 3 Alpha 20 Beta Diol&lt;/li&gt;&lt;li&gt;\u27a4 Beta Glucuronidase&lt;/li&gt;&lt;li&gt;\u27a4 development of breast milk jaundice&lt;/li&gt;&lt;li&gt;\u27a4 affecting bilirubin metabolism&lt;/li&gt;&lt;li&gt;\u27a4 promoting its enterohepatic circulation&lt;/li&gt;&lt;li&gt;\u27a4 prolonged jaundice period&lt;/li&gt;&lt;li&gt;\u27a4 affected infants&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1799&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1799&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;For each pathogen listed in Column A, select the protective component from Column B that breast milk provides to help guard the infant against that particular pathogen. Match the pathogen with the correct breast milk component:&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;A-4, B-3, C-1, D-2&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;A-2, B-3, C-1, D-4&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;A-3, B-1, C-4, D-2&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A-4, B-3, C-2, D-1&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. A-4, B-3, C-1, D-2&quot;, &quot;question_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture22.jpg&quot;], &quot;explanation_images&quot;: [&quot;https://cerebellum-web-static.s3.amazonaws.com/media/public/images/2024/03/22/picture23.jpg&quot;], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) A-4, B-3, C-1, D-2&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 The Bifidus Factor is known to help protect infants from intestinal pathogens such as Shigella . Lysozyme has antibacterial properties effective against E. histolytica . Lactoferrin , with its iron-binding capability , inhibits the growth of G. lamblia. Para Amino Benzoic Acid (PABA) is believed to provide protection against malaria.&lt;/li&gt;&lt;li&gt;\u2022 The Bifidus Factor is known to help protect infants from intestinal pathogens such as Shigella .&lt;/li&gt;&lt;li&gt;\u2022 Bifidus Factor&lt;/li&gt;&lt;li&gt;\u2022 help protect infants&lt;/li&gt;&lt;li&gt;\u2022 intestinal pathogens such as Shigella&lt;/li&gt;&lt;li&gt;\u2022 Lysozyme has antibacterial properties effective against E. histolytica .&lt;/li&gt;&lt;li&gt;\u2022 Lysozyme&lt;/li&gt;&lt;li&gt;\u2022 antibacterial properties effective against E. histolytica&lt;/li&gt;&lt;li&gt;\u2022 Lactoferrin , with its iron-binding capability , inhibits the growth of G. lamblia.&lt;/li&gt;&lt;li&gt;\u2022 Lactoferrin&lt;/li&gt;&lt;li&gt;\u2022 iron-binding capability&lt;/li&gt;&lt;li&gt;\u2022 Para Amino Benzoic Acid (PABA) is believed to provide protection against malaria.&lt;/li&gt;&lt;li&gt;\u2022 Para Amino Benzoic Acid&lt;/li&gt;&lt;li&gt;\u2022 protection against malaria.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref&lt;/li&gt;&lt;li&gt;\u27a4 : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A dietitian calculates the daily caloric needs of infants based on their weight using the Holiday-Segar Formula. A mother presents with her 7 kg baby, and the dietitian sets out to determine the infant&#x27;s daily kilocalorie requirement. Using the standard caloric requirements per kilogram of body weight for infants, how many kilocalories per day does this 7 kg baby require?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;700 kcal&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;800 kcal&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;900 kcal&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;1000 kcal&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. 700 kcal&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) 700 kcal&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 According to the Holiday-Segar Formula , infants weighing 1-10 kg require 100 kcal/kg/day . Therefore, a 7 kg baby would require 700 kcal/day (7 kg x 100 kcal/kg/day).&lt;/li&gt;&lt;li&gt;\u2022 Holiday-Segar Formula&lt;/li&gt;&lt;li&gt;\u2022 infants weighing 1-10 kg&lt;/li&gt;&lt;li&gt;\u2022 100 kcal/kg/day&lt;/li&gt;&lt;li&gt;\u2022 7 kg baby would require 700 kcal/day&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Holiday-Segar Formula \u2013 The kilocalories requirement is&lt;/li&gt;&lt;li&gt;\u27a4 Holiday-Segar Formula&lt;/li&gt;&lt;li&gt;\u27a4 kilocalories requirement&lt;/li&gt;&lt;li&gt;\u27a4 1-10 kg babies \u2013100 kcal per kg&lt;/li&gt;&lt;li&gt;\u27a4 10-20 kg - 50 kcal / kg&lt;/li&gt;&lt;li&gt;\u27a4 &amp;gt;20 kg - 20 kcal/ kg&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1780&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1780&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A pediatrician is reviewing metabolic disorders and their clinical presentations with medical residents. The topic of galactosemia and its associated symptoms arises. Based on the latest updates in medical knowledge, the pediatrician poses a question about the correlation between galactosemia and macrocephaly. Does galactosemia cause macrocephaly?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;True&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;False&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Partially true&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;No updates available&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;A. True&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. A) True&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Galactosemia is a metabolic disorder that can lead to macrocephaly , among other symptoms. This is due to the accumulation of galactose in the blood , which can affect multiple organ systems , including the brain.&lt;/li&gt;&lt;li&gt;\u2022 Galactosemia&lt;/li&gt;&lt;li&gt;\u2022 metabolic disorder&lt;/li&gt;&lt;li&gt;\u2022 lead to macrocephaly&lt;/li&gt;&lt;li&gt;\u2022 accumulation of galactose in the blood&lt;/li&gt;&lt;li&gt;\u2022 affect multiple organ systems&lt;/li&gt;&lt;li&gt;\u2022 brain.&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The absolute contraindication of breast feeding is galactosemia and it can cause macrocephaly in the baby&lt;/li&gt;&lt;li&gt;\u27a4 absolute contraindication of breast feeding&lt;/li&gt;&lt;li&gt;\u27a4 galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 cause macrocephaly in the baby&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;In a Neonatal intensive care unit, a neonatologist assesses a newborn delivered at 27 weeks of gestation to determine the appropriate method of nutritional support. Given the infant&#x27;s premature status, the neonatologist must choose the safest and most effective route of feeding. Which method of nutrition is most appropriate for a newborn at this stage of gestational development?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Breastfeeding&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Paladai Feed&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Katori Spoon Feed&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;IV Fluids&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. IV Fluids&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) IV Fluids&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Breastfeeding is typically not possible for infants born at 27 weeks due to underdeveloped suck-swallow coordination and the high risk of aspiration.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 not possible for infants born at 27 weeks&lt;/li&gt;&lt;li&gt;\u2022 underdeveloped suck-swallow coordination&lt;/li&gt;&lt;li&gt;\u2022 Option B &amp;amp; C: Paladai Feed and Katori Spoon Feed are methods used for slightly older preterm infants who have more mature gastrointestinal systems.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B &amp;amp; C: Paladai Feed and Katori Spoon&lt;/li&gt;&lt;li&gt;\u2022 methods used for slightly older preterm infants&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 &amp;lt; 28 weeks: Intravenous fluids&lt;/li&gt;&lt;li&gt;\u27a4 28-32 weeks: nasogastric / orogastric feeding&lt;/li&gt;&lt;li&gt;\u27a4 32-34 weeks: paladai feed&lt;/li&gt;&lt;li&gt;\u27a4 &amp;gt;34 weeks: breast feeding&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;During a session on infant feeding in areas with high rates of HIV, a public health specialist outlines the conditions that must be met for replacement feeding to be considered a suitable alternative to breastfeeding. These criteria are designed to ensure the safety and health of the infant where breastfeeding is contraindicated. What does AFASS stand for in the context of replacement feeding?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Acceptable, Unaffordable, Feasible, Sustainable &amp;amp; Safe&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Acceptable, Affordable, Unfeasible, Sustainable &amp;amp; Safe&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Partially Acceptable, Affordable, Feasible, Sustainable &amp;amp; Safe&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Acceptable, Affordable, Feasible, Sustainable &amp;amp; Safe&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. Acceptable, Affordable, Feasible, Sustainable &amp; Safe&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) Acceptable, Affordable, Feasible, Sustainable &amp;amp; Safe&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Replacement feeding options should be Acceptable to the caregiver and family , Affordable within the family&#x27;s budget , Feasible to implement consistently and correctly, Sustainable over time , and Safe from contaminants and pathogens .&lt;/li&gt;&lt;li&gt;\u2022 Replacement feeding&lt;/li&gt;&lt;li&gt;\u2022 Acceptable to the caregiver and family&lt;/li&gt;&lt;li&gt;\u2022 Affordable within the family&#x27;s budget&lt;/li&gt;&lt;li&gt;\u2022 Feasible to implement consistently&lt;/li&gt;&lt;li&gt;\u2022 Sustainable over time&lt;/li&gt;&lt;li&gt;\u2022 Safe from contaminants and pathogens&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 To comprehend the AFASS criteria for replacement feeding , which ensure that non-breastfeeding options are safe and practical for infants who cannot be breastfed , particularly in contexts where HIV transmission risk must be minimized.&lt;/li&gt;&lt;li&gt;\u27a4 comprehend the AFASS criteria&lt;/li&gt;&lt;li&gt;\u27a4 replacement feeding&lt;/li&gt;&lt;li&gt;\u27a4 ensure that non-breastfeeding options are safe&lt;/li&gt;&lt;li&gt;\u27a4 practical for infants&lt;/li&gt;&lt;li&gt;\u27a4 cannot be breastfed&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1796&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A breastfeeding mother inquiries about nighttime feeds and their impact on milk production. The lactation consultant explains that a certain hormone, which plays a pivotal role in milk synthesis, is secreted in higher amounts during the night. Which hormone increases in secretion during the night, making nighttime breastfeeding beneficial for milk supply?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Oxytocin&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Progesterone&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Prolactin&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;A+B&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Prolactin&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) Prolactin&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Prolactin , known as the milk-producing hormone , has higher levels of secretion during the night . This is why nighttime breastfeeding is often recommended to help maintain a robust milk supply .&lt;/li&gt;&lt;li&gt;\u2022 Prolactin&lt;/li&gt;&lt;li&gt;\u2022 milk-producing hormone&lt;/li&gt;&lt;li&gt;\u2022 higher levels of secretion during the night&lt;/li&gt;&lt;li&gt;\u2022 nighttime breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 help maintain a robust milk supply&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The significance of prolactin in lactation , especially its increased nocturnal secretion , which supports the rationale for encouraging nighttime breastfeeding to enhance and maintain milk production .&lt;/li&gt;&lt;li&gt;\u27a4 prolactin in lactation&lt;/li&gt;&lt;li&gt;\u27a4 increased nocturnal secretion&lt;/li&gt;&lt;li&gt;\u27a4 rationale for encouraging nighttime breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 enhance and maintain milk production&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1799&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1799&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;A pediatrician is discussing weaning with a group of parents. She introduces the concept of &#x27;token breastfeeding\u2019. Which of the following best describes token breastfeeding?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;If an infant mostly has breastfed and less outside food, it is called as token breastfeeding.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;If an infant mostly has other food with no breastfeeds, it is called as token breastfeeding.&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;If an infant mostly has other food, but still breastfeeds occasionally, it is called as token breastfeeding.&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;None of the above&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. If an infant mostly has other food, but still breastfeeds occasionally, it is called as token breastfeeding.&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. C) If an infant mostly has other food, but still breastfeeds occasionally, it is called as token breastfeeding.&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Token breastfeeding occurs when an infant primarily consumes foods other than breast milk but still engages in occasional breastfeeding sessions.&lt;/li&gt;&lt;li&gt;\u2022 Token breastfeeding&lt;/li&gt;&lt;li&gt;\u2022 infant primarily consumes foods&lt;/li&gt;&lt;li&gt;\u2022 breast milk&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 Token breastfeeding is the practice where infants primarily eat complementary foods but continue to breastfeed on a non-nutritive basis , typically as a means of comfort or routine .&lt;/li&gt;&lt;li&gt;\u27a4 Token breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 infants primarily eat complementary foods&lt;/li&gt;&lt;li&gt;\u27a4 continue to breastfeed on a non-nutritive basis&lt;/li&gt;&lt;li&gt;\u27a4 means of comfort or routine&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1795&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1795&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}, {&quot;text&quot;: &quot;An intern is reviewing contraindications for breastfeeding. He must identify scenarios where breastfeeding would not be advisable for the infant&#x27;s safety. Which of the following conditions is considered a contraindication to breastfeeding?&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Mother on chemo or radiotherapy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Galactosemia&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Lactose intolerance&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;All of the above&quot;, &quot;correct&quot;: true}], &quot;correct_answer&quot;: &quot;D. All of the above&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Ans. D) All of the above&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;Explanation:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u2022 Explanation:&lt;/li&gt;&lt;li&gt;\u2022 Option A: Mothers undergoing chemotherapy or radiotherapy may excrete toxic substances in breast milk that could harm the infant.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 A: Mothers undergoing chemotherapy or radiotherapy&lt;/li&gt;&lt;li&gt;\u2022 excrete toxic substances in breast milk&lt;/li&gt;&lt;li&gt;\u2022 Option B: Infants with galactosemia cannot metabolize the galactose in breast milk , leading to serious complications.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 B: Infants with galactosemia&lt;/li&gt;&lt;li&gt;\u2022 cannot metabolize the galactose in breast milk&lt;/li&gt;&lt;li&gt;\u2022 Option C: While true lactose intolerance in infants is rare, if present, it would necessitate an alternative to lactose-containing breast milk.&lt;/li&gt;&lt;li&gt;\u2022 Option&lt;/li&gt;&lt;li&gt;\u2022 C: While true lactose intolerance in infants is rare,&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;&lt;strong&gt;Educational Objective:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\u27a4 Educational Objective:&lt;/li&gt;&lt;li&gt;\u27a4 The contraindications to breastfeeding , includes maternal treatments such as chemotherapy or radiotherapy and certain metabolic conditions in the infant , such as galactosemia .&lt;/li&gt;&lt;li&gt;\u27a4 contraindications&lt;/li&gt;&lt;li&gt;\u27a4 breastfeeding&lt;/li&gt;&lt;li&gt;\u27a4 maternal treatments such as chemotherapy&lt;/li&gt;&lt;li&gt;\u27a4 radiotherapy&lt;/li&gt;&lt;li&gt;\u27a4 certain metabolic conditions&lt;/li&gt;&lt;li&gt;\u27a4 infant&lt;/li&gt;&lt;li&gt;\u27a4 galactosemia&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1797&lt;/li&gt;&lt;li&gt;\u27a4 Ref : Nelson 21 st Edition, Page No 1797&lt;/li&gt;&lt;/ul&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;&quot;}];
            if (!Array.isArray(questions) || questions.length === 0) {
                throw new Error(&quot;Questions data is empty or invalid&quot;);
            }
            debugLog(`Successfully parsed ${questions.length} questions`);
        } catch (e) {
            console.error(&quot;Failed to parse questions_json:&quot;, e);
            document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error loading quiz data. Please check the console for details or contact support.&quot;;
            document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            document.getElementById(&#x27;start-test&#x27;).disabled = true;
            // Fallback to sample questions for testing
            questions = [
                {
                    text: &quot;What is 2 + 2?&quot;,
                    options: [
                        { label: &quot;A&quot;, text: &quot;3&quot;, correct: false },
                        { label: &quot;B&quot;, text: &quot;4&quot;, correct: true },
                        { label: &quot;C&quot;, text: &quot;5&quot;, correct: false },
                        { label: &quot;D&quot;, text: &quot;6&quot;, correct: false }
                    ],
                    correct_answer: &quot;B. 4&quot;,
                    question_images: [],
                    explanation_images: [],
                    explanation: &quot;&lt;p&gt;2 + 2 = 4&lt;/p&gt;&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;,
                    bot: &quot;@dams_new_robot&quot;,
                    audio: &quot;&quot;,
                    video: &quot;&quot;
                }
            ];
            debugLog(&quot;Loaded fallback questions&quot;);
        }

        // Quiz state
        let currentQuestion = 0;
        let answers = new Array(questions.length).fill(null);
        let markedForReview = new Array(questions.length).fill(false);
        let timeRemaining = 41 * 60; // Duration in seconds
        let timerInterval = null;
        const quizId = `{title.replace(/\s+/g, &#x27;_&#x27;).toLowerCase()}`; // Unique ID for local storage

        // Load saved progress
        function loadProgress() {
            try {
                debugLog(&quot;Loading progress from localStorage&quot;);
                const saved = localStorage.getItem(`quiz_${quizId}`);
                if (saved) {
                    const { savedAnswers, savedMarked, savedTime } = JSON.parse(saved);
                    answers = savedAnswers || answers;
                    markedForReview = savedMarked || markedForReview;
                    timeRemaining = savedTime !== undefined ? savedTime : timeRemaining;
                    debugLog(&quot;Progress loaded successfully&quot;);
                } else {
                    debugLog(&quot;No saved progress found&quot;);
                }
            } catch (e) {
                console.error(&quot;Error loading progress:&quot;, e);
                debugLog(&quot;Failed to load progress: &quot; + e.message);
            }
        }

        // Save progress
        function saveProgress() {
            try {
                debugLog(&quot;Saving progress to localStorage&quot;);
                localStorage.setItem(`quiz_${quizId}`, JSON.stringify({
                    savedAnswers: answers,
                    savedMarked: markedForReview,
                    savedTime: timeRemaining
                }));
                debugLog(&quot;Progress saved successfully&quot;);
            } catch (e) {
                console.error(&quot;Error saving progress:&quot;, e);
                debugLog(&quot;Failed to save progress: &quot; + e.message);
            }
        }

        // Initialize quiz
        function initQuiz() {
            try {
                debugLog(&quot;Initializing quiz&quot;);
                loadProgress();
                const startButton = document.getElementById(&#x27;start-test&#x27;);
                if (!startButton) {
                    throw new Error(&quot;Start test button not found&quot;);
                }
                startButton.addEventListener(&#x27;click&#x27;, startQuiz);
                debugLog(&quot;Start test button listener attached&quot;);
                document.getElementById(&#x27;previous-btn&#x27;).addEventListener(&#x27;click&#x27;, showPreviousQuestion);
                document.getElementById(&#x27;next-btn&#x27;).addEventListener(&#x27;click&#x27;, showNextQuestion);
                document.getElementById(&#x27;mark-review&#x27;).addEventListener(&#x27;click&#x27;, toggleMarkForReview);
                document.getElementById(&#x27;nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;submit-test&#x27;).addEventListener(&#x27;click&#x27;, showSubmitModal);
                document.getElementById(&#x27;continue-test&#x27;).addEventListener(&#x27;click&#x27;, closeExitModal);
                document.getElementById(&#x27;exit-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Exiting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;cancel-submit&#x27;).addEventListener(&#x27;click&#x27;, closeSubmitModal);
                document.getElementById(&#x27;confirm-submit&#x27;).addEventListener(&#x27;click&#x27;, submitTest);
                document.getElementById(&#x27;take-again&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; {
                    debugLog(&quot;Restarting test&quot;);
                    localStorage.removeItem(`quiz_${quizId}`);
                    window.location.reload();
                });
                document.getElementById(&#x27;review-test&#x27;).addEventListener(&#x27;click&#x27;, () =&gt; showResults(currentResultQuestion));
                document.getElementById(&#x27;close-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleNavPanel);
                document.getElementById(&#x27;theme-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleTheme);
                document.getElementById(&#x27;nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateNavPanel);
                document.getElementById(&#x27;prev-result&#x27;).addEventListener(&#x27;click&#x27;, showPreviousResult);
                document.getElementById(&#x27;next-result&#x27;).addEventListener(&#x27;click&#x27;, showNextResult);
                document.getElementById(&#x27;results-nav-toggle&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;close-results-nav&#x27;).addEventListener(&#x27;click&#x27;, toggleResultsNavPanel);
                document.getElementById(&#x27;results-nav-filter&#x27;).addEventListener(&#x27;change&#x27;, updateResultsNavPanel);
                debugLog(&quot;Quiz initialized successfully&quot;);
            } catch (e) {
                console.error(&quot;Failed to initialize quiz:&quot;, e);
                debugLog(&quot;Failed to initialize quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;start-test&#x27;).disabled = true;
            }
        }

        // Start quiz
        function startQuiz() {
            try {
                debugLog(&quot;Starting quiz&quot;);
                document.getElementById(&#x27;instructions&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.remove(&#x27;hidden&#x27;);
                showQuestion(currentQuestion);
                startTimer();
                updateNavPanel();
                debugLog(&quot;Quiz started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting quiz:&quot;, e);
                debugLog(&quot;Failed to start quiz: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error starting quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;instructions&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        }

        // Show question
        function showQuestion(index) {
            try {
                debugLog(`Showing question ${index + 1}`);
                currentQuestion = index;
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                document.getElementById(&#x27;question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;question-text&#x27;).innerHTML = q.text || &quot;No question text available&quot;;
                const imagesDiv = document.getElementById(&#x27;question-images&#x27;);
                imagesDiv.innerHTML = q.question_images &amp;&amp; q.question_images.length &gt; 0
                    ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg&quot;&gt;`).join(&#x27;&#x27;)
                    : &#x27;&#x27;;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                optionsDiv.innerHTML = q.options &amp;&amp; q.options.length &gt; 0
                    ? q.options.map(opt =&gt; `
                        &lt;button class=&quot;option-btn w-full text-left p-3 border rounded-lg ${answers[index] === opt.label ? &#x27;selected&#x27; : &#x27;&#x27;}&quot; 
                                onclick=&quot;selectOption(${index}, &#x27;${opt.label}&#x27;)&quot; 
                                aria-label=&quot;Option ${opt.label}: ${opt.text}&quot;&gt;
                            ${opt.label}. ${opt.text}
                        &lt;/button&gt;
                    `).join(&#x27;&#x27;)
                    : &#x27;&lt;p class=&quot;text-red-500&quot;&gt;No options available&lt;/p&gt;&#x27;;
                document.getElementById(&#x27;previous-btn&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-btn&#x27;).disabled = index === questions.length - 1;
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[index]);
                updateProgressBar();
                saveProgress();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying question:&quot;, e);
                debugLog(&quot;Failed to display question: &quot; + e.message);
            }
        }

        // Select option
        function selectOption(index, label) {
            try {
                debugLog(`Selecting option ${label} for question ${index + 1}`);
                answers[index] = label;
                const optionsDiv = document.getElementById(&#x27;options&#x27;);
                const optionButtons = optionsDiv.querySelectorAll(&#x27;.option-btn&#x27;);
                optionButtons.forEach(btn =&gt; {
                    const btnLabel = btn.textContent.trim().split(&#x27;.&#x27;)[0];
                    btn.classList.toggle(&#x27;selected&#x27;, btnLabel === label);
                });
                updateNavPanel();
                saveProgress();
                debugLog(`Option ${label} selected for question ${index + 1}`);
            } catch (e) {
                console.error(&quot;Error selecting option:&quot;, e);
                debugLog(&quot;Failed to select option: &quot; + e.message);
            }
        }

        // Toggle mark for review
        function toggleMarkForReview() {
            try {
                debugLog(`Toggling mark for review on question ${currentQuestion + 1}`);
                markedForReview[currentQuestion] = !markedForReview[currentQuestion];
                document.getElementById(&#x27;mark-review&#x27;).classList.toggle(&#x27;marked&#x27;, markedForReview[currentQuestion]);
                updateNavPanel();
                saveProgress();
                debugLog(`Mark for review toggled for question ${currentQuestion + 1}`);
            } catch (e) {
                console.error(&quot;Error marking for review:&quot;, e);
                debugLog(&quot;Failed to mark for review: &quot; + e.message);
            }
        }

        // Navigate to previous question
        function showPreviousQuestion() {
            try {
                debugLog(`Navigating to previous question from ${currentQuestion + 1}`);
                if (currentQuestion &gt; 0) {
                    currentQuestion--;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous question:&quot;, e);
                debugLog(&quot;Failed to navigate to previous question: &quot; + e.message);
            }
        }

        // Navigate to next question
        function showNextQuestion() {
            try {
                debugLog(`Navigating to next question from ${currentQuestion + 1}`);
                if (currentQuestion &lt; questions.length - 1) {
                    currentQuestion++;
                    showQuestion(currentQuestion);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next question:&quot;, e);
                debugLog(&quot;Failed to navigate to next question: &quot; + e.message);
            }
        }

        // Handle question navigation click
        function handleQuestionNavClick(index) {
            try {
                debugLog(`Navigating to question ${index + 1} via nav panel`);
                showQuestion(index);
                toggleNavPanel();
            } catch (e) {
                console.error(&quot;Error handling navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate via nav panel: &quot; + e.message);
            }
        }

        // Start timer
        function startTimer() {
            try {
                debugLog(&quot;Starting timer&quot;);
                timerInterval = setInterval(() =&gt; {
                    if (timeRemaining &lt;= 0) {
                        debugLog(&quot;Timer expired, submitting test&quot;);
                        clearInterval(timerInterval);
                        submitTest();
                    } else {
                        timeRemaining--;
                        const minutes = Math.floor(timeRemaining / 60);
                        const seconds = timeRemaining % 60;
                        document.getElementById(&#x27;timer&#x27;).innerHTML = `Time Remaining: &lt;span&gt;${minutes.toString().padStart(2, &#x27;0&#x27;)}:${seconds.toString().padStart(2, &#x27;0&#x27;)}&lt;/span&gt;`;
                        saveProgress();
                    }
                }, 1000);
                debugLog(&quot;Timer started successfully&quot;);
            } catch (e) {
                console.error(&quot;Error starting timer:&quot;, e);
                debugLog(&quot;Failed to start timer: &quot; + e.message);
            }
        }

        // Update progress bar
        function updateProgressBar() {
            try {
                debugLog(&quot;Updating progress bar&quot;);
                const progress = ((currentQuestion + 1) / questions.length) * 100;
                document.getElementById(&#x27;progress-bar&#x27;).style.width = `${progress}%`;
                debugLog(&quot;Progress bar updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating progress bar:&quot;, e);
                debugLog(&quot;Failed to update progress bar: &quot; + e.message);
            }
        }

        // Update quiz navigation panel
        function updateNavPanel() {
            try {
                debugLog(&quot;Updating quiz navigation panel&quot;);
                const filter = document.getElementById(&#x27;nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;question-nav-btn ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleQuestionNavClick(${i})&quot;
                                aria-label=&quot;Go to Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Quiz navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to update quiz navigation panel: &quot; + e.message);
            }
        }

        // Update results navigation panel
        function updateResultsNavPanel() {
            try {
                debugLog(&quot;Updating results navigation panel&quot;);
                const filter = document.getElementById(&#x27;results-nav-filter&#x27;).value;
                const navGrid = document.getElementById(&#x27;results-nav-grid&#x27;);
                navGrid.innerHTML = questions.map((_, i) =&gt; {
                    if (filter === &#x27;answered&#x27; &amp;&amp; !answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;unanswered&#x27; &amp;&amp; answers[i]) return &#x27;&#x27;;
                    if (filter === &#x27;marked&#x27; &amp;&amp; !markedForReview[i]) return &#x27;&#x27;;
                    return `
                        &lt;button class=&quot;result-nav-btn-grid ${answers[i] ? &#x27;answered&#x27; : &#x27;unanswered&#x27;} ${markedForReview[i] ? &#x27;marked-nav&#x27; : &#x27;&#x27;}&quot;
                                onclick=&quot;handleResultNavClick(${i})&quot;
                                aria-label=&quot;Go to Result for Question ${i + 1}&quot;&gt;
                            ${i + 1}
                        &lt;/button&gt;
                    `;
                }).join(&#x27;&#x27;);
                debugLog(&quot;Results navigation panel updated&quot;);
            } catch (e) {
                console.error(&quot;Error updating results navigation panel:&quot;, e);
                debugLog(&quot;Failed to update results navigation panel: &quot; + e.message);
            }
        }

        // Toggle quiz navigation panel
        function toggleNavPanel() {
            try {
                debugLog(&quot;Toggling quiz navigation panel&quot;);
                const navPanel = document.getElementById(&#x27;nav-panel&#x27;);
                navPanel.classList.toggle(&#x27;hidden&#x27;);
                debugLog(&quot;Quiz navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling quiz navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle quiz navigation panel: &quot; + e.message);
            }
        }

        // Toggle results navigation panel
        function toggleResultsNavPanel() {
            try {
                debugLog(&quot;Toggling results navigation panel&quot;);
                const resultsNavPanel = document.getElementById(&#x27;results-nav-panel&#x27;);
                resultsNavPanel.classList.toggle(&#x27;hidden&#x27;);
                if (!resultsNavPanel.classList.contains(&#x27;hidden&#x27;)) {
                    updateResultsNavPanel();
                }
                debugLog(&quot;Results navigation panel toggled&quot;);
            } catch (e) {
                console.error(&quot;Error toggling results navigation panel:&quot;, e);
                debugLog(&quot;Failed to toggle results navigation panel: &quot; + e.message);
            }
        }

        // Handle result navigation click
        function handleResultNavClick(index) {
            try {
                debugLog(`Navigating to result for question ${index + 1} via nav panel`);
                showResults(index);
                toggleResultsNavPanel();
            } catch (e) {
                console.error(&quot;Error handling result navigation click:&quot;, e);
                debugLog(&quot;Failed to navigate to result: &quot; + e.message);
            }
        }

        // Show submit modal
        function showSubmitModal() {
            try {
                debugLog(&quot;Showing submit modal&quot;);
                const attempted = answers.filter(a =&gt; a !== null).length;
                document.getElementById(&#x27;attempted-count&#x27;).textContent = attempted;
                document.getElementById(&#x27;unattempted-count&#x27;).textContent = questions.length - attempted;
                document.getElementById(&#x27;submit-modal&#x27;).classList.remove(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal displayed&quot;);
            } catch (e) {
                console.error(&quot;Error showing submit modal:&quot;, e);
                debugLog(&quot;Failed to show submit modal: &quot; + e.message);
            }
        }

        // Close submit modal
        function closeSubmitModal() {
            try {
                debugLog(&quot;Closing submit modal&quot;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Submit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing submit modal:&quot;, e);
                debugLog(&quot;Failed to close submit modal: &quot; + e.message);
            }
        }

        // Close exit modal
        function closeExitModal() {
            try {
                debugLog(&quot;Closing exit modal&quot;);
                document.getElementById(&#x27;exit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                debugLog(&quot;Exit modal closed&quot;);
            } catch (e) {
                console.error(&quot;Error closing exit modal:&quot;, e);
                debugLog(&quot;Failed to close exit modal: &quot; + e.message);
            }
        }

        // Submit test
        function submitTest() {
            try {
                debugLog(&quot;Submitting test&quot;);
                clearInterval(timerInterval);
                document.getElementById(&#x27;quiz&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;submit-modal&#x27;).classList.add(&#x27;hidden&#x27;);
                document.getElementById(&#x27;results&#x27;).classList.remove(&#x27;hidden&#x27;);
                showResults(0); // Start with first question
                // Trigger confetti animation
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                localStorage.removeItem(`quiz_${quizId}`);
                debugLog(&quot;Test submitted successfully&quot;);
            } catch (e) {
                console.error(&quot;Error submitting test:&quot;, e);
                debugLog(&quot;Failed to submit test: &quot; + e.message);
            }
        }

        // Show result for a single question
        function showResults(index) {
            try {
                debugLog(`Showing result for question ${index + 1}`);
                currentResultQuestion = index;
                let correct = 0, wrong = 0, unanswered = 0, marked = 0;
                answers.forEach((answer, i) =&gt; {
                    const isCorrect = answer &amp;&amp; questions[i].options.find(opt =&gt; opt.label === answer)?.correct;
                    if (answer === null) unanswered++;
                    else if (isCorrect) correct++;
                    else wrong++;
                    if (markedForReview[i]) marked++;
                });
                const q = questions[index];
                if (!q) {
                    throw new Error(`Question ${index} is undefined`);
                }
                const userAnswer = answers[index];
                const isCorrect = userAnswer &amp;&amp; q.options.find(opt =&gt; opt.label === userAnswer)?.correct;
                const resultsContent = document.getElementById(&#x27;results-content&#x27;);
                resultsContent.innerHTML = `
                    &lt;div class=&quot;border p-4 rounded-lg ${isCorrect ? &#x27;bg-green-50&#x27; : userAnswer ? &#x27;bg-red-50&#x27; : &#x27;bg-gray-50&#x27;}&quot;&gt;
                        &lt;p class=&quot;font-semibold&quot;&gt;Question ${index + 1}: ${q.text || &#x27;No question text&#x27;}&lt;/p&gt;
                        ${q.question_images &amp;&amp; q.question_images.length &gt; 0 ? q.question_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Question Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        &lt;p&gt;&lt;strong&gt;Your Answer:&lt;/strong&gt; ${userAnswer ? `${userAnswer}. ${q.options.find(opt =&gt; opt.label === userAnswer)?.text || &#x27;Invalid option&#x27;}` : &#x27;Unanswered&#x27;}&lt;/p&gt;
                        &lt;p&gt;&lt;strong&gt;Correct Answer:&lt;/strong&gt; ${q.correct_answer || &#x27;Unknown&#x27;}&lt;/p&gt;
                        &lt;div class=&quot;mt-2&quot;&gt;${q.explanation || &#x27;No explanation available&#x27;}&lt;/div&gt;
                        ${q.explanation_images &amp;&amp; q.explanation_images.length &gt; 0 ? q.explanation_images.map(url =&gt; `&lt;img src=&quot;${url}&quot; alt=&quot;Explanation Image&quot; class=&quot;max-w-full h-auto rounded-lg my-2&quot;&gt;`).join(&#x27;&#x27;) : &#x27;&#x27;}
                        ${q.video ? `
                            &lt;button class=&quot;play-video bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadVideo(this, &#x27;${q.video}&#x27;, &#x27;video-${index}&#x27;)&quot;
                                    aria-label=&quot;Play explanation video for Question ${index + 1}&quot;&gt;
                                Play Video Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;video-${index}&quot; class=&quot;video-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&lt;p class=&quot;text-gray-500 mt-2&quot;&gt;No video available&lt;/p&gt;&#x27;}
                        ${q.audio ? `
                            &lt;button class=&quot;play-audio bg-blue-500 text-white px-4 py-2 rounded-lg mt-2&quot; 
                                    onclick=&quot;loadAudio(this, &#x27;${q.audio}&#x27;, &#x27;audio-${index}&#x27;)&quot;
                                    aria-label=&quot;Play audio explanation for Question ${index + 1}&quot;&gt;
                                Play Audio Explanation
                            &lt;/button&gt;
                            &lt;div id=&quot;audio-${index}&quot; class=&quot;audio-container mt-2&quot;&gt;&lt;/div&gt;
                        ` : &#x27;&#x27;}
                    &lt;/div&gt;
                `;
                document.getElementById(&#x27;correct-count&#x27;).textContent = correct;
                document.getElementById(&#x27;wrong-count&#x27;).textContent = wrong;
                document.getElementById(&#x27;unanswered-count&#x27;).textContent = unanswered;
                document.getElementById(&#x27;marked-count&#x27;).textContent = marked;
                document.getElementById(&#x27;result-question-number&#x27;).innerHTML = `Question &lt;span&gt;${index + 1}&lt;/span&gt; of ${questions.length}`;
                document.getElementById(&#x27;prev-result&#x27;).disabled = index === 0;
                document.getElementById(&#x27;next-result&#x27;).disabled = index === questions.length - 1;
                updateResultsNavPanel();
                window.scrollTo({ top: 0, behavior: &#x27;smooth&#x27; });
                debugLog(`Result for question ${index + 1} displayed successfully`);
            } catch (e) {
                console.error(&quot;Error displaying result:&quot;, e);
                debugLog(&quot;Failed to display result: &quot; + e.message);
            }
        }

        // Navigate to previous result
        function showPreviousResult() {
            try {
                debugLog(`Navigating to previous result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &gt; 0) {
                    showResults(currentResultQuestion - 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to previous result:&quot;, e);
                debugLog(&quot;Failed to navigate to previous result: &quot; + e.message);
            }
        }

        // Navigate to next result
        function showNextResult() {
            try {
                debugLog(`Navigating to next result from question ${currentResultQuestion + 1}`);
                if (currentResultQuestion &lt; questions.length - 1) {
                    showResults(currentResultQuestion + 1);
                }
            } catch (e) {
                console.error(&quot;Error navigating to next result:&quot;, e);
                debugLog(&quot;Failed to navigate to next result: &quot; + e.message);
            }
        }

        // Lazy-load video
        function loadVideo(button, videoUrl, containerId) {
            try {
                debugLog(`Loading video for ${containerId}: ${videoUrl}`);
                if (!videoUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No video available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No video URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;div class=&quot;video-loading&quot;&gt;&lt;/div&gt;
                    &lt;video controls class=&quot;w-full max-w-[600px] rounded-lg&quot; preload=&quot;metadata&quot; aria-label=&quot;Video explanation&quot;&gt;
                        &lt;source src=&quot;${videoUrl}&quot; type=&quot;${videoUrl.endsWith(&#x27;.m3u8&#x27;) ? &#x27;application/x-mpegURL&#x27; : &#x27;video/mp4&#x27;}&quot;&gt;
                        Your browser does not support the video tag.
                    &lt;/video&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Initialize HLS.js for .m3u8 videos
                const video = container.querySelector(&#x27;video&#x27;);
                if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; Hls.isSupported()) {
                    const hls = new Hls();
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.ERROR, (event, data) =&gt; {
                        console.error(&quot;HLS.js error:&quot;, data);
                        container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                        debugLog(&quot;HLS.js error: &quot; + JSON.stringify(data));
                    });
                } else if (videoUrl.endsWith(&#x27;.m3u8&#x27;) &amp;&amp; video.canPlayType(&#x27;application/vnd.apple.mpegurl&#x27;)) {
                    video.src = videoUrl;
                }
                // Handle video load errors
                video.onerror = () =&gt; {
                    console.error(&quot;Video load error for URL:&quot;, videoUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Video load error for URL: &quot; + videoUrl);
                };
                // Remove loading spinner when video is ready
                video.onloadedmetadata = () =&gt; {
                    container.querySelector(&#x27;.video-loading&#x27;).remove();
                    debugLog(&quot;Video loaded successfully&quot;);
                };
            } catch (e) {
                console.error(&quot;Error loading video:&quot;, e);
                debugLog(&quot;Failed to load video: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading video. &lt;a href=&quot;${videoUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open video in new tab&quot;&gt;Open video&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Lazy-load audio
        function loadAudio(button, audioUrl, containerId) {
            try {
                debugLog(`Loading audio for ${containerId}: ${audioUrl}`);
                if (!audioUrl) {
                    const container = document.getElementById(containerId);
                    container.innerHTML = `&lt;p class=&quot;text-gray-500&quot;&gt;No audio available&lt;/p&gt;`;
                    button.remove();
                    debugLog(&quot;No audio URL provided&quot;);
                    return;
                }
                const container = document.getElementById(containerId);
                container.innerHTML = `
                    &lt;audio controls class=&quot;w-full max-w-[600px]&quot; preload=&quot;metadata&quot; aria-label=&quot;Audio explanation&quot;&gt;
                        &lt;source src=&quot;${audioUrl}&quot; type=&quot;audio/mpeg&quot;&gt;
                        Your browser does not support the audio tag.
                    &lt;/audio&gt;
                `;
                container.classList.add(&#x27;active&#x27;);
                button.remove();
                // Handle audio load errors
                const audio = container.querySelector(&#x27;audio&#x27;);
                audio.onerror = () =&gt; {
                    console.error(&quot;Audio load error for URL:&quot;, audioUrl);
                    container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
                    debugLog(&quot;Audio load error for URL: &quot; + audioUrl);
                };
                debugLog(&quot;Audio loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading audio:&quot;, e);
                debugLog(&quot;Failed to load audio: &quot; + e.message);
                const container = document.getElementById(containerId);
                container.innerHTML = `&lt;p class=&quot;text-red-500&quot;&gt;Error loading audio. &lt;a href=&quot;${audioUrl}&quot; target=&quot;_blank&quot; aria-label=&quot;Open audio in new tab&quot;&gt;Open audio&lt;/a&gt;&lt;/p&gt;`;
            }
        }

        // Toggle dark mode
        function toggleTheme() {
            try {
                debugLog(&quot;Toggling theme&quot;);
                document.documentElement.classList.toggle(&#x27;dark&#x27;);
                localStorage.setItem(&#x27;theme&#x27;, document.documentElement.classList.contains(&#x27;dark&#x27;) ? &#x27;dark&#x27; : &#x27;light&#x27;);
                debugLog(&quot;Theme toggled successfully&quot;);
            } catch (e) {
                console.error(&quot;Error toggling theme:&quot;, e);
                debugLog(&quot;Failed to toggle theme: &quot; + e.message);
            }
        }

        // Load theme preference
        function loadTheme() {
            try {
                debugLog(&quot;Loading theme preference&quot;);
                const theme = localStorage.getItem(&#x27;theme&#x27;);
                if (theme === &#x27;dark&#x27;) {
                    document.documentElement.classList.add(&#x27;dark&#x27;);
                }
                debugLog(&quot;Theme loaded successfully&quot;);
            } catch (e) {
                console.error(&quot;Error loading theme:&quot;, e);
                debugLog(&quot;Failed to load theme: &quot; + e.message);
            }
        }

        // Initialize on DOM content loaded
        window.addEventListener(&#x27;DOMContentLoaded&#x27;, () =&gt; {
            try {
                debugLog(&quot;DOM content loaded, initializing quiz&quot;);
                loadTheme();
                initQuiz();
            } catch (e) {
                console.error(&quot;Error during DOMContentLoaded:&quot;, e);
                debugLog(&quot;Failed to initialize on DOMContentLoaded: &quot; + e.message);
                document.getElementById(&#x27;error-message&#x27;).innerHTML = &quot;Error initializing quiz. Please check the console for details or contact support.&quot;;
                document.getElementById(&#x27;error-message&#x27;).classList.remove(&#x27;hidden&#x27;);
            }
        });
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;" frameborder="0" width="100%" height="2000px"></iframe>
</div>

