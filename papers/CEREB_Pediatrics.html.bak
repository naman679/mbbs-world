&lt;button class=&quot;bg-yellow-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-yellow-400 transition w-full md:w-auto&quot; id=&quot;mark-review&quot;&gt;Mark for Review&lt;/button&gt;
