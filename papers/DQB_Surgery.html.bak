<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Surgery - Combined Tests</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    button {
      margin: 5px;
      padding: 10px 15px;
      background: #f0f0f0;
      border: 1px solid #ccc;
      border-radius: 4px;
      cursor: pointer;
    }
    button:hover { background: #ddd; }
    .iframe-container { margin-top: 20px; }
    .iframe-container iframe { display: block; }
  </style>
  <script>
    function showTest(id) {
      if (document.querySelector('.iframe-container:not([style*="display: none"])') !== document.getElementById(id)) {
        if (!confirm("Are you sure you want to switch tests? Any unsaved progress may be lost.")) {
          return;
        }
      }
      document.querySelectorAll('.iframe-container').forEach(div => div.style.display = 'none');
      document.getElementById(id).style.display = 'block';
      window.scrollTo(0, 0);
    }
  </script>
</head>
<body>
  <h1>Surgery - Combined Tests</h1>
  <div class="nav-buttons"><button onclick="showTest('test1')">Adrenal_Gland</button>
<button onclick="showTest('test2')">Appendix</button>
<button onclick="showTest('test3')">Arterial_System</button>
<button onclick="showTest('test4')">Bariatric_Surgery</button>
<button onclick="showTest('test5')">Biliary_System</button>
<button onclick="showTest('test6')">Bladder</button>
<button onclick="showTest('test7')">Breast</button>
<button onclick="showTest('test8')">Burns</button>
<button onclick="showTest('test9')">Cleft_Palate</button>
<button onclick="showTest('test10')">Esophagus</button>
<button onclick="showTest('test11')">Gall_Bladder</button>
<button onclick="showTest('test12')">Head_and_Neck</button>
<button onclick="showTest('test13')">Hernia</button>
<button onclick="showTest('test14')">Inflammatory_Bowel_Disease</button>
<button onclick="showTest('test15')">Instruments</button>
<button onclick="showTest('test16')">Kidney__Ureter</button>
<button onclick="showTest('test17')">Liver</button>
<button onclick="showTest('test18')">Men_Syndrome</button>
<button onclick="showTest('test19')">Oral_Cavity</button>
<button onclick="showTest('test20')">Pancreas</button>
<button onclick="showTest('test21')">Plastic_Surgery</button>
<button onclick="showTest('test22')">Prostate</button>
<button onclick="showTest('test23')">Rectum_and_anal_canal</button>
<button onclick="showTest('test24')">Salivary_Glands</button>
<button onclick="showTest('test25')">Shock</button>
<button onclick="showTest('test26')">Skin</button>
<button onclick="showTest('test27')">Small__large_intestine</button>
<button onclick="showTest('test28')">Stomach</button>
<button onclick="showTest('test29')">Surgery_Clinical_vignettes</button>
<button onclick="showTest('test30')">Surgery_Image_Based_Question</button>
<button onclick="showTest('test31')">Surgical_Nutrition</button>
<button onclick="showTest('test32')">Surgical_infection</button>
<button onclick="showTest('test33')">Sutures</button>
<button onclick="showTest('test34')">Testes__Scrotum</button>
<button onclick="showTest('test35')">Thyroid</button>
<button onclick="showTest('test36')">Transplant</button>
<button onclick="showTest('test37')">Trauma</button>
<button onclick="showTest('test38')">Urethra__Penis</button>
<button onclick="showTest('test39')">Venous_System</button>
<button onclick="showTest('test40')">Wound_Healing</button>
</div>
  <hr>
  
<div id="test1" class="iframe-container" style="display:block;">
    <h2>Adrenal_Gland</h2>
    <iframe srcdoc="&lt;!DOCTYPE html&gt;

&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;utf-8&quot;/&gt;
&lt;meta content=&quot;width=device-width, initial-scale=1.0&quot; nameag=&quot;viewport&quot;/&gt;
