&lt;button class=&quot;bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition&quot; id=&quot;confirm-submit&quot;&gt;Submit Test&lt;/button&gt;
&lt;/div&gt;
&lt;/div&gt;
