1sf3u.cloudfront.net/dqb_vod/53715151705324609/53715151705324609.m3u8&quot;}, {&quot;text&quot;: &quot;In pattey’s mastectomy, the step not done is: (LQ)&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Nipple and areola removed&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Surrounding normal tissue of tumor is removed&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Pectoralis major removed&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Pectoralis minor removed&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Pectoralis major removed&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanation&quot;: &quot;&lt;p&gt;&lt;strong&gt;Correct Answer (C)&lt;/strong&gt;&lt;/p&gt;\n&lt;p&gt;@dams_new_robot&lt;/p&gt;&quot;, &quot;bot&quot;: &quot;@dams_new_robot&quot;, &quot;video&quot;: &quot;https://d2enu63wt1sf3u.cloudfront.net/dqb_vod/26715141705326703/26715141705326703.m3u8&quot;}, {&quot;text&quot;: &quot;Malti, a 45-years female patient with a family history of breast carcinoma, showed diffuse microcalcification on mammography. Indraductal carcinoma in situ was seen on biopsy. Most appropriate management is: (AIIMS May 2014)&quot;, &quot;options&quot;: [{&quot;label&quot;: &quot;A&quot;, &quot;text&quot;: &quot;Quadrantectomy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;B&quot;, &quot;text&quot;: &quot;Radical mastectomy&quot;, &quot;correct&quot;: false}, {&quot;label&quot;: &quot;C&quot;, &quot;text&quot;: &quot;Simple mastectomy&quot;, &quot;correct&quot;: true}, {&quot;label&quot;: &quot;D&quot;, &quot;text&quot;: &quot;Chemotherapy&quot;, &quot;correct&quot;: false}], &quot;correct_answer&quot;: &quot;C. Simple mastectomy&quot;, &quot;question_images&quot;: [], &quot;explanation_images&quot;: [], &quot;explanati