<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CEREB Pharmacology - Combined Tests</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    button {
      margin: 5px;
      padding: 10px 15px;
      background: #f0f0f0;
      border: 1px solid #ccc;
      border-radius: 4px;
      cursor: pointer;
    }
    button:hover { background: #ddd; }
    .iframe-container { margin-top: 20px; }
    .iframe-container iframe { display: block; }
  </style>
  <script>
    function showTest(id) {
      if (document.querySelector('.iframe-container:not([style*="display: none"])') !== document.getElementById(id)) {
        if (!confirm("Are you sure you want to switch tests? Any unsaved progress may be lost.")) {
          return;
        }
      }
      document.querySelectorAll('.iframe-container').forEach(div => div.style.display = 'none');
      document.getElementById(id).style.display = 'block';
      window.scrollTo(0, 0);
    }
  </script>
</head>
<body>
  <h1>Cereb Pharmacology - Combined Tests</h1>
  <div class="nav-buttons"><button onclick="showTest('test1')">Anaesthesia</button>
<button onclick="showTest('test2')">Anti-Cancer Drugs & Immunosuppressants</button>
<button onclick="showTest('test3')">Antimicrobial Agents</button>
<button onclick="showTest('test4')">Autacoids</button>
<button onclick="showTest('test5')">Autonomic Nervous System</button>
<button onclick="showTest('test6')">Cardiovascular System</button>
<button onclick="showTest('test7')">Central Nervous System</button>
<button onclick="showTest('test8')">Endocrine System</button>
<button onclick="showTest('test9')">Gastrointestinal System</button>
<button onclick="showTest('test10')">General Pharmacology</button>
<button onclick="showTest('test11')">Hematology</button>
<button onclick="showTest('test12')">Kidney</button>
<button onclick="showTest('test13')">Respiratory System</button>
</div>
  <hr>
  
<div id="test1" class="iframe-container" style="display:block;">
    <h2>Anaesthesia</h2>
    <iframe srcdoc="&lt;!DOCTYPE html&gt;

&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;utf-8&quot;/&gt;
&lt;meta content=&quot;width=device-width, initial-scale=1.0&quot; nameag=&quot;viewport&quot;/&gt;
&lt;title&gt;Anaesthesia&lt;/title&gt;
